<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Keepmark.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- sqlite-net-pcl drags in the unencrypted bundle_green provider; exclude it
         entirely so only SQLCipher (bundle_e_sqlcipher) ships and initializes. -->
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.10" ExcludeAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.10" />
  </ItemGroup>

</Project>
