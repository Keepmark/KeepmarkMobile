@using Keepmark.Core.Data

<div class="xbs-tree">
    <div class="xbs-tree-search">
        <svg class="km-ico xbs-tree-search-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="M20 20l-4.2-4.2" /></svg>
        <input class="form-control" placeholder="@L.Get(Str.PickerFilter)" aria-label="@L.Get(Str.PickerFilter)"
               @oninput="OnFilter" value="@filter" />
    </div>
    <div class="xbs-tree-scroll" role="tree" aria-label="@L.Get(Str.PickerFolders)">
    <div class="xbs-tree-list">
    @if (string.IsNullOrWhiteSpace(filter))
    {
        <div class="xbs-tree-item">
            <div class="xbs-tree-row @(Selected is null ? "selected" : string.Empty)">
                <span class="xbs-tree-exp xbs-tree-exp-ph" aria-hidden="true"></span>
                <button type="button" role="treeitem" aria-selected="@((Selected is null).ToString().ToLowerInvariant())" aria-level="1"
                        class="xbs-tree-node" @onclick="() => Highlight(null)">
                    <span class="xbs-tree-ico home" aria-hidden="true"><svg class="km-ico" viewBox="0 0 24 24"><path d="M4 11l8-6 8 6v8a1 1 0 0 1-1 1h-4v-6h-6v6H5a1 1 0 0 1-1-1z" /></svg></span>
                    <span class="xbs-tree-label">@L.Get(Str.SheetTopLevel)</span>
                    @if (Selected is null) { <svg class="km-ico xbs-tree-check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg> }
                </button>
            </div>
        </div>
        @foreach (var root in Roots)
        {
            @TreeNode(root, 0)
        }
        @if (Draft is not null && Draft.ParentRowId is null)
        {
            @DraftNode(0)
        }
    }
    else
    {
        <p class="xbs-tree-note" role="status">@Filtered.Count folder(s) match</p>
        @foreach (var f in Filtered)
        {
            <div class="xbs-tree-row @(Selected == f.RowId ? "selected" : string.Empty)">
                <button type="button" role="treeitem" aria-level="2" aria-selected="@((Selected == f.RowId).ToString().ToLowerInvariant())"
                        class="xbs-tree-node" @onclick="() => Highlight(f.RowId)">
                    <span class="xbs-tree-ico" aria-hidden="true"><svg class="km-ico" viewBox="0 0 24 24"><path d="M3.5 7.5a2 2 0 0 1 2-2h4l2 2h7a2 2 0 0 1 2 2v7.5a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2z" /></svg></span>
                    <span class="xbs-tree-label">@(f.DisplayTitle ?? L.Get(Str.SheetTypeFolder))<small>@PathOf(f)</small></span>
                    @if (Selected == f.RowId) { <svg class="km-ico xbs-tree-check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg> }
                </button>
            </div>
        }
        @if (Filtered.Count == 0)
        {
            <p class="xbs-tree-note" role="status">@L.Get(Str.PickerNoMatch)</p>
        }
    }
    </div>
    @if (AllowCreate && Draft is null && string.IsNullOrWhiteSpace(filter))
    {
        @if (creating)
        {
            <form class="xbs-move-new xbs-tree-new" @onsubmit="CreateDraft" @onsubmit:preventDefault="true">
                <input class="form-control" placeholder="@L.Get(Str.MoveFolderName)" aria-label="@L.Get(Str.MoveFolderName)"
                       @bind="newName" @bind:event="oninput" @ref="newInput" />
                <button type="submit" class="btn btn-primary" disabled="@string.IsNullOrWhiteSpace(newName)">@L.Get(Str.MoveCreate)</button>
            </form>
        }
        else
        {
            <button type="button" class="xbs-move-newbtn xbs-tree-new" @onclick="StartCreate">
                <svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                <span>@L.Get(Str.MoveNewFolderIn, NameOf(Selected))</span>
            </button>
        }
    }
    </div>
    <div class="xbs-tree-foot">
        <button type="button" class="btn btn-secondary" @onclick="Cancel">@L.Get(Str.CommonCancel)</button>
        <button type="button" class="btn btn-primary" @onclick="Confirm">@L.Get(Str.PickerSelect)</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public List<ItemRow> Folders { get; set; } = [];
    [Parameter] public int? Selected { get; set; }
    [Parameter] public EventCallback<int?> SelectedChanged { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>RowId whose whole subtree is hidden (cannot move a folder into itself).</summary>
    [Parameter] public int? ExcludeSubtreeRoot { get; set; }

    /// <summary>Shows "New folder in …": the folder is only a draft here,
    /// created by the owner on Save (cancel leaves nothing behind).</summary>
    [Parameter] public bool AllowCreate { get; set; }
    [Parameter] public DraftFolder? Draft { get; set; }
    [Parameter] public EventCallback<DraftFolder?> DraftChanged { get; set; }

    /// <summary>Selected value meaning "the draft folder" (real RowIds are positive).</summary>
    public const int DraftRowId = -1;

    public sealed record DraftFolder(int? ParentRowId, string Title);

    private bool creating;
    private bool focusNew;
    private string newName = string.Empty;
    private ElementReference newInput;

    private List<ItemRow> Roots = [];
    private Dictionary<int, List<ItemRow>> ByParent = new();
    private Dictionary<int, ItemRow> ById = new();
    private readonly HashSet<int> collapsed = new();
    private string filter = string.Empty;
    private List<ItemRow> Filtered = [];

    protected override void OnParametersSet()
    {
        var childrenOf = Folders.Where(f => f.ParentRowId is not null)
            .GroupBy(f => f.ParentRowId!.Value)
            .ToDictionary(g => g.Key, g => g.Select(f => f.RowId).ToList());

        var excluded = new HashSet<int>();
        if (ExcludeSubtreeRoot is not null)
        {
            var queue = new Queue<int>([ExcludeSubtreeRoot.Value]);
            while (queue.Count > 0)
            {
                var cur = queue.Dequeue();
                if (!excluded.Add(cur))
                {
                    continue;
                }

                if (childrenOf.TryGetValue(cur, out var kids))
                {
                    foreach (var k in kids)
                    {
                        queue.Enqueue(k);
                    }
                }
            }
        }

        var visible = Folders.Where(f => !excluded.Contains(f.RowId)).ToList();
        ById = visible.ToDictionary(f => f.RowId);
        var ids = visible.Select(f => f.RowId).ToHashSet();
        Roots = visible.Where(f => f.ParentRowId is null || !ids.Contains(f.ParentRowId.Value))
            .OrderBy(f => f.SortOrder).ToList();
        ByParent = visible.Where(f => f.ParentRowId is not null)
            .GroupBy(f => f.ParentRowId!.Value)
            .ToDictionary(g => g.Key, g => g.OrderBy(f => f.SortOrder).ToList());

        // Start fully collapsed; the path to the current selection stays open.
        collapsed.Clear();
        foreach (var f in visible)
        {
            if (ByParent.ContainsKey(f.RowId))
            {
                collapsed.Add(f.RowId);
            }
        }

        var sel = Selected;
        if (sel == DraftRowId && Draft?.ParentRowId is not null)
        {
            collapsed.Remove(Draft.ParentRowId.Value);
            sel = Draft.ParentRowId;
        }

        while (sel is not null && ById.TryGetValue(sel.Value, out var node) && node.ParentRowId is not null)
        {
            collapsed.Remove(node.ParentRowId.Value);
            sel = node.ParentRowId;
        }
    }

    private Task Highlight(int? rowId) => SelectedChanged.InvokeAsync(rowId);

    private void StartCreate()
    {
        creating = true;
        focusNew = true;
        newName = string.Empty;
    }

    private async Task CreateDraft()
    {
        var name = newName.Trim();
        if (name.Length == 0)
        {
            return;
        }

        creating = false;
        // The draft goes under the highlighted folder (a vanished one = top level).
        var parent = Selected is not null && ById.ContainsKey(Selected.Value) ? Selected : null;
        await DraftChanged.InvokeAsync(new DraftFolder(parent, name));
        await SelectedChanged.InvokeAsync(DraftRowId);
    }

    private async Task RemoveDraft()
    {
        var parent = Draft?.ParentRowId;
        await DraftChanged.InvokeAsync(null);
        if (Selected == DraftRowId)
        {
            await SelectedChanged.InvokeAsync(parent);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusNew && creating)
        {
            focusNew = false;
            try { await newInput.FocusAsync(); } catch { }
        }
    }

    private string NameOf(int? rowId) =>
        rowId is not null && ById.TryGetValue(rowId.Value, out var f)
            ? f.DisplayTitle ?? L.Get(Str.SheetTypeFolder)
            : L.Get(Str.SheetTopLevel);
    private Task Confirm() => OnConfirm.InvokeAsync();
    private Task Cancel() => OnCancel.InvokeAsync();

    private static string? NodeExpanded(bool hasKids, bool isCollapsed) =>
        hasKids ? (!isCollapsed).ToString().ToLowerInvariant() : null;

    private string ExpandLabel(bool isCollapsed, string? title) =>
        L.Get(isCollapsed ? Str.PickerExpand : Str.PickerCollapse, title ?? L.Get(Str.SheetTypeFolder));

    private void Toggle(int rowId)
    {
        if (!collapsed.Remove(rowId))
        {
            collapsed.Add(rowId);
        }
    }

    private void OnFilter(ChangeEventArgs e)
    {
        filter = e.Value?.ToString() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(filter))
        {
            Filtered = [];
            return;
        }

        Filtered = ById.Values
            .Where(f => f.DisplayTitle is not null && f.DisplayTitle.Contains(filter, StringComparison.OrdinalIgnoreCase))
            .OrderBy(f => f.DisplayTitle)
            .ToList();
    }

    private string PathOf(ItemRow f)
    {
        var parts = new Stack<string>();
        var cur = f.ParentRowId is not null && ById.TryGetValue(f.ParentRowId.Value, out var p) ? p : null;
        while (cur is not null)
        {
            if (cur.DisplayTitle is not null)
            {
                parts.Push(cur.DisplayTitle);
            }

            cur = cur.ParentRowId is not null && ById.TryGetValue(cur.ParentRowId.Value, out var q) ? q : null;
        }

        var path = string.Join(" / ", parts);
        return string.IsNullOrEmpty(path) ? L.Get(Str.SheetTopLevel) : path;
    }

    private RenderFragment TreeNode(ItemRow Node, int Level) => __builder =>
    {
        var realKids = ByParent.TryGetValue(Node.RowId, out var kids) && kids.Count > 0;
        var draftHere = Draft is not null && Draft.ParentRowId == Node.RowId;
        var hasKids = realKids || draftHere;
        var isCollapsed = collapsed.Contains(Node.RowId);
        var isSelected = Selected == Node.RowId;
        <div class="xbs-tree-item">
            <div class="xbs-tree-row @(isSelected ? "selected" : string.Empty)">
                @if (hasKids)
                {
                    <button type="button" class="xbs-tree-exp" aria-expanded="@((!isCollapsed).ToString().ToLowerInvariant())"
                            aria-label="@ExpandLabel(isCollapsed, Node.DisplayTitle)"
                            @onclick="() => Toggle(Node.RowId)" @onclick:stopPropagation="true">
                        <svg class="km-ico sm xbs-expand-chev @(isCollapsed ? string.Empty : "open")" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
                    </button>
                }
                else
                {
                    <span class="xbs-tree-exp xbs-tree-exp-ph" aria-hidden="true"></span>
                }
                <button type="button" role="treeitem" aria-selected="@(isSelected.ToString().ToLowerInvariant())"
                        aria-expanded="@NodeExpanded(hasKids, isCollapsed)" aria-level="@(Level + 1)"
                        class="xbs-tree-node"
                        @onclick="() => Highlight(Node.RowId)" @onclick:stopPropagation="true">
                    <span class="xbs-tree-ico" aria-hidden="true"><svg class="km-ico" viewBox="0 0 24 24"><path d="M3.5 7.5a2 2 0 0 1 2-2h4l2 2h7a2 2 0 0 1 2 2v7.5a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2z" /></svg></span>
                    <span class="xbs-tree-label">@(Node.DisplayTitle ?? L.Get(Str.SheetTypeFolder))</span>
                    @if (hasKids)
                    {
                        var count = (kids?.Count ?? 0) + (draftHere ? 1 : 0);
                        <span class="xbs-tree-count" aria-label="@L.Get(Str.PickerSubfolders, count)">@count</span>
                    }
                    @if (isSelected) { <svg class="km-ico xbs-tree-check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg> }
                </button>
            </div>
            @if (hasKids && !isCollapsed)
            {
                <div class="xbs-tree-kids" role="group">
                    @if (realKids)
                    {
                        @foreach (var k in kids!)
                        {
                            @TreeNode(k, Level + 1)
                        }
                    }
                    @if (draftHere)
                    {
                        @DraftNode(Level + 1)
                    }
                </div>
            }
        </div>
    };

    private RenderFragment DraftNode(int Level) => __builder =>
    {
        var isSelected = Selected == DraftRowId;
        <div class="xbs-tree-item">
            <div class="xbs-tree-row xbs-tree-draft @(isSelected ? "selected" : string.Empty)">
                <span class="xbs-tree-exp xbs-tree-exp-ph" aria-hidden="true"></span>
                <button type="button" role="treeitem" aria-selected="@(isSelected.ToString().ToLowerInvariant())" aria-level="@(Level + 1)"
                        class="xbs-tree-node" @onclick="() => Highlight(DraftRowId)" @onclick:stopPropagation="true">
                    <span class="xbs-tree-ico" aria-hidden="true"><svg class="km-ico" viewBox="0 0 24 24"><path d="M3.5 7.5a2 2 0 0 1 2-2h4l2 2h7a2 2 0 0 1 2 2v7.5a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2z" /></svg></span>
                    <span class="xbs-tree-label">@Draft!.Title</span>
                    <span class="xbs-tree-badge">@L.Get(Str.PickerNewBadge)</span>
                    @if (isSelected) { <svg class="km-ico xbs-tree-check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg> }
                </button>
                <button type="button" class="xbs-tree-exp" aria-label="@L.Get(Str.PickerRemoveNew, Draft!.Title)"
                        @onclick="RemoveDraft" @onclick:stopPropagation="true">
                    <svg class="km-ico sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
                </button>
            </div>
        </div>
    };
}
