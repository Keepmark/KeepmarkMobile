@using Keepmark.Core.Data

@* Leading tile of a bookmark row: for folders, a navy folder whose pocket
   has a bookmark pressed into it, starting at the rim as if one slid inside
   (canvas "B4E"; gradient and lift filter are shared defs in index.html); for
   bookmarks, the brand's bookmark shape filled with the site color and the
   initial in its upper part (color hashed from the host, so the same site
   keeps the same color everywhere; canvas "Icone" variant 1).
   Not "mark": Bootstrap styles .mark as a padded highlight.
   Decorative: the row label names it. *@
@if (Row.IsFolder)
{
    <span class="xbs-tile folder @SizeClass" aria-hidden="true">
        <svg viewBox="0 0 40 40">
            <path d="M3 9a4 4 0 0 1 4-4h8.5l4 4H33a4 4 0 0 1 4 4v19a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4z" fill="#1b2a5e" />
            <path d="M3 15a3 3 0 0 1 3-3h28a3 3 0 0 1 3 3v17a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4z" fill="url(#km-fold-face)" filter="url(#km-fold-lift)" />
            <path d="M6 12.6h28" stroke="rgba(255,255,255,0.28)" stroke-width="1.2" stroke-linecap="round" />
            <path d="M15 12.6h10v18l-5-3.6-5 3.6z" fill="rgba(255,255,255,0.22)" transform="translate(0 0.9)" />
            <path d="M15 12.6h10v18l-5-3.6-5 3.6z" fill="#1e3170" stroke="rgba(0,0,0,0.35)" stroke-width="0.8" />
            <path d="M15 12.6h10" stroke="#273f85" stroke-width="1.4" />
        </svg>
    </span>
}
else
{
    <span class="xbs-tile site @SizeClass" aria-hidden="true">
        <svg viewBox="0 0 40 40"><path d="M10 2h20a4 4 0 0 1 4 4v32l-14-8.5L6 38V6a4 4 0 0 1 4-4z" fill="@Color" /><text x="20" y="21.5" text-anchor="middle">@Initial</text></svg>
    </span>
}

@code {
    [Parameter, EditorRequired] public ItemRow Row { get; set; } = null!;
    [Parameter] public bool Large { get; set; }

    // White text passes 4.5:1 on every swatch. The last one was the bar navy
    // until v1.0.154; it vanished into the dark list.
    private static readonly string[] Palette =
    [
        "#3d4fb0", "#1f6f5c", "#8a4b12", "#5a3e99", "#9f2b2b", "#2f5e8f", "#2f6e3a", "#7a3a6e", "#4a5170", "#34508f"
    ];

    private string SizeClass => Large ? "lg" : string.Empty;

    private string Host
    {
        get
        {
            if (Uri.TryCreate(Row.Url, UriKind.Absolute, out var u) && !string.IsNullOrEmpty(u.Host))
            {
                return u.Host.StartsWith("www.", StringComparison.OrdinalIgnoreCase) ? u.Host[4..] : u.Host;
            }

            return Row.Url ?? Row.Title ?? string.Empty;
        }
    }

    private string Initial
    {
        get
        {
            foreach (var ch in (Row.Title ?? string.Empty) + Host)
            {
                if (char.IsLetterOrDigit(ch))
                {
                    return char.ToUpperInvariant(ch).ToString();
                }
            }

            return "•";
        }
    }

    private string Color
    {
        get
        {
            // Stable across runs (string.GetHashCode is randomized per process).
            uint h = 2166136261;
            foreach (var ch in Host.ToLowerInvariant())
            {
                h = (h ^ ch) * 16777619;
            }

            return Palette[h % (uint)Palette.Length];
        }
    }
}
