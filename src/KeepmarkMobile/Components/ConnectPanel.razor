@inherits KeepmarkMobile.Components.SessionComponentBase
@using Keepmark.Core.Workflow
@using Keepmark.Core.Sync
@inject KeepmarkMobile.Services.XbsSession Session
@inject KeepmarkMobile.Services.XbsSettings AppSettings
@inject KeepmarkMobile.Services.ToastState Toast
@inject KeepmarkMobile.Services.IQrScanner QrScanner
@inject KeepmarkMobile.Services.AppLockState AppLock
@inject KeepmarkMobile.Services.SyncLinkInbox LinkInbox
@implements IDisposable

@* One sync at a time, one clear step at a time: this is the add/connect flow
   used by the Sync section. It never draws the saved-sync list (the page owns
   it) and reports back with OnFinished / OnCancel. *@

@if (!Session.Ready)
{
    <p role="status"><em>@L.Get(Str.BackupStarting)</em></p>
}
else if (createdId is not null)
{
    @* A new sync ID is the only readable form of the credential: it is shown in
       full and the panel waits for Done instead of vanishing. *@
    <div class="alert alert-success" role="status">
        <p class="mb-1">@message</p>
        <p class="mb-1">@L.Get(Str.ConnSyncId) <code class="xbs-created-id">@createdId</code>
            <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="CopyCreatedId">@L.Get(Str.ConnCopySyncId)</button></p>
        <p class="mb-0">@WorkflowTexts.CreatedNext</p>
    </div>
    <div class="d-grid">
        <button class="btn btn-primary" @onclick="DoneAsync">@L.Get(Str.CommonDone)</button>
    </div>
}
else
{
    @if (mode is null)
    {
        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert @(isError ? "alert-danger" : "alert-success")" role="@(isError ? "alert" : "status")">@message</div>
        }
        @if (!AddingWhileLinked)
        {
            <p class="xbs-connect-lead">@L.Get(Str.ConnLead)</p>
        }
        @* Three flat choices, the shared link first: it is the usual way to add
           a sync that already exists (nothing to type). *@
        <div class="xbs-choices">
            <button class="xbs-choice" @onclick='() => Choose("link")'>
                @* QR first (scanning is the quick path), the link as its own badge:
                       the tile-colored disc cuts it free of the QR finders. *@
                    <span class="xbs-choice-ico"><svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="2.5" width="6" height="6" rx="1.3" /><rect x="11.5" y="2.5" width="6" height="6" rx="1.3" /><rect x="2.5" y="11.5" width="6" height="6" rx="1.3" /><path d="M5.5 5.5h0M14.5 5.5h0M5.5 14.5h0" /><circle class="xbs-ico-knock" cx="17.5" cy="17.5" r="6.2" /><path transform="translate(17.5 17.5) scale(.5) translate(-12 -12)" style="stroke-width:3.5" d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" /></svg></span>
                <span class="xbs-choice-text"><strong>@L.Get(Str.ConnMethodLinkTitle)</strong><span>@L.Get(Str.ConnMethodLinkText)</span></span>
                <svg class="km-ico sm xbs-choice-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
            </button>
            <button class="xbs-choice" @onclick='() => Choose("creds")'>
                <span class="xbs-choice-ico"><svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 7a4 4 0 1 1-3.9 4.9L4 19v2h3v-2h2v-2h2l1.1-1.1A4 4 0 0 1 15 7zM16 10h.01" /></svg></span>
                <span class="xbs-choice-text"><strong>@L.Get(Str.ConnMethodCredsTitle)</strong><span>@L.Get(Str.ConnMethodCredsText)</span></span>
                <svg class="km-ico sm xbs-choice-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
            </button>
            @if (AllowCreate)
            {
                <button class="xbs-choice" @onclick='() => Choose("new")'>
                    <span class="xbs-choice-ico"><svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></span>
                    <span class="xbs-choice-text"><strong>@L.Get(Str.ConnCreateTitle)</strong><span>@(localCount > 0 ? Loc.Plural(Str.ConnCreateTextUpload, localCount) : L.Get(Str.ConnCreateTextFresh))</span></span>
                    <svg class="km-ico sm xbs-choice-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
                </button>
            }
        </div>
        <p class="xbs-hint mt-3">@L.Get(Str.ConnBackupHintA) <a href="backup">@L.Get(Str.ConnBackupHintLink)</a> @L.Get(Str.ConnBackupHintB)</p>
        <div class="d-grid mt-3">
            <button class="btn btn-secondary" data-back="15" @onclick="CancelAsync" disabled="@busy">@L.Get(Str.CommonCancel)</button>
        </div>
    }
    else
    {
        @* data-back: the Android back key presses this button (gestures.js
           xbsGestures.back), so the key steps back inside the flow instead
           of leaving the page. Sheets (30+) still win over it. *@
        <button class="xbs-back" data-back="15" @onclick="Back" disabled="@busy"><svg class="km-ico sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>@L.Get(Str.CommonBack)</button>
        @if (qrState.ShowReview)
        {
            <QrCredentialReview ServiceUrl="@qrServiceUrl" SyncId="@qrSyncId" Busy="@(busy || qrState.IsVerifying)"
                                Title="@(candidateFromLink ? L.Get(Str.ConnLinkAcquired) : null)"
                                OnVerify="LinkQr" OnCancel="CancelQr" />
        }
        else
        {
            <h2 class="xbs-step-title">@StepTitle</h2>
            @if (mode == "link" && reconcile is null)
            {
                @* A link someone shared (keepmark://sync): pasted here, or
                   tapped elsewhere and delivered through SyncLinkInbox. Both
                   end in the same reviewed candidate as a QR scan. *@
                @if (pendingOnce is { } once)
                {
                    @* One-time link: nothing is redeemed until "Open link",
                       which uses it up. Like the QR review, the offer stands
                       alone: QR, service and manual fields return on Cancel. *@
                    <div class="km-once-offer mb-3" role="group" aria-label="@L.Get(Str.ConnLinkLabel)">
                        <div class="alert alert-info mb-2" role="status">@L.Get(Str.ConnLinkOnceNote, once.ServiceUrl)</div>
                        @if (once.CodeRequired)
                        {
                            <label class="form-label" for="conn-once-code">@L.Get(Str.ConnLinkCodeLabel)</label>
                            <input id="conn-once-code" class="form-control km-once-code mb-2" @bind="onceCode" @bind:event="oninput" @bind:after="ClearOnceError"
                                   inputmode="numeric" autocomplete="one-time-code" maxlength="7" disabled="@busy"
                                   aria-invalid="@(string.IsNullOrEmpty(onceError) ? "false" : "true")" aria-describedby="conn-once-error"
                                   autocorrect="off" autocapitalize="off" spellcheck="false" />
                        }
                        @if (!string.IsNullOrEmpty(onceError))
                        {
                            <div id="conn-once-error" class="alert alert-danger mb-2" role="alert">@onceError</div>
                        }
                        <div class="d-flex flex-wrap gap-2">
                            <button class="btn btn-primary" @onclick="OpenOnceAsync" disabled="@busy">
                                @if (busy) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }
                                @L.Get(Str.ConnLinkOpen)
                            </button>
                            <button class="btn btn-secondary" @onclick="DropOnce" disabled="@busy">@L.Get(Str.CommonCancel)</button>
                        </div>
                    </div>
                }
                else
                {
                    <button class="btn btn-secondary mb-2" @onclick="ScanQr" disabled="@busy"><svg class="km-ico sm me-2" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h6v6H3zM15 3h6v6h-6zM3 15h6v6H3zM15 15h2v2h-2zM19 15h2v6h-2zM15 19h2v2h-2z" /></svg>@L.Get(Str.ConnQrScan)</button>
                    <div class="form-text mb-3">@L.Get(Str.ConnQrHint)</div>
                    @if (!string.IsNullOrEmpty(qrError))
                    {
                        <div class="alert alert-danger" role="alert">@qrError</div>
                    }
                <label class="form-label" for="conn-share-link">@L.Get(Str.ConnLinkLabel)</label>
                <div class="input-group mb-1">
                    <input id="conn-share-link" class="form-control xbs-field-has-ico" @bind="linkText" @bind:event="oninput" @bind:after="ClearLinkPasteError"
                           placeholder="@L.Get(Str.ConnLinkPlaceholder)" disabled="@busy"
                           autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" />
                    @* Between input and button, not first: Bootstrap's input-group
                       corner rules key off :first-child / :last-child. *@
                    <svg class="km-ico sm xbs-field-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" /></svg>
                    <button class="btn btn-secondary" @onclick="UsePastedLink" disabled="@(busy || string.IsNullOrWhiteSpace(linkText))">@L.Get(Str.ConnLinkUse)</button>
                </div>
                <div class="mb-3"></div>
                @if (!string.IsNullOrEmpty(linkPasteError))
                {
                    <div class="alert alert-danger" role="alert">@linkPasteError</div>
                }
                }
            }
            @if (reconcile is null && pendingOnce is null && mode != "link")
            {
                <ServiceSelector Value="@serviceUrl" ValueChanged="ServiceChanged" Checked="ServiceChecked" Disabled="@busy" />
            }
            @if (mode is "link" or "creds" && reconcile is not null)
            {
                @* Verified: the apply step uses exactly these credentials, so the
                   inputs are gone (editing them would not change the target). *@
                <div class="xbs-verified" role="status">
                    <svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                    <div class="xbs-verified-text">
                        <strong>@L.Get(Str.ConnSyncOpenedA) <code>@WorkflowRules.ShortId(reconcile.Candidate.Id)</code> @L.Get(Str.ConnSyncOpenedB)</strong>
                        <span>@L.Get(Str.ConnItemsCounts, reconcile.RemoteCount, reconcile.LocalCount)</span>
                    </div>
                    <button class="xbs-link-btn" @ref="useAnotherButton" @onclick="UseDifferentSync" disabled="@(busy || confirmDiscard)">@L.Get(mode == "link" ? Str.ConnUseAnotherLink : Str.ConnEditCreds)</button>
                </div>
                @if (confirmDiscard)
                {
                    @* The key came from a one-time link: it is used up and
                       cannot bring the key back, so dropping it asks first. *@
                    <div class="alert alert-warning mb-3" role="group" aria-label="@L.Get(Str.ConnOnceDiscard)">
                        <p class="mb-2">@L.Get(Str.ConnOnceDiscard)</p>
                        <div class="d-flex flex-wrap gap-2">
                            <button class="btn btn-danger" @onclick="DiscardOnceKey" disabled="@busy">@L.Get(Str.ConnOnceDiscardYes)</button>
                            <button class="btn btn-secondary" data-back="20" @ref="discardCancelButton" @onclick="KeepOnceKey" disabled="@busy">@L.Get(Str.CommonCancel)</button>
                        </div>
                    </div>
                }
            }
            else if (mode == "creds")
            {
                @if (pendingOnce is null)
                {
                <div class="mb-3">
                    <label class="form-label">@L.Get(Str.ConnSyncId)</label>
                    <input disabled="@busy" class="form-control" @bind="syncId" @bind:after="ClearLinkError" placeholder="@L.Get(Str.ConnSyncIdPlaceholder)" autocomplete="off" spellcheck="false" autocapitalize="off" />
                    <label class="form-label mt-2">@L.Get(Str.CommonPassword)</label>
                    <input disabled="@busy" type="password" class="form-control" @bind="password" @bind:after="ClearLinkError" autocomplete="current-password" />
                    <InfoHint Text="@L.Get(Str.ConnPasswordShort)" Title="@L.Get(Str.ConnMethodCredsTitle)" Body="@L.Get(Str.ConnPasswordHint)" />
                    <div class="mt-3 d-grid">
                        <button class="btn btn-primary" @onclick="LinkExisting" disabled="@(busy || serviceInfo is null)">@L.Get(Str.ConnOpenSync)</button>
                    </div>
                    @if (!string.IsNullOrEmpty(linkError))
                    {
                        <div class="alert alert-danger mt-2" role="alert">@linkError</div>
                    }
                </div>
                }
            }
            else if (mode == "new")
            {
                <div class="mb-3">
                    <label class="form-label">@L.Get(Str.CommonNewPassword)</label>
                    <input disabled="@busy" type="password" class="form-control" @bind="newPassword" @bind:after="ClearLinkError" autocomplete="new-password" />
                    <label class="form-label mt-2">@L.Get(Str.ConnConfirmPassword)</label>
                    <input disabled="@busy" type="password" class="form-control" @bind="confirmPassword" @bind:after="ClearLinkError" autocomplete="new-password" />
                    <InfoHint Text="@L.Get(Str.ConnPwNewShort)" Title="@L.Get(Str.ConnCreateTitle)" Body="@L.Get(Str.ConnPwNewHint)" />
                    @NameField()
                    <div class="mt-2 d-grid gap-2">
                        @if (localCount > 0)
                        {
                            <button class="btn btn-primary" @onclick="CreateWithUpload" disabled="@(busy || !CanCreate || NameTaken)">@Loc.Plural(Str.ConnCreateUpload, localCount)</button>
                            <InfoHint Text="@L.Get(Str.ConnCreateUploadShort)" Title="@Loc.Plural(Str.ConnCreateUpload, localCount)" Body="@L.Get(Str.ConnCreateUploadHint)" />
                            @if (armed != "createEmpty")
                            {
                                <button class="btn btn-outline-danger" @onclick='() => armed = "createEmpty"' disabled="@(busy || !CanCreate || NameTaken)">@L.Get(Str.ConnCreateEmptyInstead)</button>
                            }
                            else
                            {
                                <ConfirmBlock Message="@Loc.Plural(Str.ConnReplaceEmptyMessage, localCount)"
                                              Implication="@WorkflowTexts.CreateEmptyImplication"
                                              ConfirmLabel="@L.Get(Str.ConnYesCreateEmpty)" Busy="busy"
                                              OnConfirm="CreateNew" OnCancel="Disarm" />
                            }
                        }
                        else
                        {
                            <button class="btn btn-outline-primary" @onclick="CreateNew" disabled="@(busy || !CanCreate || NameTaken)">@L.Get(Str.ConnCreateNew)</button>
                            <div class="form-text">@L.Get(Str.ConnCreateEmptyHint)</div>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(linkError))
                    {
                        <div class="alert alert-danger mt-2" role="alert">@linkError</div>
                    }
                </div>
            }
        }
    }

    @if (reconcile is not null && !qrState.ShowReview)
    {
        <DirectionPicker Name="syncDirection" Value="@direction" ValueChanged="SetDirection"
                         LocalCount="reconcile.LocalCount" RemoteCount="reconcile.RemoteCount"
                         Disabled="@busy" />
        <p class="text-muted">@WorkflowTexts.DirectionConfirm(direction, AddingWhileLinked).Implication</p>
        @if (direction == "merge" && mergeStats is not null)
        {
            <ul class="xbs-review-list mt-2">
                <li><strong>@mergeStats.LocalOnly</strong> @L.Get(Str.ConnReviewUpload)</li>
                <li><strong>@mergeStats.RemoteOnly</strong> @L.Get(Str.ConnReviewDownload)</li>
                @if (mergeStats.TitleConflicts > 0)
                {
                    <li><strong>@mergeStats.TitleConflicts</strong> @Loc.Plural(Str.ConnReviewTitles, mergeStats.TitleConflicts)</li>
                }
            </ul>
        }
        @if (direction == "merge" && mergeStats is null && !busy && !string.IsNullOrEmpty(applyError))
        {
            <button class="btn btn-secondary mb-2" @onclick="PreviewMerge">@L.Get(Str.StatusCompareAgain)</button>
        }
        @NameField()
        <div class="d-grid">
            <button class="btn btn-primary" @onclick="ApplyChosen" disabled="@(busy || NameTaken || (direction == "merge" && (mergeStats is null || !ReferenceEquals(mergeStatsFor, reconcile))))">@ApplyLabel</button>
        </div>
        @if (!string.IsNullOrEmpty(applyError))
        {
            <div class="alert alert-danger mt-2" role="alert">@applyError</div>
        }
    }
}

@code {
    /// <summary>The device already has an active sync: only "open an existing
    /// one" applies, and the new target becomes active (the old row stays).</summary>
    [Parameter] public bool AddingWhileLinked { get; set; }

    /// <summary>The sync this device uses now, if any: adding it again is
    /// refused before the server check (nothing to add, nothing to leave).</summary>
    [Parameter] public SavedSyncIdentity? ActiveSync { get; set; }

    /// <summary>Creating a brand-new sync stays a first-time flow.</summary>
    [Parameter] public bool AllowCreate { get; set; } = true;

    /// <summary>A sync was added, created or applied: the page refreshes and
    /// closes the panel (the toast carries the outcome).</summary>
    [Parameter] public EventCallback OnFinished { get; set; }

    /// <summary>The user backed out of the first step.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    private string serviceUrl = Core.XbsConstants.DefaultServiceUrl;
    private string syncId = string.Empty;
    private string password = string.Empty;
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private bool busy;
    private string message = string.Empty;
    private bool isError;
    private string linkError = string.Empty;
    private string applyError = string.Empty;
    private Core.Sync.MergeStats? mergeStats;
    private Services.ReconcileInfo? mergeStatsFor;
    private Core.Api.ServiceInfoResponse? serviceInfo;
    private Services.ReconcileInfo? reconcile;
    private int localCount;
    private string? armed;
    /// <summary>ID of the sync created in this session: shown in full right
    /// after creation, because that is when the user must store it.</summary>
    private string? createdId;
    /// <summary>Reconcile direction choice: "download" replaces local with the
    /// remote copy, "upload" overwrites the remote with local, "merge" unions
    /// both sides. Preselected to the only sensible side when one of them is
    /// empty. Changing direction invalidates the merge preview.</summary>
    private string direction = "download";

    /// <summary>The choice: null = pick, "link" = shared link or QR, "creds" =
    /// sync ID and password, "new" = create (first link only: adding while
    /// linked offers the first two).</summary>
    private string? mode;

    private string ServiceUrlClean => WorkflowRules.NormalizeServiceUrl(serviceUrl);

    // A stale "fill in both fields" error must not linger once the user edits them.
    private void ClearLinkError() { linkError = string.Empty; ClearQr(); }

    protected override void OnInitialized()
    {
        serviceUrl = AppSettings.ServiceUrl;
        AppLock.Changed += LockChanged;
        LinkInbox.Arrived += InboxArrived;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!await WaitForSessionAsync(Session)) return;
        await RefreshLocalCountAsync();
        TakeInboxLink();
    }

    // ---- shared link -------------------------------------------------------

    private string linkText = string.Empty;
    private string linkPasteError = string.Empty;
    /// <summary>The pending candidate came from a link, not a QR: other
    /// heading, other stale-key text.</summary>
    private bool candidateFromLink;

    private void ClearLinkPasteError() => linkPasteError = string.Empty;

    private void InboxArrived() => _ = InvokeAsync(() =>
    {
        TakeInboxLink();
        if (!IsDisposed) StateHasChanged();
    });

    /// <summary>A link delivered from outside waits until the app is unlocked
    /// and in front, and never replaces a step already in progress.</summary>
    private void TakeInboxLink()
    {
        if (IsDisposed || !Session.Ready || busy || AppLock.Locked || !AppLock.Foreground || createdId is not null || reconcile is not null || qrState.ShowReview || pendingOnce is not null) return;
        var text = LinkInbox.Consume();
        if (text is null) return;
        if (!OfferLink(text)) linkPasteError = L.Get(Str.ConnLinkInvalid);
    }

    private void UsePastedLink()
    {
        if (busy || AppLock.Locked || !AppLock.Foreground) return;
        var text = linkText;
        linkText = string.Empty;
        if (!OfferLink(text)) linkPasteError = L.Get(Str.ConnLinkInvalid);
    }

    /// <summary>A parsed one-time link waiting for "Open link" (nothing redeemed yet).</summary>
    private HandoffSecret? pendingOnce;
    private string onceCode = string.Empty;
    private string onceError = string.Empty;
    /// <summary>Sender's sync name from the redeemed voucher, proposed for the new row.</summary>
    private string? proposedLabel;
    /// <summary>The verified candidate came from a redeemed one-time link:
    /// that link is used up, so "Use another link" asks first.</summary>
    private bool reconcileFromOnce;
    private bool confirmDiscard;
    /// <summary>The button that opened the question is disabled while it is
    /// open (focus would drop to the page): focus moves to Cancel, and back
    /// to that button on Cancel.</summary>
    private ElementReference useAnotherButton, discardCancelButton;
    /// <summary>Read after render: the Cancel reference exists only once
    /// the question was rendered.</summary>
    private bool focusDiscardCancel, focusUseAnother;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusDiscardCancel && !focusUseAnother) return;
        var target = focusDiscardCancel ? discardCancelButton : useAnotherButton;
        focusDiscardCancel = focusUseAnother = false;
        try { await target.FocusAsync(); } catch { }
    }

    private void KeepOnceKey()
    {
        confirmDiscard = false;
        focusUseAnother = true;
    }

    private void ClearOnceError() => onceError = string.Empty;

    private void DropOnce()
    {
        pendingOnce = null;
        onceCode = onceError = string.Empty;
    }

    /// <summary>Uses the one-time link up, then verifies the key it returned
    /// at once: "Open link" was the confirmation, and the key must not sit
    /// in a review that can expire after the link is spent. A wrong code
    /// keeps the link (the service counts attempts); offline keeps it too;
    /// anything else drops it.</summary>
    private async Task OpenOnceAsync()
    {
        if (busy || pendingOnce is not { } once || AppLock.Locked || !AppLock.Foreground) return;
        var code = new string(onceCode.Where(c => !char.IsWhiteSpace(c)).ToArray());
        if (once.CodeRequired && !SyncHandoff.IsCode(code)) { onceError = L.Get(Str.ErrHandoffCodeRequired); return; }
        busy = true;
        onceError = string.Empty;
        HandoffContent? content = null;
        try
        {
            content = await Session.RedeemOneTimeLinkAsync(once, once.CodeRequired ? code : null, Lifetime);
        }
        catch (OperationCanceledException) when (Lifetime.IsCancellationRequested) { return; }
        catch (Keepmark.Core.Errors.HandoffAuthFailedException ex) { onceCode = string.Empty; onceError = ex.Message; }
        catch (Keepmark.Core.Errors.ServiceOfflineException ex) { onceError = ex.Message; }
        catch (Exception ex)
        {
            Session.Log.Warn("connect", $"One-time link failed: {ex.GetType().Name}");
            DropOnce();
            linkPasteError = ex.Message;
        }
        finally
        {
            busy = false;
            code = string.Empty;
            // A lock or background during the redeem skipped LockChanged's
            // DropOnce (busy): a kept link must not outlive it.
            if (content is null && (AppLock.Locked || !AppLock.Foreground)) DropOnce();
        }
        if (content is null || IsDisposed) return;
        DropOnce();
        var label = content.Label;
        if (!OfferCandidate(SyncHandoff.ToCandidate(content))) return;
        proposedLabel = label;
        reconcileFromOnce = true;
        content = null;
        await LinkQr();
    }

    /// <summary>Parses a shared link into the QR candidate (same review, same
    /// 60-second lifetime, same probe), or a one-time link into its offer.
    /// False = not a valid link.</summary>
    private bool OfferLink(string? text)
    {
        if (SyncHandoff.TryParse(text, out var once))
        {
            ClearQr();
            ResetForCandidate();
            linkPasteError = qrError = string.Empty;
            DropOnce();
            pendingOnce = once;
            return true;
        }
        if (!SyncShareLink.TryParse(text, out var candidate)) { mode = "link"; return false; }
        DropOnce();
        OfferCandidate(candidate!);
        return true;
    }

    /// <summary>Puts a link's key up as the reviewed candidate. False when a
    /// newer candidate already replaced it.</summary>
    private bool OfferCandidate(ConnectQrPayload candidate)
    {
        ClearQr();
        var generation = qrGeneration;
        ResetForCandidate();
        linkPasteError = qrError = string.Empty;
        qrServiceUrl = candidate.ServiceUrl; qrSyncId = candidate.Id;
        if (!qrState.Offer(candidate, generation)) return false;
        candidateFromLink = true;
        qrExpiry = CancellationTokenSource.CreateLinkedTokenSource(Lifetime);
        _ = ExpireQr(generation, qrExpiry.Token);
        return true;
    }

    /// <summary>A fresh candidate (QR or link) replaces whatever was typed.</summary>
    private void ResetForCandidate()
    {
        serviceInfo = null; linkError = applyError = message = string.Empty;
        reconcile = null; mergeStats = null; mergeStatsFor = null;
        armed = null;
        password = newPassword = confirmPassword = string.Empty;
        proposedLabel = null;
        reconcileFromOnce = confirmDiscard = false;
        mode = "link";
    }

    private async Task RefreshLocalCountAsync()
    {
        if (Session.Store is not null)
        {
            var stats = await Session.Store.GetStatsAsync();
            localCount = stats.Folders + stats.Bookmarks + stats.Separators;
        }
    }

    private void Choose(string value)
    {
        mode = value;
        reconcileFromOnce = confirmDiscard = false;
        if (value == "new") _ = SuggestNameAsync(null);
        isError = false;
        linkError = string.Empty;
        message = string.Empty;
    }

    /// <summary>Drop the verified candidate and go back to the link step or
    /// the ID/password form. A key from a one-time link asks first.</summary>
    private void UseDifferentSync()
    {
        if (reconcileFromOnce && reconcile is not null) { confirmDiscard = true; focusDiscardCancel = true; return; }
        DiscardOnceKey();
    }

    private void DiscardOnceKey()
    {
        reconcileFromOnce = confirmDiscard = false;
        reconcile = null;
        proposedLabel = null;
        mergeStats = null;
        mergeStatsFor = null;
        applyError = string.Empty;
        message = string.Empty;
    }

    private void Back()
    {
        if (qrState.ShowReview) { CancelQr(); return; }
        if (pendingOnce is not null) { DropOnce(); return; }
        ClearQr();
        mode = null;
        reconcile = null;
        reconcileFromOnce = confirmDiscard = false;
        armed = null;
        linkError = string.Empty;
        applyError = string.Empty;
        message = string.Empty;
        password = string.Empty;
        newPassword = string.Empty;
        confirmPassword = string.Empty;
        linkText = linkPasteError = qrError = string.Empty;
        nameDraft = string.Empty;
    }

    private async Task CancelAsync() => await OnCancel.InvokeAsync();

    /// <summary>Close after a created sync was acknowledged (Done).</summary>
    private async Task DoneAsync()
    {
        var text = message;
        createdId = null;
        _ = Toast.ShowAsync(text);
        await OnFinished.InvokeAsync();
    }

    /// <summary>Terminal success of an add/apply: the page owns the list now.</summary>
    private async Task FinishAsync(string text)
    {
        message = string.Empty;
        _ = Toast.ShowAsync(text);
        await OnFinished.InvokeAsync();
    }

    private async Task SetDirection(string value)
    {
        if (busy) return;
        direction = value;
        mergeStats = null;
        mergeStatsFor = null;
        applyError = string.Empty;
        if (direction == "merge") await PreviewMerge();
    }

    private void LockChanged()
    {
        if (!AppLock.Locked && AppLock.Foreground)
        {
            _ = InvokeAsync(() => { TakeInboxLink(); if (!IsDisposed) StateHasChanged(); });
            return;
        }
        if (AppLock.Locked || !AppLock.Foreground)
            _ = InvokeAsync(() =>
            {
                // The permission dialog can pause the activity before any camera
                // session exists. The scanner rechecks lock/foreground after it.
                // Native active sessions cancel themselves on this event.
                if (qrState.ShowReview) ClearQr();
                if (!busy) DropOnce();
                linkText = string.Empty;
                if (!IsDisposed) StateHasChanged();
            });
    }

    private readonly ConnectQrCandidateState qrState = new();
    private ConnectQrPayload? pendingQr => qrState.Payload;
    private CancellationTokenSource? qrExpiry;
    private int qrGeneration => qrState.Generation;
    private string qrError = string.Empty;
    private string qrServiceUrl = string.Empty;
    private string qrSyncId = string.Empty;

    private void ClearQr()
    {
        qrState.Clear();
        qrServiceUrl = qrSyncId = string.Empty;
        candidateFromLink = false;
        StopQrExpiry();
    }

    private void CancelQr()
    {
        ClearQr();
        qrError = string.Empty;
    }

    private void StopQrExpiry()
    {
        qrExpiry?.Cancel();
        qrExpiry?.Dispose();
        qrExpiry = null;
    }

    private async Task ScanQr()
    {
        if (busy || AppLock.Locked || !AppLock.Foreground) return;
        ClearQr();
        var generation = qrGeneration;
        busy = true; qrError = string.Empty;
        try
        {
            var text = await QrScanner.ScanAsync(Lifetime);
            if (IsDisposed || Lifetime.IsCancellationRequested || generation != qrGeneration || AppLock.Locked || !AppLock.Foreground) return;
            if (text is null) return;
            if (!ConnectQrPayload.TryParse(text, out var candidate))
            { qrError = L.Get(Str.ConnQrInvalid); return; }
            ResetForCandidate();
            linkPasteError = string.Empty;
            qrServiceUrl = candidate!.ServiceUrl; qrSyncId = candidate.Id;
            if (!qrState.Offer(candidate, generation)) return;
            qrExpiry = CancellationTokenSource.CreateLinkedTokenSource(Lifetime);
            _ = ExpireQr(generation, qrExpiry.Token);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (!IsDisposed && generation == qrGeneration)
                qrError = ex is Services.QrScanException scanError ? L.Get(scanError.MessageKey) : L.Get(Str.ConnQrUnavailable);
            Session.Log.Warn("connect", $"QR scanner failed: {ex.GetType().Name}");
        }
        finally { if (!IsDisposed) busy = false; }
    }

    private async Task ExpireQr(int generation, CancellationToken ct)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(60), ct);
            await InvokeAsync(() =>
            {
                if (IsDisposed || generation != qrGeneration) return;
                ClearQr(); qrError = L.Get(Str.ConnQrCleared); StateHasChanged();
            });
        }
        catch (OperationCanceledException) { }
    }

    private async Task LinkQr()
    {
        if (busy || pendingQr is null || AppLock.Locked || !AppLock.Foreground) return;
        var candidate = qrState.BeginVerification();
        StopQrExpiry();
        if (candidate is null) { qrError = L.Get(Str.ConnQrCleared); return; }
        var generation = qrGeneration;
        var targetUrl = candidate.ServiceUrl;
        var targetId = candidate.Id;
        var isKey = candidate.DerivedKey is not null;
        var staleKey = candidateFromLink ? Str.ConnLinkKeyStale : Str.ConnQrKeyStale;
        var secret = candidate.DerivedKey ?? candidate.Password ?? string.Empty;
        candidate = null;
        var task = LinkExistingCredentials(targetUrl, targetId, secret, generation, isKey, staleKey);
        secret = string.Empty;
        try { await task; }
        finally { if (generation == qrGeneration) ClearQr(); }
    }

    private bool CurrentQrAttempt(int generation) => !IsDisposed && generation == qrGeneration
        && qrState.IsVerifying && !AppLock.Locked && AppLock.Foreground;

    public override void Dispose()
    {
        AppLock.Changed -= LockChanged;
        LinkInbox.Arrived -= InboxArrived;
        linkText = string.Empty;
        DropOnce();
        proposedLabel = null;
        ClearQr();
        base.Dispose();
    }

    private void Disarm() => armed = null;

    private async Task CopyCreatedId()
    {
        if (string.IsNullOrEmpty(createdId)) return;
        try
        {
            await Clipboard.Default.SetTextAsync(createdId);
            _ = Toast.ShowAsync(L.Get(Str.ConnCopied));
        }
        catch
        {
            _ = Toast.ShowAsync(L.Get(Str.ConnCopyFailed), isError: true);
        }
    }

    private bool CanCreate => serviceInfo?.Status == Core.Models.ServiceStatus.Online;
    private Task ServiceChecked(Core.Api.ServiceInfoResponse? info) { serviceInfo = info; return Task.CompletedTask; }
    private async Task ServiceChanged(string url)
    {
        serviceUrl = url; ClearQr(); reconcile = null; linkError = string.Empty; armed = null;
        // A new sync is named after its service until the user types a name.
        if (mode == "new" && !nameTouched) await SuggestNameAsync(null);
    }

    private Task LinkExisting() => serviceInfo is null ? Task.CompletedTask : LinkExistingCredentials(ServiceUrlClean, syncId.Trim(), password);

    private async Task LinkExistingCredentials(string targetUrl, string targetId, string targetPassword, int? qrAttempt = null, bool secretIsKey = false, string staleKey = Str.ConnQrKeyStale)
    {
        await RunStepAsync(async () =>
        {
            if (string.IsNullOrWhiteSpace(targetId) || string.IsNullOrEmpty(targetPassword))
            {
                throw new InvalidOperationException(L.Get(Str.ConnEnterBoth));
            }

            if (ActiveSync is { } current && SavedSyncs.Same(current, new SavedSyncIdentity(targetUrl, targetId)))
            {
                throw new InvalidOperationException(L.Get(Str.ErrSavedAlreadyActive));
            }

            var probe = secretIsKey
                ? Session.ProbeLinkWithKeyAsync(targetUrl, targetId, targetPassword, Lifetime, staleKey)
                : Session.ProbeLinkAsync(targetUrl, targetId, targetPassword, Lifetime);
            targetPassword = string.Empty;
            var result = await probe;
            if (IsDisposed || Lifetime.IsCancellationRequested || (qrAttempt.HasValue && !CurrentQrAttempt(qrAttempt.Value))) return;
            serviceUrl = targetUrl; syncId = targetId;
            await SuggestNameAsync(new SavedSyncIdentity(targetUrl, targetId), qrAttempt.HasValue ? proposedLabel : null);
            if (IsDisposed || Lifetime.IsCancellationRequested || (qrAttempt.HasValue && !CurrentQrAttempt(qrAttempt.Value))) return;
            reconcile = result;
            // Consumed: the candidate carries the key; a failed check keeps it for a retry.
            password = string.Empty;

            mergeStats = null;
            mergeStatsFor = null;
            applyError = string.Empty;
            if (reconcile is { LocalCount: 0, RemoteCount: 0 })
            {
                await Session.ApplyRemoteAsync(Named(reconcile));
                reconcile = null;
                await RefreshLocalCountAsync();
                await FinishAsync(L.Get(Str.ConnLinkedEmpty));
            }
            else
            {
                // Preselect the only sensible direction when one side is empty.
                direction = reconcile.RemoteCount == 0 ? "upload" : "download";
            }
        }, err =>
        {
            if (!qrAttempt.HasValue) linkError = err;
            else if (CurrentQrAttempt(qrAttempt.Value)) qrError = err;
        }, "connect-link");
    }

    private async Task CreateNew()
    {
        if (!CanCreate) return;
        await RunStepAsync(async () =>
        {
            WorkflowRules.RequireNewPassword(newPassword, confirmPassword);
            createdId = await Session.CreateNewSyncAsync(ServiceUrlClean, newPassword, label: NameForSave);

            reconcile = null;
            armed = null;
            mode = null;
            newPassword = string.Empty;
            confirmPassword = string.Empty;
            await RefreshLocalCountAsync();
            Ok(L.Get(Str.ConnCreatedEmpty));
        }, err => linkError = err, "connect-create");
    }

    private async Task CreateWithUpload()
    {
        if (!CanCreate) return;
        await RunStepAsync(async () =>
        {
            WorkflowRules.RequireNewPassword(newPassword, confirmPassword);
            createdId = await Session.CreateNewSyncWithUploadAsync(ServiceUrlClean, newPassword, label: NameForSave);

            reconcile = null;
            mode = null;
            newPassword = string.Empty;
            confirmPassword = string.Empty;
            await RefreshLocalCountAsync();
            Ok(L.Get(Str.ConnCreatedUpload));
        }, err => linkError = err, "connect-create");
    }

    private string ApplyLabel => direction switch
    {
        "upload" => L.Get(Str.ConnApplyDevice),
        "merge" => L.Get(Str.ConnApplyMerge),
        _ => L.Get(Str.ConnApplyServer),
    };

    private Task ApplyChosen() => busy || reconcile is null ? Task.CompletedTask : direction switch
    {
        "upload" => ApplyLocal(),
        "merge" => ApplyMerge(),
        _ => ApplyRemote(),
    };

    private async Task ApplyRemote()
    {
        await RunStepAsync(async () =>
        {
            var target = reconcile!;
            var backedUp = await Session.ApplyRemoteAsync(Named(target));
            reconcile = null;
            mergeStats = null;
            mergeStatsFor = null;
            await RefreshLocalCountAsync();
            var done = Core.Sync.MoveResult.Describe("existing", "pull", target.Candidate.ServiceUrl, target.Candidate.Id);
            await FinishAsync(backedUp ? $"{done} {L.Get(Str.ConnSafetyLocal)}" : done);
        }, err => applyError = err, "connect-apply");
    }

    private async Task ApplyLocal()
    {
        await RunStepAsync(async () =>
        {
            var target = reconcile!;
            await Session.ApplyLocalAsync(Named(target));
            reconcile = null;
            mergeStats = null;
            mergeStatsFor = null;
            await RefreshLocalCountAsync();
            await FinishAsync($"{Core.Sync.MoveResult.Describe("existing", "push", target.Candidate.ServiceUrl, target.Candidate.Id)} {L.Get(Str.ConnSafetyRemote)}");
        }, err => applyError = err, "connect-apply");
    }

    private async Task PreviewMerge()
    {
        if (busy) return;
        await RunStepAsync(async () =>
        {
            var target = reconcile;
            if (target is null || direction != "merge") return;
            var preview = await Session.GetMergePreviewAsync(target);
            if (IsDisposed || !ReferenceEquals(target, reconcile) || direction != "merge") return;
            mergeStats = preview;
            mergeStatsFor = target;
            message = string.Empty;
        }, err => applyError = err, "connect-merge-preview");
    }

    private async Task ApplyMerge()
    {
        await RunStepAsync(async () =>
        {
            var target = reconcile!;
            if (mergeStats is null || !ReferenceEquals(mergeStatsFor, target))
            {
                throw new InvalidOperationException(L.Get(Str.ConnPreviewFirst));
            }

            var backedUp = await Session.ApplyMergeAsync(Named(target), Core.Safety.SafetyOperations.ConnectMerge);
            reconcile = null;
            mergeStats = null;
            mergeStatsFor = null;
            await RefreshLocalCountAsync();
            var done = Core.Sync.MoveResult.Describe("existing", "merge", target.Candidate.ServiceUrl, target.Candidate.Id);
            await FinishAsync(backedUp ? $"{done} {L.Get(Str.ConnSafetyBoth)}" : done);
        }, err => applyError = err, "connect-apply");
    }

    /// <summary>One action cluster, one adjacent error box: each wizard step
    /// reports into its own field (check/link/apply) rendered next to the
    /// button that produced it, instead of a single shared box.</summary>
    private async Task RunStepAsync(Func<Task> action, Action<string> setError, [System.Runtime.CompilerServices.CallerMemberName] string op = "?")
    {
        busy = true;
        isError = false;
        message = string.Empty;
        setError(string.Empty);
        try
        {
            Session.Log.Debug("connect", $"{op}: start");
            await action();
            Session.Log.Info("connect", $"{op}: ok");
        }
        catch (OperationCanceledException) when (Lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            if (IsDisposed) return;
            isError = true;
            setError(ex.Message);
            Session.Log.Warn("connect", $"{op} failed: {ex.GetType().Name}");
        }
        finally
        {
            // Secrets are cleared by each step once consumed, never on a
            // failure: the retry needs them.
            busy = false;
        }
    }

    // ---- name (last field, always editable) --------------------------------

    private string StepTitle => mode switch
    {
        "link" => L.Get(Str.ConnMethodLinkTitle),
        "creds" => L.Get(Str.ConnMethodCredsTitle),
        _ => L.Get(Str.ConnCreateTitle),
    };

    /// <summary>Name the row will get. Prefilled once the target is known: the
    /// name this device already shows for it, else the sender's name from a
    /// one-time link (when free), else the host suggestion.</summary>
    private string nameDraft = string.Empty;
    private IReadOnlyList<SavedSync> savedRows = [];
    private SavedSyncIdentity? nameTarget;
    /// <summary>The target is already a saved row (its name is kept when empty).</summary>
    private bool nameKnown;

    private string? NameForSave => SavedSyncs.NormalizeLabel(nameDraft);
    private bool NameTaken => NameForSave is { } n && SavedSyncs.LabelTaken(savedRows, nameTarget, n);
    private string NameFallback => SavedSyncs.Name(new SavedSync { ServiceUrl = nameTarget?.ServiceUrl ?? ServiceUrlClean, SyncId = nameTarget?.SyncId ?? string.Empty });

    private Services.ReconcileInfo Named(Services.ReconcileInfo info) => info with { ProposedLabel = NameForSave };

    /// <summary>The user typed a name: a later service change keeps it.</summary>
    private bool nameTouched;
    private void NameEdited() => nameTouched = true;

    private async Task SuggestNameAsync(SavedSyncIdentity? target, string? sender = null)
    {
        nameTouched = false;
        nameTarget = target;
        // Awaited from ServiceChanged (an event callback): a registry read
        // failure must only lose the suggestion, never surface as an
        // unhandled error. RememberActiveAsync re-checks the name anyway.
        try { savedRows = Session.Registry is { } registry ? await registry.ListAsync() : []; }
        catch (Exception ex)
        {
            Session.Log.Warn("connect", $"Saved syncs unreadable for the name suggestion: {ex.GetType().Name}");
            savedRows = [];
        }
        if (IsDisposed) return;
        var url = target?.ServiceUrl ?? ServiceUrlClean;
        var known = target is null ? null : SavedSyncs.Find(savedRows, target);
        nameKnown = known is not null;
        nameDraft = known is not null ? SavedSyncs.Name(known)
            : SavedSyncs.NormalizeLabel(sender) is { } s && !SavedSyncs.LabelTaken(savedRows, target, s) ? s
            : SavedSyncs.SuggestName(url, savedRows);
        if (!IsDisposed) StateHasChanged();
    }

    private RenderFragment NameField() => __builder =>
    {
        <div class="mb-3">
            <label class="form-label" for="conn-sync-name">@L.Get(Str.SyncsNameLabel)</label>
            <input id="conn-sync-name" class="form-control" @bind="nameDraft" @bind:event="oninput" @bind:after="NameEdited" disabled="@busy"
                   maxlength="@SavedSyncs.MaxLabelLength" autocomplete="off" spellcheck="false"
                   aria-invalid="@(NameTaken ? "true" : "false")" aria-describedby="conn-sync-name-hint" />
            @if (NameTaken)
            {
                <div id="conn-sync-name-hint" class="alert alert-danger mt-2 mb-0" role="alert">@L.Get(Str.SyncsNameTaken)</div>
            }
            else if (!nameKnown)
            {
                @* A saved sync keeps its name when the field is emptied, so the
                   host-fallback hint would be wrong there. *@
                <div id="conn-sync-name-hint" class="form-text">@L.Get(Str.SyncsNameEmptyHint, NameFallback)</div>
            }
        </div>
    };

    private void Ok(string text)
    {
        isError = false;
        message = text;
    }
}
