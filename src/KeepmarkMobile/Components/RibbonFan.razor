@* Closed Home section preview (canvas "R4"): one mini ribbon per item in
   its site color, overlapping. Decorative: the head names the section and
   its count. *@
<span class="xbs-fan" aria-hidden="true">
    @foreach (var c in Colors)
    {
        <svg viewBox="0 0 18 24"><path d="M2.5 0h13A2.5 2.5 0 0 1 18 2.5V24l-9-5.5L0 24V2.5A2.5 2.5 0 0 1 2.5 0z" fill="@c" /></svg>
    }
</span>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<string> Colors { get; set; } = [];
}
