    /// <summary>"3 folders · 1 bookmark" for the big title of a short list (this level only).</summary>
    private string CountLabel
    {
        get
        {
            var folders = rows.Count(r => r.IsFolder);
            var links = rows.Count(r => !r.IsFolder && r.Url != Core.XbsConstants.SeparatorUrl);
            var parts = new List<string>();
            if (folders > 0) parts.Add(Loc.Plural(Str.HomeCountFolders, folders));
            if (links > 0 || folders == 0) parts.Add(Loc.Plural(Str.HomeCountBookmarks, links));
            return string.Join(" · ", parts);
        }
    }

