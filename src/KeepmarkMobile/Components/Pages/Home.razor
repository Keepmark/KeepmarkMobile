@page "/"
@using Microsoft.JSInterop
@using Keepmark.Core.Data
@inject KeepmarkMobile.Services.XbsSession Session
@inject KeepmarkMobile.Services.PinnedStore Pins
@inject KeepmarkMobile.Services.XbsSettings AppSettings
@inject KeepmarkMobile.Services.ToastState Toast
@inject KeepmarkMobile.Services.SharedImportService SharedImport
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@L.Get(Str.NavExplore)</PageTitle>

@if (!ready)
{
    <p><em>@L.Get(Str.HomeLoading)</em></p>
}
else if (engineStatus == Core.Sync.SyncStatus.NoCredentials)
{
    <p>@L.Get(Str.HomeNoSyncA) <a href="connect">@L.Get(Str.HomeConnectLink)</a> @L.Get(Str.HomeNoSyncB)</p>
}
else
{
    <h1 class="visually-hidden">@L.Get(Str.NavGroupBookmarks)</h1>
    <header class="xbs-pagebar @(searchOpen ? "searching" : string.Empty)">
        @if (searchOpen)
        {
            <button class="xbs-barbtn" data-back="10" @onclick="CloseSearch" aria-label="@L.Get(Str.HomeCloseSearch)"><svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg></button>
            <div class="xbs-barsearch">
                <input id="xbs-q" class="xbs-barsearch-input" type="search" enterkeyhint="search" placeholder="@L.Get(Str.HomeSearchPlaceholder)" aria-label="@L.Get(Str.HomeSearchPlaceholder)"
                       @oninput="OnSearchInput" value="@query" />
                @if (!string.IsNullOrEmpty(query))
                {
                    <button class="xbs-barbtn sm" @onclick="ClearSearchAndFocus" aria-label="@L.Get(Str.HomeClearSearch)"><svg class="km-ico sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7L7 17" /></svg></button>
                }
            </div>
        }
        else
        {
            <BrandMark Class="xbs-bar-mark" />
            <span class="xbs-barpath"><span class="xbs-barpath-name">Keepmark</span></span>
            <button class="xbs-barbtn" @onclick="OpenSearch" aria-label="@L.Get(Str.HomeSearchPlaceholder)"><svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="M20 20l-4.2-4.2" /></svg></button>
            @if (!recentView)
            {
                <button class="xbs-barbtn" @onclick="ToggleSortMenu" aria-label="@L.Get(Str.HomeSortAria, SortLabel)" aria-expanded="@sortMenuOpen.ToString().ToLowerInvariant()">
                    <svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5v14M4 16l3 3 3-3M14 7h6M14 12h4M14 17h2" /></svg>
                    @if (sortMode != "Default") { <span class="xbs-barbtn-dot" aria-hidden="true"></span> }
                </button>
            }
        }
    </header>

    @if (recentView && !searchOpen)
    {
        @* "See all recent" is a virtual level: the root ribbon, then one lilac
           ribbon with the clock. Back (data-back) returns to the root. *@
        <div class="xbs-crumbbar">
            <button class="xbs-crumb-home" data-back="5" @onclick="CloseRecentView" aria-label="@L.Get(Str.HomeAllBookmarks)">
                <span><svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11l8-6.5 8 6.5M6.5 9.5V19h11V9.5" /></svg></span>
            </button>
            <nav class="xbs-crumbs" aria-label="@L.Get(Str.HomeFolderPathMenu)">
                <button class="xbs-crumb" style="z-index: 1" aria-current="location"><span><svg class="km-ico sm xbs-crumb-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" /><path d="M12 7.5V12l3 2" /></svg>@L.Get(Str.HomeRecent)</span></button>
            </nav>
        </div>
        <div class="xbs-crumbbar-space" aria-hidden="true"></div>
    }
    else if (crumbs.Count > 0 && !searchOpen)
    {
        <div class="xbs-crumbbar">
            <button class="xbs-crumb-home" @onclick="GoRoot" aria-label="@L.Get(Str.HomeAllBookmarks)">
                @* Root is the first ribbon of the path (canvas "RbTail"); the path slides under its notch. *@
                <span><svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11l8-6.5 8 6.5M6.5 9.5V19h11V9.5" /></svg></span>
            </button>
            <nav class="xbs-crumbs" aria-label="@L.Get(Str.HomeFolderPathMenu)">
                @{ var depth = 0; }
                @foreach (var c in crumbs.Reverse())
                {
                    depth++;
                    var isCurrent = depth == crumbs.Count;
                    @* Earlier ribbons sit on top: the next one shows through their tail notch. *@
                    <button class="xbs-crumb" style="z-index: @(crumbs.Count - depth + 1)" aria-current="@(isCurrent ? "location" : null)" @onclick="() => JumpTo(c.RowId)"><span>@(c.DisplayTitle ?? L.Get(Str.HomeFolderWord))</span></button>
                }
            </nav>
        </div>
        <div class="xbs-crumbbar-space" aria-hidden="true"></div>
    }

    @if (sortMenuOpen && !searchOpen)
    {
        <div class="xbs-pop-scrim" data-back="40" @onclick="ClosePops" aria-hidden="true"></div>
        <div class="xbs-pop right" role="menu" aria-label="@L.Get(Str.HomeSortMenu)">
            <div class="xbs-pop-head">@L.Get(Str.HomeSortHead)</div>
            @foreach (var (mode, label) in SortModes)
            {
                <button class="xbs-pop-item @(sortMode == mode ? "current" : string.Empty)" role="menuitemradio" aria-checked="@((sortMode == mode).ToString().ToLowerInvariant())"
                        @onclick="() => { ClosePops(); return SetSort(mode); }">
                    <span>@label</span>
                    @if (sortMode == mode) { <svg class="km-ico sm xbs-pop-check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg> }
                </button>
            }
            <p class="xbs-pop-note">@L.Get(Str.HomeSortNote)</p>
        </div>
    }

    @if (searching)
    {
        <p class="xbs-hint"><em>@L.Get(Str.HomeSearching)</em></p>
    }
    else if (isSearch)
    {
        <h2 class="xbs-section" role="status">@Loc.Plural(Str.HomeResults, hits.Count)</h2>
        @if (hitRows.Count == 0 && !searching)
        {
            <p class="xbs-hint" role="status">@L.Get(Str.HomeNoMatches)</p>
        }
        else
        {
            <div class="xbs-list">
                @foreach (var id in hitRows)
                {
                    <BookmarkRow @key="@("s" + id)" Row="byRow[id]" Expanded="expandedRows.Contains(id)" Flash="flashRowId == id" Pinned="IsPinned(id)"
                                 FolderPath="@hitPaths.GetValueOrDefault(id)" OnOpen="OpenRow" OnAction="OnRowAction" />
                }
            </div>
        }
    }
    else if (recentView)
    {
        <h2 class="xbs-section">@L.Get(Str.HomeRecentNote)</h2>
        <div class="xbs-list">
            @foreach (var r in recentAll)
            {
                <BookmarkRow @key="@("v" + r.RowId)" Row="r" Expanded="expandedRows.Contains(r.RowId)" Flash="flashRowId == r.RowId" Pinned="IsPinned(r.RowId)"
                             FolderPath="@pinPaths.GetValueOrDefault(r.RowId)" Added="@RelativeTime.Format(r.DateAdded)" OnOpen="OpenRow" OnAction="OnRowAction" />
            }
        </div>
    }
    else
    {
        <div class="xbs-browse">
        <div class="xbs-bigtitle">
            <div class="xbs-bigtitle-name">@(crumbs.Count == 0 ? L.Get(Str.HomeRootTitle) : CurrentName)</div>
            <div class="xbs-bigtitle-sub">@CountLabel</div>
        </div>
        <div class="xbs-browse-body">
        @* Canvas "R1 + R4": each section is a card with a ribbon hanging from
           its top edge (folded flap above, like the action sheet); closed, the
           head shows a strip of mini ribbons in the items' site colors. *@
        @if (pinnedRows.Count > 0 && crumbs.Count == 0)
        {
            <section class="xbs-sect">
                <button class="xbs-sect-head" @onclick="TogglePinned" aria-expanded="@pinnedOpen.ToString().ToLowerInvariant()">
                    <svg class="xbs-sect-rib" viewBox="0 0 26 40" aria-hidden="true"><path d="M2 0h22l2 6H0z" fill="#6b4a07" /><path d="M0 6h26v32l-13-7.5L0 38z" fill="#b07a12" /><path d="M9.5 12h7l-1 4.5 2.6 2.6v1.6H7.9v-1.6l2.6-2.6z M13 20.7v4" fill="none" stroke="#fff" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" /></svg>
                    <span class="xbs-sect-label">@L.Get(Str.HomePinned)</span>
                    <span class="xbs-sect-n">@pinnedRows.Count</span>
                    @if (!pinnedOpen) { <RibbonFan Colors="FanColors(pinnedRows)" /> }
                    <svg class="km-ico sm chev @(pinnedOpen ? "open" : string.Empty)" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
                </button>
                @if (pinnedOpen)
                {
                    <div class="xbs-list xbs-sect-body">
                        @foreach (var r in pinnedRows)
                        {
                            <BookmarkRow @key="@("p" + r.RowId)" Row="r" Pinned="true" Expanded="expandedRows.Contains(r.RowId)" Flash="flashRowId == r.RowId"
                                             FolderPath="@pinPaths.GetValueOrDefault(r.RowId)" Count="@folderCounts.GetValueOrDefault(r.RowId)" OnOpen="OpenRow" OnAction="OnRowAction" />
                        }
                    </div>
                }
            </section>
        }
        @if (showRecent && recentAll.Count > 0 && crumbs.Count == 0)
        {
            <section class="xbs-sect">
                <button class="xbs-sect-head" @onclick="ToggleRecent" aria-expanded="@recentOpen.ToString().ToLowerInvariant()">
                    <svg class="xbs-sect-rib" viewBox="0 0 26 40" aria-hidden="true"><path d="M2 0h22l2 6H0z" fill="#2b3a8c" /><path d="M0 6h26v32l-13-7.5L0 38z" fill="#3d4fb0" /><circle cx="13" cy="18" r="5.5" fill="none" stroke="#fff" stroke-width="1.5" /><path d="M13 15v3.2l2 1.3" fill="none" stroke="#fff" stroke-width="1.5" stroke-linecap="round" /></svg>
                    <span class="xbs-sect-label">@L.Get(Str.HomeRecent)</span>
                    <span class="xbs-sect-n">@RecentShown.Count</span>
                    @if (!recentOpen) { <RibbonFan Colors="FanColors(RecentShown)" /> }
                    <svg class="km-ico sm chev @(recentOpen ? "open" : string.Empty)" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
                </button>
                @if (recentOpen)
                {
                    <div class="xbs-list xbs-sect-body">
                        @foreach (var r in RecentShown)
                        {
                            <BookmarkRow @key="@("n" + r.RowId)" Row="r" Pinned="IsPinned(r.RowId)" Expanded="expandedRows.Contains(r.RowId)" Flash="flashRowId == r.RowId"
                                         FolderPath="@pinPaths.GetValueOrDefault(r.RowId)" Added="@RelativeTime.Format(r.DateAdded)" OnOpen="OpenRow" OnAction="OnRowAction" />
                        }
                    </div>
                    @if (recentAll.Count > RecentShown.Count)
                    {
                        <button class="xbs-sect-more" @onclick="OpenRecentView">@L.Get(Str.HomeRecentAll)<svg class="km-ico sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg></button>
                    }
                }
            </section>
        }
        @if (rows.Count > 0)
        {
            <div class="xbs-list">
                @foreach (var r in rows)
                {
                    <BookmarkRow @key="@("r" + r.RowId)" Row="r" Expanded="expandedRows.Contains(r.RowId)" Flash="flashRowId == r.RowId" Pinned="IsPinned(r.RowId)" Count="@folderCounts.GetValueOrDefault(r.RowId)" OnOpen="OpenRow" OnAction="OnRowAction" />
                }
            </div>
        }
        else
        {
            <p class="xbs-hint" role="status">@(crumbs.Count == 0 ? L.Get(Str.HomeEmptyRoot) : L.Get(Str.HomeEmptyFolder))</p>
        }
        </div>
        </div>
    }

    <div class="xbs-statusbar @StatusClass @(StatusVisible ? string.Empty : "away")" role="status" aria-hidden="@(StatusVisible ? "false" : "true")">
        <span class="xbs-status-dot" aria-hidden="true"></span>
        <span class="xbs-statusbar-main">
            @if (!string.IsNullOrEmpty(FriendlyStatus()))
            {
                @if (engineStatus == Core.Sync.SyncStatus.Conflict)
                {
                    <a href="status" class="xbs-status-link" @onclick="@(() => Nav.NavigateTo("/status"))">@FriendlyStatus()</a>
                }
                else
                {
                    <text>@FriendlyStatus()</text>
                }
            }
            else
            {
                <text>@(lastSync is null ? L.Get(Str.NavNotSyncedYet) : L.Get(Str.NavSynced, FormatLastSync(lastSync)))</text>
            }
        </span>
        @if (Session.Engine?.Mode == Core.Sync.SyncMode.Manual)
        {
            <button class="xbs-statusbar-sync" @onclick="SyncNow">@L.Get(Str.CommonSyncNow)</button>
        }
    </div>
}

@if (ready && Session.Engine is not null)
{
    <button class="xbs-fab" @onclick="AddNew" aria-label="@L.Get(Str.HomeAddAria)">
        <svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
        <span class="xbs-fab-label" aria-hidden="true">@L.Get(Str.HomeAdd)</span>
    </button>
}

@if (sheetFor is not null)
{
    <BookmarkSheet Visible="true" Existing="sheetFor.Row" DefaultParent="sheetFor.Parent"
                   PresetUrl="@sheetFor.PresetUrl" PresetTitle="@sheetFor.PresetTitle"
                   Folders="allFolders" OnSave="SaveSheet" OnCancel="() => sheetFor = null"
                   FindDuplicates="FindDuplicates" OnOpenExisting="OpenExisting"
                   OnEditExisting="r => sheetFor = new SheetTarget(r, null)" />
}

@if (menuFor is not null)
{
    <div class="xbs-sheet-backdrop" data-back="30" @onclick="() => menuFor = null">
        <div class="xbs-sheet menu" style="--km-site: @(menuFor.IsFolder ? "#273f85" : RowTile.ColorFor(menuFor))" role="dialog" aria-modal="true" aria-label="@L.Get(Str.HomeActionsFor, menuFor.DisplayTitle ?? menuFor.Url ?? L.Get(Str.HomeItemWord))" @onclick:stopPropagation="true">
            @* Canvas "SheetGridA": a ribbon hangs over the top edge (site color
               for bookmarks, navy with a folder glyph for folders); frequent
               actions as tiles, then a group with location and the separate
               Delete. No Cancel: the backdrop and Back close it. *@
            <RowTile Row="menuFor" Ribbon="true" />
            <div class="xbs-sheet-info @(MenuExpanded ? "expanded" : string.Empty)" data-sheet-info aria-expanded="@MenuExpanded.ToString().ToLowerInvariant()">
            <div class="xbs-sheet-head ribboned">
                <div class="xbs-sheet-head-text">
                    <h2 class="xbs-sheet-title">@(menuFor.DisplayTitle ?? menuFor.Url)</h2>
                    @if (!menuFor.IsFolder && !string.IsNullOrEmpty(menuFor.Url))
                    {
                        <div class="xbs-sheet-url">@menuFor.Url</div>
                    }
                    else if (menuFor.IsFolder && folderCounts.TryGetValue(menuFor.RowId, out var menuCount))
                    {
                        <div class="xbs-sheet-url">@Loc.Plural(Str.HomeCountBookmarks, menuCount)</div>
                    }
                </div>
            </div>
            @if (!menuFor.IsFolder)
            {
                @if (!string.IsNullOrEmpty(menuFor.Description)) { <p class="xbs-sheet-desc">@menuFor.Description</p> }
                @if (!string.IsNullOrEmpty(menuFor.Tags))
                {
                    <div class="xbs-sheet-tags">
                        @foreach (var tag in menuFor.Tags.Split('\u001F', StringSplitOptions.RemoveEmptyEntries))
                        {
                            <span class="xbs-tag">#@tag</span>
                        }
                    </div>
                }
            }
            @if (RelativeTime.Detail(menuFor.DateAdded) is { } added)
            {
                <div class="xbs-sheet-added"><svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></svg>@L.Get(Str.SheetAdded, added)</div>
            }
            </div>
            <div class="xbs-action-tiles">
                <button class="xbs-action-tile primary" @onclick="() => { var r = menuFor; menuFor = null; _ = OpenRow(r); }"><span class="xbs-action-ico"><svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="@(menuFor.IsFolder ? "M9 6l6 6-6 6" : "M14 4h6v6M20 4l-8 8M10 5H5v14h14v-5")" /></svg></span>@L.Get(Str.HomeOpen)</button>
                @if (!menuFor.IsFolder)
                {
                    <button class="xbs-action-tile" @onclick="() => ShareRow(menuFor)"><span class="xbs-action-ico"><svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="12" r="2.5" /><circle cx="18" cy="6" r="2.5" /><circle cx="18" cy="18" r="2.5" /><path d="M8.2 10.8l7.6-3.6M8.2 13.2l7.6 3.6" /></svg></span>@L.Get(Str.HomeShare)</button>
                }
                <button class="xbs-action-tile" @onclick="() => { var r = menuFor; menuFor = null; sheetFor = new SheetTarget(r, null); }"><span class="xbs-action-ico"><svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4l10.5-10.5a2.1 2.1 0 0 0-4-4L4 16z" /></svg></span>@L.Get(Str.HomeEdit)</button>
                <button class="xbs-action-tile pin @(MenuPinned ? "on" : string.Empty)" aria-pressed="@MenuPinned.ToString().ToLowerInvariant()" @onclick="() => TogglePin(menuFor)"><span class="xbs-action-ico"><svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4h6l-1 5 3 3v2H7v-2l3-3z M12 14v6" /></svg></span>@(MenuPinned ? L.Get(Str.HomeUnpin) : L.Get(Str.HomePin))</button>
            </div>
            @* Canvas "MoveQuick" (D): where the item lives (tap = go there) with
               Move beside it, then recent destinations for a one-tap move. *@
            <div class="xbs-loc">
                <button class="xbs-loc-path" @onclick="() => GoToLocation(menuFor)" aria-label="@($"{L.Get(Str.HomeGoToLocation)}: {FolderPath(menuFor.ParentRowId)}")">
                    <svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 7.5a2 2 0 0 1 2-2h4l2 2h7a2 2 0 0 1 2 2v7.5a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2z" /></svg>
                    <span class="xbs-loc-text"><small>@L.Get(Str.HomeLocation)</small><span>@FolderPath(menuFor.ParentRowId)</span></span>
                </button>
                <button class="xbs-loc-move" @onclick="OpenMovePicker"><svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 7.5a2 2 0 0 1 2-2h4l2 2h7a2 2 0 0 1 2 2v7.5a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2z M10 13.5h6M13.5 11l2.5 2.5-2.5 2.5" /></svg>@L.Get(Str.HomeMove)</button>
            </div>
            @if (MenuQuickTargets is { Count: > 0 } quick)
            {
                <div class="xbs-quick-label">@L.Get(Str.HomeMoveQuick)</div>
                <div class="xbs-quick-chips">
                    @foreach (var f in quick)
                    {
                        <button class="xbs-quick-chip" @onclick="() => MoveRow(menuFor, f.RowId)"><svg class="km-ico sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 7.5a2 2 0 0 1 2-2h4l2 2h7a2 2 0 0 1 2 2v7.5a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2z" /></svg><span>@(f.DisplayTitle ?? L.Get(Str.SheetTypeFolder))</span></button>
                    }
                    <button class="xbs-quick-chip other" @onclick="OpenMovePicker"><span>@L.Get(Str.HomeMoveOther)</span></button>
                </div>
            }
            <div class="xbs-action-group">
                <button class="xbs-action danger" @onclick="() => DeleteRow(menuFor)"><svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14M10 11v6M14 11v6M6.5 7l1 12h9l1-12M9.5 7V4.5h5V7" /></svg>@L.Get(Str.CommonDelete)</button>
            </div>
        </div>
    </div>
}

@if (movingFor is not null)
{
    <MovePicker Row="movingFor" Folders="allFolders" Recents="MoveRecentRowIds()"
                OnMove="t => MoveRow(movingFor, t)" OnCancel="() => movingFor = null" CreateFolderIn="CreateFolderIn" />
}

@if (undo is not null)
{
    <div class="xbs-undo">
        <span>@L.Get(Str.HomeDeleted)</span>
        <button class="xbs-undo-btn" @onclick="UndoDelete">@L.Get(Str.CommonUndo)</button>
    </div>
}
else if (moved is not null)
{
    <div class="xbs-undo" role="status">
        <span>@moved.Value.Text</span>
        <button class="xbs-undo-btn ghost" @onclick="ShowMoved">@L.Get(Str.HomeMoveShow)</button>
        <button class="xbs-undo-btn" @onclick="UndoMove">@L.Get(Str.CommonUndo)</button>
    </div>
}

@code {
    private bool ready;
    private Core.Sync.SyncStatus engineStatus;
    private DateTimeOffset? lastSync;
    private List<ItemRow> rows = [];
    private List<ItemRow> pinnedRows = [];
    private List<ItemRow> allFolders = [];
    private List<string> pinned = [];
    private Dictionary<int, string> pinKeyByRow = [];
    private bool MenuPinned => menuFor is not null && IsPinned(menuFor.RowId);
    private bool IsPinned(int rowId) => pinKeyByRow.TryGetValue(rowId, out var k) && pinned.Contains(k);
    private readonly Stack<ItemRow> crumbs = new();
    private readonly Dictionary<int, ItemRow> byRow = new();
    private string query = string.Empty;
    private List<SearchHit> hits = [];
    private List<int> hitRows = [];
    private Dictionary<int, string> hitPaths = new();
    private bool isSearch;
    private bool searching;
    private int searchGen;
    private CancellationTokenSource? debounce;
    private DotNetObjectReference<Home>? dotNet;
    private bool gesturesInit;
    private SheetTarget? sheetFor;
    private ItemRow? menuFor;
    private ItemRow? movingFor;
    // Last move, for the undo bar: the row, where it came from (RowId and stable NodeId) and the bar text.
    private (ItemRow Row, int? FromRowId, int? FromNodeId, string Text)? moved;
    private bool pinnedOpen = false;
    // "Recently added": newest bookmarks by NodeId (RecentLimit for the full
    // view); Home shows the first recentCount, the full view all of them.
    private const int RecentLimit = 50;
    private List<ItemRow> recentAll = [];
    private bool showRecent;
    private int recentCount = 5;
    private bool recentOpen = true;
    private bool recentView;
    private List<ItemRow> RecentShown => recentAll.Count <= recentCount ? recentAll : recentAll.GetRange(0, recentCount);
    private int? flashRowId;
    private int? flashNodeId;
    private readonly HashSet<int> expandedRows = new();
    private Dictionary<int, string> pinPaths = new();
    private Dictionary<int, int> folderCounts = new();
    private string sortMode = "Default";
    private CancellationTokenSource? flashTimer;
    // Re-renders the relative "added" labels (recent rows, open sheet) once a minute.
    private Timer? recentClock;
    private (int? Parent, List<Core.Models.BookmarkNode> Subtree)? undo;
    private CancellationTokenSource? undoTimer;

    private int? CurrentParent => crumbs.Count == 0 ? null : crumbs.Peek().RowId;

    private sealed record SheetTarget(ItemRow? Row, int? Parent, string? PresetUrl = null, string? PresetTitle = null);

    protected override async Task OnInitializedAsync()
    {
        for (int i = 0; i < 100 && !Session.Ready; i++)
        {
            await Task.Delay(100);
        }

        if (Session.Engine is not null)
        {
            Session.Engine.StatusChanged += OnStatus;
            Session.Engine.DataChanged += OnData;
        }

        pinned = Pins.Load();
        sortMode = AppSettings.ListSort;
        recentOpen = AppSettings.RecentOpen;
        await RefreshAsync();
        ready = true;
        SharedImport.Arrived += OnSharedArrived;
        OpenSharedIfPending();
        recentClock = new Timer(_ => _ = InvokeAsync(TickRecent), null, TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));
    }

    private void TickRecent()
    {
        var visible = recentView || (showRecent && recentOpen && crumbs.Count == 0 && !searchOpen);
        if ((visible && recentAll.Any(r => r.DateAdded is not null)) || menuFor?.DateAdded is not null)
        {
            StateHasChanged();
        }
    }

    private void OnStatus(Core.Sync.SyncStatus s)
    {
        if (engineStatus == Core.Sync.SyncStatus.Syncing && s == Core.Sync.SyncStatus.Idle)
        {
            FlashSynced();
        }

        TrackTrouble(s);
        engineStatus = s;
        if (Session.Engine is not null)
        {
            lastSync = Session.Engine.LastSyncAt;
        }

        InvokeAsync(StateHasChanged);
    }

    // The status pill only shows when it has something to say: for a few
    // seconds after a sync succeeds, a conflict (needs a choice), unsent edits
    // in manual mode, or an offline/error state that has lasted TroubleDelay
    // (a single failed attempt or a running sync stays silent). Otherwise it
    // steps aside; the drawer head always carries the full sync state.
    private static readonly TimeSpan TroubleDelay = TimeSpan.FromSeconds(30);
    private bool statusFlash;
    private CancellationTokenSource? statusFlashCts;
    private bool troubleShown;
    private CancellationTokenSource? troubleCts;

    private bool StatusVisible =>
        statusFlash
        || engineStatus == Core.Sync.SyncStatus.Conflict
        || (troubleShown && engineStatus is Core.Sync.SyncStatus.Offline or Core.Sync.SyncStatus.Error)
        || (Session.Engine is { Mode: Core.Sync.SyncMode.Manual, PendingEdits: > 0 });

    // Offline/Error start a timer; retries (Syncing) in between keep it
    // running, only a successful Idle clears it.
    private void TrackTrouble(Core.Sync.SyncStatus s)
    {
        if (s is Core.Sync.SyncStatus.Offline or Core.Sync.SyncStatus.Error)
        {
            if (troubleCts is not null)
            {
                return;
            }

            var cts = troubleCts = new CancellationTokenSource();
            _ = Task.Delay(TroubleDelay, cts.Token).ContinueWith(t =>
            {
                if (t.IsCanceled)
                {
                    return;
                }

                troubleShown = true;
                InvokeAsync(StateHasChanged);
            }, TaskScheduler.Default);
        }
        else if (s != Core.Sync.SyncStatus.Syncing)
        {
            troubleCts?.Cancel();
            troubleCts?.Dispose();
            troubleCts = null;
            troubleShown = false;
        }
    }

    private void FlashSynced()
    {
        statusFlashCts?.Cancel();
        statusFlashCts?.Dispose();
        var cts = statusFlashCts = new CancellationTokenSource();
        statusFlash = true;
        _ = Task.Delay(3000, cts.Token).ContinueWith(t =>
        {
            if (t.IsCanceled)
            {
                return;
            }

            statusFlash = false;
            InvokeAsync(StateHasChanged);
        }, TaskScheduler.Default);
    }

    private string StatusClass => engineStatus switch
    {
        Core.Sync.SyncStatus.Syncing => "syncing",
        Core.Sync.SyncStatus.Offline or Core.Sync.SyncStatus.Error => "warn",
        Core.Sync.SyncStatus.Conflict => "conflict",
        _ => lastSync is null ? "off" : "ok"
    };

    private string FriendlyStatus() => engineStatus switch
    {
        Core.Sync.SyncStatus.Syncing => L.Get(Str.CommonSyncing),
        Core.Sync.SyncStatus.Offline => L.Get(Str.NavOffline),
        Core.Sync.SyncStatus.Conflict => L.Get(Str.NavConflict),
        Core.Sync.SyncStatus.Error => L.Get(Str.NavSyncError),
        _ => string.Empty
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!gesturesInit && ready)
        {
            gesturesInit = true;
            dotNet = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("xbsGestures.init", dotNet);
        }

        if (focusSearch)
        {
            focusSearch = false;
            try { await JS.InvokeVoidAsync("xbsGestures.focus", "#xbs-q"); } catch { }
        }

        // Short list sits just above mid-screen; the crumb strip shows its
        // current (last) level. Both are measured in JS after every paint.
        if (ready)
        {
            try { await JS.InvokeVoidAsync("xbsGestures.layoutBrowse"); } catch { }
        }

        if (ready && sheetFor is null && Session.Engine is not null && SharedImport.Peek() is not null)
        {
            if (OpenSharedIfPending())
            {
                StateHasChanged();
            }
        }

        // A modal sheet is open: freeze the page behind it so no scroll
        // leaks through the backdrop (touch or wheel). Owner-keyed with the
        // nav drawer: whoever is still open keeps the lock.
        if (ready)
        {
            try { await JS.InvokeVoidAsync("xbsGestures.lockScroll", menuFor is not null || sheetFor is not null || movingFor is not null, "sheet"); } catch { }
        }
    }

    private async Task RefreshAsync()
    {
        if (Session is { Store: not null, Engine: not null })
        {
            // Every successful push/pull rewrites all rows (new RowIds): rebase
            // in-memory RowId references on the stable NodeId first, otherwise
            // the open folder (and expansions) silently point nowhere.
            await RebaseCrumbsAsync();
            // Capture expanded folders by stable NodeId before byRow is refilled below.
            var expandedNodes = expandedRows
                .Where(id => byRow.TryGetValue(id, out _))
                .Select(id => byRow[id].NodeId)
                .Where(n => n is not null)
                .Select(n => n!.Value)
                .ToHashSet();
            engineStatus = Session.Engine.Status;
            TrackTrouble(engineStatus);
            lastSync = Session.Engine.LastSyncAt;
            var parent = CurrentParent;
            rows = await Session.Store.GetChildrenAsync(parent);
            // Display-only sort: stored SortOrder (and therefore the sync blob)
            // is never touched — folders first, separators last.
            rows = sortMode switch
            {
                "Asc" => rows.OrderBy(RankForSort)
                    .ThenBy(r => SortTitle(r), StringComparer.OrdinalIgnoreCase).ToList(),
                "Desc" => rows.OrderBy(RankForSort)
                    .ThenByDescending(r => SortTitle(r), StringComparer.OrdinalIgnoreCase).ToList(),
                _ => rows
            };
            allFolders = await Session.Store.GetAllFoldersAsync();
            await MigrateLegacyPinsAsync();
            (pinnedRows, pinKeyByRow) = await Session.Store.GetPinnedAsync(pinned);
            showRecent = AppSettings.ShowRecent;
            recentCount = AppSettings.RecentCount;
            recentAll = showRecent ? await Session.Store.GetRecentBookmarksAsync(RecentLimit) : [];
            if (recentAll.Count == 0) recentView = false;
            pinPaths = await Session.Store.GetFolderPathsAsync();
            folderCounts = await Session.Store.GetFolderBookmarkCountsAsync();
            byRow.Clear();
            foreach (var r in rows.Concat(pinnedRows).Concat(recentAll)) byRow[r.RowId] = r;
            foreach (var h in hits)
            {
                var node = await Session.Store.GetNodeAsync(h.RowId);
                if (node is not null) byRow[h.RowId] = node;
            }

            hitRows = hits.Where(h => byRow.ContainsKey(h.RowId)).Select(h => h.RowId).ToList();
            hitPaths = hits.ToDictionary(h => h.RowId, h => h.FolderPath);
            // Search results hold RowIds: any store rewrite (delete, sync)
            // rekeys them. If some no longer resolve, re-run the live query
            // instead of showing a stale count with an empty list.
            if (isSearch && Session.Store is not null && query.Trim().Length >= 2 &&
                hits.Count > hitRows.Count)
            {
                var gen = ++searchGen;
                var found = await Session.Store.SearchAsync(query.Trim(), 50);
                if (gen == searchGen)
                {
                    hits = found;
                    foreach (var h in hits)
                    {
                        if (!byRow.ContainsKey(h.RowId))
                        {
                            var node = await Session.Store.GetNodeAsync(h.RowId);
                            if (node is not null)
                            {
                                byRow[h.RowId] = node;
                            }
                        }
                    }

                    hitRows = hits.Where(h => byRow.ContainsKey(h.RowId)).Select(h => h.RowId).ToList();
                    hitPaths = hits.ToDictionary(h => h.RowId, h => h.FolderPath);
                }
            }
            // Sync rewrites rekey every RowId: restore expansions via stable NodeId.
            if (expandedRows.Count > 0)
            {
                var byNode = byRow.Values
                    .Where(r => r.NodeId is not null)
                    .GroupBy(r => r.NodeId!.Value)
                    .ToDictionary(g => g.Key, g => g.First().RowId);
                expandedRows.IntersectWith(byRow.Keys);
                foreach (var n in expandedNodes)
                {
                    if (byNode.TryGetValue(n, out var freshId))
                    {
                        expandedRows.Add(freshId);
                    }
                }
            }
            // The flash target is a stable NodeId too: a sync rewrite between
            // render and tap rekeys every RowId, so resolve it to the fresh one.
            if (flashNodeId is not null)
            {
                flashRowId = byRow.Values.FirstOrDefault(r => r.NodeId == flashNodeId)?.RowId;
            }
        }
    }

    private string FormatLastSync(DateTimeOffset? value)
    {
        if (value is null)
        {
            return L.Get(Str.StatusNever);
        }

        var local = value.Value.ToLocalTime();
        return local.Date == DateTime.Now.Date ? local.ToString("t") : local.ToString("g");
    }

    private void OnData() => InvokeAsync(async () => { await RefreshAsync(); StateHasChanged(); });

    // ---- JS gesture callbacks ----

    [JSInvokable] public async Task OnRowTap(int rowId) => await OpenRow(await ResolveAsync(rowId));

    [JSInvokable]
    public Task OnRowSwipeRight(int rowId)
    {
        // Swipe right: expand details. Multiple rows stay expanded together.
        expandedRows.Add(rowId);
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnRowSwipeLeft(int rowId)
    {
        // Swipe left: collapse this row only.
        if (expandedRows.Remove(rowId))
        {
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    // Action sheet details: full title/URL/description/tags by default;
    // swipe left clamps them, swipe right expands again.
    private ItemRow? menuCollapsedFor;
    private bool MenuExpanded => menuFor is not null && !ReferenceEquals(menuCollapsedFor, menuFor);

    [JSInvokable]
    public Task OnSheetSwipe(int dir)
    {
        menuCollapsedFor = dir < 0 ? menuFor : null;
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public async Task OnRowLongPress(int rowId)
    {
        var row = await ResolveAsync(rowId);
        if (row is not null)
        {
            menuFor = row;
            StateHasChanged();
        }
    }

    private async Task<ItemRow?> ResolveAsync(int rowId)
    {
        if (byRow.TryGetValue(rowId, out var cached)) return cached;
        if (Session.Store is null) return null;
        var node = await Session.Store.GetNodeAsync(rowId);
        if (node is not null) byRow[rowId] = node;
        return node;
    }

    // ---- Actions ----

    private async Task OpenRow(ItemRow? row)
    {
        if (row is null) return;
        if (row.IsFolder)
        {
            crumbs.Push(row);
            query = string.Empty;
            isSearch = false;
            searchOpen = false;
            Session.Log.Info("ui", "Opened folder");
            Session.Log.Verbose("ui", $"Folder: {row.Title}");
            await RefreshAsync();
        }
        else if (!string.IsNullOrWhiteSpace(row.Url) && row.Url != Core.XbsConstants.SeparatorUrl)
        {
            Session.Log.Info("ui", "Opened bookmark");
            Session.Log.Verbose("ui", $"URL: {row.Url}");
            try { await Launcher.OpenAsync(row.Url); } catch { }
        }
    }

    private async Task OnRowAction((ItemRow Row, RowAction Action) a)
    {
        _ = JS.InvokeVoidAsync("xbsGestures.closeAll");
        switch (a.Action)
        {
            case RowAction.Share: await ShareRow(a.Row); break;
            case RowAction.Delete: await DeleteRow(a.Row); break;
            case RowAction.Menu: menuFor = a.Row; break;
            case RowAction.ToggleExpand:
                if (!expandedRows.Remove(a.Row.RowId))
                {
                    expandedRows.Add(a.Row.RowId);
                }

                break;
        }
    }

    private async Task ShareRow(ItemRow? row)
    {
        menuFor = null;
        if (row is null || row.IsFolder) return;
        Session.Log.Info("ui", "Shared bookmark");
        Session.Log.Verbose("ui", $"Shared: {row.Title}");
        try
        {
            await Share.Default.RequestAsync(new ShareTextRequest($"{row.Title}\n{row.Url}", L.Get(Str.HomeShareTitle)));
        }
        catch { }
    }

    private async Task TogglePin(ItemRow? row)
    {
        menuFor = null;
        StateHasChanged();
        await Task.Delay(1);
        if (row is null || Session.Engine is null) return;
        if (!pinKeyByRow.TryGetValue(row.RowId, out var pinKey))
        {
            pinKeyByRow = await Session.Store.GetPinKeysAsync();
            if (!pinKeyByRow.TryGetValue(row.RowId, out pinKey)) return;
        }

        bool added = Pins.Toggle(pinKey);
        pinned = Pins.Load();
        sortMode = AppSettings.ListSort;
        Session.Log.Info("ui", added ? "Pinned item" : "Unpinned item");
        await RefreshAsync();
        // Paint first: the toast must never gate the list update.
        StateHasChanged();
        _ = Toast.ShowAsync(added ? L.Get(Str.HomePinnedToast) : L.Get(Str.HomeUnpinnedToast));
    }

    // Builds before 1.0.174 pinned by NodeId; convert once while the ids still
    // match this device's mirror, then drop the legacy list.
    private async Task MigrateLegacyPinsAsync()
    {
        var ids = Pins.LoadLegacyIds();
        if (ids.Count == 0 || Session.Store is null) return;
        var keys = await Session.Store.GetPinKeysAsync();
        foreach (var r in await Session.Store.GetByNodeIdsAsync(ids))
        {
            if (keys.TryGetValue(r.RowId, out var k) && !pinned.Contains(k)) pinned.Add(k);
        }

        Pins.Save(pinned);
        Pins.ClearLegacy();
    }

    private async Task DeleteRow(ItemRow? row)
    {
        menuFor = null;
        if (row is null)
        {
            return;
        }

        // Optimistic UI: vanish the row (and close the menu) immediately,
        // reconcile with the store right after.
        rows.RemoveAll(r => r.RowId == row.RowId);
        pinnedRows.RemoveAll(r => r.RowId == row.RowId);
        recentAll.RemoveAll(r => r.RowId == row.RowId);
        hits.RemoveAll(h => h.RowId == row.RowId);
        hitRows.Remove(row.RowId);
        expandedRows.Remove(row.RowId);
        StateHasChanged();
        await Task.Delay(1);
        _ = JS.InvokeVoidAsync("xbsGestures.closeAll");
        if (Session.Engine is null)
        {
            await RefreshAsync();
            return;
        }
        undoTimer?.Cancel();
        // Stable identity: a sync between render and tap rekeys RowIds,
        // so the delete resolves by NodeId. Legacy rows without a NodeId
        // use the RowId path, with the parent converted to NodeId for undo.
        if (row.NodeId is not null)
        {
            undo = await Session.Engine.DeleteBookmarkByNodeIdAsync(row.NodeId.Value);
        }
        else
        {
            var legacy = await Session.Engine.DeleteBookmarkAsync(row.RowId);
            int? parentNode = null;
            if (legacy.ParentRowId is not null && Session.Store is not null)
            {
                parentNode = (await Session.Store.GetNodeAsync(legacy.ParentRowId.Value))?.NodeId;
            }

            undo = (parentNode, legacy.Subtree);
        }
        moved = null;
        await RefreshAsync();
        StateHasChanged();
        StartUndoTimer();
    }

    /// <summary>Hides the undo bar (delete or move) after 6s.</summary>
    private void StartUndoTimer()
    {
        undoTimer?.Cancel();
        undoTimer = new CancellationTokenSource();
        var token = undoTimer.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(6000, token);
                await InvokeAsync(() => { undo = null; moved = null; StateHasChanged(); });
            }
            catch (Exception ex) when (ex is TaskCanceledException || ex is InvalidOperationException || ex is ObjectDisposedException) { }
        });
    }

    private const string MoveRecentsKey = "move_recents";

    /// <summary>Recent move destinations as current RowIds, most recent first.
    /// Stored as NodeIds (stable across sync rewrites); vanished folders drop out.</summary>
    private List<int> MoveRecentRowIds()
    {
        var result = new List<int>();
        foreach (var part in Preferences.Get(MoveRecentsKey, string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries))
        {
            if (int.TryParse(part, out int nodeId) && allFolders.FirstOrDefault(f => f.NodeId == nodeId) is { } f)
            {
                result.Add(f.RowId);
            }
        }

        return result;
    }

    private static void RememberMoveTarget(int nodeId)
    {
        var ids = Preferences.Get(MoveRecentsKey, string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Where(p => p != nodeId.ToString()).Prepend(nodeId.ToString()).Take(6);
        Preferences.Set(MoveRecentsKey, string.Join(',', ids));
    }

    /// <summary>Quick-move chips for the open menu: recents except the current
    /// folder and, for a folder, anything inside it.</summary>
    private List<ItemRow>? MenuQuickTargets => menuFor is null ? null : MoveRecentRowIds()
        .Where(id => id != menuFor.ParentRowId && !IsInside(id, menuFor))
        .Select(id => allFolders.First(f => f.RowId == id))
        .Take(3)
        .ToList();

    /// <summary>True when folder rowId is the row itself or one of its descendants.</summary>
    private bool IsInside(int rowId, ItemRow row)
    {
        if (!row.IsFolder)
        {
            return false;
        }

        int? cur = rowId;
        for (int guard = 0; cur is not null && guard < 256; guard++)
        {
            if (cur == row.RowId)
            {
                return true;
            }

            cur = allFolders.FirstOrDefault(f => f.RowId == cur.Value)?.ParentRowId;
        }

        return false;
    }

    /// <summary>Folder path as "Work › Dev"; top level when null.</summary>
    private async Task<List<BookmarkSheet.DupHit>> FindDuplicates(string url)
    {
        if (Session.Store is null) return [];
        var rows = await Session.Store.FindByNormalizedUrlAsync(url);
        return rows.Select(r => new BookmarkSheet.DupHit(r, FolderPath(r.ParentRowId))).ToList();
    }

    private async Task OpenExisting(ItemRow row)
    {
        if (string.IsNullOrWhiteSpace(row.Url)) return;
        Session.Log.Info("ui", "Opened bookmark (already saved hint)");
        try { await Launcher.OpenAsync(row.Url); }
        catch (Exception ex) { Session.Log.Warn("ui", $"Open failed: {ex.GetType().Name}"); }
    }

    private string FolderPath(int? rowId)
    {
        var parts = new Stack<string>();
        for (int guard = 0; rowId is not null && guard < 256; guard++)
        {
            var f = allFolders.FirstOrDefault(x => x.RowId == rowId.Value);
            if (f is null)
            {
                break;
            }

            parts.Push(f.DisplayTitle ?? L.Get(Str.SheetTypeFolder));
            rowId = f.ParentRowId;
        }

        return parts.Count == 0 ? L.Get(Str.SheetTopLevel) : string.Join(" › ", parts);
    }

    private void OpenMovePicker()
    {
        movingFor = menuFor;
        menuFor = null;
    }

    private async Task MoveRow(ItemRow? row, int? targetRowId)
    {
        menuFor = null;
        movingFor = null;
        if (row is null || Session.Engine is null || row.ParentRowId == targetRowId)
        {
            return;
        }

        var target = targetRowId is null ? null : allFolders.FirstOrDefault(f => f.RowId == targetRowId.Value);
        if (targetRowId is not null && target is null)
        {
            return;
        }

        var from = row.ParentRowId is null ? null : allFolders.FirstOrDefault(f => f.RowId == row.ParentRowId.Value);
        var path = FolderPath(targetRowId);

        // Optimistic UI: the row leaves the folder list at once. Search hits
        // stay (only their path changes); the refresh below reconciles.
        if (!isSearch)
        {
            rows.RemoveAll(r => r.RowId == row.RowId);
            expandedRows.Remove(row.RowId);
        }

        StateHasChanged();
        await Task.Delay(1);
        _ = JS.InvokeVoidAsync("xbsGestures.closeAll");
        try
        {
            await MoveCoreAsync(row, targetRowId, target?.NodeId);
        }
        catch (Exception ex)
        {
            Session.Log.Warn("ui", $"Move failed: {ex.GetType().Name}");
            await RefreshAsync();
            StateHasChanged();
            _ = Toast.ShowAsync(L.Get(Str.HomeMoveFailed), isError: true);
            return;
        }

        Session.Log.Info("ui", "Moved item");
        Session.Log.Verbose("ui", $"Moved: {row.Title} -> {path}");
        if (target?.NodeId is int targetNode)
        {
            RememberMoveTarget(targetNode);
        }

        undo = null;
        moved = (row, row.ParentRowId, from?.NodeId,
            L.Get(Str.HomeMoved, row.DisplayTitle ?? row.Url ?? L.Get(Str.HomeItemWord), path));
        await RefreshAsync();
        StateHasChanged();
        StartUndoTimer();
    }

    /// <summary>Moves by stable NodeIds; legacy rows (or a destination without
    /// a NodeId) keep the RowId path instead of silently landing at top level.</summary>
    private async Task MoveCoreAsync(ItemRow row, int? toRowId, int? toNodeId)
    {
        if (row.NodeId is not null && (toRowId is null || toNodeId is not null))
        {
            await Session.Engine!.MoveBookmarkByNodeIdAsync(row.NodeId.Value, toNodeId);
        }
        else
        {
            await Session.Engine!.MoveBookmarkAsync(row.RowId, toRowId);
        }
    }

    private async Task UndoMove()
    {
        if (moved is null || Session.Engine is null) return;
        var m = moved.Value;
        moved = null;
        undoTimer?.Cancel();
        StateHasChanged();
        try
        {
            // Back to the original folder (appended at its end).
            await MoveCoreAsync(m.Row, m.FromRowId, m.FromNodeId);
            Session.Log.Info("ui", "Undid move");
        }
        catch (Exception ex)
        {
            Session.Log.Warn("ui", $"Undo move failed: {ex.GetType().Name}");
            _ = Toast.ShowAsync(L.Get(Str.HomeMoveFailed), isError: true);
        }

        await RefreshAsync();
    }

    private async Task ShowMoved()
    {
        if (moved is null) return;
        var row = moved.Value.Row;
        moved = null;
        undoTimer?.Cancel();
        await GoToLocation(row);
    }

    private async Task<int?> CreateFolderIn(int? parentRowId, string title)
    {
        if (Session.Engine is null) return null;
        try
        {
            var parent = parentRowId is null ? null : allFolders.FirstOrDefault(f => f.RowId == parentRowId.Value);
            var node = new Core.Models.BookmarkNode { Title = title, Children = [] };
            int rowId = parent is null || parent.NodeId is not null
                ? await Session.Engine.AddBookmarkByNodeIdAsync(parent?.NodeId, node)
                : await Session.Engine.AddBookmarkAsync(parentRowId, node);
            Session.Log.Info("ui", "Created folder (move)");
            await RefreshAsync();
            StateHasChanged();
            return rowId;
        }
        catch (Exception ex)
        {
            Session.Log.Warn("ui", $"Create folder failed: {ex.GetType().Name}");
            _ = Toast.ShowAsync(ex.Message, isError: true);
            return null;
        }
    }

    private async Task UndoDelete()
    {
        if (undo is null || Session.Engine is null) return;
        undoTimer?.Cancel();
        // undo.Parent is a stable NodeId (see DeleteRow): the restore
        // resolves it live, so a sync inside the 6s window cannot orphan it.
        // A missing parent (deleted meanwhile) falls back to top level.
        await Session.Engine.RestoreBookmarkByNodeIdAsync(undo.Value.Parent, undo.Value.Subtree);
        undo = null;
        await RefreshAsync();
    }

    private int? LastCreateFolder()
    {
        var raw = Preferences.Get("last_create_folder", string.Empty);
        if (int.TryParse(raw, out int id))
        {
            // Stored as NodeId (stable across sync rewrites); legacy RowId still honoured.
            var byNode = allFolders.FirstOrDefault(f => f.NodeId == id);
            if (byNode is not null)
            {
                return byNode.RowId;
            }

            if (allFolders.Any(f => f.RowId == id))
            {
                return id;
            }
        }

        return CurrentParent;
    }

    private async Task AddNew()
    {
        // Prefill from clipboard when it holds a URI: full URL in its field,
        // title as host+path without scheme, query or fragment.
        string? presetUrl = null;
        string? presetTitle = null;
        try
        {
            var clip = await Clipboard.Default.GetTextAsync();
            if (Uri.TryCreate(clip?.Trim(), UriKind.Absolute, out var u) &&
                (u.Scheme == Uri.UriSchemeHttp || u.Scheme == Uri.UriSchemeHttps))
            {
                presetUrl = u.ToString();
                var path = u.AbsolutePath == "/" ? string.Empty : u.AbsolutePath;
                presetTitle = u.Host + path;
            }
        }
        catch
        {
            // Clipboard unavailable: plain empty form.
        }

        sheetFor = new SheetTarget(null, LastCreateFolder(), presetUrl, presetTitle);
    }

    private async Task SaveSheet(BookmarkSheet.BookmarkEdit e)
    {
        if (Session.Engine is null) return;
        if (e.RowId is null)
        {
            var parentRow = e.ParentRowId is not null
                ? allFolders.FirstOrDefault(f => f.RowId == e.ParentRowId.Value)
                : null;
            // A vanished folder falls back to top level (same as before);
            // a folder without a stable NodeId keeps the legacy RowId path.
            int? parentRowId = e.ParentRowId is null ? null : parentRow?.RowId;
            var node = new Core.Models.BookmarkNode
            {
                Title = e.Title, Url = e.Url, Description = e.Description, Tags = e.Tags,
                Children = e.IsFolder ? [] : null
            };
            // Draft folder from the picker: folder + item go in as one subtree
            // (one transaction, one push; nothing created if the sheet was cancelled).
            if (e.NewFolderTitle is not null)
            {
                node = new Core.Models.BookmarkNode { Title = e.NewFolderTitle, Children = [node] };
            }

            _ = parentRowId is null || parentRow?.NodeId is not null
                ? await Session.Engine.AddBookmarkByNodeIdAsync(parentRow?.NodeId, node)
                : await Session.Engine.AddBookmarkAsync(parentRowId, node);

            // Next "Add" defaults to the folder just used (the new one when created here).
            var parentNode = e.NewFolderTitle is not null ? node.Id : parentRow?.NodeId;
            Preferences.Set("last_create_folder", parentNode?.ToString() ?? string.Empty);
            if (e.NewFolderTitle is not null)
            {
                Session.Log.Info("ui", "Created folder (sheet)");
            }
        }
        else
        {
            var nodeId = sheetFor?.Row?.NodeId;
            var current = await Session.Store!.GetNodeAsync(e.RowId.Value);
            int? parentNodeId = e.ParentRowId is not null
                ? allFolders.FirstOrDefault(f => f.RowId == e.ParentRowId.Value)?.NodeId
                : null;
            if (e.NewFolderTitle is not null)
            {
                // Draft folder from the picker: create it, then move the item into it below.
                var folder = new Core.Models.BookmarkNode { Title = e.NewFolderTitle, Children = [] };
                int folderRow = e.ParentRowId is null || parentNodeId is not null
                    ? await Session.Engine.AddBookmarkByNodeIdAsync(parentNodeId, folder)
                    : await Session.Engine.AddBookmarkAsync(e.ParentRowId, folder);
                Session.Log.Info("ui", "Created folder (sheet)");
                e = e with { ParentRowId = folderRow };
                parentNodeId = folder.Id;
            }
            if (nodeId is not null)
            {
                await Session.Engine.UpdateBookmarkByNodeIdAsync(nodeId.Value, e.Title, e.Url, e.Description, e.Tags);
                if (current is not null && current.ParentRowId != e.ParentRowId)
                {
                    try
                    {
                        // Unknown parent NodeId (legacy row) keeps the RowId path
                        // instead of silently moving to top level.
                        if (e.ParentRowId is null || parentNodeId is not null)
                        {
                            await Session.Engine.MoveBookmarkByNodeIdAsync(nodeId.Value, parentNodeId);
                        }
                        else
                        {
                            await Session.Engine.MoveBookmarkAsync(e.RowId.Value, e.ParentRowId);
                        }
                    }
                    catch (Exception ex)
                    {
                        // Move refused (e.g. folder into itself): fields are already saved.
                        System.Diagnostics.Debug.WriteLine($"Move skipped: {ex.Message}");
                    }
                }
            }
            else
            {
                await Session.Engine.UpdateBookmarkAsync(e.RowId.Value, e.Title, e.Url, e.Description, e.Tags);
                if (current is not null && current.ParentRowId != e.ParentRowId)
                {
                    try
                    {
                        await Session.Engine.MoveBookmarkAsync(e.RowId.Value, e.ParentRowId);
                    }
                    catch (Exception ex)
                    {
                        // Move refused (e.g. folder into itself): fields are already saved.
                        System.Diagnostics.Debug.WriteLine($"Move skipped: {ex.Message}");
                    }
                }
            }
        }

        sheetFor = null;
        Session.Log.Info("ui", e.RowId is null ? "Created item" : "Edited item");
        Session.Log.Verbose("ui", $"Saved: {e.Title}");
        await RefreshAsync();
    }

    private async Task SyncNow()
    {
        if (Session.Engine is null)
        {
            return;
        }

        try
        {
            await Session.Engine.ForceSyncAsync();
            await RefreshAsync();
            // Paint first: the toast must never gate the list update.
            StateHasChanged();
            var idle = Session.Engine.Status == Core.Sync.SyncStatus.Idle;
            Session.Log.Info("ui", idle
                ? $"Sync complete {DateTime.Now:HH:mm:ss}"
                : $"Sync finished: {Session.Engine.Status}");
            _ = Toast.ShowAsync(idle
                ? L.Get(Str.NavSyncComplete, $"{DateTime.Now:HH:mm:ss}")
                : L.Get(Str.NavSyncFinished, Core.Sync.SyncStatusText.Label(Session.Engine.Status)),
                isError: Session.Engine.Status is not (Core.Sync.SyncStatus.Idle or Core.Sync.SyncStatus.Offline));
        }
        catch (Exception ex)
        {
            Session.Log.Warn("ui", $"Manual sync failed: {ex.GetType().Name}");
            _ = Toast.ShowAsync(ex.Message, isError: true);
        }
    }

