    private async Task JumpTo(int rowId)
    {
        ClearFlash();
        while (crumbs.Count > 0 && crumbs.Peek().RowId != rowId)
        {
            crumbs.Pop();
        }

        query = string.Empty;
        isSearch = false;
        searchOpen = false;
        await RefreshAsync();
    }

    private async Task GoToLocation(ItemRow? row)
    {
        menuFor = null;
        if (row is null || Session.Store is null) return;

        Session.Log.Debug("ui", "Go to location");
        var chain = await Session.Store.GetAncestorChainAsync(row.RowId);
        ClearFlash();
        crumbs.Clear();
        recentView = false;
        foreach (var folder in chain)
        {
            crumbs.Push(folder);
        }

        query = string.Empty;
        isSearch = false;
        searchOpen = false;
        await RefreshAsync();

        flashNodeId = row.NodeId;
        flashRowId = row.RowId;
        StateHasChanged();
        await Task.Delay(120);
        try { await JS.InvokeVoidAsync("xbsGestures.scrollToRow", row.RowId); } catch { }

        flashTimer?.Cancel();
        flashTimer = new CancellationTokenSource();
        var token = flashTimer.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(2400, token);
                await InvokeAsync(() => { flashNodeId = null; flashRowId = null; StateHasChanged(); });
            }
            catch (Exception ex) when (ex is TaskCanceledException || ex is InvalidOperationException || ex is ObjectDisposedException) { }
        });
    }

    private void ClearFlash()
    {
        flashTimer?.Cancel();
        flashNodeId = null;
        flashRowId = null;
    }

    /// <summary>Re-resolves the breadcrumb chain by stable NodeId. Folders deleted
    /// remotely (or rekeyed by a sync rewrite) are dropped with everything above.</summary>
    private async Task RebaseCrumbsAsync()
    {
        if (crumbs.Count == 0 || Session.Store is null)
        {
            return;
        }

        var ids = crumbs.Where(c => c.NodeId is not null).Select(c => c.NodeId!.Value).ToList();
        var fresh = await Session.Store.GetByNodeIdsAsync(ids);
        var byNode = fresh.GroupBy(r => r.NodeId!.Value).ToDictionary(g => g.Key, g => g.First());
        var ordered = crumbs.Reverse().ToList();
        crumbs.Clear();
        foreach (var c in ordered)
        {
            if (c.NodeId is not null && byNode.TryGetValue(c.NodeId.Value, out var f))
            {
                crumbs.Push(f);
            }
            else
            {
                break;
            }
        }
    }

