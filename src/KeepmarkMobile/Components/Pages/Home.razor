    private void ClearSearch()
    {
        debounce?.Cancel();
        query = string.Empty;
        isSearch = false;
        hits = [];
        hitRows = [];
        searching = false;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        query = e.Value?.ToString() ?? string.Empty;
        debounce?.Cancel();
        debounce = new CancellationTokenSource();
        var token = debounce.Token;
        var gen = ++searchGen;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(250, token);
                await InvokeAsync(async () =>
                {
                    if (query.Trim().Length >= 2 && Session.Store is not null)
                    {
                        searching = true;
                        isSearch = true;
                        StateHasChanged();
                        var found = await Session.Store.SearchAsync(query.Trim(), 50);
                        // A newer keystroke won: drop these stale results.
                        if (gen != searchGen)
                        {
                            return;
                        }

                        hits = found;
                        await RefreshAsync();
                        searching = false;
                        Session.Log.Debug("ui", $"Search executed: {hits.Count} hit(s)");
                        Session.Log.Verbose("ui", $"Query: {query.Trim()}");
                    }
                    else
                    {
                        isSearch = false;
                        hits = [];
                        hitRows = [];
                    }

                    StateHasChanged();
                });
            }
            catch (Exception ex) when (ex is TaskCanceledException || ex is InvalidOperationException || ex is ObjectDisposedException)
            {
            }
        });
    }

    private void OnSharedArrived() => InvokeAsync(() =>
    {
        // Navigate home only when showing another page: navigating while
        // already home would recreate this page and discard the sheet below.
        // The fresh Home instance picks the pending share up in OnInitialized.
        if (!IsHome())
        {
            Nav.NavigateTo("/");
            return;
        }

        if (OpenSharedIfPending())
        {
            StateHasChanged();
        }
    });

    private bool IsHome() => string.IsNullOrEmpty(Nav.ToBaseRelativePath(Nav.Uri));

    /// <summary>Opens the add sheet prefilled from an incoming share. Returns true if one was pending.</summary>
    private bool OpenSharedIfPending()
    {
        // Peek first: consuming before the engine exists would drop the share.
        var pending = SharedImport.Peek();
        if (pending is null || Session.Engine is null)
        {
            return false;
        }

        SharedImport.Consume();
        sheetFor = new SheetTarget(null, LastCreateFolder(), pending.Url, pending.Title);
        return true;
    }

    public void Dispose()
    {
        SharedImport.Arrived -= OnSharedArrived;
        _ = JS.InvokeVoidAsync("xbsGestures.lockScroll", false, "sheet");
        if (Session.Engine is not null)
        {
            Session.Engine.StatusChanged -= OnStatus;
            Session.Engine.DataChanged -= OnData;
        }

        recentClock?.Dispose();
        debounce?.Cancel();
        debounce?.Dispose();
        flashTimer?.Cancel();
        flashTimer?.Dispose();
        statusFlashCts?.Cancel();
        statusFlashCts?.Dispose();
        troubleCts?.Cancel();
        troubleCts?.Dispose();
        undoTimer?.Cancel();
        undoTimer?.Dispose();
        dotNet?.Dispose();
    }
