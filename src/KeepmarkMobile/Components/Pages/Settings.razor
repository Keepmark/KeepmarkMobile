@page "/settings"
@inject KeepmarkMobile.Services.XbsSession Session
@inject KeepmarkMobile.Services.XbsSettings AppSettings
@inject KeepmarkMobile.Services.IStatusBarService StatusBar
@inject Microsoft.JSInterop.IJSRuntime JS
@inject KeepmarkMobile.Services.ToastState Toast
@inject KeepmarkMobile.Services.LanguageService LangSvc

<PageTitle>@L.Get(Str.SettingsTitle)</PageTitle>

<h1>@L.Get(Str.SettingsTitle)</h1>

<div class="mb-3">
    <label class="form-label">@L.Get(Str.SettingsLanguage)</label>
    <select class="form-select" @bind="language" @bind:after="ApplyLanguage">
        <option value="system">@L.Get(Str.SettingsLanguageSystem)</option>
        <option value="en">English</option>
        <option value="it">Italiano</option>
        <option value="fr">Français</option>
        <option value="es">Español</option>
        <option value="de">Deutsch</option>
        <option value="ja">日本語</option>
        <option value="pt">Português (Brasil)</option>
        <option value="ro">Română</option>
        <option value="ru">Русский</option>
        <option value="zh">简体中文</option>
    </select>
</div>

<div class="mb-3">
    <label class="form-label">@L.Get(Str.SettingsSyncMode)</label>
    <select class="form-select" @bind="mode">
        <option value="@Core.Sync.SyncMode.Auto">@L.Get(Str.SettingsModeAuto)</option>
        <option value="@Core.Sync.SyncMode.Manual">@L.Get(Str.SettingsModeManual)</option>
    </select>
</div>

@* Troubleshooting only: the log is not something the user reads, so it stays
   folded behind one button and has no page of its own in the menu. *@
<div class="mb-3">
    <label class="form-label">@L.Get(Str.NavLogs)</label>
    <div class="form-text">@L.Get(Str.SettingsLogsHint)</div>
    <button type="button" id="km-logs-toggle" class="btn btn-secondary btn-sm"
            aria-expanded="@logsOpen.ToString().ToLowerInvariant()" aria-controls="km-logs-panel"
            @onclick="ToggleLogs">
        @L.Get(logsOpen ? Str.LogsHide : Str.LogsShow)
    </button>
</div>

@if (logsOpen)
{
    <div id="km-logs-panel" class="mb-3">
        <label class="form-label" for="km-log-verbosity">@L.Get(Str.SettingsLogVerbosity)</label>
        <select id="km-log-verbosity" class="form-select" @bind="verbosity" @bind:after="ApplyVerbosity">
            <option value="@Core.Logging.XbsLogLevel.Error">@L.Get(Str.LogLevelError)</option>
            <option value="@Core.Logging.XbsLogLevel.Warning">@L.Get(Str.LogLevelWarning)</option>
            <option value="@Core.Logging.XbsLogLevel.Info">@L.Get(Str.LogLevelInfo)</option>
            <option value="@Core.Logging.XbsLogLevel.Debug">@L.Get(Str.LogLevelDebug)</option>
            <option value="@Core.Logging.XbsLogLevel.Verbose">@L.Get(Str.LogLevelVerbose)</option>
        </select>
        <div class="form-text">@L.Get(Str.SettingsVerbosityHint)</div>
        <LogsPanel />
    </div>
}

<div class="mb-3">
    <label class="form-label">@L.Get(Str.SettingsTheme)</label>
    <select class="form-select" @bind="theme">
        <option value="System">@L.Get(Str.SettingsThemeSystem)</option>
        <option value="Light">@L.Get(Str.SettingsThemeLight)</option>
        <option value="Dark">@L.Get(Str.SettingsThemeDark)</option>
    </select>
</div>

<div class="mb-3">
    <label class="form-label">@L.Get(Str.SettingsHome)</label>
    <div class="form-check form-switch">
        <input class="form-check-input" type="checkbox" role="switch" id="km-show-recent" @bind="showRecent" />
        <label class="form-check-label" for="km-show-recent">@L.Get(Str.SettingsShowRecent)</label>
    </div>
    <div class="form-text">@L.Get(Str.SettingsShowRecentHint)</div>
</div>

@if (showRecent)
{
    <div class="mb-3">
        <label class="form-label" for="km-recent-count">@L.Get(Str.SettingsRecentCount)</label>
        <select id="km-recent-count" class="form-select" @bind="recentCount">
            <option value="5">5</option>
            <option value="10">10</option>
            <option value="20">20</option>
        </select>
    </div>
}

<div class="mb-3">
    <label class="form-label">@L.Get(Str.SettingsSecurity)</label>
    <a class="xbs-setting-link" href="settings/security">
        <span>
            <strong>@L.Get(Str.SettingsAppLock)</strong>
            <small class="text-muted d-block">@LockSummary</small>
        </span>
        <span aria-hidden="true">›</span>
    </a>
</div>

<button class="btn btn-primary" @onclick="Save">@L.Get(Str.CommonSave)</button>

@code {
    private Core.Sync.SyncMode mode;
    private Core.Logging.XbsLogLevel verbosity;
    private string theme = "System";
    private string language = "system";
    private bool showRecent = true;
    private int recentCount = 5;
    /// <summary>The log panel is closed by default: it is troubleshooting
    /// material, opened on purpose.</summary>
    private bool logsOpen;

    protected override void OnInitialized()
    {
        mode = AppSettings.Mode;
        verbosity = AppSettings.Verbosity;
        theme = AppSettings.Theme;
        language = AppSettings.Language;
        showRecent = AppSettings.ShowRecent;
        recentCount = AppSettings.RecentCount;
        if (carry is { } c)
        {
            // Language change rebuilt the tree: put back the unsaved edits.
            (mode, theme, showRecent, recentCount) = c;
            carry = null;
        }
    }

    /// <summary>Verbosity applies instantly (no Save needed): later entries
    /// are recorded at the new level right away.</summary>
    private void ApplyVerbosity()
    {
        AppSettings.Verbosity = verbosity;
        Session.NotifySettingsChanged();
    }

    /// <summary>The language applies at once: Apply() sets the culture and the
    /// layout redraws its whole tree (no restart, no page reload).</summary>
    private static (Core.Sync.SyncMode, string, bool, int)? carry;

    private void ToggleLogs() => logsOpen = !logsOpen;

    private void ApplyLanguage()
    {
        carry = (mode, theme, showRecent, recentCount);
        AppSettings.Language = language is "en" or "it" or "fr" or "es" or "de" or "ja" or "pt" or "ro" or "ru" or "zh" ? language : "system";
        LangSvc.Apply();
    }

    private async Task Save()
    {
        AppSettings.Mode = mode;
        AppSettings.Verbosity = verbosity;
        AppSettings.Theme = theme is "Light" or "Dark" ? theme : "System";
        theme = AppSettings.Theme;
        AppSettings.ShowRecent = showRecent;
        AppSettings.RecentCount = recentCount;
        Session.NotifySettingsChanged();
        try { await JS.InvokeVoidAsync("xbsSetTheme", theme); } catch { }
        try { StatusBar.ApplyTheme(theme); } catch { }
        _ = Toast.ShowAsync(L.Get(Str.SettingsSaved));
    }

    private string LockSummary => AppSettings.AppLock switch
    {
        "PinOnly" => L.Get(Str.SettingsLockPinOnly, Keepmark.Core.Security.LockPolicy.Label(AppSettings.LockTimeoutMinutes)),
        "BiometricAndPin" => L.Get(Str.SettingsLockBiometricPin, Keepmark.Core.Security.LockPolicy.Label(AppSettings.LockTimeoutMinutes)),
        _ => L.Get(Str.SettingsLockOff),
    };
}
