@page "/settings"
@using Keepmark.Core.Workflow
@inject KeepmarkMobile.Services.XbsSession Session
@inject KeepmarkMobile.Services.XbsSettings AppSettings
@inject KeepmarkMobile.Services.SecureCredentialStore Creds
@inject KeepmarkMobile.Services.IStatusBarService StatusBar
@inject Microsoft.JSInterop.IJSRuntime JS
@inject KeepmarkMobile.Services.ToastState Toast
@inject KeepmarkMobile.Services.LanguageService LangSvc
@inject NavigationManager Nav

<PageTitle>@L.Get(Str.SettingsTitle)</PageTitle>

<h1>@L.Get(Str.SettingsTitle)</h1>

<div class="mb-3">
    <label class="form-label">@L.Get(Str.SettingsLanguage)</label>
    <select class="form-select" @bind="language" @bind:after="ApplyLanguage">
        <option value="system">@L.Get(Str.SettingsLanguageSystem)</option>
        <option value="en">English</option>
        <option value="it">Italiano</option>
        <option value="fr">Français</option>
        <option value="es">Español</option>
        <option value="de">Deutsch</option>
    </select>
</div>

<div class="mb-3">
    <label class="form-label">@L.Get(Str.SettingsSyncMode)</label>
    <select class="form-select" @bind="mode">
        <option value="@Core.Sync.SyncMode.Auto">@L.Get(Str.SettingsModeAuto)</option>
        <option value="@Core.Sync.SyncMode.Manual">@L.Get(Str.SettingsModeManual)</option>
    </select>
</div>

<div class="mb-3">
    <label class="form-label">@L.Get(Str.SettingsLinkedService)</label>
    <p class="form-control-plaintext"><strong>@(linkedUrl ?? L.Get(Str.SettingsNotLinked))</strong></p>
    <small class="text-muted">@L.Get(Str.SettingsMoveHintA) <a href="switch-service">@L.Get(Str.NavMoveService)</a> @L.Get(Str.SettingsMoveHintB)</small>
</div>

<div class="mb-3">
    <label class="form-label">@L.Get(Str.SettingsLogVerbosity)</label>
    <select class="form-select" @bind="verbosity" @bind:after="ApplyVerbosity">
        <option value="@Core.Logging.XbsLogLevel.Error">@L.Get(Str.LogLevelError)</option>
        <option value="@Core.Logging.XbsLogLevel.Warning">@L.Get(Str.LogLevelWarning)</option>
        <option value="@Core.Logging.XbsLogLevel.Info">@L.Get(Str.LogLevelInfo)</option>
        <option value="@Core.Logging.XbsLogLevel.Debug">@L.Get(Str.LogLevelDebug)</option>
        <option value="@Core.Logging.XbsLogLevel.Verbose">@L.Get(Str.LogLevelVerbose)</option>
    </select>
    <div class="form-text">@L.Get(Str.SettingsVerbosityHint)</div>
</div>

<div class="mb-3">
    <label class="form-label">@L.Get(Str.SettingsTheme)</label>
    <select class="form-select" @bind="theme">
        <option value="System">@L.Get(Str.SettingsThemeSystem)</option>
        <option value="Light">@L.Get(Str.SettingsThemeLight)</option>
        <option value="Dark">@L.Get(Str.SettingsThemeDark)</option>
    </select>
</div>

<div class="mb-3">
    <label class="form-label">@L.Get(Str.SettingsSecurity)</label>
    <a class="xbs-setting-link" href="settings/security">
        <span>
            <strong>@L.Get(Str.SettingsAppLock)</strong>
            <small class="text-muted d-block">@LockSummary</small>
        </span>
        <span aria-hidden="true">›</span>
    </a>
</div>

<button class="btn btn-primary" @onclick="Save">@L.Get(Str.CommonSave)</button>

@if (linkedUrl is not null)
{
    <h3 class="mt-4">@L.Get(Str.SettingsChangePassword)</h3>
    <p class="text-muted">@L.Get(Str.SettingsChangePasswordHint)</p>
    <div class="mb-3">
        <label class="form-label">@L.Get(Str.CommonCurrentPassword)</label>
        <input type="password" class="form-control" @bind="pwCurrent" disabled="@(armedPw || pwBusy)" autocomplete="current-password" />
    </div>
    <div class="mb-3">
        <label class="form-label">@L.Get(Str.CommonNewPassword)</label>
        <input type="password" class="form-control" @bind="pwNew" disabled="@(armedPw || pwBusy)" autocomplete="new-password" />
    </div>
    <div class="mb-3">
        <label class="form-label">@L.Get(Str.CommonConfirmNewPassword)</label>
        <input type="password" class="form-control" @bind="pwConfirm" disabled="@(armedPw || pwBusy)" autocomplete="new-password" />
    </div>
    <button class="btn btn-warning" @onclick="ArmChangePassword" disabled="@(pwBusy || armedPw)">@L.Get(Str.SettingsChangePasswordBtn)</button>
    @if (armedPw)
    {
        <ConfirmBlock Message="@L.Get(Str.SettingsChangePasswordMessage)" Implication="@WorkflowTexts.ChangePasswordImplication"
                      ConfirmLabel="@L.Get(Str.CommonYesChangePassword)" Busy="pwBusy" OnConfirm="ChangePassword" OnCancel="() => armedPw = false" />
    }
    @if (!string.IsNullOrEmpty(pwError))
    {
        <div class="alert alert-danger mt-2" role="alert">@pwError</div>
    }
    @if (pwDone)
    {
        <div class="alert alert-success mt-2" role="status">@WorkflowTexts.ChangePasswordDone</div>
    }
}

<h3 class="mt-4">@L.Get(Str.SettingsGestures)</h3>
<ul>
    <li><strong>@L.Get(Str.SettingsGestureTapBold)</strong> @L.Get(Str.SettingsGestureTapRest)</li>
    <li><strong>@L.Get(Str.SettingsGestureSwipeRightBold)</strong> @L.Get(Str.SettingsGestureSwipeRightRest) <strong>@L.Get(Str.SettingsGestureSwipeLeftBold)</strong> @L.Get(Str.SettingsGestureSwipeLeftRest)</li>
    <li><strong>@L.Get(Str.SettingsGestureMenuBold)</strong> @L.Get(Str.SettingsGestureMenuRest)</li>
</ul>

@code {
    private Core.Sync.SyncMode mode;
    private Core.Logging.XbsLogLevel verbosity;
    private string theme = "System";
    private string language = "system";
    private string? linkedUrl;
    private string pwCurrent = string.Empty;
    private string pwNew = string.Empty;
    private string pwConfirm = string.Empty;
    private string pwError = string.Empty;
    private bool pwDone;
    private bool pwBusy;
    private bool armedPw;

    protected override void OnInitialized()
    {
        mode = AppSettings.Mode;
        verbosity = AppSettings.Verbosity;
        theme = AppSettings.Theme;
        language = AppSettings.Language;
    }

    protected override async Task OnInitializedAsync()
    {
        var c = await Creds.GetAsync();
        linkedUrl = c?.ServiceUrl;
    }

    /// <summary>Verbosity applies instantly (no Save needed): later entries
    /// are recorded at the new level right away.</summary>
    private void ApplyVerbosity()
    {
        AppSettings.Verbosity = verbosity;
        Session.NotifySettingsChanged();
    }

    /// <summary>The language applies at once: culture first, then a full
    /// reload so every already-rendered text is drawn again.</summary>
    private void ApplyLanguage()
    {
        AppSettings.Language = language is "en" or "it" or "fr" or "es" or "de" ? language : "system";
        LangSvc.Apply();
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    private async Task Save()
    {
        AppSettings.Mode = mode;
        AppSettings.Verbosity = verbosity;
        AppSettings.Theme = theme is "Light" or "Dark" ? theme : "System";
        theme = AppSettings.Theme;
        Session.NotifySettingsChanged();
        try { await JS.InvokeVoidAsync("xbsSetTheme", theme); } catch { }
        try { StatusBar.ApplyTheme(theme); } catch { }
        _ = Toast.ShowAsync(L.Get(Str.SettingsSaved));
    }

    private string LockSummary => AppSettings.AppLock switch
    {
        "PinOnly" => L.Get(Str.SettingsLockPinOnly, Keepmark.Core.Security.LockPolicy.Label(AppSettings.LockTimeoutMinutes)),
        "BiometricAndPin" => L.Get(Str.SettingsLockBiometricPin, Keepmark.Core.Security.LockPolicy.Label(AppSettings.LockTimeoutMinutes)),
        _ => L.Get(Str.SettingsLockOff),
    };

    private string? ValidatePasswordChange(string current, string next, string confirm)
    {
        if (string.IsNullOrEmpty(current))
        {
            return L.Get(Str.ValCurrentPasswordRequired);
        }

        if (string.IsNullOrEmpty(next))
        {
            return L.Get(Str.ValNewPasswordRequired);
        }

        if (next == current)
        {
            return L.Get(Str.ValNewMustDiffer);
        }

        if (next.Length < Keepmark.Core.Crypto.BackupGuard.MinPasswordLength)
        {
            return WorkflowRules.PasswordTooShort;
        }

        if (next != confirm)
        {
            return L.Get(Str.ValNewMismatch);
        }

        return null;
    }

    /// <summary>Validate first: the confirmation opens only for a change
    /// that can run (fields are locked while it is open).</summary>
    private void ArmChangePassword()
    {
        pwError = string.Empty;
        pwDone = false;
        var invalid = ValidatePasswordChange(pwCurrent, pwNew, pwConfirm);
        if (invalid is not null)
        {
            pwError = invalid;
            return;
        }

        armedPw = true;
    }

    private async Task ChangePassword()
    {
        pwError = string.Empty;
        pwDone = false;

        pwBusy = true;
        try
        {
            await Session.ChangePasswordAsync(pwCurrent, pwNew);
            pwCurrent = pwNew = pwConfirm = string.Empty;
            armedPw = false;
            pwDone = true;
        }
        catch (Exception ex)
        {
            // Never leave the current password or its confirmation in memory;
            // the new password stays so only the proof has to be retyped.
            // Disarm so the fields are editable again.
            pwCurrent = pwConfirm = string.Empty;
            armedPw = false;
            pwError = ex.Message;
        }
        finally
        {
            pwBusy = false;
        }
    }
}
