@inherits KeepmarkMobile.Components.SessionComponentBase
@page "/backup"
@inject KeepmarkMobile.Services.XbsSession Session
@inject KeepmarkMobile.Services.SecureCredentialStore Creds
@inject KeepmarkMobile.Services.ToastState Toast
@using Keepmark.Core.Safety
@using Keepmark.Core.Workflow

<PageTitle>@L.Get(Str.NavBackup)</PageTitle>

<h1>@L.Get(Str.NavBackup)</h1>

@if (!Session.Ready)
{
    <p role="status"><em>@L.Get(Str.BackupStarting)</em></p>
}
else
{
    <div class="mb-3">
        <h4>@L.Get(Str.BackupExportH)</h4>
        <p class="text-muted">@Loc.Plural(Str.BackupExportIntro, localCount) @WorkflowTexts.BackupPasswordHint</p>
        <label class="form-label">@L.Get(Str.BackupPassword)</label>
        <input type="password" class="form-control" @bind="bkpPassword" autocomplete="new-password" />
        <label class="form-label mt-2">@L.Get(Str.BackupConfirmPassword)</label>
        <input type="password" class="form-control" @bind="bkpConfirm" autocomplete="new-password" />
        <button class="btn btn-outline-primary mt-2" @onclick="ExportBackup" disabled="@busy">@L.Get(Str.BackupExportBtn)</button>
        <StepMessage Text="@bkpMessage" Error="bkpError" />
    </div>

    <div class="mb-3">
        <h4>@L.Get(Str.BackupRestoreH)</h4>
        <button class="btn btn-outline-secondary" @onclick="PickBackup" disabled="@busy">@L.Get(Str.BackupChooseFile)</button>
        @if (impPath is not null)
        {
            <p class="mt-2 mb-1">@L.Get(Str.BackupFileLabel) <strong>@impFileName</strong></p>
            @if (impCount is null)
            {
                <label class="form-label">@L.Get(Str.BackupFilePassword)</label>
                <input type="password" class="form-control" @bind="impPassword" autocomplete="off" />
                <button class="btn btn-primary mt-2" @onclick="PreviewImport" disabled="@busy">@L.Get(Str.BackupCheckBtn)</button>
            }
            else
            {
                <p class="text-muted mb-1">@WorkflowTexts.ImportChecked(impFileName ?? L.Get(Str.BackupFallbackName), impCount.Value)</p>
                <p>@L.Get(Str.BackupReplaceMessage, localCount, impCount)</p>
                <p class="text-muted">@WorkflowTexts.ImportImplication(linked)</p>
                <button class="btn btn-danger mt-1" @onclick="ExecuteImport" disabled="@busy">@L.Get(Str.BackupRestoreBtn)</button>
            }
        }
        <StepMessage Text="@impMessage" Error="impError" />
    </div>

    <div class="mb-3">
        <h4>@L.Get(Str.BackupSafetyH)</h4>
        <p class="text-muted">@L.Get(Str.BackupSafetyIntro)</p>
        <button class="btn btn-outline-secondary mb-2" @onclick="RefreshSafety" disabled="@busy">@L.Get(Str.BackupRefreshList)</button>
        <StepMessage Text="@safetyMessage" Error="safetyError" />
        @if (safetyList.Count == 0)
        {
            <p class="text-muted">@L.Get(Str.BackupNoSafety)</p>
        }
        @foreach (var sb in safetyList)
        {
            <div class="card mb-2">
                <div class="card-body py-2">
                    <div><strong>@SafetyBackupFiles.Describe(sb)</strong></div>
                    <div class="form-text">@sb.FileName · @WorkflowRules.FormatBytes(sb.SizeBytes)
                        @if (sb.SyncId is not null)
                        {
                            <text> · @L.Get(Str.BackupSyncWord) <code>@sb.SyncId</code></text>
                        }
                    </div>
                    @if (armedRestore == sb.FileName)
                    {
                        <ConfirmBlock Message="@L.Get(Str.BackupRestoreMessage)"
                                      Implication="@WorkflowTexts.SafetyRestoreImplication(sb.Side, sb.Items)"
                                      ConfirmLabel="@L.Get(Str.CommonYesRestore)" Busy="busy"
                                      OnConfirm="ExecuteSafetyRestore" OnCancel="() => armedRestore = null" />
                    }
                    else if (armedDelete == sb.FileName)
                    {
                        <ConfirmBlock Message="@L.Get(Str.BackupDeleteMessage)"
                                      Implication="@WorkflowTexts.SafetyDeleteImplication"
                                      ConfirmLabel="@L.Get(Str.CommonYesDelete)" Busy="busy"
                                      OnConfirm="ExecuteSafetyDelete" OnCancel="() => armedDelete = null" />
                    }
                    else
                    {
                        <div class="mt-2 d-flex gap-2">
                            <button class="btn btn-outline-primary" @onclick="() => { armedRestore = sb.FileName; armedDelete = null; }" disabled="@busy">@L.Get(Str.BackupRestoreBtn)</button>
                            <button class="btn btn-outline-danger" @onclick="() => { armedDelete = sb.FileName; armedRestore = null; }" disabled="@busy">@L.Get(Str.CommonDelete)</button>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="mb-3">
        <h4>@L.Get(Str.BackupRemovedH)</h4>
        <p class="text-muted">@L.Get(Str.BackupRemovedIntro)</p>
        <button class="btn btn-outline-secondary mb-2" @onclick="RefreshRemoved" disabled="@busy">@L.Get(Str.BackupRefreshList)</button>
        <StepMessage Text="@removedMessage" Error="removedError" />
        @if (removedList.Count == 0)
        {
            <p class="text-muted">@L.Get(Str.BackupRemovedEmpty)</p>
        }
        @foreach (var rc in removedList)
        {
            <div class="card mb-2" @key="rc.FileName">
                <div class="card-body py-2">
                    <div><strong>@RemovedSyncCopies.Describe(rc)</strong></div>
                    <div class="form-text">@rc.FileName</div>
                    @if (armedRemovedRestore == rc.FileName)
                    {
                        <ConfirmBlock Message="@L.Get(Str.BackupRemovedRestoreMessage)"
                                      Implication="@L.Get(Str.BackupRemovedRestoreImplication)"
                                      ConfirmLabel="@L.Get(Str.CommonYesRestore)" Busy="busy"
                                      OnConfirm="ExecuteRemovedRestore" OnCancel="() => armedRemovedRestore = null" />
                    }
                    else if (armedRemovedDelete == rc.FileName)
                    {
                        <ConfirmBlock Message="@L.Get(Str.BackupRemovedDeleteMessage)"
                                      Implication="@L.Get(Str.BackupRemovedDeleteImplication)"
                                      ConfirmLabel="@L.Get(Str.CommonYesDelete)" Busy="busy"
                                      OnConfirm="ExecuteRemovedDelete" OnCancel="() => armedRemovedDelete = null" />
                    }
                    else
                    {
                        <div class="mt-2 d-flex gap-2">
                            <button class="btn btn-outline-primary" @onclick="() => { armedRemovedRestore = rc.FileName; armedRemovedDelete = null; }" disabled="@busy">@L.Get(Str.BackupRestoreBtn)</button>
                            <button class="btn btn-outline-danger" @onclick="() => { armedRemovedDelete = rc.FileName; armedRemovedRestore = null; }" disabled="@busy">@L.Get(Str.CommonDelete)</button>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private int localCount;
    private bool linked;
    private bool busy;
    private string bkpPassword = string.Empty;
    private string bkpConfirm = string.Empty;
    private string bkpMessage = string.Empty;
    private bool bkpError;
    private string impMessage = string.Empty;
    private bool impError;
    private string? impPath;
    private string? impFileName;
    private string impPassword = string.Empty;
    private int? impCount;
    private List<SafetyBackupEntry> safetyList = new();
    private string? armedRestore;
    private string? armedDelete;
    private string safetyMessage = string.Empty;
    private bool safetyError;
    private string safetyLoadMessage = string.Empty;
    private List<RemovedSyncCopyInfo> removedList = new();
    private string? armedRemovedRestore;
    private string? armedRemovedDelete;
    private string removedMessage = string.Empty;
    private bool removedError;
    private string removedLoadMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!await WaitForSessionAsync(Session)) return;

        await RefreshCountsAsync();
        await RefreshSafetyListAsync();
        await RefreshRemovedListAsync();
    }

    private async Task RefreshCountsAsync()
    {
        linked = await Creds.GetAsync() is not null;
        if (Session.Store is not null)
        {
            var stats = await Session.Store.GetStatsAsync();
            localCount = stats.Folders + stats.Bookmarks + stats.Separators;
        }
    }

    private async Task RefreshSafetyListAsync()
    {
        try
        {
            safetyList = await Session.ListSafetyBackupsAsync();
            ClearLoadError(ref safetyLoadMessage, ref safetyMessage, ref safetyError);
        }
        catch (Exception ex)
        {
            // Hiding a list is not harmless: it is where the user looks for a
            // recovery point, so a read failure must be named.
            safetyList = new();
            safetyLoadMessage = L.Get(Str.ErrLoadFailed, ex.Message);
            (safetyMessage, safetyError) = (safetyLoadMessage, true);
            Session.Log.Warn("backup", $"Safety list unreadable: {ex.GetType().Name}");
        }
    }

    private async Task RefreshRemovedListAsync()
    {
        try
        {
            removedList = await Session.ListRemovedSyncCopiesAsync();
            ClearLoadError(ref removedLoadMessage, ref removedMessage, ref removedError);
        }
        catch (Exception ex)
        {
            removedList = new();
            removedLoadMessage = L.Get(Str.ErrLoadFailed, ex.Message);
            (removedMessage, removedError) = (removedLoadMessage, true);
            Session.Log.Warn("backup", $"Removed-sync list unreadable: {ex.GetType().Name}");
        }
    }

    /// <summary>Clears a message only when it is the one the refresh itself put
    /// there: an action's outcome must survive a later list refresh.</summary>
    private static void ClearLoadError(ref string loadMessage, ref string message, ref bool error)
    {
        if (loadMessage.Length == 0 || message != loadMessage) return;
        loadMessage = string.Empty;
        (message, error) = (string.Empty, false);
    }

    /// <summary>Export: a new password typed twice. The fields are cleared on
    /// success only, so a failed export can be retried as is.</summary>
    private async Task ExportBackup()
    {
        await RunAsync(async () =>
        {
            WorkflowRules.RequireNewPassword(bkpPassword, bkpConfirm);
            var path = await Session.ExportBackupAsync(bkpPassword);
            bkpPassword = string.Empty;
            bkpConfirm = string.Empty;
            try
            {
                await Share.Default.RequestAsync(new ShareFileRequest(
                    L.Get(Str.BackupSaveTitle), new ShareFile(path)));
                return WorkflowTexts.ExportDone(localCount) + " " + L.Get(Str.BackupChooseWhere);
            }
            catch
            {
                return WorkflowTexts.ExportDone(localCount) + " " + L.Get(Str.BackupSavedInApp);
            }
        }, (text, error) => (bkpMessage, bkpError) = (text, error));
    }

    /// <summary>Step 1: choosing a file always starts the restore over.</summary>
    private async Task PickBackup()
    {
        await RunAsync(async () =>
        {
            var picked = await FilePicker.Default.PickAsync();
            if (picked is null)
            {
                return string.Empty;
            }

            // The picker name is untrusted: strip any path, require JSON.
            var safeName = Path.GetFileName(picked.FileName);
            if (string.IsNullOrWhiteSpace(safeName) || !Core.Crypto.BackupGuard.HasSupportedExtension(safeName))
            {
                throw new InvalidOperationException(L.Get(Str.BackupPickFile));
            }

            // Copy into our cache with a size cap: the picked URI may not be a
            // direct file path, and imports must never OOM the app.
            ForgetImport();
            var tmp = Path.Combine(FileSystem.CacheDirectory,
                $"import-{Guid.NewGuid():N}-{safeName}");
            await using (var src = await picked.OpenReadAsync())
            await using (var dst = File.Create(tmp))
            {
                await CopyCappedAsync(src, dst, Core.Crypto.BackupGuard.MaxBytes);
            }

            impPath = tmp;
            impFileName = safeName;
            return string.Empty;
        }, (text, error) => (impMessage, impError) = (text, error));
    }

    /// <summary>Back to step 1: no file, no password, nothing checked.</summary>
    private void ForgetImport()
    {
        if (impPath is not null)
        {
            try { File.Delete(impPath); } catch { }
            impPath = null;
        }

        impFileName = null;
        impPassword = string.Empty;
        impCount = null;
    }

    private static async Task CopyCappedAsync(Stream src, Stream dst, long maxBytes)
    {
        var buf = new byte[81920];
        long total = 0;
        int read;
        while ((read = await src.ReadAsync(buf).ConfigureAwait(false)) > 0)
        {
            total += read;
            if (total > maxBytes)
            {
                throw new InvalidOperationException(
                    Loc.Get(Str.BackupFileTooLarge, maxBytes / 1024 / 1024));
            }

            await dst.WriteAsync(buf.AsMemory(0, read)).ConfigureAwait(false);
        }
    }

    /// <summary>Step 2: decrypt and count, nothing changes. A wrong password
    /// clears only the password; the file stays chosen.</summary>
    private async Task PreviewImport()
    {
        await RunAsync(async () =>
        {
            if (impPath is null)
            {
                throw new InvalidOperationException(L.Get(Str.BackupChooseFirst));
            }

            if (string.IsNullOrEmpty(impPassword))
            {
                throw new InvalidOperationException(L.Get(Str.BackupEnterPassword));
            }

            try
            {
                impCount = await Session.PreviewBackupAsync(impPath, impPassword);
            }
            catch
            {
                impPassword = string.Empty;
                throw;
            }

            return string.Empty;
        }, (text, error) => (impMessage, impError) = (text, error));
    }

    /// <summary>Step 3 (confirmed). On failure the flow goes back to the
    /// password step with the file kept, never to a half-checked state.</summary>
    private async Task ExecuteImport()
    {
        if (busy) return;
        await RunAsync(async () =>
        {
            if (impPath is null || impCount is null)
            {
                throw new InvalidOperationException(L.Get(Str.BackupCheckFirst));
            }

            int restored;
            try
            {
                restored = await Session.ImportBackupAsync(impPath, impPassword);
            }
            catch
            {
                impPassword = string.Empty;
                impCount = null;
                throw;
            }

            ForgetImport();
            await RefreshCountsAsync();
            await RefreshSafetyListAsync();
            return WorkflowTexts.ImportDone(restored, linked);
        }, (text, error) => (impMessage, impError) = (text, error));
    }

    private async Task RefreshSafety()
    {
        await RunAsync(async () =>
        {
            await RefreshSafetyListAsync();
            return Loc.Plural(Str.BackupSafetyRefreshed, safetyList.Count);
        }, ReportSafetyToast);
    }

    private async Task ExecuteSafetyRestore()
    {
        await RunAsync(async () =>
        {
            if (armedRestore is null)
            {
                throw new InvalidOperationException(L.Get(Str.BackupPickFirst));
            }

            var restored = await Session.RestoreSafetyBackupAsync(armedRestore);
            armedRestore = null;
            await RefreshCountsAsync();
            await RefreshSafetyListAsync();
            return WorkflowTexts.SafetyRestoreDone(restored);
        }, (text, error) => (safetyMessage, safetyError) = (text, error));
        armedRestore = null;
    }

    private async Task ExecuteSafetyDelete()
    {
        await RunAsync(async () =>
        {
            if (armedDelete is null)
            {
                throw new InvalidOperationException(L.Get(Str.BackupPickFirst));
            }

            await Session.DeleteSafetyBackupAsync(armedDelete);
            armedDelete = null;
            await RefreshSafetyListAsync();
            return L.Get(Str.BackupSafetyDeleted);
        }, ReportSafetyToast);
        armedDelete = null;
    }

    /// <summary>Short confirmations with nothing to act on: success fades as a
    /// toast, errors stay inline next to the button.</summary>
    private void ReportSafetyToast(string text, bool error)
    {
        if (!error && !string.IsNullOrEmpty(text))
        {
            (safetyMessage, safetyError) = (string.Empty, false);
            _ = Toast.ShowAsync(text);
            return;
        }

        (safetyMessage, safetyError) = (text, error);
    }

    private async Task RefreshRemoved()
    {
        await RunAsync(async () =>
        {
            await RefreshRemovedListAsync();
            return string.Empty;
        }, ReportRemovedToast);
    }

    private async Task ExecuteRemovedRestore()
    {
        await RunAsync(async () =>
        {
            if (armedRemovedRestore is null)
            {
                throw new InvalidOperationException(L.Get(Str.BackupPickFirst));
            }

            var restored = await Session.RestoreRemovedSyncCopyAsync(armedRemovedRestore);
            armedRemovedRestore = null;
            await RefreshCountsAsync();
            await RefreshSafetyListAsync();
            await RefreshRemovedListAsync();
            return WorkflowTexts.SafetyRestoreDone(restored);
        }, ReportRemovedToast);
        armedRemovedRestore = null;
    }

    private async Task ExecuteRemovedDelete()
    {
        await RunAsync(async () =>
        {
            if (armedRemovedDelete is null)
            {
                throw new InvalidOperationException(L.Get(Str.BackupPickFirst));
            }

            await Session.DeleteRemovedSyncCopyAsync(armedRemovedDelete);
            armedRemovedDelete = null;
            await RefreshRemovedListAsync();
            return L.Get(Str.BackupRemovedDeleted);
        }, ReportRemovedToast);
        armedRemovedDelete = null;
    }

    /// <summary>Copies of removed syncs: a refresh says nothing, so only the
    /// outcome of a restore or a delete is announced.</summary>
    private void ReportRemovedToast(string text, bool error)
    {
        if (!error && !string.IsNullOrEmpty(text))
        {
            (removedMessage, removedError) = (string.Empty, false);
            _ = Toast.ShowAsync(text);
            return;
        }

        (removedMessage, removedError) = (text, error);
    }

    /// <summary>Runs one action and reports into that action's own message
    /// box only: the other sections and their fields are left alone.</summary>
    private async Task RunAsync(Func<Task<string>> action, Action<string, bool> report,
        [System.Runtime.CompilerServices.CallerMemberName] string op = "?")
    {
        busy = true;
        report(string.Empty, false);
        try
        {
            Session.Log.Debug("backup", $"{op}: start");
            report(await action(), false);
            Session.Log.Debug("backup", $"{op}: ok");
        }
        catch (Exception ex)
        {
            report(ex.Message, true);
            Session.Log.Warn("backup", $"{op} failed: {ex.GetType().Name}");
        }
        finally
        {
            busy = false;
        }
    }
}
