@page "/backup"
@inject KeepmarkMobile.Services.XbsSession Session
@inject KeepmarkMobile.Services.SecureCredentialStore Creds
@using Keepmark.Core.Safety
@using Keepmark.Core.Workflow

<PageTitle>Backup</PageTitle>

<h1>Backup</h1>

@if (!Session.Ready)
{
    <p role="status"><em>Starting…</em></p>
}
else
{
    <div class="mb-3">
        <h4>Export</h4>
        <p class="text-muted">Save this device's @localCount item(s) to an encrypted file. Choose a backup password of
            at least 8 characters. @WorkflowTexts.BackupPasswordHint</p>
        <label class="form-label">Backup password</label>
        <input type="password" class="form-control" @bind="bkpPassword" autocomplete="new-password" />
        <label class="form-label mt-2">Confirm backup password</label>
        <input type="password" class="form-control" @bind="bkpConfirm" autocomplete="new-password" />
        <button class="btn btn-outline-primary mt-2" @onclick="ExportBackup" disabled="@busy">Export encrypted backup</button>
        <StepMessage Text="@bkpMessage" Error="bkpError" />
    </div>

    <div class="mb-3">
        <h4>Restore from a backup file</h4>
        <p class="text-muted">@WorkflowTexts.ImportImplication(linked)</p>
        <button class="btn btn-outline-secondary" @onclick="PickBackup" disabled="@busy">Choose backup file…</button>
        @if (impPath is not null)
        {
            <p class="mt-2 mb-1">File: <strong>@impFileName</strong></p>
            @if (impCount is null)
            {
                <label class="form-label">Password of this backup</label>
                <input type="password" class="form-control" @bind="impPassword" autocomplete="off" />
                <button class="btn btn-primary mt-2" @onclick="PreviewImport" disabled="@busy">Check backup</button>
            }
            else
            {
                <p class="text-muted mb-1">@WorkflowTexts.ImportChecked(impFileName ?? "Backup", impCount.Value)</p>
                @if (armedImp)
                {
                    <ConfirmBlock Message="@($"Replace your {localCount} item(s) with the {impCount} from this backup?")"
                                  Implication="@WorkflowTexts.ImportImplication(linked)"
                                  ConfirmLabel="Yes, restore" Busy="busy"
                                  OnConfirm="ExecuteImport" OnCancel="() => armedImp = false" />
                }
                else
                {
                    <button class="btn btn-danger mt-1" @onclick="() => armedImp = true" disabled="@busy">Replace with this backup…</button>
                }
            }
        }
        <StepMessage Text="@impMessage" Error="impError" />
    </div>

    <div class="mb-3">
        <h4>Safety backups</h4>
        <p class="text-muted">Automatic snapshots taken before every overwrite or deletion (encrypted when a sync is linked,
            otherwise plaintext; kept in the app folder).
            Restore one to undo a download, upload, import, password change, move or duplicates cleanup —
            or delete it to free space. Newest first, oldest auto-pruned beyond five.</p>
        <button class="btn btn-outline-secondary mb-2" @onclick="RefreshSafety" disabled="@busy">Refresh list</button>
        <StepMessage Text="@safetyMessage" Error="safetyError" />
        @if (safetyList.Count == 0)
        {
            <p class="text-muted">No safety backups yet.</p>
        }
        @foreach (var sb in safetyList)
        {
            <div class="card mb-2">
                <div class="card-body py-2">
                    <div><strong>@SafetyBackupFiles.Describe(sb)</strong></div>
                    <div class="form-text">@sb.FileName · @WorkflowRules.FormatBytes(sb.SizeBytes)
                        @if (sb.SyncId is not null)
                        {
                            <text> · sync <code>@sb.SyncId</code></text>
                        }
                    </div>
                    @if (armedRestore == sb.FileName)
                    {
                        <ConfirmBlock Message="Restore this safety backup?"
                                      Implication="@WorkflowTexts.SafetyRestoreImplication(sb.Side, sb.Items)"
                                      ConfirmLabel="Yes, restore" Busy="busy"
                                      OnConfirm="ExecuteSafetyRestore" OnCancel="() => armedRestore = null" />
                    }
                    else if (armedDelete == sb.FileName)
                    {
                        <ConfirmBlock Message="Delete this safety backup?"
                                      Implication="@WorkflowTexts.SafetyDeleteImplication"
                                      ConfirmLabel="Yes, delete" Busy="busy"
                                      OnConfirm="ExecuteSafetyDelete" OnCancel="() => armedDelete = null" />
                    }
                    else
                    {
                        <div class="mt-2 d-flex gap-2">
                            <button class="btn btn-outline-primary" @onclick="() => { armedRestore = sb.FileName; armedDelete = null; }" disabled="@busy">Restore…</button>
                            <button class="btn btn-outline-danger" @onclick="() => { armedDelete = sb.FileName; armedRestore = null; }" disabled="@busy">Delete</button>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private int localCount;
    private bool linked;
    private bool busy;
    private string bkpPassword = string.Empty;
    private string bkpConfirm = string.Empty;
    private string bkpMessage = string.Empty;
    private bool bkpError;
    private string impMessage = string.Empty;
    private bool impError;
    private string? impPath;
    private string? impFileName;
    private string impPassword = string.Empty;
    private int? impCount;
    private bool armedImp;
    private List<SafetyBackupEntry> safetyList = new();
    private string? armedRestore;
    private string? armedDelete;
    private string safetyMessage = string.Empty;
    private bool safetyError;

    protected override async Task OnInitializedAsync()
    {
        for (int i = 0; i < 100 && !Session.Ready; i++)
        {
            await Task.Delay(100);
        }

        await RefreshCountsAsync();
        await RefreshSafetyListAsync();
    }

    private async Task RefreshCountsAsync()
    {
        linked = await Creds.GetAsync() is not null;
        if (Session.Store is not null)
        {
            var stats = await Session.Store.GetStatsAsync();
            localCount = stats.Folders + stats.Bookmarks + stats.Separators;
        }
    }

    private async Task RefreshSafetyListAsync()
    {
        try
        {
            safetyList = await Session.ListSafetyBackupsAsync();
        }
        catch
        {
            safetyList = new();
        }
    }

    /// <summary>Export: a new password typed twice. The fields are cleared on
    /// success only, so a failed export can be retried as is.</summary>
    private async Task ExportBackup()
    {
        await RunAsync(async () =>
        {
            WorkflowRules.RequireNewPassword(bkpPassword, bkpConfirm);
            var path = await Session.ExportBackupAsync(bkpPassword);
            bkpPassword = string.Empty;
            bkpConfirm = string.Empty;
            try
            {
                await Share.Default.RequestAsync(new ShareFileRequest(
                    "Save encrypted backup", new ShareFile(path)));
                return WorkflowTexts.ExportDone(localCount) + " Choose where to keep the file.";
            }
            catch
            {
                return WorkflowTexts.ExportDone(localCount) + " It is saved in the app folder; share it from there when needed.";
            }
        }, (text, error) => (bkpMessage, bkpError) = (text, error));
    }

    /// <summary>Step 1: choosing a file always starts the restore over.</summary>
    private async Task PickBackup()
    {
        await RunAsync(async () =>
        {
            var picked = await FilePicker.Default.PickAsync();
            if (picked is null)
            {
                return string.Empty;
            }

            // The picker name is untrusted: strip any path, require JSON.
            var safeName = Path.GetFileName(picked.FileName);
            if (string.IsNullOrWhiteSpace(safeName) || !Core.Crypto.BackupGuard.HasSupportedExtension(safeName))
            {
                throw new InvalidOperationException("Pick a backup file (.xbs.json).");
            }

            // Copy into our cache with a size cap: the picked URI may not be a
            // direct file path, and imports must never OOM the app.
            ForgetImport();
            var tmp = Path.Combine(FileSystem.CacheDirectory,
                $"import-{Guid.NewGuid():N}-{safeName}");
            await using (var src = await picked.OpenReadAsync())
            await using (var dst = File.Create(tmp))
            {
                await CopyCappedAsync(src, dst, Core.Crypto.BackupGuard.MaxBytes);
            }

            impPath = tmp;
            impFileName = safeName;
            return string.Empty;
        }, (text, error) => (impMessage, impError) = (text, error));
    }

    /// <summary>Back to step 1: no file, no password, nothing checked.</summary>
    private void ForgetImport()
    {
        if (impPath is not null)
        {
            try { File.Delete(impPath); } catch { }
            impPath = null;
        }

        impFileName = null;
        impPassword = string.Empty;
        impCount = null;
        armedImp = false;
    }

    private static async Task CopyCappedAsync(Stream src, Stream dst, long maxBytes)
    {
        var buf = new byte[81920];
        long total = 0;
        int read;
        while ((read = await src.ReadAsync(buf).ConfigureAwait(false)) > 0)
        {
            total += read;
            if (total > maxBytes)
            {
                throw new InvalidOperationException(
                    $"File is too large (over {maxBytes / 1024 / 1024} MB).");
            }

            await dst.WriteAsync(buf.AsMemory(0, read)).ConfigureAwait(false);
        }
    }

    /// <summary>Step 2: decrypt and count, nothing changes. A wrong password
    /// clears only the password; the file stays chosen.</summary>
    private async Task PreviewImport()
    {
        await RunAsync(async () =>
        {
            if (impPath is null)
            {
                throw new InvalidOperationException("Choose the backup file first.");
            }

            if (string.IsNullOrEmpty(impPassword))
            {
                throw new InvalidOperationException("Enter the password of this backup.");
            }

            try
            {
                impCount = await Session.PreviewBackupAsync(impPath, impPassword);
            }
            catch
            {
                impPassword = string.Empty;
                throw;
            }

            armedImp = false;
            return string.Empty;
        }, (text, error) => (impMessage, impError) = (text, error));
    }

    /// <summary>Step 3 (confirmed). On failure the flow goes back to the
    /// password step with the file kept, never to a half-checked state.</summary>
    private async Task ExecuteImport()
    {
        await RunAsync(async () =>
        {
            if (impPath is null || impCount is null)
            {
                throw new InvalidOperationException("Check the backup first.");
            }

            int restored;
            try
            {
                restored = await Session.ImportBackupAsync(impPath, impPassword);
            }
            catch
            {
                impPassword = string.Empty;
                impCount = null;
                armedImp = false;
                throw;
            }

            ForgetImport();
            await RefreshCountsAsync();
            await RefreshSafetyListAsync();
            return WorkflowTexts.ImportDone(restored, linked);
        }, (text, error) => (impMessage, impError) = (text, error));
    }

    private async Task RefreshSafety()
    {
        await RunAsync(async () =>
        {
            await RefreshSafetyListAsync();
            return $"Safety list refreshed ({safetyList.Count} backup(s)).";
        }, (text, error) => (safetyMessage, safetyError) = (text, error));
    }

    private async Task ExecuteSafetyRestore()
    {
        await RunAsync(async () =>
        {
            if (armedRestore is null)
            {
                throw new InvalidOperationException("Pick a backup first.");
            }

            var restored = await Session.RestoreSafetyBackupAsync(armedRestore);
            armedRestore = null;
            await RefreshCountsAsync();
            await RefreshSafetyListAsync();
            return WorkflowTexts.SafetyRestoreDone(restored);
        }, (text, error) => (safetyMessage, safetyError) = (text, error));
        armedRestore = null;
    }

    private async Task ExecuteSafetyDelete()
    {
        await RunAsync(async () =>
        {
            if (armedDelete is null)
            {
                throw new InvalidOperationException("Pick a backup first.");
            }

            await Session.DeleteSafetyBackupAsync(armedDelete);
            armedDelete = null;
            await RefreshSafetyListAsync();
            return "Safety backup deleted.";
        }, (text, error) => (safetyMessage, safetyError) = (text, error));
        armedDelete = null;
    }

    /// <summary>Runs one action and reports into that action's own message
    /// box only: the other sections and their fields are left alone.</summary>
    private async Task RunAsync(Func<Task<string>> action, Action<string, bool> report,
        [System.Runtime.CompilerServices.CallerMemberName] string op = "?")
    {
        busy = true;
        report(string.Empty, false);
        try
        {
            Session.Log.Debug("backup", $"{op}: start");
            report(await action(), false);
            Session.Log.Debug("backup", $"{op}: ok");
        }
        catch (Exception ex)
        {
            report(ex.Message, true);
            Session.Log.Warn("backup", $"{op} failed: {ex.GetType().Name}");
        }
        finally
        {
            busy = false;
        }
    }
}
