@page "/backup"
@inject KeepmarkMobile.Services.XbsSession Session
@inject KeepmarkMobile.Services.ToastState Toast
@using Keepmark.Core.Safety

<PageTitle>Backup</PageTitle>

<h1>Backup</h1>

@if (!Session.Ready)
{
    <p role="status"><em>Starting…</em></p>
}
else
{
    <p class="text-muted">Save your local bookmarks to an encrypted file (password of your choice), or restore from one. The file opens only with that password.</p>

    <div class="mb-3">
        <h4>Export</h4>
        <label class="form-label">Backup password</label>
        <input type="password" class="form-control" @bind="bkpPassword" autocomplete="new-password" />
        <label class="form-label mt-2">Confirm password</label>
        <input type="password" class="form-control" @bind="bkpConfirm" autocomplete="new-password" />
        <div class="form-text">Encrypts your current @localCount local item(s). Keep the password: without it the file is unreadable.</div>
        <button class="btn btn-outline-primary mt-2" @onclick="ExportBackup" disabled="@busy">Export encrypted backup</button>
        @if (!string.IsNullOrEmpty(bkpMessage))
        {
            <div class="alert mt-2 @(bkpError ? "alert-danger" : "alert-success")" role="@(bkpError ? "alert" : "status")">@bkpMessage</div>
        }
    </div>

    <div class="mb-3">
        <h4>Import</h4>
        <button class="btn btn-outline-secondary" @onclick="PickBackup" disabled="@busy">Choose backup file…</button>
        @if (impPath is not null)
        {
            <p class="mt-2 mb-1">File: <strong>@impFileName</strong></p>
            @if (impCount is null)
            {
                <label class="form-label">Backup password</label>
                <input type="password" class="form-control" @bind="impPassword" autocomplete="current-password" />
                <div class="form-text">Reading the file verifies the password first — a wrong password stops here.</div>
                <div class="mt-2 d-flex gap-2">
                    <button class="btn btn-secondary" @onclick="PreviewImport" disabled="@busy">Read backup</button>
                </div>
            }
            else
            {
                @* Read with this password: restore uses the same one, so it is no longer editable. *@
                <p class="text-muted mb-1">Password verified. Choose the file again to use a different backup or password.</p>
            }
            @if (impCount is not null)
            {
                @if (!armedImp)
                {
                    <div class="alert alert-warning mt-2">
                        Backup holds <strong>@impCount</strong> item(s); your local tree has <strong>@localCount</strong>.
                        <div class="mt-2">
                            <button class="btn btn-danger" @onclick='() => armedImp = true' disabled="@busy">Replace local with backup…</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-danger mt-2">
                        <strong>Replace your @localCount local item(s) with the @impCount from backup?</strong>
                        A safety backup of the current local tree is saved first; the restored tree syncs up right after.
                        <div class="mt-2 d-flex gap-2">
                            <button class="btn btn-danger" @onclick="ExecuteImport" disabled="@busy">Yes, restore</button>
                            <button class="btn btn-secondary" @onclick="() => armedImp = false" disabled="@busy">Cancel</button>
                        </div>
                    </div>
                }
            }
        }
        @if (!string.IsNullOrEmpty(impMessage))
        {
            <div class="alert mt-2 @(impError ? "alert-danger" : "alert-success")" role="@(impError ? "alert" : "status")">@impMessage</div>
        }
    </div>

    <div class="mb-3">
        <h4>Safety backups</h4>
        <p class="text-muted">Automatic snapshots taken before every overwrite or deletion (encrypted when a sync is linked,
            otherwise plaintext; kept in the app folder).
            Restore one to undo a download, upload, import, password change, move or duplicates cleanup —
            or delete it to free space. Newest first, oldest auto-pruned beyond five.</p>
        <button class="btn btn-outline-secondary mb-2" @onclick="RefreshSafety" disabled="@busy">Refresh list</button>
        @if (!string.IsNullOrEmpty(safetyMessage))
        {
            <div class="alert mt-2 @(safetyError ? "alert-danger" : "alert-success")" role="@(safetyError ? "alert" : "status")">@safetyMessage</div>
        }
        @if (safetyList.Count == 0)
        {
            <p class="text-muted">No safety backups yet.</p>
        }
        @foreach (var sb in safetyList)
        {
            <div class="card mb-2">
                <div class="card-body py-2">
                    <div><strong>@SafetyBackupFiles.Describe(sb)</strong></div>
                    <div class="form-text">@sb.FileName · @FormatBytes(sb.SizeBytes)
                        @if (sb.SyncId is not null)
                        {
                            <text> · sync <code>@sb.SyncId</code></text>
                        }
                    </div>
                    @if (armedRestore == sb.FileName)
                    {
                        <div class="alert alert-danger mt-2 mb-2">
                            @if (sb.Side == "local")
                            {
                                <text><strong>Replace your @localCount local item(s) with this backup (@sb.Items items)?</strong>
                                A pre-restore backup of the current tree is saved first; the restored tree syncs up after.</text>
                            }
                            else
                            {
                                <text><strong>Upload this backup (@sb.Items items) onto the currently linked sync?</strong>
                                A pre-restore backup of the server copy is saved first. Refused when unlinked.</text>
                            }
                            <div class="mt-2 d-flex gap-2">
                                <button class="btn btn-danger" @onclick="ExecuteSafetyRestore" disabled="@busy">Yes, restore</button>
                                <button class="btn btn-secondary" @onclick="() => armedRestore = null" disabled="@busy">Cancel</button>
                            </div>
                        </div>
                    }
                    else if (armedDelete == sb.FileName)
                    {
                        <div class="alert alert-warning mt-2 mb-2">
                            <strong>Delete this safety backup?</strong> There is no undo for this.
                            <div class="mt-2 d-flex gap-2">
                                <button class="btn btn-danger" @onclick="ExecuteSafetyDelete" disabled="@busy">Yes, delete</button>
                                <button class="btn btn-secondary" @onclick="() => armedDelete = null" disabled="@busy">Cancel</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="mt-2 d-flex gap-2">
                            <button class="btn btn-outline-primary" @onclick="() => { armedRestore = sb.FileName; armedDelete = null; }" disabled="@busy">Restore…</button>
                            <button class="btn btn-outline-danger" @onclick="() => { armedDelete = sb.FileName; armedRestore = null; }" disabled="@busy">Delete</button>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private int localCount;
    private bool busy;
    private string message = string.Empty;
    private bool isError;
    private string bkpPassword = string.Empty;
    private string bkpConfirm = string.Empty;
    private string bkpMessage = string.Empty;
    private bool bkpError;
    private string impMessage = string.Empty;
    private bool impError;
    private string? impPath;
    private string? impFileName;
    private string impPassword = string.Empty;
    private int? impCount;
    private bool armedImp;
    private List<SafetyBackupEntry> safetyList = new();
    private string? armedRestore;
    private string? armedDelete;
    private string safetyMessage = string.Empty;
    private bool safetyError;

    protected override async Task OnInitializedAsync()
    {
        for (int i = 0; i < 100 && !Session.Ready; i++)
        {
            await Task.Delay(100);
        }

        if (Session.Store is not null)
        {
            var stats = await Session.Store.GetStatsAsync();
            localCount = stats.Folders + stats.Bookmarks + stats.Separators;
        }

        await RefreshSafetyListAsync();
    }

    private async Task RefreshSafetyListAsync()
    {
        try
        {
            safetyList = await Session.ListSafetyBackupsAsync();
        }
        catch
        {
            safetyList = new();
        }
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        if (bytes < 1024L * 1024)
        {
            return $"{bytes / 1024.0:0.#} KB";
        }

        return $"{bytes / (1024.0 * 1024):0.##} MB";
    }

    private static void RequireMatchingPasswords(string first, string second)
    {
        if (first.Length < 8)
        {
            throw new InvalidOperationException("Use a password of at least 8 characters.");
        }

        if (!string.Equals(first, second, StringComparison.Ordinal))
        {
            throw new InvalidOperationException("Passwords do not match.");
        }
    }

    private async Task ExportBackup()
    {
        await RunAsync(async () =>
        {
            RequireMatchingPasswords(bkpPassword, bkpConfirm);
            var path = await Session.ExportBackupAsync(bkpPassword);
            bkpPassword = string.Empty;
            bkpConfirm = string.Empty;
            try
            {
                await Share.Default.RequestAsync(new ShareFileRequest(
                    "Save encrypted backup", new ShareFile(path)));
                Ok($"Backup exported ({localCount} items). Choose where to keep the file.");
            }
            catch
            {
                Ok($"Backup saved privately. Export it from the app folder when needed.");
            }
        });
        // Passwords never linger, on success or failure.
        bkpPassword = string.Empty;
        bkpConfirm = string.Empty;
        bkpMessage = message;
        bkpError = isError;
        message = string.Empty;
    }

    private async Task PickBackup()
    {
        await RunAsync(async () =>
        {
            var picked = await FilePicker.Default.PickAsync();
            if (picked is null)
            {
                return;
            }

            // The picker name is untrusted: strip any path, require JSON.
            var safeName = Path.GetFileName(picked.FileName);
            if (string.IsNullOrWhiteSpace(safeName) || !Core.Crypto.BackupGuard.HasSupportedExtension(safeName))
            {
                throw new InvalidOperationException("Pick a backup file (.xbs.json).");
            }

            // Copy into our cache with a size cap: the picked URI may not be a
            // direct file path, and imports must never OOM the app.
            ForgetImportTmp();
            var tmp = Path.Combine(FileSystem.CacheDirectory,
                $"import-{Guid.NewGuid():N}-{safeName}");
            await using (var src = await picked.OpenReadAsync())
            await using (var dst = File.Create(tmp))
            {
                await CopyCappedAsync(src, dst, Core.Crypto.BackupGuard.MaxBytes);
            }

            impPath = tmp;
            impFileName = safeName;
            impCount = null;
            armedImp = false;
            Ok("File selected. Enter its password and Read backup.");
        });
        impMessage = message;
        impError = isError;
        message = string.Empty;
    }

    private void ForgetImportTmp()
    {
        if (impPath is not null)
        {
            try { File.Delete(impPath); } catch { }
            impPath = null;
        }
    }

    private static async Task CopyCappedAsync(Stream src, Stream dst, long maxBytes)
    {
        var buf = new byte[81920];
        long total = 0;
        int read;
        while ((read = await src.ReadAsync(buf).ConfigureAwait(false)) > 0)
        {
            total += read;
            if (total > maxBytes)
            {
                throw new InvalidOperationException(
                    $"File is too large (over {maxBytes / 1024 / 1024} MB).");
            }

            await dst.WriteAsync(buf.AsMemory(0, read)).ConfigureAwait(false);
        }
    }

    private async Task PreviewImport()
    {
        await RunAsync(async () =>
        {
            if (impPath is null)
            {
                throw new InvalidOperationException("Choose a backup file first.");
            }

            if (string.IsNullOrEmpty(impPassword))
            {
                throw new InvalidOperationException("Enter the backup password.");
            }

            impCount = await Session.PreviewBackupAsync(impPath, impPassword);
            armedImp = false;
            Ok("Backup reads correctly. Review the counts above.");
        });
        impMessage = message;
        impError = isError;
        message = string.Empty;
    }

    private async Task ExecuteImport()
    {
        await RunAsync(async () =>
        {
            if (impPath is null || impCount is null)
            {
                throw new InvalidOperationException("Read the backup first.");
            }

            var restored = await Session.ImportBackupAsync(impPath, impPassword);
            impPassword = string.Empty;
            impCount = null;
            armedImp = false;
            ForgetImportTmp();
            if (Session.Store is not null)
            {
                var stats = await Session.Store.GetStatsAsync();
                localCount = stats.Folders + stats.Bookmarks + stats.Separators;
            }

            Ok($"Restored {restored} item(s). Safety backup of the replaced bookmarks saved — see Safety backups below. They sync up automatically.");
        });
        // The import flow is over either way: never keep the password around.
        impPassword = string.Empty;
        impMessage = message;
        impError = isError;
        message = string.Empty;
    }

    private async Task RefreshSafety()
    {
        await RunAsync(async () =>
        {
            await RefreshSafetyListAsync();
            Ok($"Safety list refreshed ({safetyList.Count} backup(s)).");
        });
        safetyMessage = message;
        safetyError = isError;
        message = string.Empty;
    }

    private async Task ExecuteSafetyRestore()
    {
        await RunAsync(async () =>
        {
            if (armedRestore is null)
            {
                throw new InvalidOperationException("Pick a backup first.");
            }

            var restored = await Session.RestoreSafetyBackupAsync(armedRestore);
            armedRestore = null;
            if (Session.Store is not null)
            {
                var stats = await Session.Store.GetStatsAsync();
                localCount = stats.Folders + stats.Bookmarks + stats.Separators;
            }

            await RefreshSafetyListAsync();
            Ok($"Restored {restored} item(s). A pre-restore backup was saved first.");
        });
        safetyMessage = message;
        safetyError = isError;
        message = string.Empty;
    }

    private async Task ExecuteSafetyDelete()
    {
        await RunAsync(async () =>
        {
            if (armedDelete is null)
            {
                throw new InvalidOperationException("Pick a backup first.");
            }

            await Session.DeleteSafetyBackupAsync(armedDelete);
            armedDelete = null;
            await RefreshSafetyListAsync();
            Ok("Safety backup deleted.");
        });
        safetyMessage = message;
        safetyError = isError;
        message = string.Empty;
    }

    private async Task RunAsync(Func<Task> action, [System.Runtime.CompilerServices.CallerMemberName] string op = "?")
    {
        busy = true;
        isError = false;
        message = string.Empty;
        try
        {
            Session.Log.Debug("backup", $"{op}: start");
            await action();
            Session.Log.Debug("backup", $"{op}: ok");
        }
        catch (Exception ex)
        {
            isError = true;
            message = ex.Message;
            Session.Log.Warn("backup", $"{op} failed: {ex.GetType().Name}");
        }
        finally
        {
            // Export passwords never linger. impPassword is excluded on
            // purpose: it is entered at "Read backup" and reused at
            // "Yes, restore" (ExecuteImport clears it when the flow ends).
            bkpPassword = string.Empty;
            bkpConfirm = string.Empty;
            busy = false;
        }
    }

    private void Ok(string text)
    {
        isError = false;
        message = text;
    }
}
