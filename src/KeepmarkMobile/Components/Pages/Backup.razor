@inherits KeepmarkMobile.Components.SessionComponentBase
@page "/backup"
@inject KeepmarkMobile.Services.XbsSession Session
@inject KeepmarkMobile.Services.SecureCredentialStore Creds
@inject KeepmarkMobile.Services.ToastState Toast
@inject KeepmarkMobile.Services.XbsSettings AppSettings
@inject NavigationManager Nav
@using Keepmark.Core.Safety
@using Keepmark.Core.Workflow

<PageTitle>@L.Get(Str.NavBackup)</PageTitle>

<h1>@L.Get(Str.NavBackup)</h1>

@if (!Session.Ready)
{
    <p role="status"><em>@L.Get(Str.BackupStarting)</em></p>
}
else
{
    @* Two compact actions: the parameters open inline under the one chosen,
       so the page stays a short overview (same model as the browser manager). *@
    <div class="km-bk-actions">
        <section class="km-bk-action @(exportOpen ? "is-open" : "")">
            <div class="km-bk-action-head">
                <h4>@L.Get(Str.BackupExportH)</h4>
                <InfoHint Text="@L.Get(Str.BackupExportShort)" Title="@L.Get(Str.BackupExportH)" Body="@ExportBody" />
            </div>
            @if (!exportOpen)
            {
                <button class="btn btn-outline-primary" @onclick="OpenExport" disabled="@busy">@L.Get(Str.BackupExportOpen)</button>
            }
            else
            {
                <label class="form-label">@L.Get(Str.BackupPassword)</label>
                <input type="password" class="form-control" @bind="bkpPassword" autocomplete="new-password" />
                <label class="form-label mt-2">@L.Get(Str.BackupConfirmPassword)</label>
                <input type="password" class="form-control" @bind="bkpConfirm" autocomplete="new-password" />
                <div class="d-flex gap-2 mt-2">
                    <button class="btn btn-primary" @onclick="ExportBackup" disabled="@busy">@L.Get(Str.BackupExportBtn)</button>
                    <button class="btn btn-outline-secondary" @onclick="CloseExport" disabled="@busy">@L.Get(Str.CommonCancel)</button>
                </div>
            }
            <StepMessage Text="@bkpMessage" Error="bkpError" />
        </section>

        <section class="km-bk-action @(impPath is not null ? "is-open" : "")">
            <div class="km-bk-action-head">
                <h4>@L.Get(Str.BackupRestoreH)</h4>
            </div>
            <p class="km-bk-hint">@L.Get(Str.BackupRestoreShort)</p>
            @if (impPath is null)
            {
                <button class="btn btn-outline-primary" @onclick="PickBackup" disabled="@busy">@L.Get(Str.BackupRestoreOpen)</button>
            }
            else
            {
                <p class="mb-1">@L.Get(Str.BackupFileLabel) <strong>@impFileName</strong></p>
                @if (impCount is null)
                {
                    <label class="form-label">@L.Get(Str.BackupFilePassword)</label>
                    <input type="password" class="form-control" @bind="impPassword" autocomplete="off" />
                    <div class="d-flex gap-2 mt-2">
                        <button class="btn btn-primary" @onclick="PreviewImport" disabled="@busy">@L.Get(Str.BackupCheckBtn)</button>
                        <button class="btn btn-outline-secondary" @onclick="CancelImport" disabled="@busy">@L.Get(Str.CommonCancel)</button>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-1">@WorkflowTexts.ImportChecked(impFileName ?? L.Get(Str.BackupFallbackName), impCount.Value)</p>
                    <p>@L.Get(Str.BackupReplaceMessage, localCount, impCount)</p>
                    <p class="text-muted">@WorkflowTexts.ImportImplication(linked)</p>
                    <div class="d-flex gap-2 mt-1">
                        <button class="btn btn-danger" @onclick="ExecuteImport" disabled="@busy">@L.Get(Str.BackupRestoreBtn)</button>
                        <button class="btn btn-outline-secondary" @onclick="CancelImport" disabled="@busy">@L.Get(Str.CommonCancel)</button>
                    </div>
                }
            }
            <StepMessage Text="@impMessage" Error="impError" />
        </section>

        @* bookmarks.html: plain text exchange with any browser. Export warns
           first (not encrypted); import only adds, in a new folder. *@
        <section class="km-bk-action @(htmlExportArmed || htmlPath is not null ? "is-open" : "")">
            <div class="km-bk-action-head">
                <h4>@L.Get(Str.HtmlH)</h4>
                <InfoHint Text="@L.Get(Str.HtmlShort)" Title="@L.Get(Str.HtmlH)" Body="@L.Get(Str.HtmlIntro)" />
            </div>
            @if (htmlExportArmed)
            {
                <p class="km-bk-warn" role="status">
                    <svg class="km-ico sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M10.3 3.9 2.5 18a2 2 0 0 0 1.7 3h15.6a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" /><path d="M12 9v5M12 17h.01" /></svg>
                    <span>@L.Get(Str.HtmlExportWarn)</span>
                </p>
                <div class="d-flex gap-2 mt-2">
                    <button class="btn btn-primary" @onclick="ExportHtml" disabled="@busy">@L.Get(Str.HtmlExportBtn)</button>
                    <button class="btn btn-outline-secondary" @onclick="CancelHtml" disabled="@busy">@L.Get(Str.CommonCancel)</button>
                </div>
            }
            else if (htmlPath is not null)
            {
                <p class="mb-1">@L.Get(Str.BackupFileLabel) <strong>@htmlFileName</strong></p>
                @if (htmlPlan is not null)
                {
                    <p class="text-muted mb-1" role="status">@L.Get(Str.HtmlPreviewCounts, htmlPlan.Bookmarks, htmlPlan.Folders, htmlPlan.Separators)</p>
                    @if (htmlSkipped > 0)
                    {
                        <p class="text-muted mb-1">@L.Get(Str.HtmlPreviewSkipped, htmlSkipped)</p>
                    }
                    @if (htmlPlan.Duplicates > 0)
                    {
                        <p class="text-muted mb-1">@L.Get(Str.HtmlPreviewDuplicates, htmlPlan.Duplicates)</p>
                        <div class="form-check mb-1">
                            <input class="form-check-input" type="checkbox" id="km-html-skip" @bind="htmlSkipDuplicates" @bind:after="ReplanHtml" disabled="@busy" />
                            <label class="form-check-label" for="km-html-skip">@L.Get(Str.HtmlSkipDuplicates)</label>
                        </div>
                    }
                    <p class="text-muted">@L.Get(Str.HtmlImportTarget, htmlFolder, L.Get(Str.ContainerOther))</p>
                    <div class="d-flex gap-2 mt-1">
                        <button class="btn btn-primary" @onclick="ImportHtml" disabled="@(busy || htmlPlan.Bookmarks == 0)">@L.Get(Str.HtmlImportBtn)</button>
                        <button class="btn btn-outline-secondary" @onclick="CancelHtml" disabled="@busy">@L.Get(Str.CommonCancel)</button>
                    </div>
                }
                else
                {
                    <div class="d-flex gap-2 mt-1">
                        <button class="btn btn-outline-secondary" @onclick="CancelHtml" disabled="@busy">@L.Get(Str.CommonCancel)</button>
                    </div>
                }
            }
            else
            {
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-outline-primary" @onclick="ArmHtmlExport" disabled="@busy">@L.Get(Str.HtmlExportOpen)</button>
                    <button class="btn btn-outline-primary" @onclick="PickHtml" disabled="@busy">@L.Get(Str.HtmlImportOpen)</button>
                </div>
            }
            <StepMessage Text="@htmlMessage" Error="htmlError" />
        </section>
    </div>

    <div class="mb-3">
        <h4>@L.Get(Str.BackupSafetyH)</h4>
        <InfoHint Text="@L.Get(Str.BackupSafetyShort)" Title="@L.Get(Str.BackupSafetyH)" Body="@L.Get(Str.BackupSafetyIntro, AppSettings.SafetyKeep)" />
        <button class="btn btn-outline-secondary mb-2" @onclick="RefreshSafety" disabled="@busy">@L.Get(Str.BackupRefreshList)</button>
        <StepMessage Text="@safetyMessage" Error="safetyError" />
        @if (LockedCount > 0)
        {
            @* Only when something is filtered out: backups of other syncs (or
               needing a link) cannot be restored here, so they stay hidden
               by default and come back, locked, under "All". *@
            <div class="xbs-seg km-sb-filter" role="group" aria-label="@L.Get(Str.SafetyFilterLabel)">
                <button type="button" aria-pressed="@((!safetyShowAll).ToString().ToLowerInvariant())" @onclick="() => safetyShowAll = false">@L.Get(Str.SafetyFilterHere, safetyList.Count - LockedCount)</button>
                <button type="button" aria-pressed="@safetyShowAll.ToString().ToLowerInvariant()" @onclick="() => safetyShowAll = true">@L.Get(Str.SafetyFilterAll, safetyList.Count)</button>
            </div>
        }
        @if (safetyList.Count == 0)
        {
            <p class="text-muted">@L.Get(Str.BackupNoSafety)</p>
        }
        else if (VisibleSafety.Count == 0)
        {
            <p class="text-muted">@Loc.Plural(Str.SafetyNoneHere, LockedCount)</p>
        }
        @foreach (var day in VisibleSafety.GroupBy(e => SafetyBackupFiles.DayLabel(e.CreatedAtUtc, DateTime.Now)))
        {
            <h5 class="km-sb-day">@day.Key</h5>
            @foreach (var sb in day)
            {
                var sbLock = SafetyBackupFiles.Lock(sb, activeSyncId);
                var sbOwner = sbLock == SafetyLock.OtherSync ? SafetyBackupFiles.Owner(sb, savedRows, activeSyncId) : null;
                <div class="km-sb-item @(sbLock != SafetyLock.None ? "is-locked" : "")" @key="sb.FileName">
                    <div class="km-sb-head">
                        <strong>@SafetyOperations.Describe(sb.Operation)</strong>
                        <time>@sb.CreatedAtUtc.ToLocalTime().ToString("t")</time>
                    </div>
                    @if (sb.Added > 0 || sb.Removed > 0)
                    {
                        <div class="km-sb-chips">
                            @if (sb.Added > 0)
                            {
                                <span class="km-sb-chip is-add">@L.Get(Str.SafetyAdded, sb.Added)</span>
                            }
                            @if (sb.Removed > 0)
                            {
                                <span class="km-sb-chip is-del">@L.Get(Str.SafetyRemoved, sb.Removed)</span>
                            }
                        </div>
                    }
                    <div class="km-sb-sync">
                        @if (sb.SyncId is null)
                        {
                            <span>@L.Get(Str.SafetyNoSync)</span>
                        }
                        else
                        {
                            @if (sb.SyncName is not null)
                            {
                                <span class="km-sb-name">@sb.SyncName</span>
                            }
                            <code>@sb.SyncId</code>
                        }
                    </div>
                    <div class="km-sb-meta">
                        <span>@SafetyBackupFiles.Meta(sb, WorkflowRules.FormatBytes(sb.SizeBytes))</span>
                        <span class="km-sb-chip @(sb.Enc == "master" ? "is-enc" : "")">@L.Get(sb.Enc == "master" ? Str.SafetyEncrypted : Str.SafetyNotEncrypted)</span>
                    </div>
                    @if (sbLock != SafetyLock.None)
                    {
                        <p class="km-sb-lock">
                            <svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
                            <span>@LockText(sbLock, sbOwner)</span>
                        </p>
                    }
                    @if (armedRestore == sb.FileName)
                    {
                        <ConfirmBlock Message="@L.Get(Str.BackupRestoreMessage)"
                                      Implication="@WorkflowTexts.SafetyRestoreImplication(sb.Side, sb.Items)"
                                      ConfirmLabel="@L.Get(Str.CommonYesRestore)" Busy="busy"
                                      OnConfirm="ExecuteSafetyRestore" OnCancel="() => armedRestore = null" />
                    }
                    else if (armedDelete == sb.FileName)
                    {
                        <ConfirmBlock Message="@L.Get(Str.BackupDeleteMessage)"
                                      Implication="@WorkflowTexts.SafetyDeleteImplication"
                                      ConfirmLabel="@L.Get(Str.CommonYesDelete)" Busy="busy"
                                      OnConfirm="ExecuteSafetyDelete" OnCancel="() => armedDelete = null" />
                    }
                    else
                    {
                        <div class="km-sb-actions">
                            @if (sbOwner is not null)
                            {
                                <button class="btn btn-sm btn-primary" @onclick='() => Nav.NavigateTo("/syncs")' disabled="@busy">@L.Get(Str.SafetyActivateOwner, Keepmark.Core.Sync.SavedSyncs.Name(sbOwner))</button>
                            }
                            else if (sbLock == SafetyLock.None)
                            {
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => { armedRestore = sb.FileName; armedDelete = null; }" disabled="@busy">@L.Get(Str.BackupRestoreBtn)</button>
                            }
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => { armedDelete = sb.FileName; armedRestore = null; }" disabled="@busy">@L.Get(Str.CommonDelete)</button>
                        </div>
                    }
                </div>
            }
        }
    </div>

    @* Only when there is something to show: copies exist only after a sync
       vanished from its service, so an empty section is noise. A load error
       or an action's outcome (e.g. the last copy deleted) keeps it visible. *@
    @if (removedList.Count > 0 || removedMessage.Length > 0)
    {
        <div class="mb-3">
            <h4>@L.Get(Str.BackupRemovedH)</h4>
            <InfoHint Text="@L.Get(Str.BackupRemovedShort)" Title="@L.Get(Str.BackupRemovedH)" Body="@L.Get(Str.BackupRemovedIntro)" />
            <button class="btn btn-outline-secondary mb-2" @onclick="RefreshRemoved" disabled="@busy">@L.Get(Str.BackupRefreshList)</button>
            <StepMessage Text="@removedMessage" Error="removedError" />
            @foreach (var rc in removedList)
            {
                <div class="card mb-2" @key="rc.FileName">
                    <div class="card-body py-2">
                        <div><strong>@RemovedSyncCopies.Describe(rc)</strong></div>
                        <div class="form-text">@rc.FileName</div>
                        @if (armedRemovedRestore == rc.FileName)
                        {
                            <ConfirmBlock Message="@L.Get(Str.BackupRemovedRestoreMessage)"
                                          Implication="@L.Get(Str.BackupRemovedRestoreImplication)"
                                          ConfirmLabel="@L.Get(Str.CommonYesRestore)" Busy="busy"
                                          OnConfirm="ExecuteRemovedRestore" OnCancel="() => armedRemovedRestore = null" />
                        }
                        else if (armedRemovedDelete == rc.FileName)
                        {
                            <ConfirmBlock Message="@L.Get(Str.BackupRemovedDeleteMessage)"
                                          Implication="@L.Get(Str.BackupRemovedDeleteImplication)"
                                          ConfirmLabel="@L.Get(Str.CommonYesDelete)" Busy="busy"
                                          OnConfirm="ExecuteRemovedDelete" OnCancel="() => armedRemovedDelete = null" />
                        }
                        else
                        {
                            <div class="mt-2 d-flex gap-2">
                                <button class="btn btn-outline-primary" @onclick="() => { armedRemovedRestore = rc.FileName; armedRemovedDelete = null; }" disabled="@busy">@L.Get(Str.BackupRestoreBtn)</button>
                                <button class="btn btn-outline-danger" @onclick="() => { armedRemovedDelete = rc.FileName; armedRemovedRestore = null; }" disabled="@busy">@L.Get(Str.CommonDelete)</button>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private int localCount;
    private bool linked;
    private bool exportOpen;
    private bool busy;
    private string bkpPassword = string.Empty;
    private string bkpConfirm = string.Empty;
    private string bkpMessage = string.Empty;
    private bool bkpError;
    private string impMessage = string.Empty;
    private bool impError;
    private string? impPath;
    private string? impFileName;
    private string impPassword = string.Empty;
    private int? impCount;
    private List<SafetyBackupEntry> safetyList = new();
    private string? armedRestore;
    private string? armedDelete;
    private string safetyMessage = string.Empty;
    private bool safetyError;
    private string safetyLoadMessage = string.Empty;
    private bool safetyShowAll;
    private string? activeSyncId;
    private List<Keepmark.Core.Sync.SavedSync> savedRows = new();

    private int LockedCount => safetyList.Count(e => SafetyBackupFiles.Lock(e, activeSyncId) != SafetyLock.None);

    private List<SafetyBackupEntry> VisibleSafety => safetyShowAll || LockedCount == 0
        ? safetyList
        : safetyList.Where(e => SafetyBackupFiles.Lock(e, activeSyncId) == SafetyLock.None).ToList();

    private string LockText(SafetyLock state, Keepmark.Core.Sync.SavedSync? owner) => state switch
    {
        SafetyLock.NeedsLink => L.Get(Str.SafetyLockedNeedsLink),
        _ when owner is not null => L.Get(Str.SafetyLockedOther, Keepmark.Core.Sync.SavedSyncs.Name(owner)),
        _ => L.Get(Str.SafetyLockedUnknown),
    };
    private List<RemovedSyncCopyInfo> removedList = new();
    private string? armedRemovedRestore;
    private string? armedRemovedDelete;
    private string removedMessage = string.Empty;
    private bool removedError;
    private string removedLoadMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!await WaitForSessionAsync(Session)) return;

        await RefreshCountsAsync();
        await RefreshSafetyListAsync();
        await RefreshRemovedListAsync();
    }

    /// <summary>Export explanation for the sheet: the counted intro plus the
    /// password rule, kept together as one block of reading.</summary>
    private string ExportBody =>
        Loc.Plural(Str.BackupExportIntro, localCount) + " " + WorkflowTexts.BackupPasswordHint;

    private async Task RefreshCountsAsync()
    {
        linked = await Creds.GetAsync() is not null;
        if (Session.Store is not null)
        {
            var stats = await Session.Store.GetStatsAsync();
            localCount = stats.Folders + stats.Bookmarks + stats.Separators;
        }
    }

    private async Task RefreshSafetyListAsync()
    {
        try
        {
            var entries = await Session.ListSafetyBackupsAsync();
            var saved = Session.Registry is null ? new List<Keepmark.Core.Sync.SavedSync>() : await Session.Registry.ListAsync();
            activeSyncId = (await Creds.GetAsync())?.Id;
            savedRows = saved.ToList();
            safetyList = SafetyBackupFiles.WithSyncNames(entries, saved);
            ClearLoadError(ref safetyLoadMessage, ref safetyMessage, ref safetyError);
        }
        catch (Exception ex)
        {
            // Hiding a list is not harmless: it is where the user looks for a
            // recovery point, so a read failure must be named.
            safetyList = new();
            safetyLoadMessage = L.Get(Str.ErrLoadFailed, ex.Message);
            (safetyMessage, safetyError) = (safetyLoadMessage, true);
            Session.Log.Warn("backup", $"Safety list unreadable: {ex.GetType().Name}");
        }
    }

    private async Task RefreshRemovedListAsync()
    {
        try
        {
            removedList = await Session.ListRemovedSyncCopiesAsync();
            ClearLoadError(ref removedLoadMessage, ref removedMessage, ref removedError);
        }
        catch (Exception ex)
        {
            removedList = new();
            removedLoadMessage = L.Get(Str.ErrLoadFailed, ex.Message);
            (removedMessage, removedError) = (removedLoadMessage, true);
            Session.Log.Warn("backup", $"Removed-sync list unreadable: {ex.GetType().Name}");
        }
    }

    /// <summary>Clears a message only when it is the one the refresh itself put
    /// there: an action's outcome must survive a later list refresh.</summary>
    private static void ClearLoadError(ref string loadMessage, ref string message, ref bool error)
    {
        if (loadMessage.Length == 0 || message != loadMessage) return;
        loadMessage = string.Empty;
        (message, error) = (string.Empty, false);
    }

    private void OpenExport()
    {
        (bkpMessage, bkpError) = (string.Empty, false);
        exportOpen = true;
    }

    /// <summary>Closing the export never keeps a typed password around.</summary>
    private void CloseExport()
    {
        bkpPassword = string.Empty;
        bkpConfirm = string.Empty;
        (bkpMessage, bkpError) = (string.Empty, false);
        exportOpen = false;
    }

    private void CancelImport()
    {
        ForgetImport();
        (impMessage, impError) = (string.Empty, false);
    }

    /// <summary>Export: a new password typed twice. The fields are cleared on
    /// success only, so a failed export can be retried as is.</summary>
    private async Task ExportBackup()
    {
        await RunAsync(async () =>
        {
            WorkflowRules.RequireNewPassword(bkpPassword, bkpConfirm);
            var path = await Session.ExportBackupAsync(bkpPassword);
            bkpPassword = string.Empty;
            bkpConfirm = string.Empty;
            exportOpen = false;
            try
            {
                await Share.Default.RequestAsync(new ShareFileRequest(
                    L.Get(Str.BackupSaveTitle), new ShareFile(path)));
                return WorkflowTexts.ExportDone(localCount) + " " + L.Get(Str.BackupChooseWhere);
            }
            catch
            {
                return WorkflowTexts.ExportDone(localCount) + " " + L.Get(Str.BackupSavedInApp);
            }
        }, (text, error) => (bkpMessage, bkpError) = (text, error));
    }

    /// <summary>Step 1: choosing a file always starts the restore over.</summary>
    private async Task PickBackup()
    {
        await RunAsync(async () =>
        {
            var picked = await FilePicker.Default.PickAsync();
            if (picked is null)
            {
                return string.Empty;
            }

            // The picker name is untrusted: strip any path, require JSON.
            var safeName = Path.GetFileName(picked.FileName);
            if (string.IsNullOrWhiteSpace(safeName) || !Core.Crypto.BackupGuard.HasSupportedExtension(safeName))
            {
                throw new InvalidOperationException(L.Get(Str.BackupPickFile));
            }

            // Copy into our cache with a size cap: the picked URI may not be a
            // direct file path, and imports must never OOM the app.
            ForgetImport();
            var tmp = Path.Combine(FileSystem.CacheDirectory,
                $"import-{Guid.NewGuid():N}-{safeName}");
            await using (var src = await picked.OpenReadAsync())
            await using (var dst = File.Create(tmp))
            {
                await CopyCappedAsync(src, dst, Core.Crypto.BackupGuard.MaxBytes);
            }

            impPath = tmp;
            impFileName = safeName;
            return string.Empty;
        }, (text, error) => (impMessage, impError) = (text, error));
    }

    /// <summary>Back to step 1: no file, no password, nothing checked.</summary>
    private void ForgetImport()
    {
        if (impPath is not null)
        {
            try { File.Delete(impPath); } catch { }
            impPath = null;
        }

        impFileName = null;
        impPassword = string.Empty;
        impCount = null;
    }

    private static async Task CopyCappedAsync(Stream src, Stream dst, long maxBytes)
    {
        var buf = new byte[81920];
        long total = 0;
        int read;
        while ((read = await src.ReadAsync(buf).ConfigureAwait(false)) > 0)
        {
            total += read;
            if (total > maxBytes)
            {
                throw new InvalidOperationException(
                    Loc.Get(Str.BackupFileTooLarge, maxBytes / 1024 / 1024));
            }

            await dst.WriteAsync(buf.AsMemory(0, read)).ConfigureAwait(false);
        }
    }

    /// <summary>Step 2: decrypt and count, nothing changes. A wrong password
    /// clears only the password; the file stays chosen.</summary>
    private async Task PreviewImport()
    {
        await RunAsync(async () =>
        {
            if (impPath is null)
            {
                throw new InvalidOperationException(L.Get(Str.BackupChooseFirst));
            }

            if (string.IsNullOrEmpty(impPassword))
            {
                throw new InvalidOperationException(L.Get(Str.BackupEnterPassword));
            }

            try
            {
                impCount = await Session.PreviewBackupAsync(impPath, impPassword);
            }
            catch
            {
                impPassword = string.Empty;
                throw;
            }

            return string.Empty;
        }, (text, error) => (impMessage, impError) = (text, error));
    }

    /// <summary>Step 3 (confirmed). On failure the flow goes back to the
    /// password step with the file kept, never to a half-checked state.</summary>
    private async Task ExecuteImport()
    {
        if (busy) return;
        await RunAsync(async () =>
        {
            if (impPath is null || impCount is null)
            {
                throw new InvalidOperationException(L.Get(Str.BackupCheckFirst));
            }

            int restored;
            try
            {
                restored = await Session.ImportBackupAsync(impPath, impPassword);
            }
            catch
            {
                impPassword = string.Empty;
                impCount = null;
                throw;
            }

            ForgetImport();
            await RefreshCountsAsync();
            await RefreshSafetyListAsync();
            return WorkflowTexts.ImportDone(restored, linked);
        }, (text, error) => (impMessage, impError) = (text, error));
    }

    // ---- bookmarks.html ------------------------------------------------------

    private bool htmlExportArmed;
    private string? htmlPath;
    private string? htmlFileName;
    private string htmlFolder = string.Empty;
    private Keepmark.Core.Html.NetscapeImportPlan? htmlPlan;
    private int htmlSkipped;
    private bool htmlSkipDuplicates = true;
    private string htmlMessage = string.Empty;
    private bool htmlError;

    private void ArmHtmlExport()
    {
        ForgetHtml();
        (htmlMessage, htmlError) = (string.Empty, false);
        htmlExportArmed = true;
    }

    private void CancelHtml()
    {
        ForgetHtml();
        (htmlMessage, htmlError) = (string.Empty, false);
    }

    private void ForgetHtml()
    {
        htmlExportArmed = false;
        if (htmlPath is not null)
        {
            try { File.Delete(htmlPath); } catch { }
            htmlPath = null;
        }

        htmlFileName = null;
        htmlPlan = null;
        htmlSkipped = 0;
        htmlSkipDuplicates = true;
    }

    /// <summary>Confirmed export: the warning was on screen, this click is
    /// the consent. The file is offered to the share sheet like the
    /// encrypted export.</summary>
    private async Task ExportHtml()
    {
        await RunAsync(async () =>
        {
            var (path, count) = await Session.ExportHtmlAsync();
            htmlExportArmed = false;
            var done = Loc.Plural(Str.HtmlExportDone, count);
            try
            {
                await Share.Default.RequestAsync(new ShareFileRequest(L.Get(Str.HtmlSaveTitle), new ShareFile(path)));
                return done + " " + L.Get(Str.BackupChooseWhere);
            }
            catch
            {
                return done + " " + L.Get(Str.BackupSavedInApp);
            }
        }, (text, error) => (htmlMessage, htmlError) = (text, error));
    }

    /// <summary>Choose a file, copy it (capped) into the cache and preview it
    /// at once: there is no password step.</summary>
    private async Task PickHtml()
    {
        await RunAsync(async () =>
        {
            var picked = await FilePicker.Default.PickAsync();
            if (picked is null)
            {
                return string.Empty;
            }

            var safeName = Path.GetFileName(picked.FileName);
            if (string.IsNullOrWhiteSpace(safeName) || !Core.Html.NetscapeBookmarks.HasSupportedExtension(safeName))
            {
                throw new InvalidOperationException(L.Get(Str.HtmlPickFile));
            }

            ForgetHtml();
            var tmp = Path.Combine(FileSystem.CacheDirectory, $"import-{Guid.NewGuid():N}.html");
            await using (var src = await picked.OpenReadAsync())
            await using (var dst = File.Create(tmp))
            {
                await CopyCappedAsync(src, dst, Core.Html.NetscapeBookmarks.MaxBytes);
            }

            htmlPath = tmp;
            htmlFileName = safeName;
            htmlFolder = L.Get(Str.HtmlImportFolder,
                DateTime.Now.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture));
            try
            {
                (htmlPlan, htmlSkipped) = await Session.PreviewHtmlAsync(tmp, htmlSkipDuplicates);
            }
            catch
            {
                ForgetHtml();
                throw;
            }

            return htmlPlan.Bookmarks == 0 ? L.Get(Str.HtmlImportNothing) : string.Empty;
        }, (text, error) => (htmlMessage, htmlError) = (text, error));
    }

    private async Task ReplanHtml()
    {
        if (htmlPath is null) return;
        await RunAsync(async () =>
        {
            (htmlPlan, htmlSkipped) = await Session.PreviewHtmlAsync(htmlPath, htmlSkipDuplicates);
            return htmlPlan.Bookmarks == 0 ? L.Get(Str.HtmlImportNothing) : string.Empty;
        }, (text, error) => (htmlMessage, htmlError) = (text, error));
    }

    private async Task ImportHtml()
    {
        if (busy || htmlPath is null) return;
        await RunAsync(async () =>
        {
            var (count, folder) = await Session.ImportHtmlAsync(htmlPath, htmlSkipDuplicates, htmlFolder);
            ForgetHtml();
            await RefreshCountsAsync();
            await RefreshSafetyListAsync();
            return Loc.Plural(Str.HtmlImportDone, count, folder);
        }, (text, error) => (htmlMessage, htmlError) = (text, error));
    }

    private async Task RefreshSafety()
    {
        await RunAsync(async () =>
        {
            await RefreshSafetyListAsync();
            return Loc.Plural(Str.BackupSafetyRefreshed, safetyList.Count);
        }, ReportSafetyToast);
    }

    private async Task ExecuteSafetyRestore()
    {
        await RunAsync(async () =>
        {
            if (armedRestore is null)
            {
                throw new InvalidOperationException(L.Get(Str.BackupPickFirst));
            }

            var restored = await Session.RestoreSafetyBackupAsync(armedRestore);
            armedRestore = null;
            await RefreshCountsAsync();
            await RefreshSafetyListAsync();
            return WorkflowTexts.SafetyRestoreDone(restored);
        }, (text, error) => (safetyMessage, safetyError) = (text, error));
        armedRestore = null;
    }

    private async Task ExecuteSafetyDelete()
    {
        await RunAsync(async () =>
        {
            if (armedDelete is null)
            {
                throw new InvalidOperationException(L.Get(Str.BackupPickFirst));
            }

            await Session.DeleteSafetyBackupAsync(armedDelete);
            armedDelete = null;
            await RefreshSafetyListAsync();
            return L.Get(Str.BackupSafetyDeleted);
        }, ReportSafetyToast);
        armedDelete = null;
    }

    /// <summary>Short confirmations with nothing to act on: success fades as a
    /// toast, errors stay inline next to the button.</summary>
    private void ReportSafetyToast(string text, bool error)
    {
        if (!error && !string.IsNullOrEmpty(text))
        {
            (safetyMessage, safetyError) = (string.Empty, false);
            _ = Toast.ShowAsync(text);
            return;
        }

        (safetyMessage, safetyError) = (text, error);
    }

    private async Task RefreshRemoved()
    {
        await RunAsync(async () =>
        {
            await RefreshRemovedListAsync();
            return string.Empty;
        }, ReportRemovedToast);
    }

    private async Task ExecuteRemovedRestore()
    {
        await RunAsync(async () =>
        {
            if (armedRemovedRestore is null)
            {
                throw new InvalidOperationException(L.Get(Str.BackupPickFirst));
            }

            var restored = await Session.RestoreRemovedSyncCopyAsync(armedRemovedRestore);
            armedRemovedRestore = null;
            await RefreshCountsAsync();
            await RefreshSafetyListAsync();
            await RefreshRemovedListAsync();
            return WorkflowTexts.SafetyRestoreDone(restored);
        }, ReportRemovedToast);
        armedRemovedRestore = null;
    }

    private async Task ExecuteRemovedDelete()
    {
        await RunAsync(async () =>
        {
            if (armedRemovedDelete is null)
            {
                throw new InvalidOperationException(L.Get(Str.BackupPickFirst));
            }

            await Session.DeleteRemovedSyncCopyAsync(armedRemovedDelete);
            armedRemovedDelete = null;
            await RefreshRemovedListAsync();
            return L.Get(Str.BackupRemovedDeleted);
        }, ReportRemovedToast);
        armedRemovedDelete = null;
    }

    /// <summary>Copies of removed syncs: a refresh says nothing, so only the
    /// outcome of a restore or a delete is announced.</summary>
    private void ReportRemovedToast(string text, bool error)
    {
        if (!error && !string.IsNullOrEmpty(text))
        {
            (removedMessage, removedError) = (string.Empty, false);
            _ = Toast.ShowAsync(text);
            return;
        }

        (removedMessage, removedError) = (text, error);
    }

    /// <summary>Runs one action and reports into that action's own message
    /// box only: the other sections and their fields are left alone.</summary>
    private async Task RunAsync(Func<Task<string>> action, Action<string, bool> report,
        [System.Runtime.CompilerServices.CallerMemberName] string op = "?")
    {
        busy = true;
        report(string.Empty, false);
        try
        {
            Session.Log.Debug("backup", $"{op}: start");
            report(await action(), false);
            Session.Log.Debug("backup", $"{op}: ok");
        }
        catch (Exception ex)
        {
            report(ex.Message, true);
            Session.Log.Warn("backup", $"{op} failed: {ex.GetType().Name}");
        }
        finally
        {
            busy = false;
        }
    }
}
