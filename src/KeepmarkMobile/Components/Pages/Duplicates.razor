@inherits KeepmarkMobile.Components.SessionComponentBase
@page "/duplicates"
@using System.Linq
@using Keepmark.Core.Workflow
@using Microsoft.JSInterop
@inject KeepmarkMobile.Services.XbsSession Session
@inject KeepmarkMobile.Services.ToastState Toast
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@L.Get(Str.NavDuplicates)</PageTitle>

<h1>@L.Get(Str.DupTitle)</h1>
<p class="text-muted">@L.Get(Str.DupIntro)</p>

@if (!ready)
{
    <p role="status"><em>@L.Get(Str.CommonLoading)</em></p>
}
else if (groups.Count == 0)
{
    <div class="alert alert-success" role="status">@L.Get(Str.DupClean)</div>
}
else
{
    <p class="text-muted" role="status"><small>@Loc.Plural(Str.DupMarkedLine, MarkedCount())</small></p>

    @foreach (var g in groups)
    {
            var markedHere = g.Rows.Count(r => selected.Contains(r.RowId));
            <section class="xbs-dupgroup">
                <div class="xbs-duptext-sub text-break">@g.Url <span class="badge text-bg-secondary">@g.Rows.Count</span></div>
                @foreach (var r in g.Rows.Skip(PageOf(g) * 100).Take(100))
                {
                    @DupRow(r, r.Title ?? r.Url ?? string.Empty, PathOf(r.RowId))
                }
                @if (g.Rows.Count > 100)
                {
                    <div class="d-flex gap-2 align-items-center my-2">
                        <button class="btn btn-outline-secondary" disabled="@(PageOf(g) == 0)" aria-label="@L.Get(Str.CommonPreviousPage)" @onclick="() => ChangePage(g, -1)">←</button>
                        <span role="status">@($"{PageOf(g) * 100 + 1}–{Math.Min((PageOf(g) + 1) * 100, g.Rows.Count)} / {g.Rows.Count}")</span>
                        <button class="btn btn-outline-secondary" disabled="@((PageOf(g) + 1) * 100 >= g.Rows.Count)" aria-label="@L.Get(Str.CommonNextPage)" @onclick="() => ChangePage(g, 1)">→</button>
                    </div>
                }
                @if (armedGroup == g.Url)
                {
                    var confirm = WorkflowTexts.DupDeleteConfirm(markedHere);
                    <ConfirmBlock Message="@confirm.Message" Implication="@confirm.Implication" ConfirmLabel="@confirm.ConfirmLabel"
                                  Busy="busy" OnConfirm="() => ExecuteGroup(g)" OnCancel="() => armedGroup = null" />
                }
                else
                {
                    <button class="btn btn-outline-danger mt-1" disabled="@(busy || markedHere == 0)" @onclick="() => armedGroup = g.Url">
                        @(markedHere == 0 ? L.Get(Str.DupDeleteWord) + " " + L.Get(Str.DupDeleteMarkedWord) : Loc.Plural(Str.DupDeleteN, markedHere))
                    </button>
                }
            </section>
        }

    @if (!string.IsNullOrEmpty(deleteError))
    {
        <div class="alert alert-danger mt-2" role="alert">@deleteError</div>
    }
    <div class="xbs-dupbar">
        <span role="status">@Loc.Plural(Str.DupBarMarked, MarkedCount())</span>
        @if (!armedAll)
        {
            <button class="btn btn-outline-danger" disabled="@(busy || MarkedCount() == 0)" @onclick="() => armedAll = true">@L.Get(Str.DupDeleteBtn)</button>
        }
        else
        {
            var confirm = WorkflowTexts.DupDeleteConfirm(MarkedCount());
            <div class="w-100">
                <ConfirmBlock Message="@confirm.Message" Implication="@confirm.Implication" ConfirmLabel="@confirm.ConfirmLabel"
                              Busy="busy" OnConfirm="ExecuteAll" OnCancel="() => armedAll = false" />
            </div>
        }
    </div>
}

@code {
    private readonly string gestureOwner = Guid.NewGuid().ToString("N");
    private readonly Dictionary<string, int> pages = new();
    private int PageOf(Core.Data.DuplicateGroup group) => Math.Min(pages.GetValueOrDefault(group.Url), (group.Rows.Count - 1) / 100);
    private void ChangePage(Core.Data.DuplicateGroup group, int delta)
    {
        pages[group.Url] = Math.Clamp(PageOf(group) + delta, 0, (group.Rows.Count - 1) / 100);
        expandedDup.Clear();
    }
    private bool ready;
    private List<Core.Data.DuplicateGroup> groups = [];
    private Dictionary<int, string> paths = new();
    private Dictionary<int, Core.Data.DuplicateGroup> groupOf = new();
    private readonly HashSet<int> selected = [];
    private readonly HashSet<int> expandedDup = new();
    private DotNetObjectReference<Duplicates>? dotNet;
    private string? armedGroup;
    private bool armedAll;
    private bool busy;
    private string deleteError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!await WaitForSessionAsync(Session)) return;

        if (Session.Engine is not null)
        {
            Session.Engine.DataChanged += OnData;
        }

        await ReloadAsync();
        if (IsDisposed) return;
        ready = true;
    }

    private void OnData() => InvokeAsync(async () =>
    {
        // A push/pull rekeys every RowId: refresh unless a delete is in
        // flight (its final ReloadAsync reconciles everything).
        if (!busy)
        {
            await ReloadAsync();
            StateHasChanged();
        }
    });

    private async Task ReloadAsync()
    {
        armedGroup = null;
        armedAll = false;
        busy = false;
        if (Session.Store is null)
        {
            return;
        }

        groups = await Session.Store.GetDuplicateUrlsAsync();
        paths = await Session.Store.GetFolderPathsAsync(groups.SelectMany(g => g.Rows).Select(r => r.RowId));
        groupOf = groups.SelectMany(g => g.Rows.Select(r => (r.RowId, g)))
            .ToDictionary(x => x.RowId, x => x.g);
        // Default: everything marked but the first occurrence of each link.
        selected.Clear();
        foreach (var g in groups)
        {
            foreach (var r in g.Rows.Skip(1))
            {
                selected.Add(r.RowId);
            }
        }
    }

    private string PathOf(int rowId) => paths.GetValueOrDefault(rowId, string.Empty);

    private int MarkedCount() => selected.Count;

    /// <summary>Invariant: the last unmarked copy of a link cannot be marked.</summary>
    private bool IsLocked(int rowId) =>
        !selected.Contains(rowId) &&
        groupOf.TryGetValue(rowId, out var g) &&
        g.Rows.All(r => r.RowId == rowId || selected.Contains(r.RowId));

    private string MarkLabel(bool marked, bool locked) =>
        marked ? L.Get(Str.DupUnmark) : locked ? L.Get(Str.DupAlwaysKept) : L.Get(Str.DupMark);

    private async Task Toggle(int rowId)
    {
        if (IsLocked(rowId))
        {
            await Toast.ShowAsync(L.Get(Str.DupOneStays));
            return;
        }

        if (!selected.Remove(rowId))
        {
            selected.Add(rowId);
        }

        armedGroup = null;
        armedAll = false;
    }

    private async Task Open(Core.Data.ItemRow r)
    {
        if (!string.IsNullOrWhiteSpace(r.Url))
        {
            try { await Launcher.OpenAsync(r.Url); } catch { }
        }
    }

    /// <summary>Bulk delete by stable NodeId in ONE shot (one transaction,
    /// one push). A safety backup of the current tree is saved first.
    /// Failures are logged, never swallowed silently.</summary>
    private async Task<int> DeleteNodeIdsAsync(IEnumerable<int?> nodeIds)
    {
        var ids = nodeIds.Where(n => n.HasValue).Select(n => n.Value).Distinct().ToList();
        if (ids.Count == 0)
        {
            return 0;
        }

        try
        {
            return await Session.DeleteBookmarksAsync(ids);
        }
        catch (Exception ex)
        {
            Session.Log.Warn("duplicates", $"Batch delete failed: {ex.GetType().Name}");
            deleteError = ex.Message;
            return 0;
        }
    }

    private async Task ExecuteGroup(Core.Data.DuplicateGroup g)
    {
        if (Session.Engine is null || busy)
        {
            return;
        }

        busy = true;
        deleteError = string.Empty;
        var deleted = 0;
        try
        {
            // Safety net (the UI already enforces it): never wipe a link entirely.
            var targets = g.Rows
                .Where(r => selected.Contains(r.RowId) &&
                            g.Rows.Any(o => o.RowId != r.RowId && !selected.Contains(o.RowId)))
                .ToList();
            // Optimistic: hide them now, reconcile with the store after.
            foreach (var r in targets)
            {
                g.Rows.Remove(r);
                selected.Remove(r.RowId);
            }

            armedGroup = null;
            StateHasChanged();
            await Task.Delay(1);
            deleted = await DeleteNodeIdsAsync(targets.Select(r => r.NodeId));

            await ReloadAsync();
        }
        finally
        {
            busy = false;
        }

        // Grid first, toast calmly after (fire-and-forget): the sync already
        // left in background via the engine.
        StateHasChanged();
        Session.Log.Info("duplicates", deleted > 0 ? $"Deleted {deleted} duplicate(s)" : "Nothing to delete");
        _ = Toast.ShowAsync(deleted > 0
            ? WorkflowTexts.DupDeleteDone(deleted)
            : L.Get(Str.DupNothing));
    }

    private async Task ExecuteAll()
    {
        if (Session.Engine is null || busy)
        {
            return;
        }

        busy = true;
        deleteError = string.Empty;
        var count = 0;
        try
        {
            var byGroup = new List<(Core.Data.DuplicateGroup Group, List<Core.Data.ItemRow> Targets)>();
            foreach (var g in groups)
            {
                var targets = g.Rows
                    .Where(r => selected.Contains(r.RowId) &&
                                g.Rows.Any(o => o.RowId != r.RowId && !selected.Contains(o.RowId)))
                    .ToList();
                if (targets.Count > 0)
                {
                    byGroup.Add((g, targets));
                }
            }

            // Optimistic: hide them now, reconcile with the store after.
            foreach (var (grp, targets) in byGroup)
            {
                foreach (var r in targets)
                {
                    grp.Rows.Remove(r);
                    selected.Remove(r.RowId);
                }
            }

            armedAll = false;
            StateHasChanged();
            await Task.Delay(1);
            count = await DeleteNodeIdsAsync(byGroup.SelectMany(x => x.Targets).Select(r => r.NodeId));

            await ReloadAsync();
        }
        finally
        {
            busy = false;
        }

        // Grid first, toast calmly after (fire-and-forget): the sync already
        // left in background via the engine.
        StateHasChanged();
        Session.Log.Info("duplicates", count > 0 ? $"Deleted {count} duplicate(s)" : "Nothing to delete");
        _ = Toast.ShowAsync(count > 0
            ? WorkflowTexts.DupDeleteDone(count)
            : L.Get(Str.DupNothing));
    }

    private RenderFragment DupRow(Core.Data.ItemRow r, string line1, string line2) => __builder =>
    {
        var marked = selected.Contains(r.RowId);
        var locked = IsLocked(r.RowId);
        <div class="xbs-duprow" data-rowid="@r.RowId">
            <button type="button" class="xbs-dupmark @(marked ? "on" : string.Empty)" disabled="@locked"
                    aria-pressed="@marked.ToString().ToLowerInvariant()"
                    aria-label="@MarkLabel(marked, locked)"
                    @onclick="() => Toggle(r.RowId)" @onclick:stopPropagation="true">
                @if (marked)
                {
                    <span aria-hidden="true">✕</span>
                }
                else if (locked)
                {
                    <svg class="km-ico sm" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
                }
            </button>
            <button type="button" class="xbs-duptext" aria-label="@L.Get(Str.DupOpenAria, r.Title ?? r.Url ?? string.Empty)" @onclick="() => Open(r)">
                <span class="xbs-duptext-title">@line1</span>
                @if (!string.IsNullOrEmpty(line2))
                {
                    <span class="xbs-duptext-sub">@line2</span>
                }
                @if (expandedDup.Contains(r.RowId))
                {
                    @if (!string.IsNullOrEmpty(r.Description))
                    {
                        <span class="xbs-row-desc">@r.Description</span>
                    }
                    @if (!string.IsNullOrEmpty(r.Tags))
                    {
                        <span class="xbs-row-tags">#@r.Tags.Replace("\u001F", " #")</span>
                    }
                    @if (string.IsNullOrEmpty(r.Description) && string.IsNullOrEmpty(r.Tags))
                    {
                        <span class="xbs-duptext-sub">@L.Get(Str.DupNoDetails)</span>
                    }
                }
            </button>
        </div>
    };

    [JSInvokable] public Task OnDupSwipeRight(int rowId)
    {
        expandedDup.Add(rowId);
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable] public Task OnDupSwipeLeft(int rowId)
    {
        if (expandedDup.Remove(rowId))
        {
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNet = DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("xbsGestures.initDup", dotNet, gestureOwner); } catch { }
        }
    }

    public override void Dispose()
    {
        base.Dispose();
        if (Session.Engine is not null)
        {
            Session.Engine.DataChanged -= OnData;
        }

        _ = JS.InvokeVoidAsync("xbsGestures.release", gestureOwner);
        dotNet?.Dispose();
    }
}
