@page "/settings/security"
@using Keepmark.Core.Security
@inject KeepmarkMobile.Services.XbsSession Session
@inject KeepmarkMobile.Services.XbsSettings AppSettings
@inject KeepmarkMobile.Services.IAppLockService AppLock
@inject KeepmarkMobile.Services.AppLockState LockState

<PageTitle>Security</PageTitle>

<a class="xbs-back" href="settings"><svg class="km-ico sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>Settings</a>
<h1>Security</h1>

<div class="mb-3">
    <label class="form-label" for="app-lock">App lock (device PIN / biometric)</label>
    <select id="app-lock" class="form-select" @bind="appLock">
        <option value="Off">Off (default)</option>
        <option value="PinOnly">PIN only (device PIN, pattern or password)</option>
        <option value="BiometricAndPin">Biometric + PIN fallback</option>
    </select>
    <div class="form-text">When the app is locked, the PIN or fingerprint prompt opens right away.</div>
</div>

@if (appLock != "Off")
{
    <div class="mb-3">
        <label class="form-label" for="relock">Lock again after the app goes to the background</label>
        <select id="relock" class="form-select" @bind="relockAfter">
            @foreach (var p in LockPolicy.Presets)
            {
                <option value="@p">@LockPolicy.Label(p)</option>
            }
        </select>
        <div class="form-text">The app always locks after a restart. Making this longer asks for the device PIN.</div>
    </div>
}

<button class="btn btn-primary" @onclick="Save">Save</button>
@if (saved)
{
    <span class="text-success ms-2" role="status">Saved.</span>
}
@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger mt-2" role="alert">@error</div>
}

@code {
    private string appLock = "Off";
    private int relockAfter = LockPolicy.DefaultMinutes;
    private string error = string.Empty;
    private bool saved;

    protected override void OnInitialized()
    {
        appLock = AppSettings.AppLock;
        relockAfter = AppSettings.LockTimeoutMinutes;
    }

    private async Task Save()
    {
        error = string.Empty;
        saved = false;

        // Turning the lock on/off, or keeping the app unlocked longer, weakens
        // or changes protection: always confirm with the device PIN.
        var lockChanged = appLock != AppSettings.AppLock;
        var laxer = appLock != "Off" && LockPolicy.IsLaxer(AppSettings.LockTimeoutMinutes, relockAfter);
        if (lockChanged || laxer)
        {
            var title = !lockChanged ? "Confirm longer unlock time"
                : appLock == "Off" ? "Confirm disabling app lock"
                : "Confirm app lock activation";
            bool confirmed = false;
            LockState.BeginAuth();
            try
            {
                confirmed = await AppLock.AuthenticateAsync(title, requireDeviceCredential: true);
            }
            catch
            {
                confirmed = false;
            }
            finally
            {
                // Success also counts as an unlock; a cancel here never locks.
                LockState.EndAuth(confirmed);
            }

            if (!confirmed)
            {
                appLock = AppSettings.AppLock;
                relockAfter = AppSettings.LockTimeoutMinutes;
                error = "Not confirmed with the device PIN. Nothing changed.";
                return;
            }
        }

        AppSettings.AppLock = appLock;
        AppSettings.LockTimeoutMinutes = relockAfter;
        relockAfter = AppSettings.LockTimeoutMinutes;
        Session.NotifySettingsChanged();
        saved = true;
    }
}
