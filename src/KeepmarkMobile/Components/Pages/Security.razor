@page "/settings/security"
@using Keepmark.Core.Security
@inject KeepmarkMobile.Services.XbsSession Session
@inject KeepmarkMobile.Services.XbsSettings AppSettings
@inject KeepmarkMobile.Services.IAppLockService AppLock
@inject KeepmarkMobile.Services.AppLockState LockState
@inject KeepmarkMobile.Services.ToastState Toast
@inject NavigationManager Nav

<PageTitle>@L.Get(Str.SettingsSecurity)</PageTitle>

<a class="xbs-back" href="settings"><svg class="km-ico sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>@L.Get(Str.NavSettings)</a>
<h1>@L.Get(Str.SettingsSecurity)</h1>

<div class="mb-3">
    <label class="form-label" for="app-lock">@L.Get(Str.SecAppLockLabel)</label>
    <select id="app-lock" class="form-select" @bind="appLock">
        <option value="Off">@L.Get(Str.SecOff)</option>
        <option value="PinOnly">@L.Get(Str.SecPinOnly)</option>
        <option value="BiometricAndPin">@L.Get(Str.SecBiometric)</option>
    </select>
    <div class="form-text">@L.Get(Str.SecAppLockHint)</div>
</div>

@if (appLock != "Off")
{
    <div class="mb-3">
        <label class="form-label" for="relock">@L.Get(Str.SecRelockLabel)</label>
        <select id="relock" class="form-select" @bind="relockAfter">
            @foreach (var p in LockPolicy.Presets)
            {
                <option value="@p">@LockPolicy.Label(p)</option>
            }
        </select>
        <div class="form-text">@L.Get(Str.SecRelockHint)</div>
    </div>
}

<button class="btn btn-primary" @onclick="Save">@L.Get(Str.CommonSave)</button>
@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger mt-2" role="alert">@error</div>
}

@code {
    private string appLock = "Off";
    private int relockAfter = LockPolicy.DefaultMinutes;
    private string error = string.Empty;

    protected override void OnInitialized()
    {
        appLock = AppSettings.AppLock;
        relockAfter = AppSettings.LockTimeoutMinutes;
    }

    private async Task Save()
    {
        error = string.Empty;

        // Turning the lock on/off, or keeping the app unlocked longer, weakens
        // or changes protection: always confirm with the device PIN.
        var lockChanged = appLock != AppSettings.AppLock;
        var laxer = appLock != "Off" && LockPolicy.IsLaxer(AppSettings.LockTimeoutMinutes, relockAfter);
        if (lockChanged || laxer)
        {
            var title = !lockChanged ? L.Get(Str.SecConfirmLonger)
                : appLock == "Off" ? L.Get(Str.SecConfirmDisable)
                : L.Get(Str.SecConfirmEnable);
            bool confirmed = false;
            LockState.BeginAuth();
            try
            {
                confirmed = await AppLock.AuthenticateAsync(title, requireDeviceCredential: true);
            }
            catch
            {
                confirmed = false;
            }
            finally
            {
                // Success also counts as an unlock; a cancel here never locks.
                LockState.EndAuth(confirmed);
            }

            if (!confirmed)
            {
                appLock = AppSettings.AppLock;
                relockAfter = AppSettings.LockTimeoutMinutes;
                error = L.Get(Str.SecNotConfirmed);
                return;
            }
        }

        AppSettings.AppLock = appLock;
        AppSettings.LockTimeoutMinutes = relockAfter;
        Session.NotifySettingsChanged();
        // Done here: back to Settings, the confirmation fades on its own.
        _ = Toast.ShowAsync(L.Get(Str.SecSaved));
        Nav.NavigateTo("settings");
    }
}
