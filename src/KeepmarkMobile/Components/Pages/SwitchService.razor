@inherits KeepmarkMobile.Components.SessionComponentBase
@page "/switch-service"
@page "/migrate"
@inject KeepmarkMobile.Services.XbsSession Session
@inject KeepmarkMobile.Services.XbsSettings AppSettings
@inject KeepmarkMobile.Services.ToastState Toast
@inject KeepmarkMobile.Services.SecureCredentialStore Creds
@inject NavigationManager Nav
@inject KeepmarkMobile.Services.IQrScanner QrScanner
@inject KeepmarkMobile.Services.AppLockState AppLock
@using Keepmark.Core.Workflow

<PageTitle>@L.Get(Str.NavMoveService)</PageTitle>

<h1>@L.Get(Str.SwH1)</h1>
<p class="text-muted">@L.Get(Str.SwIntro)</p>

@if (!Session.Ready)
{
    <p role="status"><em>@L.Get(Str.BackupStarting)</em></p>
}
else if (!linked)
{
    <div class="alert alert-info">
        <strong>@L.Get(Str.SwNoLinkA)</strong>
        @L.Get(Str.SwNoLinkB)
        <a href="connect">@L.Get(Str.SwNoLinkLink)</a>@L.Get(Str.SwNoLinkC)
    </div>
}
else if (step == 4)
{
    <div class="alert alert-success" role="status">
        <h4>@L.Get(Str.SwComplete)</h4>
        @if (createdId is not null)
        {
            <p>@L.Get(Str.SwCreatedA) <strong>@TargetUrlClean</strong> @Loc.Plural(Str.SwCreatedB, localCount)</p>
            <p>@L.Get(Str.SwNewIdHint)</p>
            <p><code>@createdId</code></p>
        }
        else
        {
            <p>@L.Get(Str.SwNowSyncingA) <code>@WorkflowRules.ShortId(probe?.Candidate.Id)</code> @L.Get(Str.SwNowSyncingB) <strong>@TargetUrlClean</strong>.</p>
            @if (tookRemote)
            {
                <p>@L.Get(Str.SwTookRemoteA) <strong>@TargetUrlClean</strong>@L.Get(Str.SwTookRemoteB)</p>
            }
            else if (direction == "merge")
            {
                <p>@Core.Sync.MoveResult.Describe("existing", "merge", TargetUrlClean, WorkflowRules.ShortId(probe?.Candidate.Id)) @L.Get(Str.ConnSafetyBoth)</p>
            }
            else
            {
                <p>@L.Get(Str.SwUploadedA, localCount, probe?.RemoteCount) <strong>@TargetUrlClean</strong>@L.Get(Str.SwUploadedB)</p>
            }
        }
        <p>@WorkflowTexts.MoveDoneNext</p>
        <button class="btn btn-secondary" @onclick="CopyId">@L.Get(Str.ConnCopySyncId)</button>
    </div>
    <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("/")'>@L.Get(Str.SwBackToExplore)</button>
}
else
{
    @* Destination and credentials, then one review with the definitive action. *@
    <div class="xbs-wizard-head">
        @if (step > 1)
        {
            <button class="xbs-back" @onclick="GoBack" disabled="@busy"><svg class="km-ico sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>@L.Get(Str.CommonBack)</button>
        }
        else
        {
            <span></span>
        }
        @if (!qrState.ShowReview)
        {
            <span class="xbs-stepcount">@L.Get(Str.SwStep, step == 3 ? 2 : 1)</span>
        }
    </div>
    @if (resumed && !qrState.ShowReview)
    {
        <div class="alert alert-info" role="status">
            @L.Get(Str.SwResumed)
        </div>
    }

    @if (qrState.ShowReview)
    {
        <QrCredentialReview ServiceUrl="@qrServiceUrl" SyncId="@qrSyncId" Busy="@(busy || qrState.IsVerifying)"
                            OnVerify="VerifyQr" OnCancel="CancelQr" />
    }
    else
    {
    @if (step == 1)
    {
        <button class="btn btn-secondary mb-2" @onclick="ScanQr" disabled="@busy"><svg class="km-ico sm me-2" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h6v6H3zM15 3h6v6h-6zM3 15h6v6H3zM15 15h2v2h-2zM19 15h2v6h-2zM15 19h2v2h-2z" /></svg>@L.Get(Str.ConnQrScan)</button>
            <div class="form-text mb-3">@L.Get(Str.ConnQrHint)</div>
        @if (!string.IsNullOrEmpty(qrError))
        {
            <div class="alert alert-danger" role="alert">@qrError</div>
        }
    }
    @if (step == 1)
    {
        <h2 class="xbs-step-title">@L.Get(Str.SwWhere)</h2>
        <ServiceSelector Value="@targetUrl" ValueChanged="ServiceChanged" Checked="ServiceChecked" Disabled="@busy" />
        <div class="mb-3">
            <label class="form-label">@L.Get(Str.SwIntoWhich)</label>
            <select class="form-select" disabled="@busy" @bind="slot" @bind:after="Unverify">
                <option value="new">@L.Get(Str.SwANew)</option>
                <option value="existing">@L.Get(Str.SwExisting)</option>
            </select>
        </div>
        @if (slot == "new")
        {
            <label class="form-label">@L.Get(Str.CommonNewPassword)</label>
            <input disabled="@busy" type="password" class="form-control" @bind="newPassword" @bind:event="oninput" autocomplete="new-password" />
            <label class="form-label mt-2">@L.Get(Str.ConnConfirmPassword)</label>
            <input disabled="@busy" type="password" class="form-control" @bind="confirmPassword" @bind:event="oninput" autocomplete="new-password" />
            <div class="form-text mb-3">@L.Get(Str.SwPwHint)</div>
        }
        else if (!VerifiedExisting)
        {
            <label class="form-label">@L.Get(Str.ConnSyncId)</label>
            <input disabled="@busy" class="form-control" @bind="syncId" @bind:after="ClearQr" />
            <label class="form-label mt-2">@L.Get(Str.CommonPassword)</label>
            <input disabled="@busy" type="password" class="form-control mb-3" @bind="password" @bind:after="ClearQr" autocomplete="current-password" />
        }
        @if (slot == "existing" && VerifiedExisting)
        {
            <p><code>@WorkflowRules.ShortId(probe?.Candidate.Id)</code>
                <button class="xbs-link-btn" @onclick="Unverify" disabled="@busy">@L.Get(Str.CommonChange)</button>
            </p>
        }
        <div class="d-grid">
            <button class="btn btn-primary" @onclick="ContinueToReview" disabled="@(busy || !serviceOk || (slot == "new" && serviceInfo?.Status != Core.Models.ServiceStatus.Online))">@L.Get(Str.CommonNext)</button>
        </div>
        @if (!string.IsNullOrEmpty(checkError))
        {
            <div class="alert alert-danger mt-2" role="alert">@checkError</div>
        }
        @if (!string.IsNullOrEmpty(verifyError))
        {
            <div class="alert alert-danger mt-2" role="alert">@verifyError</div>
        }
    }
    else
    {
        <h2 class="xbs-step-title">@L.Get(Str.SwReview)</h2>
        @if (slot == "existing" && probe is not null)
        {
            <DirectionPicker Name="migdir" Value="@PickerValue" ValueChanged="OnPickerChanged"
                             LocalCount="localCount" RemoteCount="probe.RemoteCount" Disabled="busy" />
        }
        <div class="xbs-review">
            @if (slot == "new")
            {
                <p>@Loc.Plural(Str.SwRevNew, localCount, TargetUrlClean)</p>

            }
            else if (direction == "upload")
            {
                <p>@L.Get(Str.SwRevUpload, probe?.RemoteCount, WorkflowRules.ShortId(probe?.Candidate.Id), TargetUrlClean, localCount)</p>
            }
            else if (direction == "merge")
            {
                <p>@L.Get(Str.SwRevMerge, localCount, probe?.RemoteCount, WorkflowRules.ShortId(probe?.Candidate.Id), TargetUrlClean)</p>
                @if (mergeStats is not null)
                {
                    <ul class="xbs-review-list">
                        <li><strong>@mergeStats.LocalOnly</strong> @L.Get(Str.ConnReviewUpload)</li>
                        <li><strong>@mergeStats.RemoteOnly</strong> @L.Get(Str.ConnReviewDownload)</li>
                        @if (mergeStats.TitleConflicts > 0)
                        {
                            <li><strong>@mergeStats.TitleConflicts</strong> @Loc.Plural(Str.ConnReviewTitles, mergeStats.TitleConflicts)</li>
                        }
                    </ul>
                }
            }
            else
            {
                <p>@L.Get(Str.SwRevDownload, localCount, probe?.RemoteCount, WorkflowRules.ShortId(probe?.Candidate.Id), TargetUrlClean)</p>
            }
        </div>
        <p class="text-muted">@MoveConfirm.Implication</p>
        @if (targetExpiryDays is not null)
        {
            <p class="form-text">@L.Get(Str.StatusSyncExpiryLine, WorkflowRules.DescribeSyncExpiry(targetExpiryDays))</p>
        }
        <div class="d-grid">
            <button class="btn @(ReplacesSomething ? "btn-danger" : "btn-primary")" @onclick="Execute" disabled="@(busy || (slot == "existing" && direction == "merge" && (mergeStats is null || !ReferenceEquals(mergeStatsFor, probe))))">@(busy ? L.Get(Str.SwMoving) : L.Get(Str.SwMoveNow))</button>
        </div>
        @if (!string.IsNullOrEmpty(verifyError))
        {
            <div class="alert alert-danger mt-2" role="alert">@verifyError</div>
        }
        @if (!string.IsNullOrEmpty(reviewError))
        {
            <div class="alert alert-danger mt-2" role="alert">@reviewError</div>
        }
        <div class="text-center mt-3">
            <button class="xbs-link-btn" @onclick="StartOver" disabled="@busy">@L.Get(Str.SwStartOver)</button>
        </div>
    }
    }
}


@code {
    private int step = 1;
    private string targetUrl = Core.XbsConstants.DefaultServiceUrl;
    private Core.Api.ServiceInfoResponse? serviceInfo;
    private string TargetUrlClean => WorkflowRules.NormalizeServiceUrl(targetUrl);
    private int? targetExpiryDays;
    private string? checkedUrl;
    private string slot = "new";
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private string syncId = string.Empty;
    private string password = string.Empty;
    private Services.ReconcileInfo? probe;
    private string? verifiedFor;
    /// <summary>Migration direction: "take" = take remote (safe default),
    /// "upload" = upload local over the remote, "merge" = union (never deletes).</summary>
    private string direction = "take";
    private Core.Sync.MergeStats? mergeStats;
    private Services.ReconcileInfo? mergeStatsFor;
    private bool tookRemote;
    private string? createdId;
    private int localCount;
    private bool busy;
    private string checkError = string.Empty;
    private string verifyError = string.Empty;
    private string reviewError = string.Empty;
    private bool linked;
    private bool resumed;


    private bool serviceOk =>
        serviceInfo is not null && checkedUrl == TargetUrlClean;

    protected override void OnInitialized()
    {
        // Open on the service this device is linked to, so the current
        // destination is recognisable before it is changed; the catalog
        // default still applies while no sync is linked.
        var current = AppSettings.ServiceUrl;
        if (!string.IsNullOrWhiteSpace(current)) targetUrl = current;
        AppLock.Changed += LockChanged;
    }

    private readonly ConnectQrCandidateState qrState = new();
    private ConnectQrPayload? pendingQr => qrState.Payload;
    private CancellationTokenSource? qrExpiry;
    private int qrGeneration => qrState.Generation;
    private string qrError = string.Empty;
    private string qrServiceUrl = string.Empty;
    private string qrSyncId = string.Empty;

    private void ClearQr()
    {
        qrState.Clear();
        qrServiceUrl = qrSyncId = string.Empty;
        StopQrExpiry();
    }

    private void CancelQr()
    {
        ClearQr();
        qrError = string.Empty;
    }

    private void StopQrExpiry()
    {
        qrExpiry?.Cancel();
        qrExpiry?.Dispose();
        qrExpiry = null;
    }

    private void LockChanged()
    {
        if (AppLock.Locked || !AppLock.Foreground)
            _ = InvokeAsync(() =>
            {
                // The permission dialog can pause the activity before any camera
                // session exists. The scanner rechecks lock/foreground after it.
                // Native active sessions cancel themselves on this event.
                if (qrState.ShowReview) ClearQr();
                if (!IsDisposed) StateHasChanged();
            });
    }

    private async Task ScanQr()
    {
        if (busy || !linked || AppLock.Locked || !AppLock.Foreground) return;
        ClearQr();
        var generation = qrGeneration;
        busy = true; qrError = string.Empty;
        try
        {
            var text = await QrScanner.ScanAsync(Lifetime);
            if (IsDisposed || Lifetime.IsCancellationRequested || generation != qrGeneration || AppLock.Locked || !AppLock.Foreground) return;
            if (text is null) return;
            var allowLocal = false;
#if DEBUG
            allowLocal = true;
#endif
            if (!ConnectQrPayload.TryParse(text, out var candidate, allowLocal))
            { qrError = L.Get(Str.ConnQrInvalid); return; }
            serviceInfo = null; checkedUrl = null; targetExpiryDays = null;
            checkError = verifyError = reviewError = string.Empty;
            probe = null; verifiedFor = null; mergeStats = null; mergeStatsFor = null;
            resumed = false;
            password = newPassword = confirmPassword = string.Empty;
            qrServiceUrl = candidate!.ServiceUrl; qrSyncId = candidate.Id;
            Session.PendingSwitch = null;
            if (!qrState.Offer(candidate, generation)) return;
            qrExpiry = CancellationTokenSource.CreateLinkedTokenSource(Lifetime);
            _ = ExpireQr(generation, qrExpiry.Token);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (!IsDisposed && generation == qrGeneration)
                qrError = ex is Services.QrScanException scanError ? L.Get(scanError.MessageKey) : L.Get(Str.ConnQrUnavailable);
            Session.Log.Warn("switch", $"QR scanner failed: {ex.GetType().Name}");
        }
        finally { if (!IsDisposed) busy = false; }
    }

    private async Task ExpireQr(int generation, CancellationToken ct)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(60), ct);
            await InvokeAsync(() =>
            {
                if (IsDisposed || generation != qrGeneration) return;
                ClearQr(); qrError = L.Get(Str.ConnQrCleared); StateHasChanged();
            });
        }
        catch (OperationCanceledException) { }
    }

    private async Task VerifyQr()
    {
        if (busy || !linked || pendingQr is null || AppLock.Locked || !AppLock.Foreground) return;
        var candidate = qrState.BeginVerification();
        StopQrExpiry();
        if (candidate is null) { qrError = L.Get(Str.ConnQrCleared); return; }
        var generation = qrGeneration;
        var targetUrl = candidate.ServiceUrl;
        var targetId = candidate.Id;
        var secret = candidate.Password;
        candidate = null;
        var task = VerifyExistingCredentials(targetUrl, targetId, secret, checkTarget: true, qrAttempt: generation);
        secret = string.Empty;
        try { await task; }
        finally { if (generation == qrGeneration) ClearQr(); }
    }

    private bool CurrentQrAttempt(int generation) => !IsDisposed && generation == qrGeneration
        && qrState.IsVerifying && !AppLock.Locked && AppLock.Foreground;

    public override void Dispose()
    {
        AppLock.Changed -= LockChanged;
        ClearQr();
        base.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        if (!await WaitForSessionAsync(Session)) return;

        if (Session.Store is not null)
        {
            var stats = await Session.Store.GetStatsAsync();
            localCount = stats.Folders + stats.Bookmarks + stats.Separators;
        }

        linked = await Creds.GetAsync() is not null;

        // Resume an unfinished wizard (user went to inspect the bookmarks
        // mid-review): secrets were never stored, the probe survives.
        if (Session.PendingSwitch is { } draft)
        {
            targetUrl = draft.TargetUrl;
            slot = draft.Slot;
            syncId = draft.SyncId;
            direction = draft.Direction is "upload" or "merge" ? draft.Direction : "take";
            probe = draft.Probe;
            verifiedFor = draft.VerifiedFor;
            // Resume on the form, never on the review: a new sync needs its
            // password again (never stored), a merge its preview again, and
            // the service its check again. "Review the move" redoes them.
            step = 1;
            resumed = true;
            try
            {
                serviceInfo = await Session.CheckServiceAsync(TargetUrlClean);
                checkedUrl = TargetUrlClean;
                targetExpiryDays = await Session.GetSyncExpiryDaysAsync(TargetUrlClean);
            }
            catch (Exception ex)
            {
                step = 1;
                checkError = ex.Message;
                Session.Log.Warn("switch", $"resume check failed: {ex.GetType().Name}");
            }
        }
    }


    /// <summary>Changing direction invalidates the merge preview (counts must
    /// always match the verified sync + direction).</summary>
    private void SetDirection(string value)
    {
        direction = value;
        mergeStats = null;
        mergeStatsFor = null;
        verifyError = string.Empty;
    }

    /// <summary>An existing sync stays verified only for the exact ID it was
    /// verified with: editing the ID (or URL) brings the credential inputs
    /// back automatically.</summary>
    private bool VerifiedExisting =>
        probe is not null && verifiedFor == $"{TargetUrlClean}|{syncId.Trim()}";

    private void Unverify()
    {
        ClearQr();
        probe = null;
        verifiedFor = null;
        mergeStats = null;
        mergeStatsFor = null;
    }

    private Task ServiceChanged(string url) { targetUrl = url; Unverify(); checkedUrl = null; serviceInfo = null; targetExpiryDays = null; return Task.CompletedTask; }
    private async Task ServiceChecked(Core.Api.ServiceInfoResponse? info)
    {
        serviceInfo = info;
        checkedUrl = info is null ? null : TargetUrlClean;
        targetExpiryDays = info?.Capabilities?.SyncExpiryDays;
        if (info is null) return;
        var url = TargetUrlClean;
        var expiry = await Session.GetSyncExpiryDaysAsync(url, Lifetime);
        if (!IsDisposed && checkedUrl == url && ReferenceEquals(serviceInfo, info)) targetExpiryDays = expiry;
    }


    private Task VerifyExisting() => VerifyExistingCredentials(TargetUrlClean, syncId.Trim(), password);

    private async Task VerifyExistingCredentials(string url, string id, string secret, bool checkTarget = false, int? qrAttempt = null)
    {
        await RunStepAsync(async () =>
        {
            if (string.IsNullOrWhiteSpace(id) || string.IsNullOrEmpty(secret))
            {
                throw new InvalidOperationException(L.Get(Str.ConnEnterBoth));
            }

            // Capture the probe task, then release our raw secret before awaiting it.
            var probeTask = Session.ProbeLinkAsync(url, id, secret, Lifetime);
            secret = string.Empty;
            var result = await probeTask;
            if (IsDisposed || Lifetime.IsCancellationRequested || (qrAttempt.HasValue && !CurrentQrAttempt(qrAttempt.Value))) return;
            if (checkTarget)
            {
                // Explicit Open sync is the first network action for a QR.
                serviceInfo = await Session.CheckServiceAsync(url);
                if (IsDisposed || Lifetime.IsCancellationRequested || (qrAttempt.HasValue && !CurrentQrAttempt(qrAttempt.Value))) return;
                checkedUrl = url;
                targetExpiryDays = await Session.GetSyncExpiryDaysAsync(url);
                if (IsDisposed || Lifetime.IsCancellationRequested || (qrAttempt.HasValue && !CurrentQrAttempt(qrAttempt.Value))) return;
                targetUrl = url; syncId = id; slot = "existing"; step = 3;
            }
            probe = result;
            // Consumed: the probe carries the key; a failed check keeps it for a retry.
            password = string.Empty;
            verifiedFor = $"{url}|{id}";
            direction = "take";
            mergeStats = null;
            mergeStatsFor = null;
            tookRemote = false;
            resumed = false;
            SaveDraft();
        }, err =>
        {
            if (!checkTarget) verifyError = err;
            else if (!qrAttempt.HasValue || CurrentQrAttempt(qrAttempt.Value)) qrError = err;
        }, "switch-verify");
    }

    private async Task PreviewMerge()
    {
        await RunStepAsync(async () =>
        {
            if (probe is null || verifiedFor != $"{TargetUrlClean}|{syncId.Trim()}")
            {
                throw new InvalidOperationException(L.Get(Str.SwOpenFirst));
            }

            var target = probe;
            var preview = await Session.GetMergePreviewAsync(target);
            if (IsDisposed || !ReferenceEquals(target, probe) || direction != "merge") return;
            mergeStats = preview;
            mergeStatsFor = target;
        }, err => verifyError = err, "switch-merge-preview");
    }

    /// <summary>The picker speaks download/upload/merge; this page keeps "take" for download.</summary>
    private string PickerValue => direction == "take" ? "download" : direction;

    private async Task OnPickerChanged(string value)
    {
        if (busy) return;
        SetDirection(value == "download" ? "take" : value);
        if (direction == "merge") await PreviewMerge();
    }

    /// <summary>Upload and download overwrite one side: the final button is red.</summary>
    private bool ReplacesSomething => slot == "existing" && direction != "merge";

    /// <summary>Consequences displayed before the definitive move action.</summary>
    private WorkflowTexts.Confirm MoveConfirm
    {
        get
        {
            if (slot == "new")
            {
                return new(WorkflowTexts.MoveNewConfirm(TargetUrlClean, localCount), WorkflowTexts.MoveImplication, L.Get(Str.CommonYesMove));
            }

            var d = WorkflowTexts.DirectionConfirm(PickerValue);
            return d with { Implication = $"{d.Implication} {WorkflowTexts.MoveImplication}" };
        }
    }

    /// <summary>Return to the destination form; the next Continue revalidates it.</summary>
    private void GoBack()
    {
        if (qrState.ShowReview) { CancelQr(); return; }
        ClearQr();
        verifyError = string.Empty;
        reviewError = string.Empty;
        step = 1;
    }

    private async Task ContinueToReview()
    {
        if (busy) return;
        if (slot == "new")
        {
            try { WorkflowRules.RequireNewPassword(newPassword, confirmPassword); }
            catch (Exception ex) { verifyError = ex.Message; return; }
        }
        if (!serviceOk || !string.IsNullOrEmpty(checkError) || (slot == "new" && serviceInfo?.Status != Core.Models.ServiceStatus.Online)) return;
        if (slot == "existing" && !VerifiedExisting)
        {
            await VerifyExisting();
            if (!VerifiedExisting) return;
        }
        await GoReview();
    }

    private async Task GoReview()
    {
        try
        {
            if (slot == "new")
            {
                WorkflowRules.RequireNewPassword(newPassword, confirmPassword);
            }
            else if (direction == "merge" && (mergeStats is null || !ReferenceEquals(mergeStatsFor, probe)))
            {
                // Merge stays preview-locked: the review shows the dry-run
                // counts for exactly this probe, computed here.
                await PreviewMerge();
                if (mergeStats is null)
                {
                    return;
                }
            }

            verifyError = string.Empty;
            reviewError = string.Empty;
            resumed = false;
            step = 3;
            SaveDraft();
        }
        catch (Exception ex)
        {
            verifyError = ex.Message;
            Session.Log.Warn("switch", $"GoReview failed: {ex.GetType().Name}");
        }
    }

    /// <summary>Snapshots the wizard (without secrets) so leaving the page
    /// to inspect the bookmarks doesn't lose the review.</summary>
    private void SaveDraft()
    {
        Session.PendingSwitch = new Services.SwitchDraft(
            TargetUrlClean, slot, syncId.Trim(), direction, probe, verifiedFor, step);
    }

    private void StartOver()
    {
        ClearQr();
        Session.PendingSwitch = null;
        step = 1;
        slot = "new";
        syncId = string.Empty;
        password = string.Empty;
        newPassword = string.Empty;
        confirmPassword = string.Empty;
        probe = null;
        verifiedFor = null;
        mergeStats = null;
        mergeStatsFor = null;
        direction = "take";
        tookRemote = false;
        createdId = null;
        serviceInfo = null;
        targetExpiryDays = null;
        checkedUrl = null;
        resumed = false;
        checkError = string.Empty;
        verifyError = string.Empty;
        reviewError = string.Empty;
    }

    private async Task Execute()
    {
        if (busy || step != 3) return;
        await RunStepAsync(async () =>
        {
            if (!serviceOk)
            {
                throw new InvalidOperationException(L.Get(Str.SwRecheck));
            }

            tookRemote = false;
            createdId = null;

            if (slot == "new")
            {
                WorkflowRules.RequireNewPassword(newPassword, confirmPassword);
                createdId = await Session.CreateNewSyncWithUploadAsync(TargetUrlClean, newPassword);
            }
            else
            {
                if (probe is null || verifiedFor != $"{TargetUrlClean}|{syncId.Trim()}")
                {
                    throw new InvalidOperationException(L.Get(Str.SwOpenFirst));
                }

                if (direction == "upload")
                {
                    await Session.ApplyLocalAsync(probe, Keepmark.Core.Safety.SafetyOperations.SwitchUpload);
                }
                else if (direction == "merge")
                {
                    if (mergeStats is null || !ReferenceEquals(mergeStatsFor, probe))
                    {
                        throw new InvalidOperationException(L.Get(Str.SwPreviewFirst));
                    }

                    await Session.ApplyMergeAsync(probe, Keepmark.Core.Safety.SafetyOperations.SwitchMerge);
                }
                else
                {
                    await Session.ApplyRemoteAsync(probe, Keepmark.Core.Safety.SafetyOperations.SwitchTakeRemote);
                    tookRemote = true;
                }
            }

            AppSettings.ServiceUrl = TargetUrlClean;
            newPassword = string.Empty;
            confirmPassword = string.Empty;
            step = 4;
            Session.PendingSwitch = null;
            Session.Log.Info("switch", createdId is not null
                ? "Move complete: new sync created and uploaded"
                : direction == "merge" ? "Move complete: merged both sides"
                : tookRemote ? "Move complete: downloaded the server copy" : "Move complete: uploaded local bookmarks");
        }, err => reviewError = err, "switch-execute");
    }

    private async Task CopyId()
    {
        var id = createdId ?? probe?.Candidate.Id;
        if (id is null)
        {
            return;
        }

        try
        {
            await Clipboard.Default.SetTextAsync(id);
            _ = Toast.ShowAsync(L.Get(Str.ConnCopied));
        }
        catch
        {
            _ = Toast.ShowAsync(L.Get(Str.ConnCopyFailed), isError: true);
        }
    }



    /// <summary>One action cluster, one adjacent error box: each wizard step
    /// reports into its own field (check/verify/review) rendered next to the
    /// button that produced it, instead of a single shared box.</summary>
    private async Task RunStepAsync(Func<Task> action, Action<string> setError, [System.Runtime.CompilerServices.CallerMemberName] string op = "?")
    {
        busy = true;
        setError(string.Empty);
        try
        {
            Session.Log.Debug("switch", $"{op}: start");
            await action();
            Session.Log.Debug("switch", $"{op}: ok");
        }
        catch (OperationCanceledException) when (Lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            if (IsDisposed) return;
            setError(ex.Message);
            Session.Log.Warn("switch", $"{op} failed: {ex.GetType().Name}");
        }
        finally
        {
            // Secrets are cleared by each step once consumed, never on a
            // failure: the retry needs them (a failed Move kept the review).
            busy = false;
        }
    }
}
