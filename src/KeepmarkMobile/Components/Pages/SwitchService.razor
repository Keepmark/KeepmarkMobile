@page "/switch-service"
@page "/migrate"
@inject KeepmarkMobile.Services.XbsSession Session
@inject KeepmarkMobile.Services.XbsSettings AppSettings
@inject KeepmarkMobile.Services.ToastState Toast
@inject KeepmarkMobile.Services.SecureCredentialStore Creds
@inject NavigationManager Nav

<PageTitle>Move service</PageTitle>

<h1>Move to another service</h1>
<p class="text-muted">Move your bookmarks to a different xBrowserSync service, into a new or an existing sync. Anything replaced is saved to Backup → Safety backups first.</p>

@if (!Session.Ready)
{
    <p role="status"><em>Starting…</em></p>
}
else if (!linked)
{
    <div class="alert alert-info">
        <strong>No service linked yet.</strong>
        Switch moves an existing connection to another service —
        <a href="connect">connect a service first</a>, then come back here.
    </div>
}
else if (step == 4)
{
    <div class="alert alert-success" role="status">
        <h4>Move complete</h4>
        @if (createdId is not null)
        {
            <p>New sync created on <strong>@targetUrl</strong> with your @localCount item(s).</p>
            <p>Your new sync ID (save it together with the password — both are needed to open the sync elsewhere):</p>
            <p><code>@createdId</code></p>
            <button class="btn btn-secondary" @onclick="CopyId">Copy sync ID</button>
        }
        else if (tookRemote)
        {
            <p>Your local tree was replaced with the server item(s) from <strong>@targetUrl</strong>. A safety backup of the previous local bookmarks was saved — see Backup → Safety backups.</p>
        }
        else if (direction == "merge")
        {
            <p>@Core.Sync.MoveResult.Describe("existing", "merge", targetUrl, ShortId(probe?.Candidate.Id)) Safety backups of both sides were saved — see Backup → Safety backups.</p>
        }
        else
        {
            <p>Your @localCount local item(s) replaced the @probe?.RemoteCount server item(s) on <strong>@targetUrl</strong>. A safety backup of the overwritten server copy was saved — see Backup → Safety backups.</p>
        }
    </div>
    <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("/")'>Back to Explore</button>
}
else
{
    @* One question per screen, one primary action at the bottom, Back at the top. *@
    <div class="xbs-wizard-head">
        @if (step > 1)
        {
            <button class="xbs-back" @onclick="GoBack" disabled="@busy"><svg class="km-ico sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>Back</button>
        }
        else
        {
            <span></span>
        }
        <span class="xbs-stepcount">Step @step of 3</span>
    </div>

    @if (step == 1)
    {
        <h2 class="xbs-step-title">Where to move</h2>
        <div class="mb-3">
            <label class="form-label">Target service URL</label>
            <input class="form-control" @bind="targetUrl" @bind:event="oninput" inputmode="url" />
            <div class="form-text">The service that will receive your bookmarks. Your current link keeps working untouched until the move completes.</div>
        </div>
        @if (!serviceOk)
        {
            @* The next step unlocks only for the exact URL that answered: editing it brings the check back. *@
            <div class="d-grid">
                <button class="btn btn-primary" @onclick="CheckService" disabled="@busy">Check service</button>
            </div>
            @if (!string.IsNullOrEmpty(checkError))
            {
                <div class="alert alert-danger mt-2" role="alert">@checkError</div>
            }
        }
        else
        {
            <div class="xbs-verified" role="status">
                <svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                <div class="xbs-verified-text">
                    <strong>Service ready</strong>
                    <span>@serviceInfo!.Status · API v@(serviceInfo.Version)</span>
                </div>
            </div>
            <div class="d-grid">
                <button class="btn btn-primary" @onclick="() => step = 2" disabled="@busy">Next</button>
            </div>
        }
    }
    else if (step == 2 && !slotChosen)
    {
        <h2 class="xbs-step-title">Into which sync?</h2>
        <div class="xbs-choices">
            <button class="xbs-choice" @onclick='() => ChooseSlot("new")'>
                <span class="xbs-choice-ico"><svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></span>
                <span class="xbs-choice-text"><strong>A new sync</strong><span>Create it on @TargetHost and upload your @localCount item(s).</span></span>
                <svg class="km-ico sm xbs-choice-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
            </button>
            <button class="xbs-choice" @onclick='() => ChooseSlot("existing")'>
                <span class="xbs-choice-ico"><svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" /></svg></span>
                <span class="xbs-choice-text"><strong>An existing sync</strong><span>You already sync on @TargetHost: open it with its sync ID and password.</span></span>
                <svg class="km-ico sm xbs-choice-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
            </button>
        </div>
    }
    else if (step == 2 && slot == "new")
    {
        <h2 class="xbs-step-title">New sync on @TargetHost</h2>
        <div class="mb-3">
            <label class="form-label">New password</label>
            <input type="password" class="form-control" @bind="newPassword" @bind:event="oninput" autocomplete="new-password" />
            <label class="form-label mt-2">Confirm password</label>
            <input type="password" class="form-control" @bind="confirmPassword" @bind:event="oninput" autocomplete="new-password" />
            <div class="form-text">At least 8 characters. It encrypts everything and cannot be recovered.</div>
        </div>
        <div class="d-grid">
            <button class="btn btn-primary" @onclick="GoReview" disabled="@(busy || !CanReview())">Review the move</button>
        </div>
        @if (!string.IsNullOrEmpty(verifyError))
        {
            <div class="alert alert-danger mt-2" role="alert">@verifyError</div>
        }
    }
    else if (step == 2 && !VerifiedExisting)
    {
        <h2 class="xbs-step-title">Existing sync on @TargetHost</h2>
        <div class="mb-3">
            <label class="form-label">Sync ID</label>
            <input class="form-control" @bind="syncId" placeholder="xxxxxxxx-xxxx-…" />
            <label class="form-label mt-2">Password</label>
            <input type="password" class="form-control" @bind="password" autocomplete="current-password" />
            <div class="form-text">Checked against the server copy: a wrong password stops here, nothing is overwritten.</div>
        </div>
        <div class="d-grid">
            <button class="btn btn-primary" @onclick="VerifyExisting" disabled="@busy">Open sync</button>
        </div>
        @if (!string.IsNullOrEmpty(verifyError))
        {
            <div class="alert alert-danger mt-2" role="alert">@verifyError</div>
        }
    }
    else if (step == 2)
    {
        <h2 class="xbs-step-title">Existing sync on @TargetHost</h2>
        <div class="xbs-verified" role="status">
            <svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
            <div class="xbs-verified-text">
                <strong>Sync <code>@ShortId(probe?.Candidate.Id)</code> opened</strong>
                <span>@probe!.RemoteCount item(s) on the server · @localCount on this device</span>
            </div>
            <button class="xbs-link-btn" @onclick="Unverify" disabled="@busy">Change</button>
        </div>
        <DirectionPicker Name="migdir" Value="@PickerValue" ValueChanged="OnPickerChanged"
                         LocalCount="localCount" RemoteCount="probe.RemoteCount" Disabled="busy" />
        <div class="d-grid">
            <button class="btn btn-primary" @onclick="GoReview" disabled="@busy">Review the move</button>
        </div>
        @if (!string.IsNullOrEmpty(verifyError))
        {
            <div class="alert alert-danger mt-2" role="alert">@verifyError</div>
        }
    }
    else
    {
        <h2 class="xbs-step-title">Review the move</h2>
        @if (resumed)
        {
            <div class="alert alert-info" role="status">
                Resumed your unfinished move — counts may have changed while you were away. Go back and open the sync again if in doubt.
            </div>
        }
        <div class="xbs-review">
            @if (slot == "new")
            {
                <p>Create a <strong>new sync</strong> on <strong>@TargetHost</strong> and upload your <strong>@localCount</strong> item(s) into it.</p>
                <p class="text-muted mb-0">Nothing is replaced. The app then syncs with the new sync; its ID is shown at the end.</p>
            }
            else if (direction == "upload")
            {
                <p>Keep this device's copy: replace the <strong>@probe?.RemoteCount</strong> item(s) of sync <code>@ShortId(probe?.Candidate.Id)</code> on <strong>@TargetHost</strong> with your <strong>@localCount</strong>.</p>
                <p class="text-muted mb-0">The server copy is saved to Backup → Safety backups first. The app then syncs with that sync.</p>
            }
            else if (direction == "merge")
            {
                <p>Merge your <strong>@localCount</strong> item(s) with the <strong>@probe?.RemoteCount</strong> of sync <code>@ShortId(probe?.Candidate.Id)</code> on <strong>@TargetHost</strong>.</p>
                @if (mergeStats is not null)
                {
                    <ul class="xbs-review-list">
                        <li><strong>@mergeStats.LocalOnly</strong> upload (only on this device)</li>
                        <li><strong>@mergeStats.RemoteOnly</strong> download (only on the server)</li>
                        @if (mergeStats.TitleConflicts > 0)
                        {
                            <li><strong>@mergeStats.TitleConflicts</strong> title conflict(s) keep the server title</li>
                        }
                    </ul>
                }
                <p class="text-muted mb-0">Nothing is deleted. Both copies are saved to Backup → Safety backups first.</p>
            }
            else
            {
                <p>Keep the server copy: replace your <strong>@localCount</strong> item(s) on this device with the <strong>@probe?.RemoteCount</strong> of sync <code>@ShortId(probe?.Candidate.Id)</code> on <strong>@TargetHost</strong>.</p>
                <p class="text-muted mb-0">Your current bookmarks are saved to Backup → Safety backups first.</p>
            }
        </div>
        <div class="d-grid">
            <button class="btn @(ReplacesSomething ? "btn-danger" : "btn-primary")" @onclick="Execute" disabled="@busy">@(busy ? "Moving…" : "Move now")</button>
        </div>
        @if (!string.IsNullOrEmpty(reviewError))
        {
            <div class="alert alert-danger mt-2" role="alert">@reviewError</div>
        }
        <div class="text-center mt-3">
            <button class="xbs-link-btn" @onclick="StartOver" disabled="@busy">Start over</button>
        </div>
    }
}


@code {
    private int step = 1;
    private string targetUrl = Core.XbsConstants.DefaultServiceUrl;
    private Core.Api.ServiceInfoResponse? serviceInfo;
    private string? checkedUrl;
    private string slot = "new";
    /// <summary>Step 2 first asks new vs existing; false shows that choice.</summary>
    private bool slotChosen;
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private string syncId = string.Empty;
    private string password = string.Empty;
    private Services.ReconcileInfo? probe;
    private string? verifiedFor;
    /// <summary>Migration direction: "take" = take remote (safe default),
    /// "upload" = upload local over the remote, "merge" = union (never deletes).</summary>
    private string direction = "take";
    private Core.Sync.MergeStats? mergeStats;
    private Services.ReconcileInfo? mergeStatsFor;
    private bool tookRemote;
    private string? createdId;
    private int localCount;
    private bool busy;
    private string checkError = string.Empty;
    private string verifyError = string.Empty;
    private string reviewError = string.Empty;
    private bool linked;
    private bool resumed;

    private bool serviceOk =>
        serviceInfo is not null && checkedUrl == targetUrl.Trim();

    protected override async Task OnInitializedAsync()
    {
        for (int i = 0; i < 100 && !Session.Ready; i++)
        {
            await Task.Delay(100);
        }

        if (Session.Store is not null)
        {
            var stats = await Session.Store.GetStatsAsync();
            localCount = stats.Folders + stats.Bookmarks + stats.Separators;
        }

        linked = await Creds.GetAsync() is not null;

        // Resume an unfinished wizard (user went to inspect the bookmarks
        // mid-review): secrets were never stored, the probe survives.
        if (Session.PendingSwitch is { } draft)
        {
            targetUrl = draft.TargetUrl;
            slot = draft.Slot;
            syncId = draft.SyncId;
            direction = draft.Direction is "upload" or "merge" ? draft.Direction : "take";
            probe = draft.Probe;
            verifiedFor = draft.VerifiedFor;
            step = draft.Step is >= 2 and <= 3 ? draft.Step : 2;
            resumed = probe is not null;
            slotChosen = true;
        }
    }

    private static string ShortId(string? id) =>
        id is null || id.Length <= 8 ? "…" : $"{id[..4]}…{id[^2..]}";

    /// <summary>Changing direction invalidates the merge preview (counts must
    /// always match the verified sync + direction).</summary>
    private void SetDirection(string value)
    {
        direction = value;
        mergeStats = null;
        mergeStatsFor = null;
        verifyError = string.Empty;
    }

    private bool CanReview() => slot == "new"
        ? newPassword.Length > 0 && confirmPassword.Length > 0
        : probe is not null && verifiedFor == $"{targetUrl.Trim()}|{syncId.Trim()}";

    /// <summary>An existing sync stays verified only for the exact ID it was
    /// verified with: editing the ID (or URL) brings the credential inputs
    /// back automatically.</summary>
    private bool VerifiedExisting =>
        probe is not null && verifiedFor == $"{targetUrl.Trim()}|{syncId.Trim()}";

    private void Unverify()
    {
        probe = null;
        verifiedFor = null;
        mergeStats = null;
        mergeStatsFor = null;
    }

    private async Task CheckService()
    {
        await RunStepAsync(async () =>
        {
            serviceInfo = await Session.CheckServiceAsync(targetUrl.Trim());
            checkedUrl = targetUrl.Trim();
            resumed = false;
            SaveDraft();
        }, err => checkError = err, "switch-check");
    }

    private async Task VerifyExisting()
    {
        await RunStepAsync(async () =>
        {
            if (string.IsNullOrWhiteSpace(syncId) || string.IsNullOrEmpty(password))
            {
                throw new InvalidOperationException("Enter both the sync ID and its password.");
            }

            probe = await Session.ProbeLinkAsync(targetUrl.Trim(), syncId.Trim(), password);
            verifiedFor = $"{targetUrl.Trim()}|{syncId.Trim()}";
            direction = "take";
            mergeStats = null;
            mergeStatsFor = null;
            tookRemote = false;
            resumed = false;
            SaveDraft();
        }, err => verifyError = err, "switch-verify");
    }

    private async Task PreviewMerge()
    {
        await RunStepAsync(async () =>
        {
            if (probe is null || verifiedFor != $"{targetUrl.Trim()}|{syncId.Trim()}")
            {
                throw new InvalidOperationException("Open the existing sync first.");
            }

            mergeStats = await Session.GetMergePreviewAsync(probe);
            mergeStatsFor = probe;
        }, err => verifyError = err, "switch-merge-preview");
    }

    private string TargetHost =>
        Uri.TryCreate(targetUrl.Trim(), UriKind.Absolute, out var u) ? u.Host : targetUrl.Trim();

    /// <summary>The picker speaks download/upload/merge; this page keeps "take" for download.</summary>
    private string PickerValue => direction == "take" ? "download" : direction;

    private void OnPickerChanged(string value) => SetDirection(value == "download" ? "take" : value);

    /// <summary>Upload and download overwrite one side: the final button is red.</summary>
    private bool ReplacesSomething => slot == "existing" && direction != "merge";

    private void ChooseSlot(string value)
    {
        slot = value;
        slotChosen = true;
        verifyError = string.Empty;
    }

    /// <summary>Back walks the screens in reverse: review → step 2 form →
    /// new/existing choice → service.</summary>
    private void GoBack()
    {
        verifyError = string.Empty;
        reviewError = string.Empty;
        if (step == 3)
        {
            step = 2;
        }
        else if (step == 2 && slotChosen)
        {
            slotChosen = false;
        }
        else
        {
            step = 1;
        }
    }

    private async Task GoReview()
    {
        try
        {
            if (slot == "new")
            {
                RequireMatchingPasswords(newPassword, confirmPassword);
            }
            else if (direction == "merge" && (mergeStats is null || !ReferenceEquals(mergeStatsFor, probe)))
            {
                // Merge stays preview-locked: the review shows the dry-run
                // counts for exactly this probe, computed here.
                await PreviewMerge();
                if (mergeStats is null)
                {
                    return;
                }
            }

            verifyError = string.Empty;
            reviewError = string.Empty;
            resumed = false;
            step = 3;
            SaveDraft();
        }
        catch (Exception ex)
        {
            verifyError = ex.Message;
            Session.Log.Warn("switch", $"GoReview failed: {ex.GetType().Name}");
        }
    }

    /// <summary>Snapshots the wizard (without secrets) so leaving the page
    /// to inspect the bookmarks doesn't lose the review.</summary>
    private void SaveDraft()
    {
        Session.PendingSwitch = new Services.SwitchDraft(
            targetUrl.Trim(), slot, syncId.Trim(), direction, probe, verifiedFor, step);
    }

    private void StartOver()
    {
        Session.PendingSwitch = null;
        step = 1;
        slot = "new";
        slotChosen = false;
        syncId = string.Empty;
        password = string.Empty;
        newPassword = string.Empty;
        confirmPassword = string.Empty;
        probe = null;
        verifiedFor = null;
        mergeStats = null;
        mergeStatsFor = null;
        direction = "take";
        tookRemote = false;
        createdId = null;
        serviceInfo = null;
        checkedUrl = null;
        resumed = false;
        checkError = string.Empty;
        verifyError = string.Empty;
        reviewError = string.Empty;
    }

    private async Task Execute()
    {
        await RunStepAsync(async () =>
        {
            if (!serviceOk)
            {
                throw new InvalidOperationException("Re-check the target service first.");
            }

            tookRemote = false;
            createdId = null;

            if (slot == "new")
            {
                RequireMatchingPasswords(newPassword, confirmPassword);
                createdId = await Session.CreateNewSyncWithUploadAsync(targetUrl.Trim(), newPassword);
            }
            else
            {
                if (probe is null || verifiedFor != $"{targetUrl.Trim()}|{syncId.Trim()}")
                {
                    throw new InvalidOperationException("Open the existing sync first.");
                }

                if (direction == "upload")
                {
                    await Session.ApplyLocalAsync(probe, Keepmark.Core.Safety.SafetyOperations.SwitchUpload);
                }
                else if (direction == "merge")
                {
                    if (mergeStats is null || !ReferenceEquals(mergeStatsFor, probe))
                    {
                        throw new InvalidOperationException("Preview the merge first — counts must match the verified sync.");
                    }

                    await Session.ApplyMergeAsync(probe, Keepmark.Core.Safety.SafetyOperations.SwitchMerge);
                }
                else
                {
                    await Session.ApplyRemoteAsync(probe, Keepmark.Core.Safety.SafetyOperations.SwitchTakeRemote);
                    tookRemote = true;
                }
            }

            AppSettings.ServiceUrl = targetUrl.Trim();
            newPassword = string.Empty;
            step = 4;
            Session.PendingSwitch = null;
            Session.Log.Info("switch", createdId is not null
                ? "Move complete: new sync created and uploaded"
                : direction == "merge" ? "Move complete: merged both sides"
                : tookRemote ? "Move complete: downloaded the server copy" : "Move complete: uploaded local bookmarks");
        }, err => reviewError = err, "switch-execute");
    }

    private async Task CopyId()
    {
        if (createdId is null)
        {
            return;
        }

        try
        {
            await Clipboard.Default.SetTextAsync(createdId);
            _ = Toast.ShowAsync("Sync ID copied — store it with the password");
        }
        catch
        {
            _ = Toast.ShowAsync("Copy failed — transcribe the ID manually", isError: true);
        }
    }

    private static void RequireMatchingPasswords(string first, string second)
    {
        if (first.Length < 8)
        {
            throw new InvalidOperationException("Use a password of at least 8 characters.");
        }

        if (!string.Equals(first, second, StringComparison.Ordinal))
        {
            throw new InvalidOperationException("Passwords do not match.");
        }
    }


    /// <summary>One action cluster, one adjacent error box: each wizard step
    /// reports into its own field (check/verify/review) rendered next to the
    /// button that produced it, instead of a single shared box.</summary>
    private async Task RunStepAsync(Func<Task> action, Action<string> setError, [System.Runtime.CompilerServices.CallerMemberName] string op = "?")
    {
        busy = true;
        setError(string.Empty);
        try
        {
            Session.Log.Debug("switch", $"{op}: start");
            await action();
            Session.Log.Debug("switch", $"{op}: ok");
        }
        catch (Exception ex)
        {
            setError(ex.Message);
            Session.Log.Warn("switch", $"{op} failed: {ex.GetType().Name}");
        }
        finally
        {
            password = string.Empty;
            confirmPassword = string.Empty;
            newPassword = string.Empty;
            busy = false;
        }
    }
}
