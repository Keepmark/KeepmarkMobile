@page "/connect"
@inject KeepmarkMobile.Services.XbsSession Session
@inject KeepmarkMobile.Services.XbsSettings AppSettings
@inject KeepmarkMobile.Services.ToastState Toast
@inject KeepmarkMobile.Services.SecureCredentialStore Creds
@using Keepmark.Core.Workflow

<PageTitle>@L.Get(Str.NavConnect)</PageTitle>

<h1>@L.Get(Str.NavConnect)</h1>

@if (!Session.Ready)
{
    <p role="status"><em>@L.Get(Str.BackupStarting)</em></p>
}
else if (linked)
{
    <div class="alert alert-success">
        @L.Get(Str.ConnLinkedTo) <strong>@linkedUrl</strong> (@L.Get(Str.BackupSyncWord) <code>@WorkflowRules.ShortId(linkedId)</code>).
        <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="CopyLinkedId">@L.Get(Str.ConnCopySyncId)</button>
    </div>
    <p>@L.Get(Str.ConnMoveHintA) <a href="switch-service">@L.Get(Str.NavMoveService)</a>@L.Get(Str.ConnMoveHintB) <a href="backup">@L.Get(Str.NavBackup)</a>.</p>
    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert mt-2 @(isError ? "alert-danger" : "alert-success")" role="@(isError ? "alert" : "status")">@message</div>
    }

    <hr />
    <h2>@L.Get(Str.ConnUnlinkH)</h2>
    <p class="text-muted">@Loc.Plural(Str.ConnUnlinkIntro, localCount)</p>
    @if (!armedUnlink)
    {
        <button class="btn btn-outline-danger" @onclick="() => { armedUnlink = true; unlinkError = string.Empty; }" disabled="@busy">@L.Get(Str.ConnUnlinkBtn)</button>
    }
    else
    {
        <ConfirmBlock Message="@L.Get(Str.ConnUnlinkMessage)" Implication="@WorkflowTexts.UnlinkImplication"
                      ConfirmLabel="@L.Get(Str.CommonYesUnlink)" Busy="busy"
                      OnConfirm="ExecuteUnlink" OnCancel="() => armedUnlink = false" />
    }
    @if (!string.IsNullOrEmpty(unlinkError))
    {
        <div class="alert alert-danger mt-3" role="alert">@unlinkError</div>
    }
}
else
{
    @if (mode is null)
    {
        @* Outcome that brought us here (e.g. "Device unlinked"), shown at the top of the choice. *@
        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert alert-success" role="status">@message</div>
        }
        <p class="xbs-connect-lead">@L.Get(Str.ConnLead)</p>
        <div class="xbs-choices">
            <button class="xbs-choice" @onclick='() => Choose("existing")'>
                <span class="xbs-choice-ico"><svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" /></svg></span>
                <span class="xbs-choice-text"><strong>@L.Get(Str.ConnLinkExistingTitle)</strong><span>@L.Get(Str.ConnLinkExistingText)</span></span>
                <svg class="km-ico sm xbs-choice-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
            </button>
            <button class="xbs-choice" @onclick='() => Choose("new")'>
                <span class="xbs-choice-ico"><svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></span>
                <span class="xbs-choice-text"><strong>@L.Get(Str.ConnCreateTitle)</strong><span>@(localCount > 0 ? Loc.Plural(Str.ConnCreateTextUpload, localCount) : L.Get(Str.ConnCreateTextFresh))</span></span>
                <svg class="km-ico sm xbs-choice-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
            </button>
        </div>
        <p class="xbs-hint mt-3">@L.Get(Str.ConnBackupHintA) <a href="backup">@L.Get(Str.ConnBackupHintLink)</a> @L.Get(Str.ConnBackupHintB)</p>
    }
    else
    {
        <button class="xbs-back" @onclick="Back" disabled="@busy"><svg class="km-ico sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>@L.Get(Str.CommonBack)</button>
        <h2 class="xbs-step-title">@(mode == "existing" ? L.Get(Str.ConnLinkExistingTitle) : L.Get(Str.ConnCreateTitle))</h2>
        <div class="xbs-service-row">
            <span class="xbs-service-label">@L.Get(Str.ConnService)</span>
            <span class="xbs-service-host">@ServiceHost</span>
            @if (reconcile is null)
            {
                <button class="xbs-link-btn" @onclick="() => showService = !showService" aria-expanded="@ServiceOpen.ToString().ToLowerInvariant()">@(ServiceOpen ? L.Get(Str.CommonHide) : L.Get(Str.CommonChange))</button>
            }
        </div>
        @if (ServiceOpen && reconcile is null)
        {
            <div class="mb-3">
                <label class="form-label">@L.Get(Str.ConnServiceUrl)</label>
                <input class="form-control" @bind="serviceUrl" inputmode="url" />
                <div class="form-text">@L.Get(Str.ConnServiceUrlHint)</div>
                <button class="btn btn-secondary mt-2" @onclick="CheckService" disabled="@busy">@L.Get(Str.ConnCheckService)</button>
                @if (!string.IsNullOrEmpty(checkError))
                {
                    <div class="alert alert-danger mt-2" role="alert">@checkError</div>
                }
                @if (serviceInfo is not null)
                {
                    <p class="mt-2" role="status">@L.Get(Str.ConnStatusLine, serviceInfo.Status, serviceInfo.Version, serviceInfo.MaxSyncSize / 1024)</p>
                }
            </div>
        }
        @if (mode == "existing" && reconcile is not null)
        {
            @* Verified: the apply step uses exactly these credentials, so the
               inputs are gone (editing them would not change the target). *@
            <div class="xbs-verified" role="status">
                <svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                <div class="xbs-verified-text">
                    <strong>@L.Get(Str.ConnSyncOpenedA) <code>@WorkflowRules.ShortId(reconcile.Candidate.Id)</code> @L.Get(Str.ConnSyncOpenedB)</strong>
                    <span>@L.Get(Str.ConnItemsCounts, reconcile.RemoteCount, reconcile.LocalCount)</span>
                </div>
                <button class="xbs-link-btn" @onclick="UseDifferentSync" disabled="@busy">@L.Get(Str.CommonChange)</button>
            </div>
        }
        else if (mode == "existing")
        {
            <div class="mb-3">
                <label class="form-label">@L.Get(Str.ConnSyncId)</label>
                <input class="form-control" @bind="syncId" placeholder="xxxxxxxx-xxxx-…" />
                <label class="form-label mt-2">@L.Get(Str.CommonPassword)</label>
                <input type="password" class="form-control" @bind="password" autocomplete="current-password" />
                <div class="form-text">@L.Get(Str.ConnPasswordHint)</div>
                <div class="mt-3 d-grid">
                    <button class="btn btn-primary" @onclick="LinkExisting" disabled="@busy">@L.Get(Str.ConnOpenSync)</button>
                </div>
                @if (!string.IsNullOrEmpty(linkError))
                {
                    <div class="alert alert-danger mt-2" role="alert">@linkError</div>
                }
            </div>
        }
        else
        {
            <div class="mb-3">
                <label class="form-label">@L.Get(Str.CommonNewPassword)</label>
                <input type="password" class="form-control" @bind="newPassword" autocomplete="new-password" />
                <label class="form-label mt-2">@L.Get(Str.ConnConfirmPassword)</label>
                <input type="password" class="form-control" @bind="confirmPassword" autocomplete="new-password" />
                <div class="form-text">@L.Get(Str.ConnPwNewHint)</div>
                <div class="mt-2 d-grid gap-2">
                    @if (localCount > 0)
                    {
                        <button class="btn btn-primary" @onclick="CreateWithUpload" disabled="@busy">@Loc.Plural(Str.ConnCreateUpload, localCount)</button>
                        <div class="form-text">@L.Get(Str.ConnCreateUploadHint)</div>
                        @if (armed != "createEmpty")
                        {
                            <button class="btn btn-outline-danger" @onclick='() => armed = "createEmpty"' disabled="@busy">@L.Get(Str.ConnCreateEmptyInstead)</button>
                        }
                        else
                        {
                            <ConfirmBlock Message="@Loc.Plural(Str.ConnReplaceEmptyMessage, localCount)"
                                          Implication="@WorkflowTexts.CreateEmptyImplication"
                                          ConfirmLabel="@L.Get(Str.ConnYesCreateEmpty)" Busy="busy"
                                          OnConfirm="CreateNew" OnCancel="Disarm" />
                        }
                    }
                    else
                    {
                        <button class="btn btn-outline-primary" @onclick="CreateNew" disabled="@busy">@L.Get(Str.ConnCreateNew)</button>
                        <div class="form-text">@L.Get(Str.ConnCreateEmptyHint)</div>
                    }
                </div>
                @if (!string.IsNullOrEmpty(linkError))
                {
                    <div class="alert alert-danger mt-2" role="alert">@linkError</div>
                }
            </div>
        }
    }

    @if (reconcile is not null)
    {
        @* One choice, one action button; the confirm (with merge counts) replaces the button in place. *@
        <DirectionPicker Name="syncDirection" Value="@direction" ValueChanged="SetDirection"
                         LocalCount="reconcile.LocalCount" RemoteCount="reconcile.RemoteCount"
                         Disabled="@(busy || armedApply)" />
        @if (!armedApply)
        {
            <div class="d-grid">
                <button class="btn btn-primary" @onclick="ArmApply" disabled="@busy">@ApplyLabel</button>
            </div>
        }
        else
        {
            var confirm = WorkflowTexts.DirectionConfirm(direction);
            <ConfirmBlock Message="@confirm.Message" Implication="@confirm.Implication"
                          ConfirmLabel="@confirm.ConfirmLabel" Danger="@(direction != "merge")" Busy="busy"
                          OnConfirm="ApplyChosen" OnCancel="() => armedApply = false">
                @if (direction == "merge" && mergeStats is not null)
                {
                    <ul class="xbs-review-list mt-2 mb-0">
                        <li><strong>@mergeStats.LocalOnly</strong> @L.Get(Str.ConnReviewUpload)</li>
                        <li><strong>@mergeStats.RemoteOnly</strong> @L.Get(Str.ConnReviewDownload)</li>
                        @if (mergeStats.TitleConflicts > 0)
                        {
                            <li><strong>@mergeStats.TitleConflicts</strong> @Loc.Plural(Str.ConnReviewTitles, mergeStats.TitleConflicts)</li>
                        }
                    </ul>
                }
            </ConfirmBlock>
        }
        @if (!string.IsNullOrEmpty(applyError))
        {
            <div class="alert alert-danger mt-2" role="alert">@applyError</div>
        }
    }

}

@code {
    private string serviceUrl = Core.XbsConstants.DefaultServiceUrl;
    private string syncId = string.Empty;
    private string password = string.Empty;
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private bool busy;
    private string message = string.Empty;
    private bool isError;
    private string checkError = string.Empty;
    private string linkError = string.Empty;
    private string applyError = string.Empty;
    private string unlinkError = string.Empty;
    private Core.Sync.MergeStats? mergeStats;
    private Services.ReconcileInfo? mergeStatsFor;
    private Core.Api.ServiceInfoResponse? serviceInfo;
    private Services.ReconcileInfo? reconcile;
    private bool linked;
    private string? linkedUrl;
    private string? linkedId;
    private int localCount;
    private string? armed;
    private bool armedUnlink;
    /// <summary>The single apply button was tapped: its inline confirm shows.</summary>
    private bool armedApply;
    /// <summary>Reconcile direction choice: "download" replaces local with the
    /// remote copy, "upload" overwrites the remote with local, "merge" unions
    /// both sides. Preselected to the only sensible side when one of them is
    /// empty. Changing direction invalidates the merge preview.</summary>
    private string direction = "download";

    /// <summary>First-run choice: null = pick, "existing" = link, "new" = create.</summary>
    private string? mode;
    private bool showService;
    private bool ServiceOpen => showService || !string.IsNullOrEmpty(checkError);
    private string ServiceHost => Uri.TryCreate(serviceUrl, UriKind.Absolute, out var u) ? u.Host : serviceUrl;

    private void Choose(string value)
    {
        mode = value;
        isError = false;
        linkError = string.Empty;
        message = string.Empty;
    }

    /// <summary>Drop the verified candidate and go back to the ID/password form.</summary>
    private void UseDifferentSync()
    {
        reconcile = null;
        mergeStats = null;
        mergeStatsFor = null;
        armedApply = false;
        applyError = string.Empty;
        message = string.Empty;
    }

    private void Back()
    {
        mode = null;
        reconcile = null;
        armed = null;
        linkError = string.Empty;
        applyError = string.Empty;
        message = string.Empty;
        password = string.Empty;
        newPassword = string.Empty;
        confirmPassword = string.Empty;
    }

    private void SetDirection(string value)
    {
        direction = value;
        mergeStats = null;
        mergeStatsFor = null;
        applyError = string.Empty;
        armedApply = false;
    }

    protected override void OnInitialized() => serviceUrl = AppSettings.ServiceUrl;

    protected override async Task OnInitializedAsync()
    {
        for (int i = 0; i < 100 && !Session.Ready; i++)
        {
            await Task.Delay(100);
        }

        await RefreshStateAsync();
    }

    private async Task RefreshStateAsync()
    {
        var c = await Creds.GetAsync();
        linked = c is not null;
        linkedUrl = c?.ServiceUrl;
        linkedId = c?.Id;
        if (Session.Store is not null)
        {
            var stats = await Session.Store.GetStatsAsync();
            localCount = stats.Folders + stats.Bookmarks + stats.Separators;
        }
    }


    private void Disarm() => armed = null;

    private async Task CopyLinkedId()
    {
        if (string.IsNullOrEmpty(linkedId))
        {
            return;
        }

        try
        {
            await Clipboard.Default.SetTextAsync(linkedId);
            _ = Toast.ShowAsync(L.Get(Str.ConnCopied));
        }
        catch
        {
            _ = Toast.ShowAsync(L.Get(Str.ConnCopyFailed), isError: true);
        }
    }

    private async Task ExecuteUnlink()
    {
        await RunStepAsync(async () =>
        {
            await Creds.ClearAsync();
            armedUnlink = false;
            await RefreshStateAsync();
            Session.Log.Info("connect", "Device unlinked");
            Ok(WorkflowTexts.UnlinkDone);
        }, err => unlinkError = err, "connect-unlink");
    }


    private async Task CheckService()
    {
        await RunStepAsync(async () =>
        {
            serviceInfo = await Session.CheckServiceAsync(serviceUrl.Trim());
            AppSettings.ServiceUrl = serviceUrl.Trim();
        }, err => checkError = err, "connect-check");
    }

    private async Task LinkExisting()
    {
        await RunStepAsync(async () =>
        {
            if (string.IsNullOrWhiteSpace(syncId) || string.IsNullOrEmpty(password))
            {
                throw new InvalidOperationException(L.Get(Str.ConnEnterBoth));
            }

            reconcile = await Session.ProbeLinkAsync(serviceUrl.Trim(), syncId.Trim(), password);
            // Consumed: the candidate carries the key; a failed check keeps it for a retry.
            password = string.Empty;
            AppSettings.ServiceUrl = serviceUrl.Trim();
            mergeStats = null;
            mergeStatsFor = null;
            applyError = string.Empty;
            armedApply = false;
            if (reconcile is { LocalCount: 0, RemoteCount: 0 })
            {
                await Session.ApplyRemoteAsync(reconcile);
                reconcile = null;
                await RefreshStateAsync();
                Ok(L.Get(Str.ConnLinkedEmpty));
            }
            else
            {
                // Preselect the only sensible direction when one side is empty.
                direction = reconcile.RemoteCount == 0 ? "upload" : "download";
            }
        }, err => linkError = err, "connect-link");
    }

    private async Task CreateNew()
    {
        await RunStepAsync(async () =>
        {
            WorkflowRules.RequireNewPassword(newPassword, confirmPassword);
            await Session.CreateNewSyncAsync(serviceUrl.Trim(), newPassword);
            AppSettings.ServiceUrl = serviceUrl.Trim();
            reconcile = null;
            armed = null;
            newPassword = string.Empty;
            confirmPassword = string.Empty;
            await RefreshStateAsync();
            Ok($"{L.Get(Str.ConnCreatedEmpty)} {WorkflowTexts.CreatedNext}");
        }, err => linkError = err, "connect-create");
    }

    private async Task CreateWithUpload()
    {
        await RunStepAsync(async () =>
        {
            WorkflowRules.RequireNewPassword(newPassword, confirmPassword);
            await Session.CreateNewSyncWithUploadAsync(serviceUrl.Trim(), newPassword);
            AppSettings.ServiceUrl = serviceUrl.Trim();
            reconcile = null;
            newPassword = string.Empty;
            confirmPassword = string.Empty;
            await RefreshStateAsync();
            Ok($"{L.Get(Str.ConnCreatedUpload)} {WorkflowTexts.CreatedNext}");
        }, err => linkError = err, "connect-create");
    }

    private string ApplyLabel => direction switch
    {
        "upload" => L.Get(Str.StatusKeepDevice),
        "merge" => L.Get(Str.StatusMergeBoth),
        _ => L.Get(Str.StatusKeepServer),
    };

    /// <summary>First tap arms the confirm. Merge computes its dry-run here
    /// so the confirm shows the counts (merge stays preview-locked).</summary>
    private async Task ArmApply()
    {
        applyError = string.Empty;
        if (direction == "merge" && (mergeStats is null || !ReferenceEquals(mergeStatsFor, reconcile)))
        {
            await PreviewMerge();
            if (mergeStats is null)
            {
                return;
            }
        }

        armedApply = true;
    }

    private Task ApplyChosen() => direction switch
    {
        "upload" => ApplyLocal(),
        "merge" => ApplyMerge(),
        _ => ApplyRemote(),
    };

    private async Task ApplyRemote()
    {
        await RunStepAsync(async () =>
        {
            var target = reconcile!;
            await Session.ApplyRemoteAsync(target);
            reconcile = null;
            mergeStats = null;
            mergeStatsFor = null;
            armedApply = false;
            await RefreshStateAsync();
            Ok($"{Core.Sync.MoveResult.Describe("existing", "pull", target.Candidate.ServiceUrl, target.Candidate.Id)} {L.Get(Str.ConnSafetyLocal)}");
        }, err => applyError = err, "connect-apply");
    }

    private async Task ApplyLocal()
    {
        await RunStepAsync(async () =>
        {
            var target = reconcile!;
            await Session.ApplyLocalAsync(target);
            reconcile = null;
            mergeStats = null;
            mergeStatsFor = null;
            armedApply = false;
            await RefreshStateAsync();
            Ok($"{Core.Sync.MoveResult.Describe("existing", "push", target.Candidate.ServiceUrl, target.Candidate.Id)} {L.Get(Str.ConnSafetyRemote)}");
        }, err => applyError = err, "connect-apply");
    }

    private async Task PreviewMerge()
    {
        await RunStepAsync(async () =>
        {
            mergeStats = await Session.GetMergePreviewAsync(reconcile!);
            mergeStatsFor = reconcile;
            message = string.Empty;
        }, err => applyError = err, "connect-merge-preview");
    }

    private async Task ApplyMerge()
    {
        await RunStepAsync(async () =>
        {
            var target = reconcile!;
            if (mergeStats is null || !ReferenceEquals(mergeStatsFor, target))
            {
                throw new InvalidOperationException(L.Get(Str.ConnPreviewFirst));
            }

            await Session.ApplyMergeAsync(target, Core.Safety.SafetyOperations.ConnectMerge);
            reconcile = null;
            mergeStats = null;
            mergeStatsFor = null;
            armedApply = false;
            await RefreshStateAsync();
            Ok($"{Core.Sync.MoveResult.Describe("existing", "merge", target.Candidate.ServiceUrl, target.Candidate.Id)} {L.Get(Str.ConnSafetyBoth)}");
        }, err => applyError = err, "connect-apply");
    }

    /// <summary>One action cluster, one adjacent error box: each wizard step
    /// reports into its own field (check/link/apply) rendered next to the
    /// button that produced it, instead of a single shared box.</summary>
    private async Task RunStepAsync(Func<Task> action, Action<string> setError, [System.Runtime.CompilerServices.CallerMemberName] string op = "?")
    {
        busy = true;
        isError = false;
        message = string.Empty;
        setError(string.Empty);
        try
        {
            Session.Log.Debug("connect", $"{op}: start");
            await action();
            Session.Log.Info("connect", $"{op}: ok");
        }
        catch (Exception ex)
        {
            isError = true;
            setError(ex.Message);
            Session.Log.Warn("connect", $"{op} failed: {ex.GetType().Name}");
        }
        finally
        {
            // Secrets are cleared by each step once consumed, never on a
            // failure: the retry needs them.
            busy = false;
        }
    }

    private void Ok(string text)
    {
        isError = false;
        message = text;
    }
}
