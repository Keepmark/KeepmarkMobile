@inherits KeepmarkMobile.Components.SessionComponentBase
@page "/connect"
@inject KeepmarkMobile.Services.XbsSession Session
@inject KeepmarkMobile.Services.XbsSettings AppSettings
@inject KeepmarkMobile.Services.ToastState Toast
@inject KeepmarkMobile.Services.SecureCredentialStore Creds
@inject KeepmarkMobile.Services.IQrScanner QrScanner
@inject KeepmarkMobile.Services.AppLockState AppLock
@using Keepmark.Core.Workflow

<PageTitle>@L.Get(Str.NavConnect)</PageTitle>

<h1>@L.Get(Str.NavConnect)</h1>

@if (!Session.Ready)
{
    <p role="status"><em>@L.Get(Str.BackupStarting)</em></p>
}
else if (linked)
{
    <div class="alert alert-success">
        @L.Get(Str.ConnLinkedTo) <strong>@linkedUrl</strong> (@L.Get(Str.BackupSyncWord) <code>@WorkflowRules.ShortId(linkedId)</code>).
        <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="CopyLinkedId">@L.Get(Str.ConnCopySyncId)</button>
    </div>
    <p>@L.Get(Str.ConnMoveHintA) <a href="switch-service">@L.Get(Str.NavMoveService)</a>@L.Get(Str.ConnMoveHintB) <a href="backup">@L.Get(Str.NavBackup)</a>.</p>
    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert mt-2 @(isError ? "alert-danger" : "alert-success")" role="@(isError ? "alert" : "status")">@message</div>
    }

    <hr />
    <h2>@L.Get(Str.ConnUnlinkH)</h2>
    <p class="text-muted">@Loc.Plural(Str.ConnUnlinkIntro, localCount)</p>
    @if (!armedUnlink)
    {
        <button class="btn btn-outline-danger" @onclick="() => { armedUnlink = true; unlinkError = string.Empty; }" disabled="@busy">@L.Get(Str.ConnUnlinkBtn)</button>
    }
    else
    {
        <ConfirmBlock Message="@L.Get(Str.ConnUnlinkMessage)" Implication="@WorkflowTexts.UnlinkImplication"
                      ConfirmLabel="@L.Get(Str.CommonYesUnlink)" Busy="busy"
                      OnConfirm="ExecuteUnlink" OnCancel="() => armedUnlink = false" />
    }
    @if (!string.IsNullOrEmpty(unlinkError))
    {
        <div class="alert alert-danger mt-3" role="alert">@unlinkError</div>
    }
}
else
{
    @if (mode is null)
    {
        @* Outcome that brought us here (e.g. "Device unlinked"), shown at the top of the choice. *@
        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert alert-success" role="status">@message</div>
        }
        <p class="xbs-connect-lead">@L.Get(Str.ConnLead)</p>
        <div class="xbs-choices">
            <button class="xbs-choice" @onclick='() => Choose("existing")'>
                <span class="xbs-choice-ico"><svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" /></svg></span>
                <span class="xbs-choice-text"><strong>@L.Get(Str.ConnLinkExistingTitle)</strong><span>@L.Get(Str.ConnLinkExistingText)</span></span>
                <svg class="km-ico sm xbs-choice-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
            </button>
            <button class="xbs-choice" @onclick='() => Choose("new")'>
                <span class="xbs-choice-ico"><svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></span>
                <span class="xbs-choice-text"><strong>@L.Get(Str.ConnCreateTitle)</strong><span>@(localCount > 0 ? Loc.Plural(Str.ConnCreateTextUpload, localCount) : L.Get(Str.ConnCreateTextFresh))</span></span>
                <svg class="km-ico sm xbs-choice-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
            </button>
        </div>
        <p class="xbs-hint mt-3">@L.Get(Str.ConnBackupHintA) <a href="backup">@L.Get(Str.ConnBackupHintLink)</a> @L.Get(Str.ConnBackupHintB)</p>
    }
    else
    {
        <button class="xbs-back" @onclick="Back" disabled="@busy"><svg class="km-ico sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>@L.Get(Str.CommonBack)</button>
        @if (qrState.ShowReview)
        {
            <QrCredentialReview ServiceUrl="@qrServiceUrl" SyncId="@qrSyncId" Busy="@(busy || qrState.IsVerifying)"
                                OnVerify="LinkQr" OnCancel="CancelQr" />
        }
        else
        {
        <h2 class="xbs-step-title">@(mode == "existing" ? L.Get(Str.ConnLinkExistingTitle) : L.Get(Str.ConnCreateTitle))</h2>
        @if (mode == "existing" && reconcile is null)
        {
            <button class="btn btn-secondary mb-2" @onclick="ScanQr" disabled="@busy"><svg class="km-ico sm me-2" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h6v6H3zM15 3h6v6h-6zM3 15h6v6H3zM15 15h2v2h-2zM19 15h2v6h-2zM15 19h2v2h-2z" /></svg>@L.Get(Str.ConnQrScan)</button>
            <div class="form-text mb-3">@L.Get(Str.ConnQrHint)</div>
            @if (!string.IsNullOrEmpty(qrError))
            {
                <div class="alert alert-danger" role="alert">@qrError</div>
            }
        }
        @if (reconcile is null)
        {
            <ServiceSelector Value="@serviceUrl" ValueChanged="ServiceChanged" Checked="ServiceChecked" Disabled="@busy" />
        }
        @if (mode == "existing" && reconcile is not null)
        {
            @* Verified: the apply step uses exactly these credentials, so the
               inputs are gone (editing them would not change the target). *@
            <div class="xbs-verified" role="status">
                <svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                <div class="xbs-verified-text">
                    <strong>@L.Get(Str.ConnSyncOpenedA) <code>@WorkflowRules.ShortId(reconcile.Candidate.Id)</code> @L.Get(Str.ConnSyncOpenedB)</strong>
                    <span>@L.Get(Str.ConnItemsCounts, reconcile.RemoteCount, reconcile.LocalCount)</span>
                </div>
                <button class="xbs-link-btn" @onclick="UseDifferentSync" disabled="@busy">@L.Get(Str.CommonChange)</button>
            </div>
        }
        else if (mode == "existing")
        {
            <div class="mb-3">
                <label class="form-label">@L.Get(Str.ConnSyncId)</label>
                <input disabled="@busy" class="form-control" @bind="syncId" @bind:after="ClearLinkError" placeholder="a1b2c3d4e5f6…" />
                <label class="form-label mt-2">@L.Get(Str.CommonPassword)</label>
                <input disabled="@busy" type="password" class="form-control" @bind="password" @bind:after="ClearLinkError" autocomplete="current-password" />
                <div class="form-text">@L.Get(Str.ConnPasswordHint)</div>
                <div class="mt-3 d-grid">
                    <button class="btn btn-primary" @onclick="LinkExisting" disabled="@(busy || serviceInfo is null)">@L.Get(Str.ConnOpenSync)</button>
                </div>
                @if (!string.IsNullOrEmpty(linkError))
                {
                    <div class="alert alert-danger mt-2" role="alert">@linkError</div>
                }
            </div>
        }
        else
        {
            <div class="mb-3">
                <label class="form-label">@L.Get(Str.CommonNewPassword)</label>
                <input disabled="@busy" type="password" class="form-control" @bind="newPassword" @bind:after="ClearLinkError" autocomplete="new-password" />
                <label class="form-label mt-2">@L.Get(Str.ConnConfirmPassword)</label>
                <input disabled="@busy" type="password" class="form-control" @bind="confirmPassword" @bind:after="ClearLinkError" autocomplete="new-password" />
                <div class="form-text">@L.Get(Str.ConnPwNewHint)</div>
                <div class="mt-2 d-grid gap-2">
                    @if (localCount > 0)
                    {
                        <button class="btn btn-primary" @onclick="CreateWithUpload" disabled="@(busy || !CanCreate)">@Loc.Plural(Str.ConnCreateUpload, localCount)</button>
                        <div class="form-text">@L.Get(Str.ConnCreateUploadHint)</div>
                        @if (armed != "createEmpty")
                        {
                            <button class="btn btn-outline-danger" @onclick='() => armed = "createEmpty"' disabled="@(busy || !CanCreate)">@L.Get(Str.ConnCreateEmptyInstead)</button>
                        }
                        else
                        {
                            <ConfirmBlock Message="@Loc.Plural(Str.ConnReplaceEmptyMessage, localCount)"
                                          Implication="@WorkflowTexts.CreateEmptyImplication"
                                          ConfirmLabel="@L.Get(Str.ConnYesCreateEmpty)" Busy="busy"
                                          OnConfirm="CreateNew" OnCancel="Disarm" />
                        }
                    }
                    else
                    {
                        <button class="btn btn-outline-primary" @onclick="CreateNew" disabled="@(busy || !CanCreate)">@L.Get(Str.ConnCreateNew)</button>
                        <div class="form-text">@L.Get(Str.ConnCreateEmptyHint)</div>
                    }
                </div>
                @if (!string.IsNullOrEmpty(linkError))
                {
                    <div class="alert alert-danger mt-2" role="alert">@linkError</div>
                }
            </div>
        }
        }
    }

    @if (reconcile is not null && !qrState.ShowReview)
    {
        <DirectionPicker Name="syncDirection" Value="@direction" ValueChanged="SetDirection"
                         LocalCount="reconcile.LocalCount" RemoteCount="reconcile.RemoteCount"
                         Disabled="@busy" />
        <p class="text-muted">@WorkflowTexts.DirectionConfirm(direction).Implication</p>
        @if (direction == "merge" && mergeStats is not null)
        {
            <ul class="xbs-review-list mt-2">
                <li><strong>@mergeStats.LocalOnly</strong> @L.Get(Str.ConnReviewUpload)</li>
                <li><strong>@mergeStats.RemoteOnly</strong> @L.Get(Str.ConnReviewDownload)</li>
                @if (mergeStats.TitleConflicts > 0)
                {
                    <li><strong>@mergeStats.TitleConflicts</strong> @Loc.Plural(Str.ConnReviewTitles, mergeStats.TitleConflicts)</li>
                }
            </ul>
        }
        @if (direction == "merge" && mergeStats is null && !busy && !string.IsNullOrEmpty(applyError))
        {
            <button class="btn btn-secondary mb-2" @onclick="PreviewMerge">@L.Get(Str.StatusCompareAgain)</button>
        }
        <div class="d-grid">
            <button class="btn btn-primary" @onclick="ApplyChosen" disabled="@(busy || (direction == "merge" && (mergeStats is null || !ReferenceEquals(mergeStatsFor, reconcile))))">@ApplyLabel</button>
        </div>
        @if (!string.IsNullOrEmpty(applyError))
        {
            <div class="alert alert-danger mt-2" role="alert">@applyError</div>
        }
    }

}

@code {
    private string serviceUrl = Core.XbsConstants.DefaultServiceUrl;
    private string syncId = string.Empty;
    private string password = string.Empty;
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private bool busy;
    private string message = string.Empty;
    private bool isError;
    private string linkError = string.Empty;
    private string applyError = string.Empty;
    private string unlinkError = string.Empty;
    private Core.Sync.MergeStats? mergeStats;
    private Services.ReconcileInfo? mergeStatsFor;
    private Core.Api.ServiceInfoResponse? serviceInfo;
    private Services.ReconcileInfo? reconcile;
    private bool linked;
    private string? linkedUrl;
    private string? linkedId;
    private int localCount;
    private string? armed;
    private bool armedUnlink;
    /// <summary>Reconcile direction choice: "download" replaces local with the
    /// remote copy, "upload" overwrites the remote with local, "merge" unions
    /// both sides. Preselected to the only sensible side when one of them is
    /// empty. Changing direction invalidates the merge preview.</summary>
    private string direction = "download";

    /// <summary>First-run choice: null = pick, "existing" = link, "new" = create.</summary>
    private string? mode;
    private string ServiceUrlClean => WorkflowRules.NormalizeServiceUrl(serviceUrl);
    // A stale "fill in both fields" error must not linger once the user edits them.
    private void ClearLinkError() { linkError = string.Empty; ClearQr(); }

    private string ServiceHost => Uri.TryCreate(serviceUrl, UriKind.Absolute, out var u) ? (u.IsDefaultPort ? u.Host : $"{u.Host}:{u.Port}") : serviceUrl;

    private void Choose(string value)
    {
        mode = value;
        isError = false;
        linkError = string.Empty;
        message = string.Empty;
    }

    /// <summary>Drop the verified candidate and go back to the ID/password form.</summary>
    private void UseDifferentSync()
    {
        reconcile = null;
        mergeStats = null;
        mergeStatsFor = null;
        applyError = string.Empty;
        message = string.Empty;
    }

    private void Back()
    {
        if (qrState.ShowReview) { CancelQr(); return; }
        ClearQr();
        mode = null;
        reconcile = null;
        armed = null;
        linkError = string.Empty;
        applyError = string.Empty;
        message = string.Empty;
        password = string.Empty;
        newPassword = string.Empty;
        confirmPassword = string.Empty;
    }

    private async Task SetDirection(string value)
    {
        if (busy) return;
        direction = value;
        mergeStats = null;
        mergeStatsFor = null;
        applyError = string.Empty;
        if (direction == "merge") await PreviewMerge();
    }

    protected override void OnInitialized()
    {
        serviceUrl = AppSettings.ServiceUrl;
        AppLock.Changed += LockChanged;
    }

    private readonly ConnectQrCandidateState qrState = new();
    private ConnectQrPayload? pendingQr => qrState.Payload;
    private CancellationTokenSource? qrExpiry;
    private int qrGeneration => qrState.Generation;
    private string qrError = string.Empty;
    private string qrServiceUrl = string.Empty;
    private string qrSyncId = string.Empty;

    private void ClearQr()
    {
        qrState.Clear();
        qrServiceUrl = qrSyncId = string.Empty;
        StopQrExpiry();
    }

    private void CancelQr()
    {
        ClearQr();
        qrError = string.Empty;
    }

    private void StopQrExpiry()
    {
        qrExpiry?.Cancel();
        qrExpiry?.Dispose();
        qrExpiry = null;
    }

    private void LockChanged()
    {
        if (AppLock.Locked || !AppLock.Foreground)
            _ = InvokeAsync(() =>
            {
                // The permission dialog can pause the activity before any camera
                // session exists. The scanner rechecks lock/foreground after it.
                // Native active sessions cancel themselves on this event.
                if (qrState.ShowReview) ClearQr();
                if (!IsDisposed) StateHasChanged();
            });
    }

    private async Task ScanQr()
    {
        if (busy || linked || AppLock.Locked || !AppLock.Foreground) return;
        ClearQr();
        var generation = qrGeneration;
        busy = true; qrError = string.Empty;
        try
        {
            var text = await QrScanner.ScanAsync(Lifetime);
            if (IsDisposed || Lifetime.IsCancellationRequested || generation != qrGeneration || AppLock.Locked || !AppLock.Foreground) return;
            if (text is null) return;
            var allowLocal = false;
#if DEBUG
            allowLocal = true;
#endif
            if (!ConnectQrPayload.TryParse(text, out var candidate, allowLocal))
            { qrError = L.Get(Str.ConnQrInvalid); return; }
            serviceInfo = null; linkError = applyError = message = string.Empty;
            reconcile = null; mergeStats = null; mergeStatsFor = null;
            armed = null;
            password = newPassword = confirmPassword = string.Empty;
            mode = "existing";
            qrServiceUrl = candidate!.ServiceUrl; qrSyncId = candidate.Id;
            if (!qrState.Offer(candidate, generation)) return;
            qrExpiry = CancellationTokenSource.CreateLinkedTokenSource(Lifetime);
            _ = ExpireQr(generation, qrExpiry.Token);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (!IsDisposed && generation == qrGeneration)
                qrError = ex is Services.QrScanException scanError ? L.Get(scanError.MessageKey) : L.Get(Str.ConnQrUnavailable);
            Session.Log.Warn("connect", $"QR scanner failed: {ex.GetType().Name}");
        }
        finally { if (!IsDisposed) busy = false; }
    }

    private async Task ExpireQr(int generation, CancellationToken ct)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(60), ct);
            await InvokeAsync(() =>
            {
                if (IsDisposed || generation != qrGeneration) return;
                ClearQr(); qrError = L.Get(Str.ConnQrCleared); StateHasChanged();
            });
        }
        catch (OperationCanceledException) { }
    }

    private async Task LinkQr()
    {
        if (busy || linked || pendingQr is null || AppLock.Locked || !AppLock.Foreground) return;
        var candidate = qrState.BeginVerification();
        StopQrExpiry();
        if (candidate is null) { qrError = L.Get(Str.ConnQrCleared); return; }
        var generation = qrGeneration;
        var targetUrl = candidate.ServiceUrl;
        var targetId = candidate.Id;
        var secret = candidate.Password;
        candidate = null;
        var task = LinkExistingCredentials(targetUrl, targetId, secret, generation);
        secret = string.Empty;
        try { await task; }
        finally { if (generation == qrGeneration) ClearQr(); }
    }

    private bool CurrentQrAttempt(int generation) => !IsDisposed && generation == qrGeneration
        && qrState.IsVerifying && !AppLock.Locked && AppLock.Foreground;

    public override void Dispose()
    {
        AppLock.Changed -= LockChanged;
        ClearQr();
        base.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        if (!await WaitForSessionAsync(Session)) return;

        await RefreshStateAsync();
    }

    private async Task RefreshStateAsync()
    {
        var c = await Creds.GetAsync();
        linked = c is not null;
        linkedUrl = c?.ServiceUrl;
        linkedId = c?.Id;
        if (Session.Store is not null)
        {
            var stats = await Session.Store.GetStatsAsync();
            localCount = stats.Folders + stats.Bookmarks + stats.Separators;
        }
    }


    private void Disarm() => armed = null;

    private async Task CopyLinkedId()
    {
        if (string.IsNullOrEmpty(linkedId))
        {
            return;
        }

        try
        {
            await Clipboard.Default.SetTextAsync(linkedId);
            _ = Toast.ShowAsync(L.Get(Str.ConnCopied));
        }
        catch
        {
            _ = Toast.ShowAsync(L.Get(Str.ConnCopyFailed), isError: true);
        }
    }

    private async Task ExecuteUnlink()
    {
        await RunStepAsync(async () =>
        {
            await Creds.ClearAsync();
            armedUnlink = false;
            await RefreshStateAsync();
            Session.Log.Info("connect", "Device unlinked");
            Ok(WorkflowTexts.UnlinkDone);
        }, err => unlinkError = err, "connect-unlink");
    }


    private bool CanCreate => serviceInfo?.Status == Core.Models.ServiceStatus.Online;
    private Task ServiceChecked(Core.Api.ServiceInfoResponse? info) { serviceInfo = info; return Task.CompletedTask; }
    private Task ServiceChanged(string url) { serviceUrl = url; ClearQr(); reconcile = null; linkError = string.Empty; armed = null; return Task.CompletedTask; }


    private Task LinkExisting() => serviceInfo is null ? Task.CompletedTask : LinkExistingCredentials(ServiceUrlClean, syncId.Trim(), password);

    private async Task LinkExistingCredentials(string targetUrl, string targetId, string targetPassword, int? qrAttempt = null)
    {
        await RunStepAsync(async () =>
        {
            if (string.IsNullOrWhiteSpace(targetId) || string.IsNullOrEmpty(targetPassword))
            {
                throw new InvalidOperationException(L.Get(Str.ConnEnterBoth));
            }

            var probe = Session.ProbeLinkAsync(targetUrl, targetId, targetPassword, Lifetime);
            targetPassword = string.Empty;
            var result = await probe;
            if (IsDisposed || Lifetime.IsCancellationRequested || (qrAttempt.HasValue && !CurrentQrAttempt(qrAttempt.Value))) return;
            serviceUrl = targetUrl; syncId = targetId;
            reconcile = result;
            // Consumed: the candidate carries the key; a failed check keeps it for a retry.
            password = string.Empty;

            mergeStats = null;
            mergeStatsFor = null;
            applyError = string.Empty;
            if (reconcile is { LocalCount: 0, RemoteCount: 0 })
            {
                await Session.ApplyRemoteAsync(reconcile);
                reconcile = null;
                await RefreshStateAsync();
                Ok(L.Get(Str.ConnLinkedEmpty));
            }
            else
            {
                // Preselect the only sensible direction when one side is empty.
                direction = reconcile.RemoteCount == 0 ? "upload" : "download";
            }
        }, err =>
        {
            if (!qrAttempt.HasValue) linkError = err;
            else if (CurrentQrAttempt(qrAttempt.Value)) qrError = err;
        }, "connect-link");
    }

    private async Task CreateNew()
    {
        if (!CanCreate) return;
        await RunStepAsync(async () =>
        {
            WorkflowRules.RequireNewPassword(newPassword, confirmPassword);
            await Session.CreateNewSyncAsync(ServiceUrlClean, newPassword);

            reconcile = null;
            armed = null;
            newPassword = string.Empty;
            confirmPassword = string.Empty;
            await RefreshStateAsync();
            Ok($"{L.Get(Str.ConnCreatedEmpty)} {WorkflowTexts.CreatedNext}");
        }, err => linkError = err, "connect-create");
    }

    private async Task CreateWithUpload()
    {
        if (!CanCreate) return;
        await RunStepAsync(async () =>
        {
            WorkflowRules.RequireNewPassword(newPassword, confirmPassword);
            await Session.CreateNewSyncWithUploadAsync(ServiceUrlClean, newPassword);

            reconcile = null;
            newPassword = string.Empty;
            confirmPassword = string.Empty;
            await RefreshStateAsync();
            Ok($"{L.Get(Str.ConnCreatedUpload)} {WorkflowTexts.CreatedNext}");
        }, err => linkError = err, "connect-create");
    }

    private string ApplyLabel => direction switch
    {
        "upload" => L.Get(Str.ConnApplyDevice),
        "merge" => L.Get(Str.ConnApplyMerge),
        _ => L.Get(Str.ConnApplyServer),
    };

    private Task ApplyChosen() => busy || reconcile is null ? Task.CompletedTask : direction switch
    {
        "upload" => ApplyLocal(),
        "merge" => ApplyMerge(),
        _ => ApplyRemote(),
    };

    private async Task ApplyRemote()
    {
        await RunStepAsync(async () =>
        {
            var target = reconcile!;
            await Session.ApplyRemoteAsync(target);
            reconcile = null;
            mergeStats = null;
            mergeStatsFor = null;
            await RefreshStateAsync();
            Ok($"{Core.Sync.MoveResult.Describe("existing", "pull", target.Candidate.ServiceUrl, target.Candidate.Id)} {L.Get(Str.ConnSafetyLocal)}");
        }, err => applyError = err, "connect-apply");
    }

    private async Task ApplyLocal()
    {
        await RunStepAsync(async () =>
        {
            var target = reconcile!;
            await Session.ApplyLocalAsync(target);
            reconcile = null;
            mergeStats = null;
            mergeStatsFor = null;
            await RefreshStateAsync();
            Ok($"{Core.Sync.MoveResult.Describe("existing", "push", target.Candidate.ServiceUrl, target.Candidate.Id)} {L.Get(Str.ConnSafetyRemote)}");
        }, err => applyError = err, "connect-apply");
    }

    private async Task PreviewMerge()
    {
        if (busy) return;
        await RunStepAsync(async () =>
        {
            var target = reconcile;
            if (target is null || direction != "merge") return;
            var preview = await Session.GetMergePreviewAsync(target);
            if (IsDisposed || !ReferenceEquals(target, reconcile) || direction != "merge") return;
            mergeStats = preview;
            mergeStatsFor = target;
            message = string.Empty;
        }, err => applyError = err, "connect-merge-preview");
    }

    private async Task ApplyMerge()
    {
        await RunStepAsync(async () =>
        {
            var target = reconcile!;
            if (mergeStats is null || !ReferenceEquals(mergeStatsFor, target))
            {
                throw new InvalidOperationException(L.Get(Str.ConnPreviewFirst));
            }

            await Session.ApplyMergeAsync(target, Core.Safety.SafetyOperations.ConnectMerge);
            reconcile = null;
            mergeStats = null;
            mergeStatsFor = null;
            await RefreshStateAsync();
            Ok($"{Core.Sync.MoveResult.Describe("existing", "merge", target.Candidate.ServiceUrl, target.Candidate.Id)} {L.Get(Str.ConnSafetyBoth)}");
        }, err => applyError = err, "connect-apply");
    }

    /// <summary>One action cluster, one adjacent error box: each wizard step
    /// reports into its own field (check/link/apply) rendered next to the
    /// button that produced it, instead of a single shared box.</summary>
    private async Task RunStepAsync(Func<Task> action, Action<string> setError, [System.Runtime.CompilerServices.CallerMemberName] string op = "?")
    {
        busy = true;
        isError = false;
        message = string.Empty;
        setError(string.Empty);
        try
        {
            Session.Log.Debug("connect", $"{op}: start");
            await action();
            Session.Log.Info("connect", $"{op}: ok");
        }
        catch (OperationCanceledException) when (Lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            if (IsDisposed) return;
            isError = true;
            setError(ex.Message);
            Session.Log.Warn("connect", $"{op} failed: {ex.GetType().Name}");
        }
        finally
        {
            // Secrets are cleared by each step once consumed, never on a
            // failure: the retry needs them.
            busy = false;
        }
    }

    private void Ok(string text)
    {
        isError = false;
        message = text;
    }
}
