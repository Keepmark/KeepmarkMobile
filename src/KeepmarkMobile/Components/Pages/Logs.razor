@page "/logs"
@using Keepmark.Core.Workflow
@inject KeepmarkMobile.Services.XbsSession Session
@inject KeepmarkMobile.Services.ToastState Toast

<PageTitle>@L.Get(Str.NavLogs)</PageTitle>

<h1>@L.Get(Str.NavLogs)</h1>
<p class="text-muted">@L.Get(Str.LogsBuffer) <strong>@entries.Count</strong> @L.Get(Str.LogsEntriesRecording) <strong>@minLevel</strong> @L.Get(Str.LogsInfoRest)</p>

<div class="d-flex gap-2 flex-wrap mb-2">
    <select class="form-select xbs-log-filter-level" aria-label="@L.Get(Str.LogsLevelFilterAria)" @bind="level">
        <option value="">@L.Get(Str.LogsAllLevels)</option>
        <option value="@Core.Logging.XbsLogLevel.Error">@L.Get(Str.LogLevelError)</option>
        <option value="@Core.Logging.XbsLogLevel.Warning">@L.Get(Str.LogLevelWarning)</option>
        <option value="@Core.Logging.XbsLogLevel.Info">@L.Get(Str.LogLevelInfo)</option>
        <option value="@Core.Logging.XbsLogLevel.Debug">@L.Get(Str.LogLevelDebug)</option>
        <option value="@Core.Logging.XbsLogLevel.Verbose">@L.Get(Str.LogLevelVerboseShort)</option>
    </select>
    <input class="form-control xbs-log-filter-text" aria-label="@L.Get(Str.LogsFilterAria)" placeholder="@L.Get(Str.LogsFilterPlaceholder)" @bind="filter" @bind:event="oninput" />
    <button class="btn btn-outline-secondary" @onclick="Refresh">@L.Get(Str.CommonRefresh)</button>
    <button class="btn btn-outline-secondary" @onclick="Export">@L.Get(Str.CommonExport)</button>
    <button class="btn btn-outline-danger" @onclick="() => armedClear = true" disabled="@armedClear">@L.Get(Str.CommonClear)</button>
</div>
@if (armedClear)
{
    <ConfirmBlock Message="@L.Get(Str.LogsClearMessage)" Implication="@WorkflowTexts.LogsClearImplication" ConfirmLabel="@L.Get(Str.CommonYesClear)"
                  OnConfirm="ExecuteClear" OnCancel="() => armedClear = false" />
}

@if (Shown().Count == 0)
{
    <p class="text-muted">@L.Get(Str.LogsNone)</p>
}
else
{
    <div class="xbs-loglist">
        @foreach (var e in Shown())
        {
            <div class="xbs-logrow xbs-log-@e.Level.ToString().ToLowerInvariant()">
                <span class="xbs-logtime">@e.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                <span class="xbs-loglevel">@e.Level</span>
                <span class="xbs-logtag">@e.Tag</span>
                <span class="xbs-logmsg">@e.Message</span>
            </div>
        }
    </div>
}

@code {
    private string level = string.Empty;
    private string filter = string.Empty;
    private string minLevel = "?";
    private bool armedClear;
    private List<Core.Logging.LogEntry> entries = [];

    protected override void OnInitialized()
    {
        minLevel = Session.Log.MinLevel.ToString();
        Refresh();
    }

    private void Refresh()
    {
        minLevel = Session.Log.MinLevel.ToString();
        entries = Session.Log.Entries.Reverse().Take(300).ToList();
    }

    private List<Core.Logging.LogEntry> Shown()
    {
        var list = entries.AsEnumerable();
        if (Enum.TryParse<Core.Logging.XbsLogLevel>(level, out var lv))
        {
            list = list.Where(e => e.Level <= lv);
        }

        if (!string.IsNullOrWhiteSpace(filter))
        {
            list = list.Where(e =>
                e.Message.Contains(filter, StringComparison.OrdinalIgnoreCase) ||
                e.Tag.Contains(filter, StringComparison.OrdinalIgnoreCase));
        }

        return list.ToList();
    }

    private void ExecuteClear()
    {
        Session.Log.Clear();
        armedClear = false;
        Refresh();
        _ = Toast.ShowAsync(L.Get(Str.LogsCleared));
    }

    private async Task Export()
    {
        var lines = Shown().Select(e =>
            $"{e.Timestamp:u} [{e.Level}] {e.Tag}: {e.Message}");
        var text = $"Keepmark log export ({AppInfo.VersionString}, {DateTimeOffset.Now:u})\n" +
            string.Join('\n', lines) + "\n";
        var path = Path.Combine(FileSystem.CacheDirectory,
            $"keepmark-log-{DateTime.UtcNow:yyyyMMdd-HHmmss}.log");
        await File.WriteAllTextAsync(path, text);
        try
        {
            await Share.Default.RequestAsync(new ShareFileRequest(
                L.Get(Str.LogsShareTitle), new ShareFile(path)));
        }
        catch
        {
            _ = Toast.ShowAsync(L.Get(Str.LogsExportCancelled), isError: true);
        }
    }
}
