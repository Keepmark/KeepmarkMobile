@page "/logs"
@inject KeepmarkMobile.Services.XbsSession Session
@inject KeepmarkMobile.Services.ToastState Toast

<PageTitle>Logs</PageTitle>

<h1>Logs</h1>
<p class="text-muted">Buffer: <strong>@entries.Count</strong> entries · recording at <strong>@minLevel</strong> (change in Settings → Log verbosity). Newest first. At Verbose level entries may include your bookmark titles/URLs — check before sharing.</p>

<div class="d-flex gap-2 flex-wrap mb-2">
    <select class="form-select xbs-log-filter-level" aria-label="Log level filter" @bind="level">
        <option value="">All levels</option>
        <option value="@Core.Logging.XbsLogLevel.Error">Error</option>
        <option value="@Core.Logging.XbsLogLevel.Warning">Warning</option>
        <option value="@Core.Logging.XbsLogLevel.Info">Info</option>
        <option value="@Core.Logging.XbsLogLevel.Debug">Debug</option>
        <option value="@Core.Logging.XbsLogLevel.Verbose">Verbose</option>
    </select>
    <input class="form-control xbs-log-filter-text" aria-label="Filter log text" placeholder="Filter text…" @bind="filter" @bind:event="oninput" />
    <button class="btn btn-outline-secondary" @onclick="Refresh">Refresh</button>
    <button class="btn btn-outline-secondary" @onclick="Export">Export…</button>
    @if (!armedClear)
    {
        <button class="btn btn-outline-danger" @onclick="() => armedClear = true">Clear…</button>
    }
    else
    {
        <button class="btn btn-danger" @onclick="ExecuteClear">Yes, clear</button>
        <button class="btn btn-secondary" @onclick="() => armedClear = false">Cancel</button>
    }
</div>

@if (Shown().Count == 0)
{
    <p class="text-muted">No entries. Raise the log verbosity in Settings to record more.</p>
}
else
{
    <div class="xbs-loglist">
        @foreach (var e in Shown())
        {
            <div class="xbs-logrow xbs-log-@e.Level.ToString().ToLowerInvariant()">
                <span class="xbs-logtime">@e.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                <span class="xbs-loglevel">@e.Level</span>
                <span class="xbs-logtag">@e.Tag</span>
                <span class="xbs-logmsg">@e.Message</span>
            </div>
        }
    </div>
}

@code {
    private string level = string.Empty;
    private string filter = string.Empty;
    private string minLevel = "?";
    private bool armedClear;
    private List<Core.Logging.LogEntry> entries = [];

    protected override void OnInitialized()
    {
        minLevel = Session.Log.MinLevel.ToString();
        Refresh();
    }

    private void Refresh()
    {
        minLevel = Session.Log.MinLevel.ToString();
        entries = Session.Log.Entries.Reverse().Take(300).ToList();
    }

    private List<Core.Logging.LogEntry> Shown()
    {
        var list = entries.AsEnumerable();
        if (Enum.TryParse<Core.Logging.XbsLogLevel>(level, out var lv))
        {
            list = list.Where(e => e.Level <= lv);
        }

        if (!string.IsNullOrWhiteSpace(filter))
        {
            list = list.Where(e =>
                e.Message.Contains(filter, StringComparison.OrdinalIgnoreCase) ||
                e.Tag.Contains(filter, StringComparison.OrdinalIgnoreCase));
        }

        return list.ToList();
    }

    private void ExecuteClear()
    {
        Session.Log.Clear();
        armedClear = false;
        Refresh();
        _ = Toast.ShowAsync("Log buffer cleared");
    }

    private async Task Export()
    {
        var lines = Shown().Select(e =>
            $"{e.Timestamp:u} [{e.Level}] {e.Tag}: {e.Message}");
        var text = $"Keepmark log export ({AppInfo.VersionString}, {DateTimeOffset.Now:u})\n" +
            string.Join('\n', lines) + "\n";
        var path = Path.Combine(FileSystem.CacheDirectory,
            $"keepmark-log-{DateTime.UtcNow:yyyyMMdd-HHmmss}.log");
        await File.WriteAllTextAsync(path, text);
        try
        {
            await Share.Default.RequestAsync(new ShareFileRequest(
                "Share log file", new ShareFile(path)));
        }
        catch
        {
            _ = Toast.ShowAsync("Export cancelled", isError: true);
        }
    }
}
