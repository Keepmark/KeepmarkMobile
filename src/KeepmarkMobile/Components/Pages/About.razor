@page "/about"

<PageTitle>@L.Get(Str.NavAbout)</PageTitle>

<h1>@L.Get(Str.NavAbout)</h1>

<p><strong>Keepmark</strong> v@(AppInfo.VersionString) (build @(AppInfo.BuildString))</p>
<p>@L.Get(Str.AboutIndependent)</p>

<h3>@L.Get(Str.AboutCompat)</h3>
<ul>
    <li>@L.Get(Str.AboutLegacyA) <strong>xBrowserSync API v@Core.XbsConstants.ApiVersion</strong>
        @L.Get(Str.AboutLegacyB) v@(Core.XbsConstants.MinApiVersion)@L.Get(Str.AboutLegacyC)
        <strong>@L.Get(Str.AboutExtendedStrong, Core.XbsConstants.ApiVersion12)</strong>
        @L.Get(Str.AboutLegacyD)</li>
    <li>@L.Get(Str.AboutFmtA) <strong>v@(Core.XbsConstants.SyncClientVersion)</strong>@L.Get(Str.AboutFmtB)</li>
    <li>@L.Get(Str.AboutCrypto)</li>
</ul>

<h3>@L.Get(Str.AboutProject)</h3>
<p>@L.Get(Str.AboutProjectText)
    <a href="https://github.com/Keepmark">github.com/Keepmark</a></p>

<h3>@L.Get(Str.AboutRefs)</h3>
<ul>
    <li><a href="https://www.xbrowsersync.org/">@L.Get(Str.AboutRefProject)</a> (GPL-3.0)</li>
    <li><a href="https://github.com/xbrowsersync/api">@L.Get(Str.AboutRefApi)</a></li>
    <li><a href="https://github.com/xbrowsersync/app">@L.Get(Str.AboutRefClient)</a></li>
    <li><a href="https://www.xbrowsersync.org/privacypolicy">@L.Get(Str.AboutRefPrivacy)</a></li>
</ul>

<h3>@L.Get(Str.AboutLicense)</h3>
<p>@L.Get(Str.AboutLicA) <strong>GNU GPL v3</strong>@L.Get(Str.AboutLicB) <a href="https://github.com/Keepmark">@L.Get(Str.AboutLicC)</a>.</p>

<h3>@L.Get(Str.AboutDisclaimer)</h3>
<p>@L.Get(Str.AboutDisA) <strong>@L.Get(Str.AboutDisB)</strong>@L.Get(Str.AboutDisC)
    <strong>@L.Get(Str.AboutDisD)</strong>@L.Get(Str.AboutDisE)</p>

<h3>@L.Get(Str.AboutBug)</h3>
<p>@L.Get(Str.AboutBugA) <a href="https://github.com/Keepmark">GitHub</a>@L.Get(Str.AboutBugB)</p>
<button class="btn btn-outline-primary" @onclick="ReportBug">@L.Get(Str.AboutBug)</button>

@code {
    private async Task ReportBug()
    {
        var details =
            $"App version: {AppInfo.VersionString} (build {AppInfo.BuildString})\n" +
            $"API version: {Core.XbsConstants.ApiVersion} (v1.2: {Core.XbsConstants.ApiVersion12})\n" +
            $"Android: {DeviceInfo.VersionString} ({DeviceInfo.Model})\n";
        try
        {
            await Clipboard.Default.SetTextAsync(details);
            await Launcher.OpenAsync("https://github.com/Keepmark");
        }
        catch
        {
            // No browser available; the GitHub link above remains visible.
        }
    }
}
