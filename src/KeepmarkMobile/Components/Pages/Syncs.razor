@inherits KeepmarkMobile.Components.SessionComponentBase
@page "/syncs"
@using Keepmark.Core.Sync
@using Keepmark.Core.Workflow
@inject KeepmarkMobile.Services.XbsSession Session
@inject KeepmarkMobile.Services.SecureCredentialStore Creds
@inject KeepmarkMobile.Services.XbsSettings AppSettings
@inject KeepmarkMobile.Services.AppLockState AppLock
@inject KeepmarkMobile.Services.IAppLockService LockPrompt
@inject KeepmarkMobile.Services.ToastState Toast
@implements IDisposable

<PageTitle>@L.Get(Str.SyncsTitle)</PageTitle>

<h1>@L.Get(Str.SyncsTitle)</h1>

@* The intro stays one line: the rest is a tap away, so the list and the
   button are visible without scrolling. *@
<InfoHint Text="@L.Get(Str.SyncsIntroShort)" Title="@L.Get(Str.SyncsTitle)" Body="@L.Get(Str.SyncsIntro)" />

@if (!string.IsNullOrEmpty(loadError))
{
    <div class="alert alert-danger" role="alert">@loadError</div>
}

@if (!loaded)
{
    <p role="status"><em>@L.Get(Str.CommonLoading)</em></p>
}
else if (adding)
{
    @* The connect/add flow lives here, not on a page of its own: one section
       owns the syncs, and the list reappears when the panel is done. *@
    <ConnectPanel AddingWhileLinked="@(active is not null)" AllowCreate="@(active is null)"
                  OnFinished="FinishAddingAsync" OnCancel="CancelAdding" />
}
else if (rows.Count == 0 && string.IsNullOrEmpty(loadError))
{
    <p class="text-muted">@L.Get(Str.SyncsEmpty)</p>
    <div class="d-grid">
        <button class="btn btn-primary" @onclick="StartAdding">@L.Get(Str.ConnAddSyncBtn)</button>
    </div>
}
else
{
    @for (var i = 0; i < rows.Count; i++)
    {
        var row = rows[i];
        var key = SavedSyncs.Key(row.ServiceUrl, row.SyncId);
        var name = SavedSyncs.Name(row);
        var isActive = IsActive(row);
        @* One row task at a time: the row that owns the open confirmation or
           rename editor is outlined, every other row is disabled below. *@
        <div class="card mb-2 @(OwnsTask(key) ? "border-primary" : "")" @key="key">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <div><strong>@name</strong></div>
                        <div class="form-text">
                            @SavedSyncs.ServiceHost(row.ServiceUrl) · ID <code>@SavedSyncs.ShortSyncId(row.SyncId)</code>
                        </div>
                    </div>
                    <span class="badge @(isActive ? "text-bg-success" : "text-bg-secondary")">
                        @L.Get(isActive ? Str.SyncsActive : Str.SyncsInactive)
                    </span>
                </div>

                @if (renamingKey == key)
                {
                    <div class="mt-2">
                        <label class="form-label" for="sync-name-@i">@L.Get(Str.SyncsNameLabel)</label>
                        <input id="sync-name-@i" class="form-control" @bind="renameText"
                               placeholder="@RenameSuggestion(row)"
                               maxlength="@SavedSyncs.MaxLabelLength" disabled="@busy" />
                        @if (nameTaken)
                        {
                            <div class="form-text text-danger" role="alert">@L.Get(Str.SyncsNameTaken)</div>
                        }
                        <div class="mt-2 d-flex gap-2">
                            <button class="btn btn-primary" @onclick="SaveRenameAsync" disabled="@busy">@L.Get(Str.CommonSave)</button>
                            <button class="btn btn-secondary" @onclick="CancelRename" disabled="@busy">@L.Get(Str.CommonCancel)</button>
                        </div>
                    </div>
                }
                else if (armedActivateKey == key)
                {
                    <ConfirmBlock Message="@L.Get(Str.SyncsActivateMessage, name)"
                                  Implication="@L.Get(Str.SyncsActivateHint, name)"
                                  ConfirmLabel="@L.Get(Str.SyncsActivate)" Danger="false" Busy="busy"
                                  OnConfirm="ActivateAsync" OnCancel="Disarm" />
                }
                else if (armedForgetKey == key)
                {
                    <ConfirmBlock Message="@L.Get(Str.SyncsForgetMessage, name)"
                                  Implication="@L.Get(Str.SyncsForgetImplication)"
                                  ConfirmLabel="@L.Get(Str.CommonYesForget)" Busy="busy"
                                  OnConfirm="ForgetAsync" OnCancel="Disarm" />
                }
                else if (armedUnlinkKey == key)
                {
                    <ConfirmBlock Message="@L.Get(Str.SyncsUnlinkMessage, name)"
                                  Implication="@WorkflowTexts.UnlinkImplication"
                                  ConfirmLabel="@L.Get(Str.CommonYesUnlink)" Busy="busy"
                                  OnConfirm="UnlinkAsync" OnCancel="Disarm" />
                }
                else
                {
                    <div class="mt-2 d-flex flex-wrap gap-2">
                        @if (!isActive)
                        {
                            <button class="btn btn-primary btn-sm" @onclick="() => Arm(key, armActivate: true)" disabled="@RowBusy(key)"
                                    title="@L.Get(Str.SyncsActivateHint, name)">
                                @L.Get(Str.SyncsActivate)
                            </button>
                        }
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => StartRename(key, row)" disabled="@RowBusy(key)">
                            @L.Get(Str.SyncsRename)
                        </button>
                        @if (isActive)
                        {
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => Arm(key, armUnlink: true)" disabled="@RowBusy(key)">
                                @L.Get(Str.ConnUnlinkBtn)
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => Arm(key, armForget: true)" disabled="@RowBusy(key)">
                                @L.Get(Str.SyncsForget)
                            </button>
                        }
                    </div>
                }

                @if (noticeKey == key && !string.IsNullOrEmpty(notice))
                {
                    <StepMessage Text="@notice" Error="noticeError" />
                }
            </div>
        </div>
    }

    <div class="d-grid mt-3">
        @* Starting the add flow closes any row task first: the list is replaced
           by the panel, so the two operations never share the screen. *@
        <button class="btn btn-outline-primary" @onclick="StartAdding" disabled="@(busy || RowTaskOpen)">@L.Get(Str.ConnAddSyncBtn)</button>
    </div>
    @if (active is not null)
    {
        <InfoHint Text="@L.Get(Str.ConnAddSyncHintShort)" Title="@L.Get(Str.ConnAddSyncBtn)" Body="@L.Get(Str.ConnAddSyncHint)" />
    }
}

@code {
    private List<SavedSync> rows = [];
    private SyncCredentials? active;
    private bool loaded;
    private bool busy;
    /// <summary>The connect/add panel replaces the list while it is open: the
    /// page is the single place where syncs are managed.</summary>
    private bool adding;

    private string? armedActivateKey;
    private string? armedForgetKey;
    private string? armedUnlinkKey;
    private string? renamingKey;

    /// <summary>A row task is open (a confirmation or the rename editor) or
    /// running: the page must show one operation only, so every other row
    /// action stays disabled until it ends or is cancelled.</summary>
    private bool RowTaskOpen =>
        busy || renamingKey is not null || armedActivateKey is not null
        || armedForgetKey is not null || armedUnlinkKey is not null;

    /// <summary>True for the row that owns the open task (it gets the
    /// outline; its action buttons are replaced by the confirmation).</summary>
    private bool OwnsTask(string key) =>
        renamingKey == key || armedActivateKey == key
        || armedForgetKey == key || armedUnlinkKey == key;

    /// <summary>Disabled state of a row action: running, or another row is
    /// in the middle of a task. The owner keeps its own controls live.</summary>
    private bool RowBusy(string key) => busy || (RowTaskOpen && !OwnsTask(key));
    private string renameText = string.Empty;
    private bool nameTaken;

    private string? noticeKey;
    private string notice = string.Empty;
    private bool noticeError;
    private string loadError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!await WaitForSessionAsync(Session)) return;
        AppLock.Changed += OnLockChanged;
        await RefreshAsync();
    }

    public override void Dispose()
    {
        AppLock.Changed -= OnLockChanged;
        base.Dispose();
    }

    private void OnLockChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task RefreshAsync()
    {
        try
        {
            active = await Creds.GetAsync();
            rows = Session.Registry is null ? new List<SavedSync>() : await Session.Registry.ListAsync();
            loadError = string.Empty;
        }
        catch (Exception ex)
        {
            // An unreadable registry must not look like "no saved syncs".
            rows = [];
            loadError = L.Get(Str.ErrLoadFailed, ex.Message);
            Session.Log.Warn("syncs", $"Saved-sync list unreadable: {ex.GetType().Name}");
        }
        finally
        {
            loaded = true;
        }
    }

    /// <summary>Name the row would get from its host: shown as the rename
    /// placeholder so "empty" is explained instead of looking like a bug.</summary>
    private string RenameSuggestion(SavedSync row) =>
        SavedSyncs.SuggestName(row.ServiceUrl, rows, row.Identity);

    private bool IsActive(SavedSync row) =>
        active is not null && SavedSyncs.Same(row.Identity, new SavedSyncIdentity(active.ServiceUrl, active.Id));

    private void Disarm()
    {
        armedActivateKey = null;
        armedForgetKey = null;
        armedUnlinkKey = null;
    }

    // ---- add / connect ---------------------------------------------------

    private void StartAdding()
    {
        Disarm();
        ClearNotice();
        renamingKey = null;
        adding = true;
    }

    private void CancelAdding() => adding = false;

    /// <summary>The panel finished (linked, created or applied): the list is
    /// the outcome, so refresh and show it again.</summary>
    private async Task FinishAddingAsync()
    {
        adding = false;
        await RefreshAsync();
    }

    private void Arm(string key, bool armActivate = false, bool armForget = false, bool armUnlink = false)
    {
        Disarm();
        renamingKey = null;
        if (armActivate) armedActivateKey = key;
        if (armForget) armedForgetKey = key;
        if (armUnlink) armedUnlinkKey = key;
        ClearNotice();
    }

    private void ClearNotice()
    {
        noticeKey = null;
        notice = string.Empty;
        noticeError = false;
    }

    private void ShowNotice(string? key, string text, bool error = false)
    {
        noticeKey = key;
        notice = text;
        noticeError = error;
    }

    // ---- activation -------------------------------------------------------

    /// <summary>Activation asks for the device PIN/biometric when app lock is
    /// configured: the saved key is enough to switch, so the step itself must
    /// be the proof it is the owner.</summary>
    private async Task<bool> ConfirmWithAppLockAsync()
    {
        if (AppSettings.AppLock == "Off") return true;
        if (!AppLock.Foreground) return false;
        var ok = false;
        AppLock.BeginAuth();
        try
        {
            ok = await LockPrompt.AuthenticateAsync(L.Get(Str.SyncsUnlockTitle), requireDeviceCredential: false);
        }
        catch
        {
            ok = false;
        }
        finally
        {
            // Success also counts as an unlock; a cancel here never locks.
            AppLock.EndAuth(ok);
        }

        return ok;
    }

    private async Task ActivateAsync()
    {
        var key = armedActivateKey;
        var row = rows.FirstOrDefault(r => SavedSyncs.Key(r.ServiceUrl, r.SyncId) == key);
        if (busy || row is null) return;
        busy = true;
        ClearNotice();
        var name = SavedSyncs.Name(row);
        try
        {
            if (!await ConfirmWithAppLockAsync())
            {
                Disarm();
                return;
            }

            // Read-only preflight first: a wrong key, an expired sync or an
            // unreachable service changes nothing. Then the switch itself is
            // fail-closed: unsaved edits block it.
            var info = await Session.VerifySavedSyncAsync(row.Identity, Lifetime);
            await Session.ActivateSavedSyncAsync(info);
            Disarm();
            await RefreshAsync();
            ShowNotice(key, L.Get(Str.SyncsActivated, name));
            _ = Toast.ShowAsync(L.Get(Str.SyncsActivated, name));
        }
        catch (OperationCanceledException) when (IsDisposed)
        {
            // Page left while verifying: nothing was written.
        }
        catch (Exception ex)
        {
            ShowNotice(key, ex.Message, error: true);
        }
        finally
        {
            busy = false;
        }
    }

    // ---- forget / unlink -------------------------------------------------

    private async Task ForgetAsync()
    {
        var key = armedForgetKey;
        var row = rows.FirstOrDefault(r => SavedSyncs.Key(r.ServiceUrl, r.SyncId) == key);
        if (busy || row is null || IsActive(row)) return;
        busy = true;
        ClearNotice();
        var name = SavedSyncs.Name(row);
        try
        {
            if (Session.Registry is not null) await Session.ForgetSavedSyncAsync(row.Identity);
            Disarm();
            await RefreshAsync();
            _ = Toast.ShowAsync(L.Get(Str.SyncsForgot, name));
        }
        catch (Exception ex)
        {
            ShowNotice(key, ex.Message, error: true);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task UnlinkAsync()
    {
        var key = armedUnlinkKey;
        var row = rows.FirstOrDefault(r => SavedSyncs.Key(r.ServiceUrl, r.SyncId) == key);
        if (busy || row is null) return;
        busy = true;
        ClearNotice();
        var name = SavedSyncs.Name(row);
        try
        {
            await Session.UnlinkAsync();
            Disarm();
            await RefreshAsync();
            _ = Toast.ShowAsync(L.Get(Str.SyncsUnlinked, name));
        }
        catch (Exception ex)
        {
            ShowNotice(key, ex.Message, error: true);
        }
        finally
        {
            busy = false;
        }
    }

    // ---- rename ----------------------------------------------------------

    private void StartRename(string key, SavedSync row)
    {
        Disarm();
        ClearNotice();
        renamingKey = key;
        renameText = row.Label ?? string.Empty;
        nameTaken = false;
    }

    private void CancelRename()
    {
        renamingKey = null;
        nameTaken = false;
    }

    private async Task SaveRenameAsync()
    {
        var key = renamingKey;
        var row = rows.FirstOrDefault(r => SavedSyncs.Key(r.ServiceUrl, r.SyncId) == key);
        if (busy || row is null) return;
        busy = true;
        nameTaken = false;
        try
        {
            var ok = Session.Registry is not null && await Session.Registry.RenameAsync(row.Identity, renameText);
            if (!ok)
            {
                nameTaken = true;
                return;
            }

            renamingKey = null;
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            ShowNotice(key, ex.Message, error: true);
        }
        finally
        {
            busy = false;
        }
    }
}
