@inherits KeepmarkMobile.Components.SessionComponentBase
@page "/syncs"
@using Keepmark.Core.Sync
@using Keepmark.Core.Workflow
@using Keepmark.Core.Api
@using KeepmarkMobile.Services
@inject KeepmarkMobile.Services.XbsSession Session
@inject KeepmarkMobile.Services.SecureCredentialStore Creds
@inject KeepmarkMobile.Services.XbsSettings AppSettings
@inject KeepmarkMobile.Services.AppLockState AppLock
@inject KeepmarkMobile.Services.IAppLockService LockPrompt
@inject KeepmarkMobile.Services.ToastState Toast
@inject KeepmarkMobile.Services.SyncLinkInbox LinkInbox
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@L.Get(Str.SyncsTitle)</PageTitle>

<div @onclick="CloseMenu" @onkeydown="CloseMenuOnEscape">
<h1>@L.Get(Str.SyncsTitle)</h1>

@* The intro stays one line: the rest is a tap away, so the list and the
   button are visible without scrolling. *@
<InfoHint Text="@L.Get(Str.SyncsIntroShort)" Title="@L.Get(Str.SyncsTitle)" Body="@L.Get(Str.SyncsIntro)" />

@if (!string.IsNullOrEmpty(loadError))
{
    <div class="alert alert-danger" role="alert">@loadError</div>
}

@if (!loaded)
{
    <p role="status"><em>@L.Get(Str.CommonLoading)</em></p>
}
else if (adding)
{
    @* The connect/add flow lives here, not on a page of its own: one section
       owns the syncs, and the list reappears when the panel is done. *@
    <ConnectPanel AddingWhileLinked="@(active is not null)" AllowCreate="@(active is null)"
                  OnFinished="FinishAddingAsync" OnCancel="CancelAdding" />
}
else if (rows.Count == 0 && string.IsNullOrEmpty(loadError))
{
    <p class="text-muted">@L.Get(Str.SyncsEmpty)</p>
    <div class="d-grid">
        <button class="btn btn-primary" @onclick="StartAdding">@L.Get(Str.ConnAddSyncBtn)</button>
    </div>
}
else
{
    @for (var i = 0; i < rows.Count; i++)
    {
        var row = rows[i];
        var key = SavedSyncs.Key(row.ServiceUrl, row.SyncId);
        var name = SavedSyncs.Name(row);
        var isActive = IsActive(row);
        @* One row task at a time: the row that owns the open confirmation or
           rename editor is outlined, every other row is disabled below. *@
        <div class="card mb-2 @(OwnsTask(key) ? "border-primary" : "")" @key="key">
            <div class="card-body py-2">
                @* One line per sync: the state slot holds the Active badge on the
                   active row and the Activate button on the others, so the
                   active sync never offers to activate itself. *@
                <div class="xbs-sync-head">
                    <div class="xbs-sync-name">
                        <div><strong>@name</strong></div>
                        <div class="form-text">
                            @SavedSyncs.ServiceHost(row.ServiceUrl) · ID <code>@SavedSyncs.ShortSyncId(row.SyncId)</code>
                        </div>
                    </div>
                    @if (isActive)
                    {
                        <span class="badge text-bg-success">@L.Get(Str.SyncsActive)</span>
                    }
                    else if (!OwnsTask(key))
                    {
                        <button class="btn btn-outline-primary btn-sm xbs-sync-activate" @onclick="() => Arm(key, armActivate: true)"
                                disabled="@RowBusy(key)" title="@L.Get(Str.SyncsActivateHint, name)">
                            @L.Get(Str.SyncsActivate)
                        </button>
                    }
                    @if (!OwnsTask(key))
                    {
                        <div class="xbs-sync-actions" @onclick:stopPropagation="true">
                            <button type="button" class="btn btn-outline-secondary xbs-sync-more"
                                    aria-label="@L.Get(Str.RowActionsFor, name)"
                                    aria-expanded="@((menuKey == key).ToString().ToLowerInvariant())"
                                    aria-controls="sync-actions-@i" disabled="@RowBusy(key)"
                                    @onclick="() => ToggleMenu(key)">
                                <span aria-hidden="true">⋮</span>
                            </button>
                        </div>
                    }
                </div>

                @if (renamingKey == key)
                {
                    <div class="mt-2">
                        <label class="form-label" for="sync-name-@i">@L.Get(Str.SyncsNameLabel)</label>
                        @* The field starts with the current name, selected, so
                           typing replaces it; the grey text is only an example,
                           and the line below says what an empty name means. *@
                        <input id="sync-name-@i" class="form-control" @bind="renameText"
                               placeholder="@L.Get(Str.SyncsNameExample)"
                               maxlength="@SavedSyncs.MaxLabelLength" disabled="@busy" />
                        <div class="form-text">@L.Get(Str.SyncsNameEmptyHint, RenameSuggestion(row))</div>
                        @if (nameTaken)
                        {
                            <div class="form-text text-danger" role="alert">@L.Get(Str.SyncsNameTaken)</div>
                        }
                        <div class="mt-2 d-flex gap-2">
                            <button class="btn btn-primary" @onclick="SaveRenameAsync" disabled="@busy">@L.Get(Str.CommonSave)</button>
                            <button class="btn btn-secondary" @onclick="CancelRename" disabled="@busy">@L.Get(Str.CommonCancel)</button>
                        </div>
                    </div>
                }
                else if (armedActivateKey == key && busy)
                {
                    @* Verify + save + download take a few seconds: say so,
                       like the quick-switch sheet does. *@
                    <p class="km-switch-busy mt-2" role="status"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> @L.Get(Str.SwitchActivating)</p>
                }
                else if (armedActivateKey == key)
                {
                    <SwitchConfirm Name="@name" Busy="busy" OnConfirm="ActivateAsync" OnCancel="Disarm" />
                }
                else if (armedForgetKey == key)
                {
                    <ConfirmBlock Message="@L.Get(Str.SyncsForgetMessage, name)"
                                  Implication="@L.Get(Str.SyncsForgetImplication)"
                                  ConfirmLabel="@L.Get(Str.CommonYesForget)" Busy="busy"
                                  OnConfirm="ForgetAsync" OnCancel="Disarm" />
                }
                else if (armedUnlinkKey == key)
                {
                    <ConfirmBlock Message="@L.Get(Str.SyncsUnlinkMessage, name)"
                                  Implication="@WorkflowTexts.UnlinkImplication"
                                  ConfirmLabel="@L.Get(Str.CommonYesUnlink)" Busy="busy"
                                  OnConfirm="UnlinkAsync" OnCancel="Disarm" />
                }
                else if (passwordKey == key)
                {
                    @* The long password belongs to this sync: its change is a
                       row task here, never a Settings section. *@
                    <div class="mt-2">
                        <InfoHint Text="@L.Get(Str.SettingsChangePasswordShort)" Title="@L.Get(Str.SettingsChangePassword)" Body="@L.Get(Str.SettingsChangePasswordHint)" />
                        <div class="mb-2">
                            <label class="form-label" for="sync-pw-current-@i">@L.Get(Str.CommonCurrentPassword)</label>
                            <input id="sync-pw-current-@i" type="password" class="form-control" @bind="pwCurrent" @bind:after="ClearPwError" disabled="@(armedPw || pwBusy)" autocomplete="current-password" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label" for="sync-pw-new-@i">@L.Get(Str.CommonNewPassword)</label>
                            <input id="sync-pw-new-@i" type="password" class="form-control" @bind="pwNew" @bind:after="ClearPwError" disabled="@(armedPw || pwBusy)" autocomplete="new-password" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label" for="sync-pw-confirm-@i">@L.Get(Str.CommonConfirmNewPassword)</label>
                            <input id="sync-pw-confirm-@i" type="password" class="form-control" @bind="pwConfirm" @bind:after="ClearPwError" disabled="@(armedPw || pwBusy)" autocomplete="new-password" />
                        </div>
                        @if (!armedPw)
                        {
                            <div class="d-flex flex-wrap gap-2">
                                <button class="btn btn-warning btn-sm" @onclick="ArmChangePassword" disabled="@pwBusy">@L.Get(Str.SettingsChangePasswordBtn)</button>
                                <button class="btn btn-secondary btn-sm" @onclick="ClosePassword" disabled="@pwBusy">@L.Get(Str.CommonCancel)</button>
                            </div>
                        }
                        @if (armedPw)
                        {
                            <ConfirmBlock Message="@L.Get(Str.SettingsChangePasswordMessage)" Implication="@WorkflowTexts.ChangePasswordImplication"
                                          ConfirmLabel="@L.Get(Str.CommonYesChangePassword)" Busy="pwBusy" OnConfirm="ChangePasswordAsync" OnCancel="() => armedPw = false" />
                        }
                        @if (!string.IsNullOrEmpty(pwError))
                        {
                            <div class="alert alert-danger mt-2" role="alert">@pwError</div>
                        }
                        @if (pwDone)
                        {
                            <div class="alert alert-success mt-2" role="status">@WorkflowTexts.ChangePasswordDone</div>
                        }
                    </div>
                }
                else if (shareKey == key && busy)
                {
                    <p class="km-switch-busy mt-2" role="status"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> @L.Get(Str.SyncsShareChecking)</p>
                }
                else if (shareKey == key && shareLink is not null)
                {
                    @* The link is shown only after the app lock, cleared on close,
                       lock or background, never stored. A lasting link is a
                       credential; a one-time link works once and expires. One
                       tap makes it with the defaults; "Change" remakes it. *@
                    <div class="mt-2 km-share">
                        <label class="form-label" for="sync-share-@i">@L.Get(Str.SyncsShareLabel, name)</label>
                        <textarea id="sync-share-@i" class="form-control font-monospace small" rows="3" readonly
                                  autocomplete="off" spellcheck="false">@shareLink</textarea>
                        @if (shareOnce is { } once)
                        {
                            @if (once.Code is { } code)
                            {
                                <div class="km-share-code mt-2" role="group" aria-label="@L.Get(Str.SyncsShareCodeCaption)">
                                    <span class="km-share-code-caption">@L.Get(Str.SyncsShareCodeCaption)</span>
                                    <span class="km-share-code-value font-monospace">@($"{code[..3]} {code[3..]}")</span>
                                    <span class="form-text">@L.Get(Str.SyncsShareCodeTell)</span>
                                </div>
                            }
                            @if (!shareEditing)
                            {
                                <div class="km-share-summary mt-2">
                                    <span role="status">@L.Get(Str.SyncsShareValidUntil, ValidUntil(once), L.Get(once.Code is null ? Str.SyncsShareNoCode : Str.SyncsShareWithCode))</span>
                                    <button class="xbs-link-btn" @onclick="EditShare">@L.Get(Str.CommonChange)</button>
                                </div>
                            }
                            else
                            {
                                <div class="km-share-options mt-2" role="group" aria-label="@L.Get(Str.CommonChange)">
                                    <label class="form-label" for="sync-share-ttl-@i">@L.Get(Str.SyncsShareTtlLabel)</label>
                                    <select id="sync-share-ttl-@i" class="form-select mb-2" @bind="shareTtl">
                                        @foreach (var (seconds, text) in ShareTtlChoices)
                                        {
                                            <option value="@seconds">@text</option>
                                        }
                                    </select>
                                    <div class="form-check mb-1">
                                        <input id="sync-share-code-@i" class="form-check-input" type="checkbox" @bind="shareWithCode" />
                                        <label class="form-check-label" for="sync-share-code-@i">@L.Get(Str.SyncsShareCodeLabel)</label>
                                    </div>
                                    <div class="form-text mb-3">@L.Get(Str.SyncsShareCodeHint)</div>
                                    <div class="km-share-actions">
                                        <button class="btn btn-primary" @onclick="() => RemakeOneTimeAsync(key, row)">@L.Get(Str.SyncsShareCreateOnce)</button>
                                        <button class="btn btn-secondary" @onclick="() => shareEditing = false">@L.Get(Str.CommonCancel)</button>
                                    </div>
                                </div>
                            }
                        }
                        else if (shareNoOneTime)
                        {
                            <p class="xbs-hint mt-2 mb-0" role="note">@L.Get(Str.SyncsShareNoOneTime)</p>
                        }
                        @if (!shareEditing)
                        {
                            <p class="xbs-hint mt-2 mb-2">@L.Get(Str.SyncsShareHowTo)</p>
                            <div class="alert alert-warning mb-0" role="note">@L.Get(shareOnce is null ? Str.SyncsShareWarn : Str.SyncsShareWarnOnce)</div>
                            @* Two equal columns: send/copy first, then revoke/done;
                               a lone last button takes the whole row. *@
                            <div class="km-share-actions mt-3">
                                <button class="btn btn-primary" @onclick="SendShareLinkAsync">@L.Get(Str.SyncsShareSend)</button>
                                <button class="btn btn-outline-primary" @onclick="CopyShareLinkAsync">@L.Get(Str.SyncsShareCopy)</button>
                                @if (shareOnce is not null)
                                {
                                    <button class="btn btn-outline-danger" @onclick="() => RevokeOneTimeAsync(key)">@L.Get(Str.SyncsShareRevoke)</button>
                                }
                                <button class="btn btn-secondary" @onclick="CloseShare">@L.Get(Str.CommonDone)</button>
                            </div>
                        }
                    </div>
                }
                else if (menuKey == key)
                {
                    <div id="sync-actions-@i" class="xbs-sync-action-list mt-2" role="group" @onclick:stopPropagation="true"
                         aria-label="@L.Get(Str.RowActionsFor, name)">
                        <button type="button" @onclick="() => StartRename(key, row)">@L.Get(Str.SyncsRename)</button>
                        @if (row.CanActivate || isActive)
                        {
                            <button type="button" @onclick="() => StartShareAsync(key, row)">@L.Get(Str.SyncsShare)</button>
                        }
                        @if (isActive)
                        {
                            <button type="button" @onclick="() => StartPassword(key)">@L.Get(Str.SettingsChangePasswordBtn)</button>
                        }
                        <hr />
                        @if (isActive)
                        {
                            <button type="button" class="text-danger" @onclick="() => Arm(key, armUnlink: true)">@L.Get(Str.ConnUnlinkBtn)</button>
                        }
                        else
                        {
                            <button type="button" class="text-danger" @onclick="() => Arm(key, armForget: true)">@L.Get(Str.SyncsForget)</button>
                        }
                    </div>
                }

                @if (noticeKey == key && !string.IsNullOrEmpty(notice))
                {
                    <StepMessage Text="@notice" Error="noticeError" />
                }
            </div>
        </div>
    }

    <div class="d-grid mt-3">
        @* Starting the add flow closes any row task first: the list is replaced
           by the panel, so the two operations never share the screen. *@
        <button class="btn btn-outline-primary" @onclick="StartAdding" disabled="@(busy || RowTaskOpen)">@L.Get(Str.ConnAddSyncBtn)</button>
    </div>
    @if (active is not null)
    {
        <InfoHint Text="@L.Get(Str.ConnAddSyncHintShort)" Title="@L.Get(Str.ConnAddSyncBtn)" Body="@L.Get(Str.ConnAddSyncHint)" />
    }
}

</div>

@code {
    private List<SavedSync> rows = [];
    private SyncCredentials? active;
    private bool loaded;
    private bool busy;
    /// <summary>The connect/add panel replaces the list while it is open: the
    /// page is the single place where syncs are managed.</summary>
    private bool adding;

    private string? menuKey;

    private void CloseMenu() => menuKey = null;

    private void ToggleMenu(string key)
    {
        if (RowBusy(key)) return;
        menuKey = menuKey == key ? null : key;
    }

    private void CloseMenuOnEscape(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Escape") menuKey = null;
    }

    private string? armedActivateKey;
    private string? armedForgetKey;
    private string? armedUnlinkKey;
    private string? renamingKey;
    /// <summary>Row whose change-password task is open (active row only).</summary>
    private string? passwordKey;
    private string pwCurrent = string.Empty;
    private string pwNew = string.Empty;
    private string pwConfirm = string.Empty;
    private string pwError = string.Empty;
    private bool pwDone;
    private bool pwBusy;
    private bool armedPw;

    /// <summary>A row task is open (a confirmation or the rename editor) or
    /// running: the page must show one operation only, so every other row
    /// action stays disabled until it ends or is cancelled.</summary>
    private bool RowTaskOpen =>
        busy || renamingKey is not null || armedActivateKey is not null
        || armedForgetKey is not null || armedUnlinkKey is not null
        || passwordKey is not null || shareKey is not null;

    /// <summary>True for the row that owns the open task (it gets the
    /// outline; its action buttons are replaced by the confirmation).</summary>
    private bool OwnsTask(string key) =>
        renamingKey == key || armedActivateKey == key
        || armedForgetKey == key || armedUnlinkKey == key || passwordKey == key || shareKey == key;

    /// <summary>Disabled state of a row action: running, or another row is
    /// in the middle of a task. The owner keeps its own controls live.</summary>
    private bool RowBusy(string key) => busy || (RowTaskOpen && !OwnsTask(key));
    private string renameText = string.Empty;
    private bool nameTaken;

    private string? noticeKey;
    private string notice = string.Empty;
    private bool noticeError;
    private string loadError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!await WaitForSessionAsync(Session)) return;
        AppLock.Changed += OnLockChanged;
        LinkInbox.Arrived += OnSyncLinkArrived;
        await RefreshAsync();
        OpenForLink();
    }

    // ---- shared link -------------------------------------------------------

    /// <summary>Row whose share panel is open, and its link (memory only).</summary>
    private string? shareKey;
    private string? shareLink;
    /// <summary>The service keeps one-time links (limits for the options).</summary>
    private HandoffCapability? shareCaps;
    /// <summary>The "Change" options of the one-time link are open.</summary>
    private bool shareEditing;
    private int shareTtl = 600;
    private bool shareWithCode;
    /// <summary>The link on screen is a one-time link (code, validity, revoke).</summary>
    private OneTimeShare? shareOnce;
    /// <summary>The lasting link was used because the service has no one-time links.</summary>
    private bool shareNoOneTime;

    private IEnumerable<(int Seconds, string Text)> ShareTtlChoices
    {
        get
        {
            var max = shareCaps?.MaxTtlSeconds ?? 600;
            var any = false;
            foreach (var (seconds, text) in new[] { (600, L.Get(Str.SyncsShareTtl10)), (3600, L.Get(Str.SyncsShareTtl60)) })
            {
                if (seconds > max) continue;
                any = true;
                yield return (seconds, text);
            }
            if (!any) yield return (max, L.Get(Str.SyncsShareTtl10));
        }
    }

    private static string ValidUntil(OneTimeShare share)
        => share.ExpiresAt is { } at ? at.ToLocalTime().ToString("t", System.Globalization.CultureInfo.CurrentCulture) : "—";

    private void OnSyncLinkArrived() => _ = InvokeAsync(() => { OpenForLink(); StateHasChanged(); });

    /// <summary>A sync link arrived from outside: open the add flow, which
    /// consumes it into its review (after the app lock).</summary>
    private void OpenForLink()
    {
        if (IsDisposed || !loaded || adding || busy || !LinkInbox.HasPending) return;
        StartAdding();
    }

    /// <summary>Same proof as activation: the saved key alone is enough to
    /// hand the sync to someone else, so the app lock gates it.</summary>
    private async Task StartShareAsync(string key, SavedSync row)
    {
        if (busy) return;
        Disarm();
        renamingKey = null;
        ClearNotice();
        if (!await ConfirmWithAppLockAsync(Str.SyncsShareUnlockTitle)) return;
        CloseShare();
        shareKey = key;
        busy = true;
        StateHasChanged();
        try
        {
            var caps = await Session.GetHandoffCapabilityAsync(SavedSyncs.CanonicalServiceUrl(row.ServiceUrl), Lifetime);
            if (IsDisposed || shareKey != key || AppLock.Locked || !AppLock.Foreground) return;
            if (caps is not null)
            {
                // One tap: the voucher is made at once with the defaults
                // (shortest validity, no code); "Change" remakes it.
                shareCaps = caps;
                shareTtl = ShareTtlChoices.First().Seconds;
                shareWithCode = false;
                await CreateOneTimeCoreAsync(key, row);
                return;
            }
            var link = await Session.PrepareShareLinkAsync(row.Identity, Lifetime);
            if (IsDisposed || shareKey != key || AppLock.Locked || !AppLock.Foreground) return;
            shareLink = link;
            shareNoOneTime = true;
        }
        catch (OperationCanceledException) when (Lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            shareKey = null;
            ShowNotice(key, ex.Message, error: true);
            Session.Log.Warn("syncs", $"Share link failed: {ex.GetType().Name}");
        }
        finally
        {
            busy = false;
            if (shareLink is null && shareKey == key) CloseShare();
        }
    }

    /// <summary>Makes the voucher with the current options (caller holds busy
    /// and handles errors).</summary>
    private async Task CreateOneTimeCoreAsync(string key, SavedSync row)
    {
        if (!ShareTtlChoices.Any(c => c.Seconds == shareTtl)) shareTtl = ShareTtlChoices.First().Seconds;
        var once = await Session.CreateOneTimeShareAsync(row.Identity, shareTtl, shareWithCode, Lifetime);
        if (IsDisposed || shareKey != key || AppLock.Locked || !AppLock.Foreground)
        {
            // Nobody saw this voucher: revoke it rather than leave a live
            // link no one can cancel (best effort; it expires anyway).
            _ = RevokeUnseenAsync(once);
            return;
        }
        shareOnce = once;
        shareLink = once.Link;
        shareEditing = false;
    }

    private void EditShare()
    {
        if (busy || shareOnce is not { } once) return;
        shareWithCode = once.Code is not null;
        shareEditing = true;
    }

    /// <summary>"Change": the link on screen is revoked first (it may already
    /// have been sent, so a failed revoke stops here), then a new one is made.</summary>
    private async Task RemakeOneTimeAsync(string key, SavedSync row)
    {
        if (busy || shareKey != key || shareCaps is null || shareOnce is not { } old) return;
        busy = true;
        StateHasChanged();
        try
        {
            await Session.RevokeOneTimeShareAsync(old, Lifetime);
            if (IsDisposed || shareKey != key) return;
            shareOnce = null;
            shareLink = null;
            await CreateOneTimeCoreAsync(key, row);
        }
        catch (OperationCanceledException) when (Lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            if (shareOnce is null) CloseShare();
            ShowNotice(key, shareOnce is null ? ex.Message : L.Get(Str.ErrHandoffRevokeFailed), error: true);
            Session.Log.Warn("syncs", $"One-time link remake failed: {ex.GetType().Name}");
        }
        finally
        {
            busy = false;
            if (shareLink is null && shareKey == key) CloseShare();
        }
    }

    private async Task RevokeUnseenAsync(OneTimeShare once)
    {
        try { await Session.RevokeOneTimeShareAsync(once, CancellationToken.None); }
        catch (Exception ex) { Session.Log.Warn("syncs", $"Unseen one-time link not revoked: {ex.GetType().Name}"); }
    }

    /// <summary>Deletes the voucher on the service at once. Closing the panel
    /// does not: the link stays valid until used or expired.</summary>
    private async Task RevokeOneTimeAsync(string key)
    {
        if (busy || shareOnce is not { } once) return;
        busy = true;
        StateHasChanged();
        try
        {
            var revoked = await Session.RevokeOneTimeShareAsync(once, Lifetime);
            if (IsDisposed) return;
            CloseShare();
            ShowNotice(key, L.Get(revoked ? Str.SyncsShareRevoked : Str.SyncsShareAlreadyGone));
        }
        catch (OperationCanceledException) when (Lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            ShowNotice(key, L.Get(Str.ErrHandoffRevokeFailed), error: true);
            Session.Log.Warn("syncs", $"Revoke failed: {ex.GetType().Name}");
        }
        finally
        {
            busy = false;
        }
    }

    private void CloseShare()
    {
        shareKey = null;
        shareLink = null;
        shareCaps = null;
        shareOnce = null;
        shareNoOneTime = false;
        shareWithCode = false;
        shareEditing = false;
    }

    private async Task CopyShareLinkAsync()
    {
        if (shareLink is null) return;
        try
        {
            Platforms.Android.SensitiveClipboard.SetText(L.Get(Str.SyncsShareSubject), shareLink);
            _ = Toast.ShowAsync(L.Get(Str.SyncsShareCopied));
        }
        catch
        {
            _ = Toast.ShowAsync(L.Get(Str.ConnCopyFailed), isError: true);
        }
        await Task.CompletedTask;
    }

    /// <summary>The share sheet is open: going to the background keeps the box.</summary>
    private bool sendingOut;

    private async Task SendShareLinkAsync()
    {
        if (shareLink is null) return;
        try
        {
            sendingOut = true;
            await Share.Default.RequestAsync(new ShareTextRequest(shareLink, L.Get(Str.SyncsShareSubject)));
        }
        catch (Exception ex)
        {
            sendingOut = false;
            Session.Log.Warn("syncs", $"Share sheet failed: {ex.GetType().Name}");
        }
    }

    public override void Dispose()
    {
        AppLock.Changed -= OnLockChanged;
        LinkInbox.Arrived -= OnSyncLinkArrived;
        CloseShare();
        base.Dispose();
    }

    private void OnLockChanged() => _ = InvokeAsync(() =>
    {
        // The link must not stay on screen behind the lock or in recents.
        // One exception: our own share sheet ("Send…") sends the app to the
        // background; the box (code, expiry, Revoke) must still be there when
        // the sender comes back. The app lock still closes it.
        if (AppLock.Locked) { sendingOut = false; CloseShare(); }
        else if (!AppLock.Foreground) { if (!sendingOut) CloseShare(); }
        else { sendingOut = false; OpenForLink(); }
        StateHasChanged();
    });

    private async Task RefreshAsync()
    {
        try
        {
            active = await Creds.GetAsync();
            rows = Session.Registry is null ? new List<SavedSync>() : await Session.Registry.ListAsync();
            loadError = string.Empty;
        }
        catch (Exception ex)
        {
            // An unreadable registry must not look like "no saved syncs".
            rows = [];
            loadError = L.Get(Str.ErrLoadFailed, ex.Message);
            Session.Log.Warn("syncs", $"Saved-sync list unreadable: {ex.GetType().Name}");
        }
        finally
        {
            loaded = true;
        }
    }

    /// <summary>Name the row would get from its host: shown as the rename
    /// placeholder so "empty" is explained instead of looking like a bug.</summary>
    private string RenameSuggestion(SavedSync row) =>
        SavedSyncs.SuggestName(row.ServiceUrl, rows, row.Identity);

    private bool IsActive(SavedSync row) =>
        active is not null && SavedSyncs.Same(row.Identity, new SavedSyncIdentity(active.ServiceUrl, active.Id));

    private void Disarm()
    {
        menuKey = null;
        armedActivateKey = null;
        armedForgetKey = null;
        armedUnlinkKey = null;
        ClosePassword();
        CloseShare();
    }

    // ---- add / connect ---------------------------------------------------

    private void StartAdding()
    {
        Disarm();
        ClearNotice();
        renamingKey = null;
        adding = true;
    }

    private void CancelAdding() => adding = false;

    /// <summary>The panel finished (linked, created or applied): the list is
    /// the outcome, so refresh and show it again.</summary>
    private async Task FinishAddingAsync()
    {
        adding = false;
        await RefreshAsync();
    }

    private void Arm(string key, bool armActivate = false, bool armForget = false, bool armUnlink = false)
    {
        Disarm();
        renamingKey = null;
        if (armActivate) armedActivateKey = key;
        if (armForget) armedForgetKey = key;
        if (armUnlink) armedUnlinkKey = key;
        ClearNotice();
    }

    private void ClearNotice()
    {
        noticeKey = null;
        notice = string.Empty;
        noticeError = false;
    }

    private void ShowNotice(string? key, string text, bool error = false)
    {
        noticeKey = key;
        notice = text;
        noticeError = error;
    }

    // ---- activation -------------------------------------------------------

    /// <summary>Activation asks for the device PIN/biometric when app lock is
    /// configured: the saved key is enough to switch, so the step itself must
    /// be the proof it is the owner.</summary>
    private async Task<bool> ConfirmWithAppLockAsync(string titleKey = Str.SyncsUnlockTitle)
    {
        if (AppSettings.AppLock == "Off") return true;
        if (!AppLock.Foreground) return false;
        var ok = false;
        AppLock.BeginAuth();
        try
        {
            ok = await LockPrompt.AuthenticateAsync(L.Get(titleKey), requireDeviceCredential: false);
        }
        catch
        {
            ok = false;
        }
        finally
        {
            // Success also counts as an unlock; a cancel here never locks.
            AppLock.EndAuth(ok);
        }

        return ok;
    }

    private async Task ActivateAsync()
    {
        var key = armedActivateKey;
        var row = rows.FirstOrDefault(r => SavedSyncs.Key(r.ServiceUrl, r.SyncId) == key);
        if (busy || row is null) return;
        busy = true;
        ClearNotice();
        var name = SavedSyncs.Name(row);
        try
        {
            if (!await ConfirmWithAppLockAsync())
            {
                Disarm();
                return;
            }

            // Read-only preflight first: a wrong key, an expired sync or an
            // unreachable service changes nothing. Then the switch itself is
            // fail-closed: unsaved edits block it.
            var info = await Session.VerifySavedSyncAsync(row.Identity, Lifetime);
            await Session.ActivateSavedSyncAsync(info);
            Disarm();
            await RefreshAsync();
            ShowNotice(key, L.Get(Str.SyncsActivated, name));
            _ = Toast.ShowAsync(L.Get(Str.SyncsActivated, name));
        }
        catch (OperationCanceledException) when (IsDisposed)
        {
            // Page left while verifying: nothing was written.
        }
        catch (Exception ex)
        {
            ShowNotice(key, ex.Message, error: true);
        }
        finally
        {
            busy = false;
        }
    }

    // ---- forget / unlink -------------------------------------------------

    private async Task ForgetAsync()
    {
        var key = armedForgetKey;
        var row = rows.FirstOrDefault(r => SavedSyncs.Key(r.ServiceUrl, r.SyncId) == key);
        if (busy || row is null || IsActive(row)) return;
        busy = true;
        ClearNotice();
        var name = SavedSyncs.Name(row);
        try
        {
            if (Session.Registry is not null) await Session.ForgetSavedSyncAsync(row.Identity);
            Disarm();
            await RefreshAsync();
            _ = Toast.ShowAsync(L.Get(Str.SyncsForgot, name));
        }
        catch (Exception ex)
        {
            ShowNotice(key, ex.Message, error: true);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task UnlinkAsync()
    {
        var key = armedUnlinkKey;
        var row = rows.FirstOrDefault(r => SavedSyncs.Key(r.ServiceUrl, r.SyncId) == key);
        if (busy || row is null) return;
        busy = true;
        ClearNotice();
        var name = SavedSyncs.Name(row);
        try
        {
            await Session.UnlinkAsync();
            Disarm();
            await RefreshAsync();
            _ = Toast.ShowAsync(L.Get(Str.SyncsUnlinked, name));
        }
        catch (Exception ex)
        {
            ShowNotice(key, ex.Message, error: true);
        }
        finally
        {
            busy = false;
        }
    }

    // ---- change password (active sync only) ------------------------------

    /// <summary>The long password is a property of the active sync, so its
    /// change is a row task: one sync at a time, no Settings section.</summary>
    private void StartPassword(string key)
    {
        Disarm();
        ClearNotice();
        renamingKey = null;
        passwordKey = key;
        pwCurrent = pwNew = pwConfirm = string.Empty;
        pwError = string.Empty;
        pwDone = false;
    }

    /// <summary>Ends the task and never keeps a typed password around.</summary>
    private void ClosePassword()
    {
        passwordKey = null;
        armedPw = false;
        pwCurrent = pwNew = pwConfirm = string.Empty;
        pwError = string.Empty;
        pwDone = false;
    }

    private void ClearPwError()
    {
        pwError = string.Empty;
        pwDone = false;
    }

    private string? ValidatePasswordChange(string current, string next, string confirm)
    {
        if (string.IsNullOrEmpty(current)) return L.Get(Str.ValCurrentPasswordRequired);
        if (string.IsNullOrEmpty(next)) return L.Get(Str.ValNewPasswordRequired);
        if (next == current) return L.Get(Str.ValNewMustDiffer);
        if (next.Length < Keepmark.Core.Crypto.BackupGuard.MinPasswordLength) return WorkflowRules.PasswordTooShort;
        if (next != confirm) return L.Get(Str.ValNewMismatch);
        return null;
    }

    /// <summary>Validate first: the confirmation opens only for a change that
    /// can run (fields are locked while it is open).</summary>
    private void ArmChangePassword()
    {
        pwError = string.Empty;
        pwDone = false;
        var invalid = ValidatePasswordChange(pwCurrent, pwNew, pwConfirm);
        if (invalid is not null)
        {
            pwError = invalid;
            return;
        }

        armedPw = true;
    }

    private async Task ChangePasswordAsync()
    {
        var key = passwordKey;
        pwError = string.Empty;
        pwDone = false;
        pwBusy = true;
        try
        {
            await Session.ChangePasswordAsync(pwCurrent, pwNew);
            pwCurrent = pwNew = pwConfirm = string.Empty;
            armedPw = false;
            pwDone = true;
            ShowNotice(key, WorkflowTexts.ChangePasswordDone);
        }
        catch (Exception ex)
        {
            // Never leave the current password or its confirmation in memory;
            // the new one stays so only the proof has to be retyped.
            pwCurrent = pwConfirm = string.Empty;
            armedPw = false;
            pwError = ex.Message;
        }
        finally
        {
            pwBusy = false;
        }
    }

    // ---- rename ----------------------------------------------------------

    private void StartRename(string key, SavedSync row)
    {
        Disarm();
        ClearNotice();
        renamingKey = key;
        renameText = SavedSyncs.Name(row);
        nameTaken = false;
        selectRenameField = true;
    }

    /// <summary>Set when the rename editor opens: after that render the field
    /// gets focus with its text selected.</summary>
    private bool selectRenameField;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!selectRenameField || renamingKey is null) return;
        selectRenameField = false;
        var index = rows.FindIndex(r => SavedSyncs.Key(r.ServiceUrl, r.SyncId) == renamingKey);
        if (index < 0) return;
        try { await JS.InvokeVoidAsync("xbsGestures.focusSelect", $"#sync-name-{index}"); } catch { }
    }

    private void CancelRename()
    {
        renamingKey = null;
        nameTaken = false;
    }

    private async Task SaveRenameAsync()
    {
        var key = renamingKey;
        var row = rows.FirstOrDefault(r => SavedSyncs.Key(r.ServiceUrl, r.SyncId) == key);
        if (busy || row is null) return;
        // The field opens with the shown name: saving it unchanged must not
        // turn the host fallback into a fixed label.
        if (renameText.Trim() == SavedSyncs.Name(row))
        {
            renamingKey = null;
            return;
        }
        busy = true;
        nameTaken = false;
        try
        {
            var ok = Session.Registry is not null && await Session.Registry.RenameAsync(row.Identity, renameText);
            if (!ok)
            {
                nameTaken = true;
                return;
            }

            renamingKey = null;
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            ShowNotice(key, ex.Message, error: true);
        }
        finally
        {
            busy = false;
        }
    }
}
