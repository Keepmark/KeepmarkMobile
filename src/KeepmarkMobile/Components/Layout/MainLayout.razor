@inherits LayoutComponentBase
@inject KeepmarkMobile.Services.XbsSession Session
@inject KeepmarkMobile.Services.AppLockState LockState
@inject KeepmarkMobile.Services.XbsSettings AppSettings
@inject KeepmarkMobile.Services.IAppLockService AppLock
@inject KeepmarkMobile.Services.ToastState Toast
@inject KeepmarkMobile.Services.SharedImportService SharedImport
@inject KeepmarkMobile.Services.SecureCredentialStore Creds
@inject KeepmarkMobile.Services.IStatusBarService StatusBar
@inject Microsoft.JSInterop.IJSRuntime JS
@inject NavigationManager Nav
@inject KeepmarkMobile.Services.LanguageService Lang
@implements IDisposable

<div class="page" @key="Lang.Version">
    @if (syncing)
    {
        <div class="xbs-toploader" role="progressbar" aria-label="@L.Get(Str.LayoutSyncingAria)"></div>
        <div class="xbs-syncing-pill" role="status"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> @L.Get(Str.CommonSyncing)</div>
    }
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <article class="content px-2">
            @Body
        </article>
    </main>
</div>

@if (Toast.Message is not null)
{
    <div class="xbs-toast @(Toast.IsError ? "error" : "ok")" role="status">
        <span class="xbs-toast-icon" aria-hidden="true">@(Toast.IsError ? "⚠" : "✓")</span>
        <span>@Toast.Message</span>
    </div>
}

@if (LockState.Locked)
{
    <div class="xbs-lock" role="dialog" aria-modal="true" aria-label="@L.Get(Str.LayoutUnlockAria)">
        <div class="xbs-lock-card">
            <h3>@L.Get(Str.LayoutLockedTitle)</h3>
            @if (LockState.AutoPromptSuppressed)
            {
                @* Prompt cancelled or failed: manual retry, never an auto loop. *@
                <p class="text-muted">@L.Get(Str.LayoutAuthenticate)</p>
                <button class="btn btn-primary btn-lg" @onclick="Unlock">@L.Get(Str.LayoutUnlock)</button>
                @if (!string.IsNullOrEmpty(lockError))
                {
                    <p class="text-danger mt-2">@lockError</p>
                }
            }
            else
            {
                <p class="text-muted">@L.Get(Str.LayoutWaiting)</p>
            }
        </div>
    </div>
}

@code {
    private string lockError = string.Empty;
    private bool syncing;

    protected override void OnInitialized()
    {
        LockState.Changed += OnLockChanged;
        LockState.PromptRequested += OnPromptRequested;
        Toast.Changed += OnToast;
        SharedImport.Arrived += OnShareArrived;
        Lang.Changed += OnLanguageChanged;
        _ = WatchSessionAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ApplyThemeAsync();
            await ApplyLanguageAsync();
            // Cold start: the lock may have asked for the prompt before this
            // layout subscribed.
            if (LockState.ShouldPrompt)
            {
                await Unlock();
            }
        }
    }

    private void OnLanguageChanged() => _ = InvokeAsync(async () =>
    {
        StateHasChanged();
        await ApplyLanguageAsync();
    });

    public async Task ApplyLanguageAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("xbsSetLang", Lang.ActiveLang, new
            {
                jumpTo = L.Get(Str.JsJumpTo),
                top = L.Get(Str.JsTop),
                bottom = L.Get(Str.JsBottom),
                scrollBottom = L.Get(Str.JsScrollBottom),
                scrollTop = L.Get(Str.JsScrollTop),
            });
        }
        catch
        {
        }
    }

    public async Task ApplyThemeAsync()
    {
        try { await JS.InvokeVoidAsync("xbsSetTheme", AppSettings.Theme); } catch { }
        try { StatusBar.ApplyTheme(AppSettings.Theme); } catch { }
    }

    private async Task WatchSessionAsync()
    {
        for (int i = 0; i < 200 && !Session.Ready; i++)
        {
            await Task.Delay(100);
        }

        if (Session.Engine is not null)
        {
            Session.Engine.StatusChanged += OnEngineStatus;
            syncing = Session.Engine.Status == Core.Sync.SyncStatus.Syncing;
            await InvokeAsync(StateHasChanged);
        }

        await RedirectFirstRunAsync();
    }

    /// <summary>Absolute first launch (no credentials, empty library): start on Connect.</summary>
    private async Task RedirectFirstRunAsync()
    {
        try
        {
            if (Session.Store is null)
            {
                return;
            }

            if (await Creds.GetAsync().ConfigureAwait(false) is not null)
            {
                return;
            }

            var stats = await Session.Store.GetStatsAsync().ConfigureAwait(false);
            if (stats.Folders + stats.Bookmarks + stats.Separators > 0)
            {
                return;
            }

            if (!string.IsNullOrEmpty(Nav.ToBaseRelativePath(Nav.Uri).Trim('/')))
            {
                return;
            }

            await InvokeAsync(() => Nav.NavigateTo("/connect"));
        }
        catch
        {
            // Never break startup for a convenience redirect.
        }
    }

    private void OnEngineStatus(Core.Sync.SyncStatus s)
    {
        syncing = s == Core.Sync.SyncStatus.Syncing;
        InvokeAsync(StateHasChanged);
    }

    private void OnLockChanged() => InvokeAsync(StateHasChanged);
    private void OnPromptRequested() => InvokeAsync(Unlock);
    private void OnToast() => InvokeAsync(StateHasChanged);

    private void OnShareArrived() => InvokeAsync(() =>
    {
        // Home opens the sheet itself when already shown; navigating now would
        // recreate it and lose the pending share. Only navigate from elsewhere.
        if (!string.IsNullOrEmpty(Nav.ToBaseRelativePath(Nav.Uri)))
        {
            Nav.NavigateTo("/");
        }
    });

    /// <summary>Opens the system prompt (auto on resume, or the manual Unlock
    /// button after a cancel). Single-flight via AuthInProgress.</summary>
    private async Task Unlock()
    {
        if (!LockState.Locked || LockState.AuthInProgress)
        {
            return;
        }

        lockError = string.Empty;
        LockState.BeginAuth();
        StateHasChanged();
        bool ok = false;
        try
        {
            ok = await AppLock.AuthenticateAsync(L.Get(Str.LayoutUnlockPrompt), requireDeviceCredential: false);
        }
        catch
        {
            ok = false;
        }
        finally
        {
            LockState.EndAuth(ok);
        }

        if (!ok)
        {
            lockError = L.Get(Str.LayoutNotUnlocked);
        }

        StateHasChanged();
    }

    public void Dispose()
    {
        LockState.Changed -= OnLockChanged;
        LockState.PromptRequested -= OnPromptRequested;
        Toast.Changed -= OnToast;
        SharedImport.Arrived -= OnShareArrived;
        Lang.Changed -= OnLanguageChanged;
        if (Session.Engine is not null)
        {
            Session.Engine.StatusChanged -= OnEngineStatus;
        }
    }
}
