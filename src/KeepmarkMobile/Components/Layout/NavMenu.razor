@inject KeepmarkMobile.Services.XbsSession Session
@inject KeepmarkMobile.Services.ToastState Toast
@inject KeepmarkMobile.Services.SecureCredentialStore Creds
@inject IJSRuntime JS
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <img src="img/mark.png" alt="" class="nav-brand-mark" />
        <a class="navbar-brand" href="">Keepmark</a>
    </div>
</div>

<button class="navbar-toggler xbs-nav-toggler" aria-label="Navigation menu" aria-expanded="@((!collapseNavMenu).ToString().ToLowerInvariant())" @onclick="ToggleNavMenu"></button>

@if (!collapseNavMenu)
{
    <div class="xbs-drawer-scrim" data-back="20" @onclick="CloseMenu" aria-hidden="true"></div>
}
<div class="@NavMenuCssClass nav-scrollable">
    <div class="xbs-drawer-head">
        <div class="xbs-drawer-status @HeadStatusClass">
            <span class="xbs-status-dot" aria-hidden="true"></span>
            <span>@HeadStatus</span>
        </div>
        <div class="xbs-drawer-sync">
            <div class="xbs-drawer-svc">
                @if (creds is not null)
                {
                    <div class="xbs-drawer-host">@ServiceHost</div>
                    <div class="xbs-drawer-id">ID @ShortId</div>
                }
                else
                {
                    <div class="xbs-drawer-host">No service linked</div>
                }
            </div>
            <button class="xbs-drawer-syncbtn" @onclick="SyncAndClose" disabled="@(!linked)" title="@(linked ? "Upload local changes and download server changes now" : "Link a service first (Connect)")">
                <svg class="km-ico sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 0 1 13.7-5.7L20 8.5M20 4v4.5h-4.5M20 12a8 8 0 0 1-13.7 5.7L4 15.5M4 20v-4.5h4.5" /></svg>Sync now
            </button>
        </div>
    </div>
    <nav class="xbs-drawer-nav" aria-label="Main">
        <div class="xbs-nav-group">Bookmarks</div>
            <NavLink class="xbs-nav" href="" Match="NavLinkMatch.All" @onclick="CloseMenu"><svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4h10v16l-5-3.5L7 20z" /></svg><span class="xbs-nav-label">Explore</span></NavLink>
            <NavLink class="xbs-nav" href="duplicates" @onclick="CloseMenu"><svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="11" height="11" rx="2" /><path d="M5 15V6a1 1 0 0 1 1-1h9" /></svg><span class="xbs-nav-label">Duplicates</span>@if (dupCount > 0) { <span class="xbs-nav-badge">@dupCount</span> }</NavLink>
            <NavLink class="xbs-nav" href="backup" @onclick="CloseMenu"><svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16v12H4zM4 7l2-3h12l2 3M10 11h4" /></svg><span class="xbs-nav-label">Backup</span></NavLink>
        <div class="xbs-nav-group">Sync</div>
            <NavLink class="xbs-nav" href="connect" @onclick="CloseMenu"><svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" /></svg><span class="xbs-nav-label">Connect</span></NavLink>
            <NavLink class="xbs-nav" href="status" @onclick="CloseMenu"><svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h4l3-7 4 14 3-7h4" /></svg><span class="xbs-nav-label">Status</span></NavLink>
        @if (linked)
        {
            <NavLink class="xbs-nav" href="switch-service" title="@SwitchTitle" @onclick="CloseMenu"><svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h12l-3-3M17 17H5l3 3" /></svg><span class="xbs-nav-label">Move service</span></NavLink>
        }
        else
        {
            <span class="xbs-nav disabled" aria-disabled="true" title="@SwitchTitle"><svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h12l-3-3M17 17H5l3 3" /></svg><span class="xbs-nav-label">Move service</span></span>
        }
        <div class="xbs-nav-group">App</div>
            <NavLink class="xbs-nav" href="settings" @onclick="CloseMenu"><svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M12 3v2.5M12 18.5V21M3 12h2.5M18.5 12H21M5.6 5.6l1.8 1.8M16.6 16.6l1.8 1.8M5.6 18.4l1.8-1.8M16.6 7.4l1.8-1.8" /></svg><span class="xbs-nav-label">Settings</span></NavLink>
            <NavLink class="xbs-nav" href="logs" @onclick="CloseMenu"><svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4h9l3 3v13H6zM9 10h6M9 14h6M9 18h3" /></svg><span class="xbs-nav-label">Logs</span></NavLink>
            <NavLink class="xbs-nav" href="about" @onclick="CloseMenu"><svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M12 11v5M12 8h.01" /></svg><span class="xbs-nav-label">About</span></NavLink>
    </nav>
    <div class="xbs-drawer-foot">Keepmark v@(AppInfo.VersionString)</div>
</div>

@code {
    private int dupCount;
    private bool linked;
    private Core.Sync.SyncCredentials? creds;
    private bool collapseNavMenu = true;

    private string NavMenuCssClass => collapseNavMenu ? "collapse" : string.Empty;
    private string SwitchTitle => linked ? "Move to another service" : "Link a service first (Connect)";

    protected override async Task OnInitializedAsync()
    {
        for (int i = 0; i < 100 && !Session.Ready; i++)
        {
            await Task.Delay(100);
        }

        if (Session.Engine is not null)
        {
            Session.Engine.DataChanged += OnData;
            Session.Engine.StatusChanged += OnStatus;
        }

        await RefreshLinkedAsync();
        await RefreshDupCountAsync();
    }

    /// <summary>Switch service needs an existing link: refresh on init, on
    /// engine changes, and on every drawer open (link/unlink elsewhere).</summary>
    private async Task RefreshLinkedAsync()
    {
        try
        {
            creds = await Creds.GetAsync();
            linked = creds is not null;
        }
        catch
        {
            creds = null;
            linked = false;
        }
    }

    private async Task RefreshDupCountAsync()
    {
        if (Session.Store is null)
        {
            return;
        }

        try
        {
            dupCount = (await Session.Store.GetDuplicateUrlsAsync()).Sum(g => g.Rows.Count - 1);
        }
        catch
        {
            dupCount = 0;
        }
    }

    private void OnData() => InvokeAsync(async () => { await RefreshDupCountAsync(); await RefreshLinkedAsync(); StateHasChanged(); });

    // While the drawer is open the page behind must not scroll (same lock as modal sheets).
    private async Task ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
        try { await JS.InvokeVoidAsync("xbsGestures.lockScroll", !collapseNavMenu, "nav"); } catch { }
        if (!collapseNavMenu)
        {
            await RefreshLinkedAsync();
        }
    }

    private async Task CloseMenu()
    {
        collapseNavMenu = true;
        try { await JS.InvokeVoidAsync("xbsGestures.lockScroll", false, "nav"); } catch { }
    }

    public void Dispose()
    {
        _ = JS.InvokeVoidAsync("xbsGestures.lockScroll", false, "nav");
        if (Session.Engine is not null)
        {
            Session.Engine.DataChanged -= OnData;
            Session.Engine.StatusChanged -= OnStatus;
        }
    }

    private void OnStatus(Core.Sync.SyncStatus _) => InvokeAsync(StateHasChanged);

    private string ServiceHost => Uri.TryCreate(creds?.ServiceUrl, UriKind.Absolute, out var u) ? u.Host : creds?.ServiceUrl ?? string.Empty;

    // Sync IDs are bearer tokens: only ever show a truncated form.
    private string ShortId => creds is null || creds.Id.Length < 10 ? "…" : $"{creds.Id[..4]}…{creds.Id[^4..]}";

    private string HeadStatusClass => !linked ? "off" : Session.Engine?.Status switch
    {
        Core.Sync.SyncStatus.Syncing => "syncing",
        Core.Sync.SyncStatus.Offline or Core.Sync.SyncStatus.Error => "warn",
        Core.Sync.SyncStatus.Conflict => "conflict",
        _ => "ok"
    };

    private string HeadStatus
    {
        get
        {
            if (!linked || Session.Engine is null)
            {
                return "Not connected";
            }

            return Session.Engine.Status switch
            {
                Core.Sync.SyncStatus.Syncing => "Syncing…",
                Core.Sync.SyncStatus.Offline => "Offline — will retry",
                Core.Sync.SyncStatus.Conflict => "Conflict — see Status",
                Core.Sync.SyncStatus.Error => "Sync error",
                _ => Session.Engine.LastSyncAt is { } t
                    ? "Synced · " + (t.ToLocalTime().Date == DateTime.Now.Date ? t.ToLocalTime().ToString("t") : t.ToLocalTime().ToString("g"))
                    : "Not synced yet"
            };
        }
    }

    private async Task SyncAndClose()
    {
        await SyncNow();
        await CloseMenu();
    }

    private async Task SyncNow()
    {
        if (Session.Engine is null)
        {
            return;
        }

        try
        {
            await Session.Engine.ForceSyncAsync();
            // Paint first: the toast must never gate the status update.
            StateHasChanged();
            _ = Toast.ShowAsync(Session.Engine.Status == Core.Sync.SyncStatus.Idle
                ? $"Sync complete {DateTime.Now:HH:mm:ss}"
                : $"Sync finished: {Session.Engine.Status}");
        }
        catch (Exception ex)
        {
            _ = Toast.ShowAsync(ex.Message, isError: true);
        }
    }
}
