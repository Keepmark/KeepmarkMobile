@inherits KeepmarkMobile.Components.SessionComponentBase
@inject KeepmarkMobile.Services.XbsSession Session
@inject KeepmarkMobile.Services.XbsSettings Settings
@using Keepmark.Core.Workflow

<div class="mb-3 km-service-picker">
    <label class="form-label" for="@id">@L.Get(Str.ConnService)</label>
    <button id="@id" type="button" class="km-service-current" @onclick="() => expanded = !expanded" disabled="@Disabled" aria-expanded="@expanded.ToString().ToLowerInvariant()" aria-controls="@(id + "-choices")">
        <span><strong>@SelectedTitle</strong><small>@SelectedDetail</small></span><span aria-hidden="true">⌄</span>
    </button>
    @if (expanded && !Disabled)
    {
        <div id="@(id + "-choices")" class="km-service-choices" role="group" aria-label="@L.Get(Str.ConnService)">
            @foreach (var item in ServiceCatalog.Public)
            {
                <button type="button" class="km-service-option" aria-pressed="@((selection == item.Url).ToString().ToLowerInvariant())" @onclick="() => SelectValue(item.Url)">
                    <strong>@(new Uri(item.Url).Host)</strong><small>@Detail(item)</small>
                </button>
            }
            @foreach (var url in Settings.SavedServices)
            {
                <button type="button" class="km-service-option" aria-pressed="@((selection == url).ToString().ToLowerInvariant())" @onclick="() => SelectValue(url)"><strong>@url</strong><small>@SavedDetail(url)</small></button>
            }
            <button type="button" class="km-service-option" @onclick='() => SelectValue("custom")'>@L.Get(Str.ServiceCustom)</button>
        </div>
    }
    @if (selection == "custom")
    {
        <label class="form-label mt-2" for="@(id + "-url")">@L.Get(Str.ConnServiceUrl)</label>
        @* Scheme picker and host box are one field: two halves of the same URL,
           composing to exactly what the single box used to hold. The picker
           carries the HTTPS-only default, so a host typed on its own is never
           sent in cleartext (http is for self-hosted services, and the check
           still refuses it outside DEBUG). *@
        <div class="km-url-row">
            <select class="form-select" aria-label="@L.Get(Str.ConnServiceScheme)" disabled="@Disabled" @onchange="EditScheme">
                <option value="https" selected="@(Scheme == "https")">https://</option>
                <option value="http" selected="@(Scheme == "http")">http://</option>
            </select>
            <input id="@(id + "-url")" class="form-control" value="@Host" @oninput="EditHost" disabled="@Disabled" inputmode="url" autocapitalize="off" autocorrect="off" spellcheck="false" placeholder="sync.example.org" />
        </div>
        <div class="form-text">@L.Get(Str.ConnServiceUrlHintPlain)</div>
        <button class="btn btn-secondary mt-2" disabled="@(Disabled || checking || string.IsNullOrWhiteSpace(Value))" @onclick="Check">@L.Get(Str.ConnCheckService)</button>
    }
    @if (checking || info is not null || !string.IsNullOrEmpty(error))
    {
        @* One card for the whole service state: coloured dot + status word,
           the endpoint facts as chips, then the server note (or the error)
           below a hairline. Never colour alone: the word carries the state.
           A failed check is an error surface, so it is role="alert" (R8.7);
           every other state is a polite status. *@
        <div class="km-service-status @StatusClass" role="@(IsError ? "alert" : "status")" aria-live="@(IsError ? null : "polite")">
            <div class="km-service-status-head">
                <span class="km-service-dot" aria-hidden="true"></span>
                <strong>@StatusLabel</strong>
            </div>
            @if (info is not null)
            {
                <div class="km-service-meta">
                    @* Endpoint facts: version and location are dropped when the
                       service omits them (self-hosted often has no location). *@
                    @if (!string.IsNullOrWhiteSpace(info.Version)) { <span class="km-service-chip">@L.Get(Str.ServiceApi, info.Version)</span> }
                    <span class="km-service-chip">@L.Get(Str.ServiceSize, (info.MaxSyncSize / 1048576d).ToString("0.##"))</span>
                    @if (!string.IsNullOrWhiteSpace(info.Location)) { <span class="km-service-chip">@LocationLabel(info.Location)</span> }
                </div>
            }
            @if (StatusNote is not null)
            {
                <p class="km-service-note">
                    @if (NoteIsWarning)
                    {
                        <svg class="km-ico sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M10.3 3.9 2.5 18a2 2 0 0 0 1.7 3h15.6a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" /><path d="M12 9v5M12 17h.01" /></svg>
                    }
                    else
                    {
                        <svg class="km-ico sm" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v5M12 8h.01" /></svg>
                    }
                    <span>@StatusNote</span>
                </p>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string Value { get; set; } = Core.XbsConstants.DefaultServiceUrl;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public EventCallback<Core.Api.ServiceInfoResponse?> Checked { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private readonly string id = "service-" + Guid.NewGuid().ToString("N");
    private string? observed;
    private string selection = string.Empty;
    /// <summary>What the scheme picker shows: the scheme of the URL the parent
    /// holds, "https" for a host on its own. Derived, never stored separately —
    /// the composed URL stays the single source of truth.</summary>
    private string Scheme => WorkflowRules.SplitServiceUrl(Value).Scheme;
    /// <summary>What the host box shows: the URL without its scheme.</summary>
    private string Host => WorkflowRules.SplitServiceUrl(Value).Host;
    private bool checking;
    private bool expanded;
    private string SelectedTitle => selection == "custom" ? L.Get(Str.ServiceCustom) : Uri.TryCreate(Value, UriKind.Absolute, out var uri) ? uri.Host : Value;
    private string SelectedDetail => ServiceCatalog.Public.FirstOrDefault(x => x.Url == selection) is { } item ? Detail(item) : selection == "custom" ? string.Empty : SavedDetail(selection);
    private string Detail(ServiceChoice item) => $"{L.Get("ServiceCountry" + item.Location)} · {item.Limit} · API {item.Version}";
    /// <summary>Catalog rows and endpoint metadata name the same country codes:
    /// translate the ones the app ships (GB/CA/DE/IT) so the card never shows a
    /// bare "GB" next to a list that says "Regno Unito"; anything else is shown
    /// as the service reports it, "—" when absent.</summary>
    private string LocationLabel(string? location) =>
        string.IsNullOrWhiteSpace(location) ? "—"
        : ServiceCatalog.Public.Any(x => x.Location == location) ? L.Get("ServiceCountry" + location)
        : location;
    private string SavedDetail(string url)
    {
        var metadata = ServiceCatalog.Normalize(Value) == url && info is not null ? info : Settings.SavedServiceInfo(url);
        return $"{L.Get(Str.ServiceSaved)} · {LocationLabel(metadata?.Location)} · {(metadata is null ? "—" : (metadata.MaxSyncSize / 1048576d).ToString("0.##") + " MB")} · API {metadata?.Version ?? "—"}";
    }
    private string error = string.Empty;
    /// <summary>State of the checked endpoint: dot colour and word, driven by
    /// the same value so they can never disagree (checking > error > status).</summary>
    private string StatusClass =>
        checking ? "is-checking"
        : info?.Status == Core.Models.ServiceStatus.Online ? "is-ok"
        : info?.Status == Core.Models.ServiceStatus.NoNewSyncs ? "is-warn"
        : "is-error";
    private string StatusLabel =>
        checking ? L.Get(Str.ServiceChecking)
        : info?.Status == Core.Models.ServiceStatus.Online ? L.Get(Str.ServiceReady)
        : info?.Status == Core.Models.ServiceStatus.NoNewSyncs ? L.Get(Str.ServiceStatusNoNew)
        : L.Get(Str.ServiceUnavailable);
    /// <summary>A failed check is an error surface (<c>role="alert"</c>, R8.7);
    /// the three other states are a polite status.</summary>
    private bool IsError => StatusClass == "is-error";
    /// <summary>Error and "no new syncs" are warnings for the note icon; the
    /// server's own message is an info note.</summary>
    private bool NoteIsWarning =>
        !string.IsNullOrEmpty(error) || info?.Status == Core.Models.ServiceStatus.NoNewSyncs;
    /// <summary>One note line: the failure that stopped the check, else the
    /// server's message, else the explanation of the amber state.</summary>
    private string? StatusNote =>
        !string.IsNullOrEmpty(error) ? error
        : !string.IsNullOrWhiteSpace(info?.Message) ? info!.Message
        : info?.Status == Core.Models.ServiceStatus.NoNewSyncs ? L.Get(Str.ServiceNoNew)
        : null;
    private Core.Api.ServiceInfoResponse? info;
    private readonly ServiceCheckState checkState = new();
    private int generation => checkState.Generation;
    private CancellationTokenSource? request;

    protected override async Task OnParametersSetAsync()
    {
        var normalized = ServiceCatalog.Normalize(Value);
        if (observed == Value)
        {
            // A successful pairing may save the current custom URL without
            // changing the value. Preserve its already-verified result.
            if (selection == "custom" && Settings.SavedServices.Contains(normalized)) selection = normalized;
            return;
        }
        selection = ServiceCatalog.IsPublic(normalized) || Settings.SavedServices.Contains(normalized) ? normalized : "custom";
        observed = Value;
        await Invalidate();
        if (selection != "custom") await Check();
    }
    private async Task Invalidate()
    {
        checkState.Invalidate(); request?.Cancel(); request?.Dispose(); request = null;
        checking = false; info = null; error = string.Empty;
        await Checked.InvokeAsync(null);
    }
    private async Task SelectValue(string value)
    {
        expanded = false;
        selection = value;
        Value = selection == "custom" ? string.Empty : selection;
        observed = Value;
        await Invalidate();
        await ValueChanged.InvokeAsync(Value);
        if (selection != "custom") await Check();
    }
    private async Task EditScheme(ChangeEventArgs e)
    {
        if (Disabled) return;
        await Compose(e.Value?.ToString(), Host);
    }
    private async Task EditHost(ChangeEventArgs e)
    {
        if (Disabled) return;
        await Compose(Scheme, e.Value?.ToString());
    }
    /// <summary>Publishes the URL the two controls describe. An emptied host box
    /// clears the parent value too, so "Check service" goes back to disabled
    /// instead of testing the previous endpoint.</summary>
    private async Task Compose(string? scheme, string? host)
    {
        Value = WorkflowRules.ComposeServiceUrl(scheme, host);
        observed = Value;
        await Invalidate(); await ValueChanged.InvokeAsync(Value);
    }
    private async Task Check()
    {
        await Invalidate();
        var attempt = generation;
        var url = ServiceCatalog.Normalize(Value);
        request = CancellationTokenSource.CreateLinkedTokenSource(Lifetime);
        var token = request.Token;
        checking = true;
        try
        {
            var allowLoopback = false;
#if DEBUG
            allowLoopback = Uri.TryCreate(url, UriKind.Absolute, out var local) && local.IsLoopback && local.Scheme == "http";
#endif
            if (!Uri.TryCreate(url, UriKind.Absolute, out var uri) || (uri.Scheme != "https" && !allowLoopback) ||
                !string.IsNullOrEmpty(uri.UserInfo) || !string.IsNullOrEmpty(uri.Query) || !string.IsNullOrEmpty(uri.Fragment))
                throw new InvalidOperationException(L.Get(Str.ServiceUnavailable));
            var result = await Session.CheckServiceAsync(url, token);
            if (IsDisposed || attempt != generation) return;
            if (!checkState.Complete(attempt, result.Status))
                throw new InvalidOperationException(L.Get(Str.ServiceUnavailable));
            info = result;
            if (ServiceCatalog.IsPublic(url)) selection = url;
            Settings.UpdateSavedServiceInfo(url, result);
            await Checked.InvokeAsync(result);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception ex) { if (!IsDisposed && attempt == generation) error = ex.Message; }
        finally { if (attempt == generation) checking = false; }
    }
    public override void Dispose() { checkState.Invalidate(); request?.Cancel(); request?.Dispose(); base.Dispose(); }
}
