@inherits KeepmarkMobile.Components.SessionComponentBase
@inject KeepmarkMobile.Services.XbsSession Session
@inject KeepmarkMobile.Services.XbsSettings Settings
@using Keepmark.Core.Workflow

<div class="mb-3 km-service-picker">
    <label class="form-label" for="@id">@L.Get(Str.ConnService)</label>
    <button id="@id" type="button" class="km-service-current" @onclick="() => expanded = !expanded" disabled="@Disabled" aria-expanded="@expanded.ToString().ToLowerInvariant()" aria-controls="@(id + "-choices")">
        <span><strong>@SelectedTitle</strong><small>@SelectedDetail</small></span><span aria-hidden="true">⌄</span>
    </button>
    @if (expanded && !Disabled)
    {
        <div id="@(id + "-choices")" class="km-service-choices" role="group" aria-label="@L.Get(Str.ConnService)">
            @foreach (var item in ServiceCatalog.Public)
            {
                <button type="button" class="km-service-option" aria-pressed="@((selection == item.Url).ToString().ToLowerInvariant())" @onclick="() => SelectValue(item.Url)">
                    <strong>@(new Uri(item.Url).Host)</strong><small>@Detail(item)</small>
                </button>
            }
            @foreach (var url in Settings.SavedServices)
            {
                <button type="button" class="km-service-option" aria-pressed="@((selection == url).ToString().ToLowerInvariant())" @onclick="() => SelectValue(url)"><strong>@url</strong><small>@SavedDetail(url)</small></button>
            }
            <button type="button" class="km-service-option" @onclick='() => SelectValue("custom")'>@L.Get(Str.ServiceCustom)</button>
        </div>
    }
    @if (selection == "custom")
    {
        <label class="form-label mt-2" for="@(id + "-url")">@L.Get(Str.ConnServiceUrl)</label>
        <input id="@(id + "-url")" class="form-control" value="@Value" @oninput="Edit" disabled="@Disabled" inputmode="url" autocapitalize="off" autocorrect="off" spellcheck="false" />
        <button class="btn btn-secondary mt-2" disabled="@(Disabled || checking || string.IsNullOrWhiteSpace(Value))" @onclick="Check">@L.Get(Str.ConnCheckService)</button>
    }
    <div class="form-text mt-2" role="status" aria-live="polite">
        @if (checking) { @L.Get(Str.ServiceChecking) }
        else if (info is not null) { @ReadyLine }
    </div>
    @if (info?.Status == Core.Models.ServiceStatus.NoNewSyncs) { <p class="form-text">@L.Get(Str.ServiceNoNew)</p> }
    @if (!string.IsNullOrWhiteSpace(info?.Message)) { <p class="form-text">@info.Message</p> }
    @if (!string.IsNullOrEmpty(error)) { <div class="alert alert-danger mt-2" role="alert">@error</div> }
</div>

@code {
    [Parameter] public string Value { get; set; } = Core.XbsConstants.DefaultServiceUrl;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public EventCallback<Core.Api.ServiceInfoResponse?> Checked { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private readonly string id = "service-" + Guid.NewGuid().ToString("N");
    private string? observed;
    private string selection = string.Empty;
    private bool checking;
    private bool expanded;
    private string SelectedTitle => selection == "custom" ? L.Get(Str.ServiceCustom) : Uri.TryCreate(Value, UriKind.Absolute, out var uri) ? uri.Host : Value;
    private string SelectedDetail => ServiceCatalog.Public.FirstOrDefault(x => x.Url == selection) is { } item ? Detail(item) : selection == "custom" ? string.Empty : SavedDetail(selection);
    private string Detail(ServiceChoice item) => $"{L.Get("ServiceCountry" + item.Location)} · {item.Limit} · API {item.Version}";
    private string SavedDetail(string url)
    {
        var metadata = ServiceCatalog.Normalize(Value) == url && info is not null ? info : Settings.SavedServiceInfo(url);
        return $"{L.Get(Str.ServiceSaved)} · {metadata?.Location ?? "—"} · {(metadata is null ? "—" : (metadata.MaxSyncSize / 1048576d).ToString("0.##") + " MB")} · API {metadata?.Version ?? "—"}";
    }
    private string error = string.Empty;
    /// <summary>Verified-endpoint summary. Self-hosted services may report no
    /// location: drop the separator it would otherwise leave dangling.</summary>
    private string ReadyLine =>
        L.Get(Str.ServiceReady, info!.Version, (info.MaxSyncSize / 1048576d).ToString("0.##"), info.Location)
            .TrimEnd(' ', '\u00a0', '·');
    private Core.Api.ServiceInfoResponse? info;
    private readonly ServiceCheckState checkState = new();
    private int generation => checkState.Generation;
    private CancellationTokenSource? request;

    protected override async Task OnParametersSetAsync()
    {
        var normalized = ServiceCatalog.Normalize(Value);
        if (observed == Value)
        {
            // A successful pairing may save the current custom URL without
            // changing the value. Preserve its already-verified result.
            if (selection == "custom" && Settings.SavedServices.Contains(normalized)) selection = normalized;
            return;
        }
        selection = ServiceCatalog.IsPublic(normalized) || Settings.SavedServices.Contains(normalized) ? normalized : "custom";
        observed = Value;
        await Invalidate();
        if (selection != "custom") await Check();
    }
    private async Task Invalidate()
    {
        checkState.Invalidate(); request?.Cancel(); request?.Dispose(); request = null;
        checking = false; info = null; error = string.Empty;
        await Checked.InvokeAsync(null);
    }
    private async Task SelectValue(string value)
    {
        expanded = false;
        selection = value;
        Value = selection == "custom" ? string.Empty : selection;
        observed = Value;
        await Invalidate();
        await ValueChanged.InvokeAsync(Value);
        if (selection != "custom") await Check();
    }
    private async Task Edit(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? string.Empty; observed = Value;
        await Invalidate(); await ValueChanged.InvokeAsync(Value);
    }
    private async Task Check()
    {
        await Invalidate();
        var attempt = generation;
        var url = ServiceCatalog.Normalize(Value);
        request = CancellationTokenSource.CreateLinkedTokenSource(Lifetime);
        var token = request.Token;
        checking = true;
        try
        {
            var allowLoopback = false;
#if DEBUG
            allowLoopback = Uri.TryCreate(url, UriKind.Absolute, out var local) && local.IsLoopback && local.Scheme == "http";
#endif
            if (!Uri.TryCreate(url, UriKind.Absolute, out var uri) || (uri.Scheme != "https" && !allowLoopback) ||
                !string.IsNullOrEmpty(uri.UserInfo) || !string.IsNullOrEmpty(uri.Query) || !string.IsNullOrEmpty(uri.Fragment))
                throw new InvalidOperationException(L.Get(Str.ServiceUnavailable));
            var result = await Session.CheckServiceAsync(url, token);
            if (IsDisposed || attempt != generation) return;
            if (!checkState.Complete(attempt, result.Status))
                throw new InvalidOperationException(L.Get(Str.ServiceUnavailable));
            info = result;
            if (ServiceCatalog.IsPublic(url)) selection = url;
            Settings.UpdateSavedServiceInfo(url, result);
            await Checked.InvokeAsync(result);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception ex) { if (!IsDisposed && attempt == generation) error = ex.Message; }
        finally { if (attempt == generation) checking = false; }
    }
    public override void Dispose() { checkState.Invalidate(); request?.Cancel(); request?.Dispose(); base.Dispose(); }
}
