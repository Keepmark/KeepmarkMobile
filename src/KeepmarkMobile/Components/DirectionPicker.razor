@* The three ways to reconcile two copies, as radio cards. Same words in
   Connect, Move service and the sync conflict panel: one choice here, one
   action button below it on the page. *@
<fieldset class="xbs-options" disabled="@Disabled">
    <legend class="xbs-options-legend">@Legend</legend>
    @foreach (var o in Options())
    {
        <label class="xbs-option">
            <input type="radio" name="@Name" checked="@(Value == o.Key)" disabled="@o.Off"
                   @onchange="() => ValueChanged.InvokeAsync(o.Key)" />
            <span class="xbs-option-text">
                <strong>@o.Title</strong>
                <span>@(o.Off ? o.OffWhy : o.Text)</span>
            </span>
        </label>
    }
</fieldset>

@code {
    /// <summary>"download" (keep the server copy), "upload" (keep this
    /// device's copy) or "merge" (keep both).</summary>
    [Parameter] public string Value { get; set; } = "download";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public int LocalCount { get; set; }
    [Parameter] public int RemoteCount { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Legend { get; set; } = "Which copy do you want to keep?";
    [Parameter] public string Name { get; set; } = "direction";

    private record Opt(string Key, string Title, string Text, bool Off, string OffWhy);

    private IEnumerable<Opt> Options()
    {
        yield return new("download", "Keep the server copy",
            $"Download: this device gets the {RemoteCount} server item(s); its {LocalCount} item(s) are replaced.",
            RemoteCount == 0, "The server copy is empty.");
        yield return new("merge", "Merge both",
            "Nothing is deleted: items from both copies are kept, and items removed on one side while offline come back.",
            LocalCount == 0 || RemoteCount == 0, "Needs items on both sides.");
        yield return new("upload", "Keep this device's copy",
            $"Upload: the server gets your {LocalCount} item(s); its {RemoteCount} item(s) are replaced.",
            LocalCount == 0, "Nothing on this device to upload.");
    }
}
