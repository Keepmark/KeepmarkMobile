@using Keepmark.Core.Data

@if (Visible)
{
    <div class="xbs-sheet-backdrop" data-back="30" @onclick="RequestCancel">
        <div class="xbs-sheet" role="dialog" aria-modal="true" aria-labelledby="xbs-sheet-title" @onclick:stopPropagation="true">
            <div class="xbs-sheet-handle" aria-hidden="true"></div>
            <h2 id="xbs-sheet-title" class="xbs-sheet-title mb-3">@(IsEdit ? (EffectiveIsFolder ? "Edit folder" : "Edit bookmark") : NewIsFolder ? "New folder" : "New bookmark")</h2>
            @if (!IsEdit)
            {
                <div class="mb-2">
                    <label class="form-label" for="xbs-f-type">Type</label>
                    <select id="xbs-f-type" class="form-select" @bind="TypeValue">
                        <option value="bookmark">Bookmark</option>
                        <option value="folder">Folder</option>
                    </select>
                    @if (NewIsFolder && (url.Length > 0 || description.Length > 0 || tags.Length > 0))
                    {
                        <div class="form-text">URL, description and tags are hidden for folders — switch back to Bookmark to see them again. Nothing is lost.</div>
                    }
                </div>
            }
            <div class="mb-2">
                <label class="form-label" for="xbs-f-title">Title</label>
                <input id="xbs-f-title" class="form-control" @ref="titleInput" @bind="title" autofocus
                       aria-invalid="@((fieldError == "title").ToString().ToLowerInvariant())" aria-describedby="@(fieldError is null ? null : "xbs-form-error")" />
            </div>
            @if (!EffectiveIsFolder)
            {
                <div class="mb-2">
                    <label class="form-label" for="xbs-f-url">URL</label>
                    <input id="xbs-f-url" class="form-control" @bind="url" inputmode="url"
                           aria-invalid="@((fieldError == "url").ToString().ToLowerInvariant())" aria-describedby="@(fieldError is null ? null : "xbs-form-error")" />
                </div>
                <div class="mb-2">
                    <label class="form-label" for="xbs-f-desc">Description</label>
                    <textarea id="xbs-f-desc" class="form-control" @bind="description" rows="2" maxlength="300"></textarea>
                </div>
                <div class="mb-2">
                    <label class="form-label" for="xbs-f-tags">Tags (comma separated)</label>
                    <input id="xbs-f-tags" class="form-control" @bind="tags" />
                </div>
            }
            <div class="mb-3">
                <label class="form-label" for="xbs-f-folder">Folder</label>
                <button type="button" id="xbs-f-folder" class="form-control xbs-folder-btn" aria-expanded="@showTree.ToString().ToLowerInvariant()" @onclick="OpenTree">
                    <svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 7.5a2 2 0 0 1 2-2h4l2 2h7a2 2 0 0 1 2 2v7.5a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2z" /></svg>
                    <span class="xbs-folder-btn-text">@(SelectedFolderPath() ?? "Top level")</span>
                    <svg class="km-ico sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
                </button>
            </div>
            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-danger" id="xbs-form-error" role="alert">@error</div>
            }
            @if (confirmDiscard)
            {
                <div class="alert alert-warning" role="alert">
                    <strong>Discard unsaved changes?</strong>
                    <div class="mt-2 d-flex gap-2">
                        <button class="btn btn-danger" @onclick="Discard">Discard</button>
                        <button class="btn btn-secondary" @onclick="() => confirmDiscard = false">Keep editing</button>
                    </div>
                </div>
            }
            <div class="xbs-sheet-actions">
                <button class="btn btn-secondary" @onclick="RequestCancel">Cancel</button>
                <button class="btn btn-primary" @onclick="Save">Save</button>
            </div>
        </div>
        @if (showTree)
        {
            <div class="xbs-tree-full" role="dialog" aria-modal="true" aria-label="Choose folder" @onclick:stopPropagation="true">
                <div class="xbs-tree-head">
                    <button type="button" class="xbs-tree-close" aria-label="Cancel" @onclick="CancelTree">
                        <svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
                    </button>
                    <div class="xbs-tree-headtext">
                        <h2 class="xbs-tree-title">Choose folder</h2>
                        <div class="xbs-tree-sub">Save in: @(SelectedFolderPath() ?? "Top level")</div>
                    </div>
                </div>
                <FolderPicker Folders="Folders" Selected="selectedFolder" SelectedChanged="OnHighlight"
                              ExcludeSubtreeRoot="Existing?.RowId" OnConfirm="() => showTree = false" OnCancel="CancelTree" />
            </div>
        }
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public ItemRow? Existing { get; set; }
    [Parameter] public int? DefaultParent { get; set; }
    [Parameter] public string? PresetUrl { get; set; }
    [Parameter] public string? PresetTitle { get; set; }
    [Parameter] public List<ItemRow> Folders { get; set; } = [];
    [Parameter] public EventCallback<BookmarkEdit> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string title = string.Empty;
    private string url = string.Empty;
    private string description = string.Empty;
    private string tags = string.Empty;
    private bool NewIsFolder;
    private int? selectedFolder;
    private bool showTree;
    private string error = string.Empty;
    private string? fieldError;
    private bool confirmDiscard;
    private ElementReference titleInput;

    // Snapshot of the opened values: backdrop/Cancel only asks when dirty,
    // and parent re-renders (sync ticks) never wipe what is being typed.
    private string openKey = string.Empty;
    private string initTitle = string.Empty;
    private string initUrl = string.Empty;
    private string initDescription = string.Empty;
    private string initTags = string.Empty;
    private bool initIsFolder;
    private int? initFolder;
    private int? folderBeforePick;

    private bool IsEdit => Existing is not null;

    private string? SelectedFolderPath()
    {
        if (selectedFolder is null)
        {
            return null;
        }

        var byId = Folders.ToDictionary(f => f.RowId);
        if (!byId.TryGetValue(selectedFolder.Value, out var cur))
        {
            return null;
        }

        var parts = new Stack<string>();
        while (cur is not null)
        {
            if (cur.Title is not null)
            {
                parts.Push(cur.Title);
            }

            cur = cur.ParentRowId is not null && byId.TryGetValue(cur.ParentRowId.Value, out var p) ? p : null;
        }

        return "\U0001F4C1 " + string.Join(" / ", parts);
    }

    private void OpenTree()
    {
        folderBeforePick = selectedFolder;
        showTree = true;
    }

    private void OnHighlight(int? rowId) => selectedFolder = rowId;

    private void CancelTree()
    {
        selectedFolder = folderBeforePick;
        showTree = false;
    }

    // Bound as a string: a bool @bind renders value as a boolean attribute
    // (true -> value="", false -> omitted), so no option matched after a pick.
    private string TypeValue
    {
        get => NewIsFolder ? "folder" : "bookmark";
        set => NewIsFolder = value == "folder";
    }

    private bool EffectiveIsFolder => IsEdit ? Existing!.IsFolder : NewIsFolder;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Visible)
        {
            try { await titleInput.FocusAsync(); } catch { }
        }
    }

    protected override void OnParametersSet()
    {
        if (!Visible)
        {
            return;
        }

        // Same sheet still open (e.g. a background sync re-rendered the page):
        // keep the user's in-progress edits.
        var key = $"{Existing?.RowId}|{PresetUrl}|{PresetTitle}|{DefaultParent}";
        if (key == openKey)
        {
            return;
        }

        openKey = key;
        error = string.Empty;
        fieldError = null;
        confirmDiscard = false;
        showTree = false;
        if (Existing is not null)
        {
            title = Existing.Title ?? string.Empty;
            url = Existing.Url ?? string.Empty;
            description = Existing.Description ?? string.Empty;
            tags = Existing.Tags?.Replace(" ", ", ") ?? string.Empty;
            selectedFolder = Existing.ParentRowId;
        }
        else
        {
            title = PresetTitle ?? string.Empty;
            url = PresetUrl ?? string.Empty;
            description = string.Empty;
            tags = string.Empty;
            NewIsFolder = false;
            selectedFolder = DefaultParent;
        }

        initTitle = title;
        initUrl = url;
        initDescription = description;
        initTags = tags;
        initIsFolder = EffectiveIsFolder;
        initFolder = selectedFolder;
    }

    private bool IsDirty() =>
        title != initTitle || url != initUrl || description != initDescription ||
        tags != initTags || EffectiveIsFolder != initIsFolder || selectedFolder != initFolder;

    private void RequestCancel()
    {
        if (IsDirty())
        {
            confirmDiscard = true;
            return;
        }

        _ = OnCancel.InvokeAsync();
    }

    private Task Discard()
    {
        confirmDiscard = false;
        return OnCancel.InvokeAsync();
    }

    private async Task Save()
    {
        error = string.Empty;
        fieldError = null;
        confirmDiscard = false;
        if (string.IsNullOrWhiteSpace(title))
        {
            fieldError = "title";
            error = "Title is required.";
            return;
        }

        List<string>? tagList = null;
        if (!EffectiveIsFolder)
        {
            if (string.IsNullOrWhiteSpace(url))
            {
                fieldError = "url";
                error = "URL is required.";
                return;
            }

            if (!Uri.TryCreate(url.Trim(), UriKind.Absolute, out var u) ||
                (u.Scheme != Uri.UriSchemeHttp && u.Scheme != Uri.UriSchemeHttps))
            {
                fieldError = "url";
                error = "URL must start with http:// or https://.";
                return;
            }

            tagList = tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(t => t.Length > 0).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        }

        await OnSave.InvokeAsync(new BookmarkEdit(Existing?.RowId, title.Trim(),
            EffectiveIsFolder ? null : url.Trim(),
            EffectiveIsFolder ? null : description.Trim(),
            EffectiveIsFolder ? null : tagList, EffectiveIsFolder, selectedFolder));
    }

    public sealed record BookmarkEdit(
        int? RowId, string Title, string? Url, string? Description,
        List<string>? Tags, bool IsFolder, int? ParentRowId);
}
