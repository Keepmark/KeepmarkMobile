@using Keepmark.Core.Workflow

<section class="xbs-qr-review" aria-labelledby="qr-review-heading" aria-busy="@Busy.ToString().ToLowerInvariant()">
    <div class="xbs-qr-review-summary" role="status">
        <svg class="km-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h6v6H3zM15 3h6v6h-6zM3 15h6v6H3zM15 15h2v2h-2zM19 15h2v6h-2zM15 19h2v2h-2z" /></svg>
        <h2 id="qr-review-heading" class="xbs-step-title">@L.Get(Str.ConnQrAcquired)</h2>
        <dl>
            <dt>@L.Get(Str.ConnService)</dt><dd>@ServiceUrl</dd>
            <dt>@L.Get(Str.ConnSyncId)</dt><dd><code>@WorkflowRules.ShortId(SyncId)</code></dd>
        </dl>
    </div>
    <div class="xbs-qr-review-actions">
        <button class="btn btn-primary" @onclick="OnVerify" disabled="@Busy">@(Busy ? L.Get(Str.ConnQrVerifying) : L.Get(Str.ConnOpenSync))</button>
        <button class="btn btn-secondary" @onclick="OnCancel" disabled="@Busy">@L.Get(Str.CommonCancel)</button>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public string ServiceUrl { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string SyncId { get; set; } = string.Empty;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnVerify { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}
