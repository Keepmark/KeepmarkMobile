@page "/connect"
@inject Keepmark.Services.XbsSession Session
@inject Keepmark.Services.XbsSettings AppSettings
@inject Keepmark.Services.SecureCredentialStore Creds

<PageTitle>Connect</PageTitle>

<h1>Connect</h1>

@if (!Session.Ready)
{
    <p role="status"><em>Starting…</em></p>
}
else if (linked)
{
    <div class="alert alert-success">
        Linked to <strong>@linkedUrl</strong> (sync <code>@ShortId(linkedId)</code>).
    </div>
    <p>To move to another service use <a href="switch-service">Move service</a>, to save or restore an encrypted copy use <a href="backup">Backup</a>.</p>

    <hr />
    <h2>Unlink this device</h2>
    <p class="text-muted">Forget the sync credentials on this device. Your @localCount local item(s) stay untouched; syncing stops until you link again.</p>
    @if (!armedUnlink)
    {
        <button class="btn btn-outline-danger" @onclick="() => armedUnlink = true" disabled="@busy">Unlink…</button>
    }
    else
    {
        <div class="alert alert-danger">
            <strong>Unlink this device?</strong> Syncing stops; the bookmarks on this device stay untouched.
            <div class="mt-2 d-flex gap-2">
                <button class="btn btn-danger" @onclick="ExecuteUnlink" disabled="@busy">Yes, unlink</button>
                <button class="btn btn-secondary" @onclick="() => armedUnlink = false" disabled="@busy">Cancel</button>
            </div>
        </div>
    }
    @if (!string.IsNullOrEmpty(unlinkError))
    {
        <div class="alert alert-danger mt-3" role="alert">@unlinkError</div>
    }
    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert mt-3 @(isError ? "alert-danger" : "alert-success")" role="@(isError ? "alert" : "status")">@message</div>
    }
}
else
{
    <div class="alert alert-info">
        <h4>How your bookmarks get here</h4>
        <ul class="mb-1">
            <li><strong>Open an existing sync</strong> below — with an empty library this simply downloads everything from the server.</li>
            <li><strong>Create a new sync</strong> — start empty, or upload bookmarks you already have.</li>
            <li><strong>Restore an encrypted backup file</strong> — in the <a href="backup">Backup</a> section, no connection needed.</li>
        </ul>
        <small>Sync exchanges the whole collection at once (never single items). If both sides change independently, the app reports a conflict instead of merging silently — and every overwrite is safety-backed-up first.</small>
    </div>
    <div class="mb-3">
        <label class="form-label">Service URL</label>
        <input class="form-control" @bind="serviceUrl" inputmode="url" />
        <div class="form-text">Address of the xBrowserSync service to use. Check verifies it answers with a compatible API version.</div>
        <button class="btn btn-secondary mt-2" @onclick="CheckService" disabled="@busy">Check service</button>
        @if (!string.IsNullOrEmpty(checkError))
        {
            <div class="alert alert-danger mt-2" role="alert">@checkError</div>
        }
        @if (serviceInfo is not null)
        {
            <p class="mt-2" role="status">Status: <strong>@serviceInfo.Status</strong> · API v@(serviceInfo.Version) · max @(serviceInfo.MaxSyncSize / 1024) KB</p>
        }
    </div>

    <div class="mb-3">
        <h4>Open an existing sync</h4>
        <label class="form-label">Sync ID</label>
        <input class="form-control" @bind="syncId" placeholder="xxxxxxxx-xxxx-…" />
        <label class="form-label mt-2">Password</label>
        <input type="password" class="form-control" @bind="password" autocomplete="current-password" />
        <div class="form-text">The password is verified against the server copy: a wrong password cannot open the sync. Nothing is changed until you pick a direction below.</div>
        <div class="mt-2">
            <button class="btn btn-primary me-2" @onclick="LinkExisting" disabled="@busy">Link existing sync</button>
        </div>
        @if (!string.IsNullOrEmpty(linkError))
        {
            <div class="alert alert-danger mt-2" role="alert">@linkError</div>
        }
    </div>

    <div class="mb-3">
        <h4>Create a new sync</h4>
        <label class="form-label">New password</label>
        <input type="password" class="form-control" @bind="newPassword" autocomplete="new-password" />
        <label class="form-label mt-2">Confirm password</label>
        <input type="password" class="form-control" @bind="confirmPassword" autocomplete="new-password" />
        <div class="form-text">At least 8 characters. It encrypts everything and cannot be recovered — lose it and the sync is unreadable.</div>
        <div class="mt-2 d-grid gap-2">
            @if (localCount > 0)
            {
                <button class="btn btn-primary" @onclick="CreateWithUpload" disabled="@busy">Create and upload my @localCount item(s)</button>
                <div class="form-text">Creates the sync on this service and uploads your current local bookmarks into it. Nothing local is deleted.</div>
                @if (armed != "createEmpty")
                {
                    <button class="btn btn-outline-danger" @onclick='() => armed = "createEmpty"' disabled="@busy">Create empty instead…</button>
                }
                else
                {
                    <div class="alert alert-danger">
                        <strong>Replace your @localCount local item(s) with an empty sync?</strong>
                        A plaintext safety backup is saved first, but this discards what you see now.
                        <div class="mt-2 d-flex gap-2">
                            <button class="btn btn-danger" @onclick="CreateNew" disabled="@busy">Yes, create empty</button>
                            <button class="btn btn-secondary" @onclick="Disarm" disabled="@busy">Cancel</button>
                        </div>
                    </div>
                }
            }
            else
            {
                <button class="btn btn-outline-primary" @onclick="CreateNew" disabled="@busy">Create new sync</button>
                <div class="form-text">Creates an empty sync on this service and links the app to it.</div>
            }
        </div>
    </div>

    @if (reconcile is not null)
    {
        <div class="alert alert-warning">
            <h4>Choose sync direction</h4>
            <p>Local items: <strong>@reconcile.LocalCount</strong> · Server items: <strong>@reconcile.RemoteCount</strong>
                (server copy updated @(reconcile.RemoteLastUpdated ?? "unknown")).</p>
            <div class="mb-2">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="syncDirection" id="dir-download"
                           checked="@(direction == "download")" disabled="@(busy || reconcile.RemoteCount == 0)"
                           @onchange='() => SetDirection("download")' />
                    <label class="form-check-label" for="dir-download">
                        Download — replace the bookmarks on this device with the server copy
                        @if (reconcile.RemoteCount == 0)
                        {
                            <text>(server copy is empty)</text>
                        }
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="syncDirection" id="dir-upload"
                           checked="@(direction == "upload")" disabled="@(busy || reconcile.LocalCount == 0)"
                           @onchange='() => SetDirection("upload")' />
                    <label class="form-check-label" for="dir-upload">
                        Upload — replace the server copy with the bookmarks on this device
                        @if (reconcile.LocalCount == 0)
                        {
                            <text>(nothing local to upload)</text>
                        }
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="syncDirection" id="dir-merge"
                           checked="@(direction == "merge")"
                           disabled="@(busy || reconcile.LocalCount == 0 || reconcile.RemoteCount == 0)"
                           @onchange='() => SetDirection("merge")' />
                    <label class="form-check-label" for="dir-merge">
                        Merge — keep everything from both sides (nothing is deleted)
                        @if (reconcile.LocalCount == 0 || reconcile.RemoteCount == 0)
                        {
                            <text>(needs items on both sides)</text>
                        }
                    </label>
                </div>
            </div>
            @if (direction == "merge")
            {
                <div class="alert alert-info mb-2">
                    <strong>Merge keeps everything from both sides — nothing is deleted.</strong>
                    Local-only bookmarks upload, server-only ones download; same-URL
                    title conflicts keep the server title; items deleted on one
                    side while the other was offline reappear.
                    <div class="mt-2">
                        <button class="btn btn-secondary" @onclick="PreviewMerge" disabled="@busy">Preview merge</button>
                    </div>
                    @if (mergeStats is not null)
                    {
                        <p class="mt-2 mb-1" role="status">@mergeStats.LocalOnly local will upload (of @mergeStats.LocalCount),
                            @mergeStats.RemoteOnly remote will download (of @mergeStats.RemoteCount),
                            @mergeStats.TitleConflicts title conflicts (server title kept),
                            @mergeStats.FoldersCreated folders created,
                            @mergeStats.SeparatorsAdopted separators kept from both sides.</p>
                        @if (!armedMerge)
                        {
                            <div class="mt-2">
                                <button class="btn btn-danger" @onclick="() => armedMerge = true" disabled="@busy">Merge…</button>
                            </div>
                        }
                        else
                        {
                            <div class="mt-2 d-flex gap-2">
                                <button class="btn btn-danger" @onclick="ApplyMerge" disabled="@busy">Yes, merge</button>
                                <button class="btn btn-secondary" @onclick="() => armedMerge = false" disabled="@busy">Cancel</button>
                            </div>
                        }
                    }
                </div>
            }
            else if (direction == "upload")
            {
                <div class="alert alert-danger mb-2">
                    <strong>Replaces the @reconcile.RemoteCount server item(s) with your @reconcile.LocalCount local item(s).</strong>
                    A plaintext safety backup of the server copy is saved first.
                    @if (!armedLocal)
                    {
                        <div class="mt-2">
                            <button class="btn btn-danger" @onclick="() => armedLocal = true" disabled="@busy">Upload…</button>
                        </div>
                    }
                    else
                    {
                        <div class="mt-2 d-flex gap-2">
                            <button class="btn btn-danger" @onclick="ApplyLocal" disabled="@busy">Yes, upload</button>
                            <button class="btn btn-secondary" @onclick="() => armedLocal = false" disabled="@busy">Cancel</button>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-danger mb-2">
                    <strong>Downloads the @reconcile.RemoteCount server item(s).</strong>
                    @if (reconcile.LocalCount > 0)
                    {
                        <text>Your @reconcile.LocalCount local item(s) will be deleted.</text>
                    }
                    A plaintext safety backup is saved first.
                    @if (!armedRemote)
                    {
                        <div class="mt-2">
                            <button class="btn btn-danger" @onclick="() => armedRemote = true" disabled="@busy">Download…</button>
                        </div>
                    }
                    else
                    {
                        <div class="mt-2 d-flex gap-2">
                            <button class="btn btn-danger" @onclick="ApplyRemote" disabled="@busy">Yes, download</button>
                            <button class="btn btn-secondary" @onclick="() => armedRemote = false" disabled="@busy">Cancel</button>
                        </div>
                    }
                </div>
            }
            @if (!string.IsNullOrEmpty(applyError))
            {
                <div class="alert alert-danger mt-2" role="alert">@applyError</div>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert mt-3 @(isError ? "alert-danger" : "alert-success")" role="@(isError ? "alert" : "status")">@message</div>
    }
}

@code {
    private string serviceUrl = Core.XbsConstants.DefaultServiceUrl;
    private string syncId = string.Empty;
    private string password = string.Empty;
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private bool busy;
    private string message = string.Empty;
    private bool isError;
    private string checkError = string.Empty;
    private string linkError = string.Empty;
    private string applyError = string.Empty;
    private string unlinkError = string.Empty;
    private Core.Sync.MergeStats? mergeStats;
    private Services.ReconcileInfo? mergeStatsFor;
    private Core.Api.ServiceInfoResponse? serviceInfo;
    private Services.ReconcileInfo? reconcile;
    private bool linked;
    private string? linkedUrl;
    private string? linkedId;
    private int localCount;
    private string? armed;
    private bool armedUnlink;
    private bool armedMerge;
    private bool armedLocal;
    private bool armedRemote;
    /// <summary>Reconcile direction choice: "download" replaces local with the
    /// remote copy, "upload" overwrites the remote with local, "merge" unions
    /// both sides. Preselected to the only sensible side when one of them is
    /// empty. Changing direction invalidates the merge preview.</summary>
    private string direction = "download";

    private void SetDirection(string value)
    {
        direction = value;
        mergeStats = null;
        mergeStatsFor = null;
        applyError = string.Empty;
        armedMerge = false;
        armedLocal = false;
        armedRemote = false;
    }

    protected override void OnInitialized() => serviceUrl = AppSettings.ServiceUrl;

    protected override async Task OnInitializedAsync()
    {
        for (int i = 0; i < 100 && !Session.Ready; i++)
        {
            await Task.Delay(100);
        }

        await RefreshStateAsync();
    }

    private async Task RefreshStateAsync()
    {
        var c = await Creds.GetAsync();
        linked = c is not null;
        linkedUrl = c?.ServiceUrl;
        linkedId = c?.Id;
        if (Session.Store is not null)
        {
            var stats = await Session.Store.GetStatsAsync();
            localCount = stats.Folders + stats.Bookmarks + stats.Separators;
        }
    }

    private static string ShortId(string? id) =>
        id is null || id.Length <= 8 ? "…" : $"{id[..4]}…{id[^2..]}";

    private void Disarm() => armed = null;

    private async Task ExecuteUnlink()
    {
        await RunStepAsync(async () =>
        {
            await Creds.ClearAsync();
            armedUnlink = false;
            await RefreshStateAsync();
            Session.Log.Info("connect", "Device unlinked");
            Ok("Device unlinked. Local bookmarks kept; link again to resume syncing.");
        }, err => unlinkError = err, "connect-unlink");
    }

    private static void RequireMatchingPasswords(string first, string second)
    {
        if (first.Length < 8)
        {
            throw new InvalidOperationException("Use a password of at least 8 characters.");
        }

        if (!string.Equals(first, second, StringComparison.Ordinal))
        {
            throw new InvalidOperationException("Passwords do not match.");
        }
    }

    private async Task CheckService()
    {
        await RunStepAsync(async () =>
        {
            serviceInfo = await Session.CheckServiceAsync(serviceUrl.Trim());
            AppSettings.ServiceUrl = serviceUrl.Trim();
            Ok($"Service is valid: {serviceInfo.Status}, API v{serviceInfo.Version}.");
        }, err => checkError = err, "connect-check");
    }

    private async Task LinkExisting()
    {
        await RunStepAsync(async () =>
        {
            if (string.IsNullOrWhiteSpace(syncId) || string.IsNullOrEmpty(password))
            {
                throw new InvalidOperationException("Enter both the sync ID and its password.");
            }

            reconcile = await Session.ProbeLinkAsync(serviceUrl.Trim(), syncId.Trim(), password);
            AppSettings.ServiceUrl = serviceUrl.Trim();
            mergeStats = null;
            mergeStatsFor = null;
            applyError = string.Empty;
            armedMerge = false;
            armedLocal = false;
            armedRemote = false;
            if (reconcile is { LocalCount: 0, RemoteCount: 0 })
            {
                await Session.ApplyRemoteAsync(reconcile);
                reconcile = null;
                await RefreshStateAsync();
                Ok("Linked. Both sides were empty — ready to go.");
            }
            else
            {
                // Preselect the only sensible direction when one side is empty.
                direction = reconcile.RemoteCount == 0 ? "upload" : "download";
                Ok("Credentials valid. Choose the sync direction above.");
            }
        }, err => linkError = err, "connect-link");
    }

    private async Task CreateNew()
    {
        await RunStepAsync(async () =>
        {
            RequireMatchingPasswords(newPassword, confirmPassword);
            await Session.CreateNewSyncAsync(serviceUrl.Trim(), newPassword);
            AppSettings.ServiceUrl = serviceUrl.Trim();
            reconcile = null;
            armed = null;
            newPassword = string.Empty;
            await RefreshStateAsync();
            Ok("New empty sync created and linked. Safety backup of the previous local data saved — see Backup → Safety backups.");
        }, err => linkError = err, "connect-create");
    }

    private async Task CreateWithUpload()
    {
        await RunStepAsync(async () =>
        {
            RequireMatchingPasswords(newPassword, confirmPassword);
            await Session.CreateNewSyncWithUploadAsync(serviceUrl.Trim(), newPassword);
            AppSettings.ServiceUrl = serviceUrl.Trim();
            reconcile = null;
            newPassword = string.Empty;
            await RefreshStateAsync();
            Ok("New sync created and your local bookmarks were uploaded into it.");
        }, err => linkError = err, "connect-create");
    }

    private async Task ApplyRemote()
    {
        await RunStepAsync(async () =>
        {
            var target = reconcile!;
            await Session.ApplyRemoteAsync(target);
            reconcile = null;
            mergeStats = null;
            mergeStatsFor = null;
            armedRemote = false;
            await RefreshStateAsync();
            Ok($"{Core.Sync.MoveResult.Describe("existing", "pull", target.Candidate.ServiceUrl, target.Candidate.Id)} Safety backup of your previous local tree saved — see Backup → Safety backups.");
        }, err => applyError = err, "connect-apply");
    }

    private async Task ApplyLocal()
    {
        await RunStepAsync(async () =>
        {
            var target = reconcile!;
            await Session.ApplyLocalAsync(target);
            reconcile = null;
            mergeStats = null;
            mergeStatsFor = null;
            armedLocal = false;
            await RefreshStateAsync();
            Ok($"{Core.Sync.MoveResult.Describe("existing", "push", target.Candidate.ServiceUrl, target.Candidate.Id)} Safety backup of the previous server copy saved — see Backup → Safety backups.");
        }, err => applyError = err, "connect-apply");
    }

    private async Task PreviewMerge()
    {
        await RunStepAsync(async () =>
        {
            mergeStats = await Session.GetMergePreviewAsync(reconcile!);
            mergeStatsFor = reconcile;
            message = string.Empty;
        }, err => applyError = err, "connect-merge-preview");
    }

    private async Task ApplyMerge()
    {
        await RunStepAsync(async () =>
        {
            var target = reconcile!;
            if (mergeStats is null || !ReferenceEquals(mergeStatsFor, target))
            {
                throw new InvalidOperationException("Preview the merge first — counts must match the linked sync.");
            }

            await Session.ApplyMergeAsync(target, Core.Safety.SafetyOperations.ConnectMerge);
            reconcile = null;
            mergeStats = null;
            mergeStatsFor = null;
            armedMerge = false;
            await RefreshStateAsync();
            Ok($"{Core.Sync.MoveResult.Describe("existing", "merge", target.Candidate.ServiceUrl, target.Candidate.Id)} Safety backups of both sides saved — see Backup → Safety backups.");
        }, err => applyError = err, "connect-apply");
    }

    /// <summary>One action cluster, one adjacent error box: each wizard step
    /// reports into its own field (check/link/apply) rendered next to the
    /// button that produced it, instead of a single shared box.</summary>
    private async Task RunStepAsync(Func<Task> action, Action<string> setError, [System.Runtime.CompilerServices.CallerMemberName] string op = "?")
    {
        busy = true;
        isError = false;
        message = string.Empty;
        setError(string.Empty);
        try
        {
            Session.Log.Debug("connect", $"{op}: start");
            await action();
            Session.Log.Info("connect", $"{op}: ok");
        }
        catch (Exception ex)
        {
            isError = true;
            setError(ex.Message);
            Session.Log.Warn("connect", $"{op} failed: {ex.GetType().Name}");
        }
        finally
        {
            password = string.Empty;
            confirmPassword = string.Empty;
            newPassword = string.Empty;
            busy = false;
        }
    }

    private void Ok(string text)
    {
        isError = false;
        message = text;
    }
}
