@page "/settings"
@inject Keepmark.Services.XbsSession Session
@inject Keepmark.Services.XbsSettings AppSettings
@inject Keepmark.Services.SecureCredentialStore Creds
@inject Keepmark.Services.IAppLockService AppLock
@inject Keepmark.Services.IStatusBarService StatusBar
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>Settings</PageTitle>

<h1>Settings</h1>

<div class="mb-3">
    <label class="form-label">Sync mode (default: Automatic)</label>
    <select class="form-select" @bind="mode">
        <option value="@Core.Sync.SyncMode.Auto">Automatic — sync on every change</option>
        <option value="@Core.Sync.SyncMode.Manual">Manual — only via Sync now</option>
    </select>
</div>

<div class="mb-3">
    <label class="form-label">Linked service</label>
    <p class="form-control-plaintext"><strong>@(linkedUrl ?? "Not linked")</strong></p>
    <small class="text-muted">To move your data to another service, use the <a href="switch-service">Move service</a> section.</small>
</div>

<div class="mb-3">
    <label class="form-label">Log verbosity</label>
    <select class="form-select" @bind="verbosity" @bind:after="ApplyVerbosity">
        <option value="@Core.Logging.XbsLogLevel.Error">Error</option>
        <option value="@Core.Logging.XbsLogLevel.Warning">Warning</option>
        <option value="@Core.Logging.XbsLogLevel.Info">Info</option>
        <option value="@Core.Logging.XbsLogLevel.Debug">Debug</option>
        <option value="@Core.Logging.XbsLogLevel.Verbose">Verbose (may include your bookmark titles/URLs)</option>
    </select>
    <div class="form-text">Applies instantly, no Save needed.</div>
</div>

<div class="mb-3">
    <label class="form-label">Theme</label>
    <select class="form-select" @bind="theme">
        <option value="System">System (default)</option>
        <option value="Light">Light</option>
        <option value="Dark">Dark</option>
    </select>
</div>

<div class="mb-3">
    <label class="form-label">App lock (device PIN / biometric)</label>
    <select class="form-select" @bind="appLock">
        <option value="Off">Off (default)</option>
        <option value="PinOnly">PIN only (device PIN, pattern or password)</option>
        <option value="BiometricAndPin">Biometric + PIN fallback</option>
    </select>
</div>

@if (appLock != "Off")
{
    <div class="mb-3">
        <label class="form-label">Auto-lock after (minutes, 0 = on background)</label>
        <input type="number" class="form-control" @bind="lockTimeout" min="0" max="60" />
    </div>
}

<button class="btn btn-primary" @onclick="Save">Save</button>
@if (saved)
{
    <span class="text-success ms-2" role="status">Saved.</span>
}
@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger mt-2" role="alert">@error</div>
}

@if (linkedUrl is not null)
{
    <h3 class="mt-4">Change password</h3>
    <p class="text-muted">Re-encrypts the sync with a new password. Your current password is verified
        first and never leaves this device. The old password stops working on all devices
        immediately — update your vault and other devices.</p>
    @if (!string.IsNullOrEmpty(pwError))
    {
        <div class="alert alert-danger" role="alert">@pwError</div>
    }
    <div class="mb-3">
        <label class="form-label">Current password</label>
        <input type="password" class="form-control" @bind="pwCurrent" autocomplete="current-password" />
    </div>
    <div class="mb-3">
        <label class="form-label">New password</label>
        <input type="password" class="form-control" @bind="pwNew" autocomplete="new-password" />
    </div>
    <div class="mb-3">
        <label class="form-label">Confirm new password</label>
        <input type="password" class="form-control" @bind="pwConfirm" autocomplete="new-password" />
    </div>
    <button class="btn btn-warning" @onclick="() => armedPw = true" disabled="@(pwBusy || armedPw)">Change password…</button>
    @if (armedPw)
    {
        <div class="alert alert-danger mt-2">
            <strong>Change the sync password on all devices?</strong> The old password stops working immediately — update your vault and other devices.
            <div class="mt-2 d-flex gap-2">
                <button class="btn btn-warning" @onclick="ChangePassword" disabled="@pwBusy">Yes, change password</button>
                <button class="btn btn-secondary" @onclick="() => armedPw = false" disabled="@pwBusy">Cancel</button>
            </div>
        </div>
    }
    @if (pwDone)
    {
        <div class="alert alert-success mt-2" role="status">Password changed. A safety backup of the previous server copy was saved — see Backup → Safety backups. Update your other devices and vault now.</div>
    }
}

<h3 class="mt-4">Gestures</h3>
<ul>
    <li><strong>Tap</strong> a bookmark to open it, a folder to enter it.</li>
    <li><strong>Swipe right</strong> to expand full details, <strong>swipe left</strong> to collapse.</li>
    <li><strong>⋮ button or long-press</strong> for details and all actions (Open, Edit, Share, Pin, Delete).</li>
</ul>

@code {
    private Core.Sync.SyncMode mode;
    private Core.Logging.XbsLogLevel verbosity;
    private string theme = "System";
    private string appLock = "Off";
    private int lockTimeout;
    private string error = string.Empty;
    private bool saved;
    private string? linkedUrl;
    private string pwCurrent = string.Empty;
    private string pwNew = string.Empty;
    private string pwConfirm = string.Empty;
    private string pwError = string.Empty;
    private bool pwDone;
    private bool pwBusy;
    private bool armedPw;

    protected override void OnInitialized()
    {
        mode = AppSettings.Mode;
        verbosity = AppSettings.Verbosity;
        theme = AppSettings.Theme;
        appLock = AppSettings.AppLock;
        lockTimeout = AppSettings.LockTimeoutMinutes;
    }

    protected override async Task OnInitializedAsync()
    {
        var c = await Creds.GetAsync();
        linkedUrl = c?.ServiceUrl;
    }

    /// <summary>Verbosity applies instantly (no Save needed): later entries
    /// are recorded at the new level right away.</summary>
    private void ApplyVerbosity()
    {
        AppSettings.Verbosity = verbosity;
        Session.NotifySettingsChanged();
    }

    private async Task Save()
    {
        error = string.Empty;
        saved = false;
        // Enabling or disabling app lock always requires device-PIN confirmation.
        if (appLock != AppSettings.AppLock)
        {
            bool confirmed = false;
            try
            {
                confirmed = await AppLock.AuthenticateAsync(
                    appLock == "Off" ? "Confirm disabling app lock" : "Confirm app lock activation",
                    requireDeviceCredential: true);
            }
            catch
            {
                confirmed = false;
            }

            if (!confirmed)
            {
                appLock = AppSettings.AppLock;
                error = "Not confirmed with the device PIN. App lock unchanged.";
                return;
            }
        }

        AppSettings.Mode = mode;
        AppSettings.Verbosity = verbosity;
        AppSettings.Theme = theme is "Light" or "Dark" ? theme : "System";
        theme = AppSettings.Theme;
        Session.NotifySettingsChanged();
        try { await JS.InvokeVoidAsync("xbsSetTheme", theme); } catch { }
        try { StatusBar.ApplyTheme(theme); } catch { }
        saved = true;
        AppSettings.AppLock = appLock;
        AppSettings.LockTimeoutMinutes = Math.Clamp(lockTimeout, 0, 60);
        Session.NotifySettingsChanged();
        saved = true;
    }

    private static string? ValidatePasswordChange(string current, string next, string confirm)
    {
        if (string.IsNullOrEmpty(current))
        {
            return "Current password is required.";
        }

        if (string.IsNullOrEmpty(next))
        {
            return "A new password is required.";
        }

        if (next == current)
        {
            return "The new password must be different from the current one.";
        }

        if (next != confirm)
        {
            return "New passwords do not match.";
        }

        return null;
    }

    private async Task ChangePassword()
    {
        pwError = string.Empty;
        pwDone = false;
        var invalid = ValidatePasswordChange(pwCurrent, pwNew, pwConfirm);
        if (invalid is not null)
        {
            pwError = invalid;
            return;
        }

        pwBusy = true;
        try
        {
            await Session.ChangePasswordAsync(pwCurrent, pwNew);
            pwCurrent = pwNew = pwConfirm = string.Empty;
            armedPw = false;
            pwDone = true;
        }
        catch (Exception ex)
        {
            // Never leave the current password or its confirmation in memory;
            // the new password stays so only the proof has to be retyped.
            pwCurrent = pwConfirm = string.Empty;
            pwError = ex.Message;
        }
        finally
        {
            pwBusy = false;
        }
    }
}
