<button class="btn btn-outline-primary" @onclick="ReportBug">Report a bug</button>

@code {
    private async Task ReportBug()
    {
        var subject = Uri.EscapeDataString($"[Keepmark {AppInfo.VersionString}] Bug report");
        var body = Uri.EscapeDataString(
            $"App version: {AppInfo.VersionString} (build {AppInfo.BuildString})\n" +
            $"API version: {Core.XbsConstants.ApiVersion} (v1.2: {Core.XbsConstants.ApiVersion12})\n" +
            $"Android: {DeviceInfo.VersionString} ({DeviceInfo.Model})\n\n" +
            $"Describe the issue:\n");
        try
        {
            await Launcher.OpenAsync($"mailto:keepmark@proton.me?subject={subject}&body={body}");
        }
        catch
        {
            // No email app configured; the address above remains copyable.
        }
    }
}
