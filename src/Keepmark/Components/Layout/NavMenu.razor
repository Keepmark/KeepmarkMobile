@inject Keepmark.Services.XbsSession Session
@inject Keepmark.Services.ToastState Toast
@inject Keepmark.Services.SecureCredentialStore Creds
@inject IJSRuntime JS
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <img src="img/mark.png" alt="" class="nav-brand-mark" />
        <a class="navbar-brand" href="">Keepmark</a>
    </div>
</div>

<button class="navbar-toggler xbs-nav-toggler" aria-label="Navigation menu" aria-expanded="@((!collapseNavMenu).ToString().ToLowerInvariant())" @onclick="ToggleNavMenu"></button>

<div class="@NavMenuCssClass nav-scrollable">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="CloseMenu">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Explore
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <button class="nav-link nav-sync-btn" @onclick="SyncAndClose" disabled="@(!linked)" title="@(linked ? "Push local changes and pull remote ones now" : "Link a service first (Connect)")">
                <span aria-hidden="true" class="nav-sync-glyph">⟳</span> Sync now
            </button>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="connect" @onclick="CloseMenu">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Connect
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="backup" @onclick="CloseMenu">
                <span aria-hidden="true" class="nav-sync-glyph">⤓</span> Backup
            </NavLink>
        </div>
        <div class="nav-item px-3">
            @if (linked)
            {
                <NavLink class="nav-link" href="switch-service" title="@SwitchTitle" @onclick="CloseMenu">
                    <span aria-hidden="true" class="nav-sync-glyph">⇄</span> Switch service
                </NavLink>
            }
            else
            {
                <span class="nav-link disabled" aria-disabled="true" title="@SwitchTitle">
                    <span aria-hidden="true" class="nav-sync-glyph">⇄</span> Switch service
                </span>
            }
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="duplicates" @onclick="CloseMenu">
                <span aria-hidden="true" class="nav-sync-glyph">⧉</span> Duplicates @if (dupCount > 0) { <span class="badge text-bg-warning ms-1">@dupCount</span> }
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="status" @onclick="CloseMenu">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Status
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="logs" @onclick="CloseMenu">
                <span aria-hidden="true" class="nav-sync-glyph">≣</span> Logs
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="settings" @onclick="CloseMenu">
                <span aria-hidden="true" class="nav-sync-glyph">⚙</span> Settings
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="about" @onclick="CloseMenu">
                <span aria-hidden="true" class="nav-sync-glyph">ⓘ</span> About
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private int dupCount;
    private bool linked;
    private bool collapseNavMenu = true;

    private string NavMenuCssClass => collapseNavMenu ? "collapse" : string.Empty;
    private string SwitchTitle => linked ? "Move to another service" : "Link a service first (Connect)";

    protected override async Task OnInitializedAsync()
    {
        for (int i = 0; i < 100 && !Session.Ready; i++)
        {
            await Task.Delay(100);
        }

        if (Session.Engine is not null)
        {
            Session.Engine.DataChanged += OnData;
        }

        await RefreshLinkedAsync();
        await RefreshDupCountAsync();
    }

    /// <summary>Switch service needs an existing link: refresh on init, on
    /// engine changes, and on every drawer open (link/unlink elsewhere).</summary>
    private async Task RefreshLinkedAsync()
    {
        try
        {
            linked = await Creds.GetAsync() is not null;
        }
        catch
        {
            linked = false;
        }
    }

    private async Task RefreshDupCountAsync()
    {
        if (Session.Store is null)
        {
            return;
        }

        try
        {
            dupCount = (await Session.Store.GetDuplicateUrlsAsync()).Sum(g => g.Rows.Count - 1);
        }
        catch
        {
            dupCount = 0;
        }
    }

    private void OnData() => InvokeAsync(async () => { await RefreshDupCountAsync(); await RefreshLinkedAsync(); StateHasChanged(); });

    // While the drawer is open the page behind must not scroll (same lock as modal sheets).
    private async Task ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
        try { await JS.InvokeVoidAsync("xbsGestures.lockScroll", !collapseNavMenu, "nav"); } catch { }
        if (!collapseNavMenu)
        {
            await RefreshLinkedAsync();
        }
    }

    private async Task CloseMenu()
    {
        collapseNavMenu = true;
        try { await JS.InvokeVoidAsync("xbsGestures.lockScroll", false, "nav"); } catch { }
    }

    public void Dispose()
    {
        _ = JS.InvokeVoidAsync("xbsGestures.lockScroll", false, "nav");
        if (Session.Engine is not null)
        {
            Session.Engine.DataChanged -= OnData;
        }
    }

    private async Task SyncAndClose()
    {
        await SyncNow();
        await CloseMenu();
    }

    private async Task SyncNow()
    {
        if (Session.Engine is null)
        {
            return;
        }

        try
        {
            await Session.Engine.ForceSyncAsync();
            // Paint first: the toast must never gate the status update.
            StateHasChanged();
            _ = Toast.ShowAsync(Session.Engine.Status == Core.Sync.SyncStatus.Idle
                ? $"Sync complete {DateTime.Now:HH:mm:ss}"
                : $"Sync finished: {Session.Engine.Status}");
        }
        catch (Exception ex)
        {
            _ = Toast.ShowAsync(ex.Message, isError: true);
        }
    }
}
