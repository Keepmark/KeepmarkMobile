@inject XBrowserSyncNg.Services.XbsSession Session

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">XBrowserSyncNg</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Explore
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <button class="nav-link nav-sync-btn" @onclick="SyncNow">
                <span aria-hidden="true" class="nav-sync-glyph">⟳</span> Sync now
            </button>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="connect">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Connect
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="status">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Status
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="settings">
                <span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span> Settings
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="about">
                <span class="bi bi-info-circle-fill-nav-menu" aria-hidden="true"></span> About
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private async Task SyncNow()
    {
        if (Session.Engine is not null)
        {
            try
            {
                await Session.Engine.ExecuteAutoSyncAsync();
            }
            catch
            {
            }
        }
    }
}
