@inject XBrowserSyncNg.Services.XbsSession Session
@inject XBrowserSyncNg.Services.ToastState Toast
@inject IJSRuntime JS
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <img src="img/mark.svg" alt="" class="nav-brand-mark" />
        <a class="navbar-brand" href="">xBrowserSyncNg</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" @onchange="OnNavToggle" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Explore
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <button class="nav-link nav-sync-btn" @onclick="SyncNow" title="Push local changes and pull remote ones now">
                <span aria-hidden="true" class="nav-sync-glyph">⟳</span> Sync now
            </button>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="connect">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Connect
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="migrate">
                <span aria-hidden="true" class="nav-sync-glyph">⇄</span> Migrate
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="duplicates">
                <span aria-hidden="true" class="nav-sync-glyph">⧉</span> Duplicates @if (dupCount > 0) { <span class="badge text-bg-warning ms-1">@dupCount</span> }
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="status">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Status
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="settings">
                <span aria-hidden="true" class="nav-sync-glyph">⚙</span> Settings
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="about">
                <span aria-hidden="true" class="nav-sync-glyph">ⓘ</span> About
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private int dupCount;

    protected override async Task OnInitializedAsync()
    {
        for (int i = 0; i < 100 && !Session.Ready; i++)
        {
            await Task.Delay(100);
        }

        if (Session.Engine is not null)
        {
            Session.Engine.DataChanged += OnData;
        }

        await RefreshDupCountAsync();
    }

    private async Task RefreshDupCountAsync()
    {
        if (Session.Store is null)
        {
            return;
        }

        try
        {
            dupCount = (await Session.Store.GetDuplicateUrlsAsync()).Sum(g => g.Rows.Count - 1);
        }
        catch
        {
            dupCount = 0;
        }
    }

    private void OnData() => InvokeAsync(async () => { await RefreshDupCountAsync(); StateHasChanged(); });

    // While the drawer is open the page behind must not scroll (same lock as modal sheets).
    private async Task OnNavToggle(ChangeEventArgs e)
    {
        try { await JS.InvokeVoidAsync("xbsGestures.lockScroll", e.Value is true, "nav"); } catch { }
    }

    public void Dispose()
    {
        _ = JS.InvokeVoidAsync("xbsGestures.lockScroll", false, "nav");
        if (Session.Engine is not null)
        {
            Session.Engine.DataChanged -= OnData;
        }
    }

    private async Task SyncNow()
    {
        if (Session.Engine is null)
        {
            return;
        }

        try
        {
            await Session.Engine.ForceSyncAsync();
            await Toast.ShowAsync(Session.Engine.Status == Core.Sync.SyncStatus.Idle
                ? $"Sync complete {DateTime.Now:HH:mm:ss}"
                : $"Sync finished: {Session.Engine.Status}");
        }
        catch (Exception ex)
        {
            await Toast.ShowAsync(ex.Message, isError: true);
        }
    }
}
