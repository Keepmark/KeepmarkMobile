@inherits LayoutComponentBase
@inject XBrowserSyncNg.Services.XbsSession Session
@inject XBrowserSyncNg.Services.AppLockState LockState
@inject XBrowserSyncNg.Services.XbsSettings AppSettings
@inject XBrowserSyncNg.Services.IAppLockService AppLock
@inject XBrowserSyncNg.Services.ToastState Toast
@implements IDisposable

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <span class="navbar-brand">XBrowserSyncNg</span>
            <span>
                <button class="btn btn-sm btn-outline-primary" @onclick="SyncNow" disabled="@syncing" onmouseup="this.blur()">
                    @(syncing ? "Syncing…" : "Sync now")
                </button>
            </span>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@if (Toast.Message is not null)
{
    <div class="xbs-toast @(Toast.IsError ? "error" : string.Empty)">@Toast.Message</div>
}

@if (LockState.Locked)
{
    <div class="xbs-lock">
        <div class="xbs-lock-card">
            <h3>XBrowserSyncNg is locked</h3>
            <p class="text-muted">Authenticate to continue.</p>
            <button class="btn btn-primary btn-lg" @onclick="Unlock">Unlock</button>
            @if (!string.IsNullOrEmpty(lockError))
            {
                <p class="text-danger mt-2">@lockError</p>
            }
        </div>
    </div>
}

@code {
    private string lockError = string.Empty;
    private bool syncing;

    protected override void OnInitialized()
    {
        LockState.Changed += OnLockChanged;
        Toast.Changed += OnToast;
        _ = WatchSessionAsync();
    }

    private async Task WatchSessionAsync()
    {
        for (int i = 0; i < 200 && !Session.Ready; i++)
        {
            await Task.Delay(100);
        }

        if (Session.Engine is not null)
        {
            Session.Engine.StatusChanged += OnEngineStatus;
        }
    }

    private void OnEngineStatus(Core.Sync.SyncStatus s)
    {
        syncing = s == Core.Sync.SyncStatus.Syncing;
        InvokeAsync(StateHasChanged);
    }

    private void OnLockChanged() => InvokeAsync(StateHasChanged);
    private void OnToast() => InvokeAsync(StateHasChanged);

    private async Task SyncNow()
    {
        if (Session.Engine is null || syncing)
        {
            return;
        }

        syncing = true;
        try
        {
            await Session.Engine.ForceSyncAsync();
            var st = Session.Engine.Status;
            if (st == Core.Sync.SyncStatus.Idle)
            {
                await Toast.ShowAsync($"Sync complete {DateTime.Now:HH:mm:ss}");
            }
            else if (st == Core.Sync.SyncStatus.Conflict)
            {
                await Toast.ShowAsync("Sync conflict: review in Explore", isError: true);
            }
            else if (st == Core.Sync.SyncStatus.NoCredentials)
            {
                await Toast.ShowAsync("No sync connected — open Connect", isError: true);
            }
            else
            {
                await Toast.ShowAsync($"Sync finished: {st}", isError: st != Core.Sync.SyncStatus.Offline);
            }
        }
        catch (Exception ex)
        {
            await Toast.ShowAsync(ex.Message, isError: true);
        }
        finally
        {
            syncing = false;
            StateHasChanged();
        }
    }

    private async Task Unlock()
    {
        lockError = string.Empty;
        bool ok = false;
        try
        {
            ok = await AppLock.AuthenticateAsync("Unlock XBrowserSyncNg", requireDeviceCredential: false);
        }
        catch
        {
            ok = false;
        }

        if (ok)
        {
            LockState.Unlock();
        }
        else
        {
            lockError = "Authentication failed.";
        }
    }

    public void Dispose()
    {
        LockState.Changed -= OnLockChanged;
        Toast.Changed -= OnToast;
        if (Session.Engine is not null)
        {
            Session.Engine.StatusChanged -= OnEngineStatus;
        }
    }
}
