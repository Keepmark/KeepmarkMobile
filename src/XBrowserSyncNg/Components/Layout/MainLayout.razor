@inherits LayoutComponentBase
@inject XBrowserSyncNg.Services.XbsSession Session
@inject XBrowserSyncNg.Services.AppLockState LockState
@inject XBrowserSyncNg.Services.XbsSettings AppSettings
@inject XBrowserSyncNg.Services.IAppLockService AppLock
@inject XBrowserSyncNg.Services.ToastState Toast
@implements IDisposable

<div class="page">
    @if (syncing)
    {
        <div class="xbs-toploader" role="progressbar" aria-label="Syncing"></div>
    }
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="xbs-appbar">
            <img src="img/mark.svg" alt="" />
            <span>xBrowserSyncNg</span>
        </div>
        <article class="content px-2">
            @Body
        </article>
    </main>
</div>

@if (Toast.Message is not null)
{
    <div class="xbs-toast @(Toast.IsError ? "error" : string.Empty)">@Toast.Message</div>
}

@if (LockState.Locked)
{
    <div class="xbs-lock">
        <div class="xbs-lock-card">
            <h3>xBrowserSyncNg is locked</h3>
            <p class="text-muted">Authenticate to continue.</p>
            <button class="btn btn-primary btn-lg" @onclick="Unlock">Unlock</button>
            @if (!string.IsNullOrEmpty(lockError))
            {
                <p class="text-danger mt-2">@lockError</p>
            }
        </div>
    </div>
}

@code {
    private string lockError = string.Empty;
    private bool syncing;

    protected override void OnInitialized()
    {
        LockState.Changed += OnLockChanged;
        Toast.Changed += OnToast;
        _ = WatchSessionAsync();
    }

    private async Task WatchSessionAsync()
    {
        for (int i = 0; i < 200 && !Session.Ready; i++)
        {
            await Task.Delay(100);
        }

        if (Session.Engine is not null)
        {
            Session.Engine.StatusChanged += OnEngineStatus;
            syncing = Session.Engine.Status == Core.Sync.SyncStatus.Syncing;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnEngineStatus(Core.Sync.SyncStatus s)
    {
        syncing = s == Core.Sync.SyncStatus.Syncing;
        InvokeAsync(StateHasChanged);
    }

    private void OnLockChanged() => InvokeAsync(StateHasChanged);
    private void OnToast() => InvokeAsync(StateHasChanged);

    private async Task Unlock()
    {
        lockError = string.Empty;
        bool ok = false;
        try
        {
            ok = await AppLock.AuthenticateAsync("Unlock XBrowserSyncNg", requireDeviceCredential: false);
        }
        catch
        {
            ok = false;
        }

        if (ok)
        {
            LockState.Unlock();
        }
        else
        {
            lockError = "Authentication failed.";
        }
    }

    public void Dispose()
    {
        LockState.Changed -= OnLockChanged;
        Toast.Changed -= OnToast;
        if (Session.Engine is not null)
        {
            Session.Engine.StatusChanged -= OnEngineStatus;
        }
    }
}
