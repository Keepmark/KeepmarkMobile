@inherits LayoutComponentBase
@inject XBrowserSyncNg.Services.XbsSession Session
@inject XBrowserSyncNg.Services.AppLockState LockState
@inject XBrowserSyncNg.Services.XbsSettings AppSettings
@inject XBrowserSyncNg.Services.IAppLockService AppLock
@inject XBrowserSyncNg.Services.ToastState Toast
@inject XBrowserSyncNg.Services.SharedImportService SharedImport
@inject XBrowserSyncNg.Services.SecureCredentialStore Creds
@inject NavigationManager Nav
@implements IDisposable

<div class="page">
    @if (syncing)
    {
        <div class="xbs-toploader" role="progressbar" aria-label="Syncing"></div>
        <div class="xbs-syncing-pill" role="status"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Syncing…</div>
    }
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="xbs-appbar">
            <img src="img/mark.svg" alt="" />
            <span>xBrowserSyncNg</span>
        </div>
        <article class="content px-2">
            @Body
        </article>
    </main>
</div>

@if (Toast.Message is not null)
{
    <div class="xbs-toast @(Toast.IsError ? "error" : "ok")" role="status">
        <span class="xbs-toast-icon" aria-hidden="true">@(Toast.IsError ? "⚠" : "✓")</span>
        <span>@Toast.Message</span>
    </div>
}

@if (LockState.Locked)
{
    <div class="xbs-lock">
        <div class="xbs-lock-card">
            <h3>xBrowserSyncNg is locked</h3>
            <p class="text-muted">Authenticate to continue.</p>
            <button class="btn btn-primary btn-lg" @onclick="Unlock">Unlock</button>
            @if (!string.IsNullOrEmpty(lockError))
            {
                <p class="text-danger mt-2">@lockError</p>
            }
        </div>
    </div>
}

@code {
    private string lockError = string.Empty;
    private bool syncing;

    protected override void OnInitialized()
    {
        LockState.Changed += OnLockChanged;
        Toast.Changed += OnToast;
        SharedImport.Arrived += OnShareArrived;
        _ = WatchSessionAsync();
    }

    private async Task WatchSessionAsync()
    {
        for (int i = 0; i < 200 && !Session.Ready; i++)
        {
            await Task.Delay(100);
        }

        if (Session.Engine is not null)
        {
            Session.Engine.StatusChanged += OnEngineStatus;
            syncing = Session.Engine.Status == Core.Sync.SyncStatus.Syncing;
            await InvokeAsync(StateHasChanged);
        }

        await RedirectFirstRunAsync();
    }

    /// <summary>Absolute first launch (no credentials, empty library): start on Connect.</summary>
    private async Task RedirectFirstRunAsync()
    {
        try
        {
            if (Session.Store is null)
            {
                return;
            }

            if (await Creds.GetAsync().ConfigureAwait(false) is not null)
            {
                return;
            }

            var stats = await Session.Store.GetStatsAsync().ConfigureAwait(false);
            if (stats.Folders + stats.Bookmarks + stats.Separators > 0)
            {
                return;
            }

            if (!string.IsNullOrEmpty(Nav.ToBaseRelativePath(Nav.Uri).Trim('/')))
            {
                return;
            }

            await InvokeAsync(() => Nav.NavigateTo("/connect"));
        }
        catch
        {
            // Never break startup for a convenience redirect.
        }
    }

    private void OnEngineStatus(Core.Sync.SyncStatus s)
    {
        syncing = s == Core.Sync.SyncStatus.Syncing;
        InvokeAsync(StateHasChanged);
    }

    private void OnLockChanged() => InvokeAsync(StateHasChanged);
    private void OnToast() => InvokeAsync(StateHasChanged);

    private void OnShareArrived() => InvokeAsync(() =>
    {
        // Home opens the sheet itself when already shown; navigating now would
        // recreate it and lose the pending share. Only navigate from elsewhere.
        if (!string.IsNullOrEmpty(Nav.ToBaseRelativePath(Nav.Uri)))
        {
            Nav.NavigateTo("/");
        }
    });

    private async Task Unlock()
    {
        lockError = string.Empty;
        bool ok = false;
        try
        {
            ok = await AppLock.AuthenticateAsync("Unlock XBrowserSyncNg", requireDeviceCredential: false);
        }
        catch
        {
            ok = false;
        }

        if (ok)
        {
            LockState.Unlock();
        }
        else
        {
            lockError = "Authentication failed.";
        }
    }

    public void Dispose()
    {
        LockState.Changed -= OnLockChanged;
        Toast.Changed -= OnToast;
        SharedImport.Arrived -= OnShareArrived;
        if (Session.Engine is not null)
        {
            Session.Engine.StatusChanged -= OnEngineStatus;
        }
    }
}
