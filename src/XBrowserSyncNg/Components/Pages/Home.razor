@page "/"
@using Microsoft.JSInterop
@using XBrowserSyncNg.Core.Data
@inject XBrowserSyncNg.Services.XbsSession Session
@inject XBrowserSyncNg.Services.PinnedStore Pins
@inject XBrowserSyncNg.Services.ToastState Toast
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Explore</PageTitle>

@if (!ready)
{
    <p><em>Loading local bookmarks…</em></p>
}
else if (engineStatus == Core.Sync.SyncStatus.NoCredentials)
{
    <p>No sync connected. <a href="connect">Connect to a service</a> to get started.</p>
}
else
{
    <div class="mb-2">
        <input class="form-control" placeholder="Search bookmarks (min 2 chars)…"
               @oninput="OnSearchInput" value="@query" />
    </div>

    @if (searching)
    {
        <p><em>Searching…</em></p>
    }
    else if (isSearch)
    {
        <p class="text-muted">@hits.Count result(s)</p>
        @foreach (var id in hitRows)
        {
            <BookmarkRow Row="byRow[id]" Pinned="pinned.Contains(byRow[id].NodeId ?? -1)"
                         FolderPath="@hitPaths.GetValueOrDefault(id)" OnOpen="OpenRow" OnAction="OnRowAction" />
        }
    }
    else
    {
        <div class="xbs-crumbs" role="navigation" aria-label="Folders">
            <button class="xbs-crumb" @onclick="GoRoot" aria-label="Top level">⌂</button>
            @foreach (var c in crumbs.Reverse())
            {
                <span class="xbs-crumb-sep">/</span>
                <button class="xbs-crumb" @onclick="() => JumpTo(c.RowId)">@c.Title</button>
            }
        </div>
        @if (pinnedRows.Count > 0 && crumbs.Count == 0)
        {
            <div class="xbs-pinned-box">
                <button class="xbs-pinned-head" @onclick="() => pinnedOpen = !pinnedOpen" aria-expanded="@pinnedOpen">
                    <span class="chev">@(pinnedOpen ? "▾" : "▸")</span>
                    <span>📌 Pinned (@pinnedRows.Count)</span>
                </button>
                @if (pinnedOpen)
                {
                    <div class="xbs-pinned-list">
                        @foreach (var r in pinnedRows)
                        {
                            <BookmarkRow Row="r" Pinned="true" OnOpen="OpenRow" OnAction="OnRowAction" />
                        }
                    </div>
                }
            </div>
        }
        @foreach (var r in rows)
        {
            <BookmarkRow Row="r" Pinned="pinned.Contains(r.NodeId ?? -1)" OnOpen="OpenRow" OnAction="OnRowAction" />
        }
        @if (rows.Count == 0) { <p class="text-muted">Empty here.</p> }
    }

    <p class="text-muted mt-3"><small>Status: @engineStatus · Last sync: @(lastSync?.ToString("u") ?? "never")</small></p>
    @if (Session.Engine?.Mode == Core.Sync.SyncMode.Manual)
    {
        <button class="btn btn-outline-primary btn-sm" @onclick="SyncNow">Sync now</button>
    }
}

<button class="btn btn-primary xbs-fab" @onclick="() => sheetFor = new SheetTarget(null, CurrentParent)" aria-label="Add">+</button>

@if (sheetFor is not null)
{
    <BookmarkSheet Visible="true" Existing="sheetFor.Row" DefaultParent="sheetFor.Parent"
                   Folders="allFolders" OnSave="SaveSheet" OnCancel="() => sheetFor = null" />
}

@if (menuFor is not null)
{
    <div class="xbs-sheet-backdrop" @onclick="() => menuFor = null">
        <div class="xbs-sheet" @onclick:stopPropagation="true">
            <h4>@(menuFor.Title ?? menuFor.Url)</h4>
            <div class="d-grid gap-2">
                @if (!menuFor.IsFolder)
                {
                    <button class="btn btn-primary" @onclick="() => { var r = menuFor; menuFor = null; _ = OpenRow(r); }">Open</button>
                    <button class="btn btn-secondary" @onclick="() => ShareRow(menuFor)">Share</button>
                }
                <button class="btn btn-secondary" @onclick="() => { var r = menuFor; menuFor = null; sheetFor = new SheetTarget(r, null); }">Edit</button>
                <button class="btn btn-secondary" @onclick="() => TogglePin(menuFor)">@(menuFor.NodeId is not null && pinned.Contains(menuFor.NodeId.Value) ? "Unpin" : "Pin")</button>
                <button class="btn btn-danger" @onclick="() => DeleteRow(menuFor)">Delete</button>
                <button class="btn btn-link" @onclick="() => menuFor = null">Cancel</button>
            </div>
        </div>
    </div>
}

@if (undo is not null)
{
    <div class="xbs-undo">
        <span>Bookmark deleted.</span>
        <button class="btn btn-sm btn-light" @onclick="UndoDelete">Undo</button>
    </div>
}

@code {
    private bool ready;
    private Core.Sync.SyncStatus engineStatus;
    private DateTimeOffset? lastSync;
    private List<ItemRow> rows = [];
    private List<ItemRow> pinnedRows = [];
    private List<ItemRow> allFolders = [];
    private HashSet<int> pinned = [];
    private readonly Stack<ItemRow> crumbs = new();
    private readonly Dictionary<int, ItemRow> byRow = new();
    private string query = string.Empty;
    private List<SearchHit> hits = [];
    private List<int> hitRows = [];
    private Dictionary<int, string> hitPaths = new();
    private bool isSearch;
    private bool searching;
    private CancellationTokenSource? debounce;
    private DotNetObjectReference<Home>? dotNet;
    private bool gesturesInit;
    private SheetTarget? sheetFor;
    private ItemRow? menuFor;
    private bool pinnedOpen = true;
    private (int? Parent, List<Core.Models.BookmarkNode> Subtree)? undo;
    private CancellationTokenSource? undoTimer;

    private int? CurrentParent => crumbs.Count == 0 ? null : crumbs.Peek().RowId;

    private sealed record SheetTarget(ItemRow? Row, int? Parent);

    protected override async Task OnInitializedAsync()
    {
        for (int i = 0; i < 100 && !Session.Ready; i++)
        {
            await Task.Delay(100);
        }

        if (Session.Engine is not null)
        {
            Session.Engine.StatusChanged += OnStatus;
            Session.Engine.DataChanged += OnData;
        }

        pinned = Pins.Load();
        await RefreshAsync();
        ready = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!gesturesInit && ready)
        {
            gesturesInit = true;
            dotNet = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("xbsGestures.init", dotNet);
        }
    }

    private async Task RefreshAsync()
    {
        if (Session is { Store: not null, Engine: not null })
        {
            engineStatus = Session.Engine.Status;
            lastSync = Session.Engine.LastSyncAt;
            var parent = CurrentParent;
            rows = await Session.Store.GetChildrenAsync(parent);
            allFolders = await Session.Store.GetAllFoldersAsync();
            pinnedRows = await Session.Store.GetByNodeIdsAsync(pinned);
            byRow.Clear();
            foreach (var r in rows.Concat(pinnedRows)) byRow[r.RowId] = r;
            foreach (var h in hits)
            {
                var node = await Session.Store.GetNodeAsync(h.RowId);
                if (node is not null) byRow[h.RowId] = node;
            }

            hitRows = hits.Where(h => byRow.ContainsKey(h.RowId)).Select(h => h.RowId).ToList();
            hitPaths = hits.ToDictionary(h => h.RowId, h => h.FolderPath);
        }
    }

    private void OnStatus(Core.Sync.SyncStatus s)
    {
        engineStatus = s;
        InvokeAsync(StateHasChanged);
    }

    private void OnData() => InvokeAsync(async () => { await RefreshAsync(); StateHasChanged(); });

    // ---- JS gesture callbacks ----

    [JSInvokable] public async Task OnRowTap(int rowId) => await OpenRow(await ResolveAsync(rowId));

    [JSInvokable]
    public async Task OnRowLongPress(int rowId)
    {
        var row = await ResolveAsync(rowId);
        if (row is not null)
        {
            menuFor = row;
            StateHasChanged();
        }
    }

    private async Task<ItemRow?> ResolveAsync(int rowId)
    {
        if (byRow.TryGetValue(rowId, out var cached)) return cached;
        if (Session.Store is null) return null;
        var node = await Session.Store.GetNodeAsync(rowId);
        if (node is not null) byRow[rowId] = node;
        return node;
    }

    // ---- Actions ----

    private async Task OpenRow(ItemRow? row)
    {
        if (row is null) return;
        if (row.IsFolder)
        {
            crumbs.Push(row);
            query = string.Empty;
            isSearch = false;
            await RefreshAsync();
        }
        else if (!string.IsNullOrWhiteSpace(row.Url) && row.Url != Core.XbsConstants.SeparatorUrl)
        {
            try { await Launcher.OpenAsync(row.Url); } catch { }
        }
    }

    private async Task OnRowAction((ItemRow Row, RowAction Action) a)
    {
        await JS.InvokeVoidAsync("xbsGestures.closeAll");
        switch (a.Action)
        {
            case RowAction.Share: await ShareRow(a.Row); break;
            case RowAction.Delete: await DeleteRow(a.Row); break;
            case RowAction.Menu: menuFor = a.Row; break;
        }
    }

    private async Task ShareRow(ItemRow? row)
    {
        menuFor = null;
        if (row is null || row.IsFolder) return;
        try
        {
            await Share.Default.RequestAsync(new ShareTextRequest($"{row.Title}\n{row.Url}", "Share bookmark"));
        }
        catch { }
    }

    private async Task TogglePin(ItemRow? row)
    {
        menuFor = null;
        if (row?.NodeId is null || Session.Engine is null) return;
        bool added = Pins.Toggle(row.NodeId.Value);
        pinned = Pins.Load();
        await RefreshAsync();
        await Toast.ShowAsync(added ? "Pinned" : "Unpinned");
        StateHasChanged();
    }

    private async Task DeleteRow(ItemRow? row)
    {
        menuFor = null;
        await JS.InvokeVoidAsync("xbsGestures.closeAll");
        if (row is null || Session.Engine is null) return;
        undoTimer?.Cancel();
        undo = await Session.Engine.DeleteBookmarkAsync(row.RowId);
        await RefreshAsync();
        StateHasChanged();
        undoTimer = new CancellationTokenSource();
        var token = undoTimer.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(6000, token);
                await InvokeAsync(() => { undo = null; StateHasChanged(); });
            }
            catch (TaskCanceledException) { }
        });
    }

    private async Task UndoDelete()
    {
        if (undo is null || Session.Engine is null) return;
        undoTimer?.Cancel();
        await Session.Engine.RestoreBookmarkAsync(undo.Value.Parent, undo.Value.Subtree);
        undo = null;
        await RefreshAsync();
    }

    private async Task SaveSheet(BookmarkSheet.BookmarkEdit e)
    {
        if (Session.Engine is null) return;
        if (e.RowId is null)
        {
            var node = new Core.Models.BookmarkNode
            {
                Title = e.Title, Url = e.Url, Description = e.Description, Tags = e.Tags,
                Children = e.IsFolder ? [] : null
            };
            await Session.Engine.AddBookmarkAsync(e.ParentRowId, node);
        }
        else
        {
            await Session.Engine.UpdateBookmarkAsync(e.RowId.Value, e.Title, e.Url, e.Description, e.Tags);
            var current = await Session.Store!.GetNodeAsync(e.RowId.Value);
            if (current is not null && current.ParentRowId != e.ParentRowId)
            {
                try
                {
                    await Session.Engine.MoveBookmarkAsync(e.RowId.Value, e.ParentRowId);
                }
                catch (Exception ex)
                {
                    // Move refused (e.g. folder into itself): fields are already saved.
                    System.Diagnostics.Debug.WriteLine($"Move skipped: {ex.Message}");
                }
            }
        }

        sheetFor = null;
        await RefreshAsync();
    }

    private async Task SyncNow()
    {
        if (Session.Engine is null)
        {
            return;
        }

        try
        {
            await Session.Engine.ForceSyncAsync();
            await Toast.ShowAsync(Session.Engine.Status == Core.Sync.SyncStatus.Idle
                ? $"Sync complete {DateTime.Now:HH:mm:ss}"
                : $"Sync finished: {Session.Engine.Status}",
                isError: Session.Engine.Status is not (Core.Sync.SyncStatus.Idle or Core.Sync.SyncStatus.Offline));
        }
        catch (Exception ex)
        {
            await Toast.ShowAsync(ex.Message, isError: true);
        }

        await RefreshAsync();
    }

    private async Task GoRoot()
    {
        crumbs.Clear();
        query = string.Empty;
        isSearch = false;
        await RefreshAsync();
    }

    private async Task JumpTo(int rowId)
    {
        while (crumbs.Count > 0 && crumbs.Peek().RowId != rowId)
        {
            crumbs.Pop();
        }

        query = string.Empty;
        isSearch = false;
        await RefreshAsync();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        query = e.Value?.ToString() ?? string.Empty;
        debounce?.Cancel();
        debounce = new CancellationTokenSource();
        var token = debounce.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(250, token);
                await InvokeAsync(async () =>
                {
                    if (query.Trim().Length >= 2 && Session.Store is not null)
                    {
                        searching = true;
                        isSearch = true;
                        StateHasChanged();
                        hits = await Session.Store.SearchAsync(query.Trim(), 50);
                        await RefreshAsync();
                        searching = false;
                    }
                    else
                    {
                        isSearch = false;
                        hits = [];
                        hitRows = [];
                    }

                    StateHasChanged();
                });
            }
            catch (TaskCanceledException)
            {
            }
        });
    }

    public void Dispose()
    {
        if (Session.Engine is not null)
        {
            Session.Engine.StatusChanged -= OnStatus;
            Session.Engine.DataChanged -= OnData;
        }

        debounce?.Cancel();
        debounce?.Dispose();
        undoTimer?.Cancel();
        undoTimer?.Dispose();
        dotNet?.Dispose();
    }
}
