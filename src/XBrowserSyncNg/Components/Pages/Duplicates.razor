@page "/duplicates"
@inject XBrowserSyncNg.Services.XbsSession Session
@inject XBrowserSyncNg.Services.ToastState Toast

<PageTitle>Duplicates</PageTitle>

<h1>Duplicate bookmarks</h1>
<p class="text-muted">Same URL saved more than once. Star the copy to keep, then clean up. One copy always survives.</p>

@if (!ready)
{
    <p><em>Loading…</em></p>
}
else if (groups.Count == 0)
{
    <div class="alert alert-success">No duplicates. Your library is clean.</div>
}
else
{
    <div class="btn-group mb-2" role="group" aria-label="Grouping">
        <button class="btn @(byFolder ? "btn-outline-primary" : "btn-primary")" @onclick="() => byFolder = false">By link</button>
        <button class="btn @(byFolder ? "btn-primary" : "btn-outline-primary")" @onclick="() => byFolder = true">By folder</button>
    </div>
    <p class="text-muted"><small>@TotalOthers() duplicate(s) can go. Tap a title to open it.</small></p>

    @if (!byFolder)
    {
        @foreach (var g in groups)
        {
            <section class="xbs-dupgroup">
                <div class="xbs-duptext-sub text-break">@g.Url <span class="badge text-bg-secondary">@g.Rows.Count</span></div>
                @foreach (var r in g.Rows)
                {
                    @DupRow(r, r.Title ?? r.Url ?? string.Empty, PathOf(r.RowId))
                }
                @if (armedGroup == g.Url)
                {
                    <div class="d-flex gap-2 align-items-center flex-wrap mt-1">
                        <span><strong>Delete @(g.Rows.Count - 1)?</strong> Keeps “@KeptTitle(g)”.</span>
                        <button class="btn btn-sm btn-danger" @onclick="() => ExecuteGroup(g)">Yes</button>
                        <button class="btn btn-sm btn-secondary" @onclick="() => armedGroup = null">No</button>
                    </div>
                }
                else
                {
                    <button class="btn btn-sm btn-outline-danger mt-1" @onclick="() => armedGroup = g.Url">
                        Delete @(g.Rows.Count - 1) duplicate(s)
                    </button>
                }
            </section>
        }
    }
    else
    {
        @foreach (var f in folders)
        {
            <section class="xbs-dupgroup">
                <div class="fw-bold mb-1">@(string.IsNullOrEmpty(f.Path) ? "⌂ Top level" : f.Path)</div>
                @foreach (var r in f.Rows)
                {
                    @DupRow(r, r.Title ?? r.Url ?? string.Empty, r.Url ?? string.Empty)
                }
            </section>
        }
    }

    <div class="xbs-dupbar">
        <span>@TotalOthers() duplicate(s)</span>
        @if (!armedAll)
        {
            <button class="btn btn-danger" @onclick="() => armedAll = true">Clean all…</button>
        }
        else
        {
            <span><strong>Delete all duplicates?</strong> First copy of each link stays.</span>
            <div class="d-flex gap-2">
                <button class="btn btn-danger" @onclick="ExecuteAll">Yes, clean</button>
                <button class="btn btn-secondary" @onclick="() => armedAll = false">Cancel</button>
            </div>
        }
    </div>
}

@code {
    private bool ready;
    private List<Core.Data.DuplicateGroup> groups = [];
    private List<FolderSection> folders = [];
    private Dictionary<int, string> paths = new();
    private Dictionary<string, int> keepers = new();
    private bool byFolder;
    private string? armedGroup;
    private bool armedAll;

    private sealed record FolderSection(string Path, List<Core.Data.ItemRow> Rows);

    protected override async Task OnInitializedAsync()
    {
        for (int i = 0; i < 100 && !Session.Ready; i++)
        {
            await Task.Delay(100);
        }

        await ReloadAsync();
        ready = true;
    }

    private async Task ReloadAsync()
    {
        armedGroup = null;
        armedAll = false;
        if (Session.Store is null)
        {
            return;
        }

        groups = await Session.Store.GetDuplicateUrlsAsync();
        paths = await Session.Store.GetFolderPathsAsync();
        // Default keeper: first occurrence. Unknown groups start there too.
        foreach (var g in groups)
        {
            if (!keepers.TryGetValue(g.Url, out var id) || g.Rows.All(r => r.RowId != id))
            {
                keepers[g.Url] = g.Rows[0].RowId;
            }
        }

        folders = groups.SelectMany(g => g.Rows)
            .GroupBy(r => paths.GetValueOrDefault(r.RowId, string.Empty))
            .OrderBy(g => g.Key)
            .Select(g => new FolderSection(g.Key, g.OrderBy(r => r.SortOrder).ToList()))
            .ToList();
    }

    private string PathOf(int rowId) => paths.GetValueOrDefault(rowId, string.Empty);

    private string KeptTitle(Core.Data.DuplicateGroup g)
    {
        var kept = g.Rows.FirstOrDefault(r => r.RowId == keepers.GetValueOrDefault(g.Url));
        return (kept ?? g.Rows[0]).Title ?? g.Rows[0].Url ?? "(no title)";
    }

    private int TotalOthers() => groups.Sum(g => g.Rows.Count - 1);

    private bool IsKept(Core.Data.ItemRow r) => keepers.TryGetValue(r.Url ?? string.Empty, out var id) && id == r.RowId;

    private void Star(Core.Data.ItemRow r)
    {
        if (r.Url is not null)
        {
            keepers[r.Url] = r.RowId;
            armedGroup = null;
        }
    }

    private async Task Open(Core.Data.ItemRow r)
    {
        if (!string.IsNullOrWhiteSpace(r.Url))
        {
            try { await Launcher.OpenAsync(r.Url); } catch { }
        }
    }

    private async Task ExecuteGroup(Core.Data.DuplicateGroup g)
    {
        if (Session.Engine is null)
        {
            return;
        }

        var keeper = keepers.GetValueOrDefault(g.Url, g.Rows[0].RowId);
        var count = 0;
        foreach (var r in g.Rows.Where(r => r.RowId != keeper))
        {
            try
            {
                await Session.Engine.DeleteBookmarkAsync(r.RowId);
                count++;
            }
            catch
            {
            }
        }

        await ReloadAsync();
        await Toast.ShowAsync(count > 0 ? $"Deleted {count} duplicate(s)" : "Nothing to delete");
    }

    private async Task ExecuteAll()
    {
        if (Session.Engine is null)
        {
            return;
        }

        var count = 0;
        foreach (var g in groups)
        {
            var keeper = keepers.GetValueOrDefault(g.Url, g.Rows[0].RowId);
            foreach (var r in g.Rows.Where(r => r.RowId != keeper))
            {
                try
                {
                    await Session.Engine.DeleteBookmarkAsync(r.RowId);
                    count++;
                }
                catch
                {
                }
            }
        }

        await ReloadAsync();
        await Toast.ShowAsync(count > 0 ? $"Deleted {count} duplicate(s)" : "Nothing to delete");
    }

    private RenderFragment DupRow(Core.Data.ItemRow r, string line1, string line2) => __builder =>
    {
        <div class="xbs-duprow">
            <button type="button" class="xbs-dupstar" aria-pressed="@IsKept(r).ToString().ToLowerInvariant()"
                    aria-label="@(IsKept(r) ? "Kept copy" : $"Keep this copy instead")"
                    @onclick="() => Star(r)" @onclick:stopPropagation="true">
                <span aria-hidden="true">@(IsKept(r) ? "★" : "☆")</span>
            </button>
            <button type="button" class="xbs-duptext" aria-label="Open @(r.Title ?? r.Url)" @onclick="() => Open(r)">
                <span class="xbs-duptext-title">@line1</span>
                @if (!string.IsNullOrEmpty(line2))
                {
                    <span class="xbs-duptext-sub">@line2</span>
                }
            </button>
        </div>
    };
}
