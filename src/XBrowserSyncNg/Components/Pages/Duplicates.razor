@page "/duplicates"
@inject XBrowserSyncNg.Services.XbsSession Session
@inject XBrowserSyncNg.Services.ToastState Toast

<PageTitle>Duplicates</PageTitle>

<h1>Duplicate bookmarks</h1>
<p class="text-muted">Same URL saved more than once. Tick what to remove, then delete once — there is no undo here, a safety backup is taken automatically on the next sync only for overwritten sides, so review first.</p>

@if (!ready)
{
    <p><em>Loading…</em></p>
}
else if (groups.Count == 0)
{
    <div class="alert alert-success">No duplicates. Your library is clean.</div>
}
else
{
    <div class="btn-group mb-3" role="group" aria-label="Grouping">
        <button class="btn @(byFolder ? "btn-outline-primary" : "btn-primary")" @onclick="() => byFolder = false">By link</button>
        <button class="btn @(byFolder ? "btn-primary" : "btn-outline-primary")" @onclick="() => byFolder = true">By folder</button>
    </div>

    @if (!byFolder)
    {
        @foreach (var g in groups)
        {
            <section class="mb-3">
                <h4 class="mb-1 text-break">@g.Url <small class="text-muted">(@g.Rows.Count)</small></h4>
                <p class="text-muted mb-1"><small>Kept: @(KeptTitle(g)) — one copy always stays.</small></p>
                <div class="mb-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => KeepFirst(g)">Keep first</button>
                </div>
                @foreach (var r in g.Rows)
                {
                    @DupRow(r)
                }
            </section>
        }
    }
    else
    {
        @foreach (var f in folders)
        {
            <section class="mb-3">
                <h4 class="mb-1">@(string.IsNullOrEmpty(f.Path) ? "⌂ Top level" : f.Path)</h4>
                <div class="mb-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => SelectFolder(f)">Select all here</button>
                </div>
                @foreach (var r in f.Rows)
                {
                    @DupRow(r)
                }
            </section>
        }
    }

    <div class="xbs-dupbar">
        <span>@selected.Count selected</span>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-outline-secondary" @onclick="SelectAll">Select all</button>
            <button class="btn btn-outline-secondary" disabled="@(selected.Count == 0)" @onclick="ClearAll">Clear</button>
            @if (!armed)
            {
                <button class="btn btn-danger" disabled="@(selected.Count == 0)" @onclick="() => armed = true">Delete…</button>
            }
            else
            {
                <button class="btn btn-danger" @onclick="ExecuteDelete">Confirm delete @selected.Count</button>
                <button class="btn btn-secondary" @onclick="() => armed = false">Cancel</button>
            }
        </div>
    </div>
}

@code {
    private bool ready;
    private List<Core.Data.DuplicateGroup> groups = [];
    private List<FolderSection> folders = [];
    private Dictionary<int, string> paths = new();
    private Dictionary<int, Core.Data.DuplicateGroup> groupOf = new();
    private readonly HashSet<int> selected = [];
    private bool byFolder;
    private bool armed;

    private sealed record FolderSection(string Path, List<Core.Data.ItemRow> Rows);

    protected override async Task OnInitializedAsync()
    {
        for (int i = 0; i < 100 && !Session.Ready; i++)
        {
            await Task.Delay(100);
        }

        await ReloadAsync();
        ready = true;
    }

    private async Task ReloadAsync()
    {
        selected.Clear();
        armed = false;
        if (Session.Store is null)
        {
            return;
        }

        groups = await Session.Store.GetDuplicateUrlsAsync();
        paths = await Session.Store.GetFolderPathsAsync();
        groupOf = groups.SelectMany(g => g.Rows.Select(r => (r.RowId, g)))
            .ToDictionary(x => x.RowId, x => x.g);
        // Default: keep the first occurrence of each link, select the rest.
        foreach (var g in groups)
        {
            foreach (var r in g.Rows.Skip(1))
            {
                selected.Add(r.RowId);
            }
        }

        folders = groups.SelectMany(g => g.Rows)
            .GroupBy(r => paths.GetValueOrDefault(r.RowId, string.Empty))
            .OrderBy(g => g.Key)
            .Select(g => new FolderSection(g.Key, g.OrderBy(r => r.SortOrder).ToList()))
            .ToList();
    }

    private string PathOf(int rowId) => paths.GetValueOrDefault(rowId, string.Empty);

    /// <summary>The copy currently kept for a link: first unselected row, else the first row.</summary>
    private string KeptTitle(Core.Data.DuplicateGroup g) =>
        (g.Rows.FirstOrDefault(r => !selected.Contains(r.RowId)) ?? g.Rows[0]).Title
        ?? g.Rows[0].Url ?? "(no title)";

    /// <summary>Invariant: a link's every copy can never be selected at once.</summary>
    private bool WouldWipeGroup(int rowId) =>
        groupOf.TryGetValue(rowId, out var g) && g.Rows.All(r => r.RowId == rowId || selected.Contains(r.RowId));

    /// <summary>Structural enforcement: the last remaining copy renders a Kept badge
    /// instead of a checkbox, so it cannot be ticked at all.</summary>
    private bool IsKeeper(int rowId) =>
        !selected.Contains(rowId) &&
        groupOf.TryGetValue(rowId, out var g) &&
        g.Rows.Count(r => !selected.Contains(r.RowId)) == 1;

    private void SelectAll()
    {
        selected.Clear();
        foreach (var g in groups)
        {
            foreach (var r in g.Rows.Skip(1))
            {
                selected.Add(r.RowId);
            }
        }

        armed = false;
    }

    private void ClearAll()
    {
        selected.Clear();
        armed = false;
    }

    private void KeepFirst(Core.Data.DuplicateGroup g)
    {
        foreach (var r in g.Rows)
        {
            selected.Remove(r.RowId);
        }

        foreach (var r in g.Rows.Skip(1))
        {
            selected.Add(r.RowId);
        }
    }

    private void SelectFolder(FolderSection f)
    {
        foreach (var r in f.Rows)
        {
            // Same invariant as manual ticking: always leave one copy behind.
            if (!WouldWipeGroup(r.RowId))
            {
                selected.Add(r.RowId);
            }
        }
    }

    private async Task Toggle(int rowId)
    {
        if (IsKeeper(rowId))
        {
            await Toast.ShowAsync("This copy is kept — untick another copy to keep that one instead");
            return;
        }

        if (selected.Contains(rowId))
        {
            selected.Remove(rowId);
        }
        else if (WouldWipeGroup(rowId))
        {
            await Toast.ShowAsync("Keeping one copy of this link — untick another copy first");
            return;
        }
        else
        {
            selected.Add(rowId);
        }

        armed = false;
    }

    private async Task Open(Core.Data.ItemRow r)
    {
        if (!string.IsNullOrWhiteSpace(r.Url))
        {
            try { await Launcher.OpenAsync(r.Url); } catch { }
        }
    }

    private async Task ExecuteDelete()
    {
        if (Session.Engine is null || selected.Count == 0)
        {
            return;
        }

        // Safety net (the UI already enforces it): never wipe a link entirely.
        var safe = selected
            .Where(id => !groupOf.TryGetValue(id, out var g) ||
                         g.Rows.Any(r => r.RowId != id && !selected.Contains(r.RowId)))
            .ToList();
        var skipped = selected.Count - safe.Count;
        var count = safe.Count;
        foreach (var id in safe)
        {
            try
            {
                await Session.Engine.DeleteBookmarkAsync(id);
            }
            catch
            {
                // Keep going: remaining ones are retried on the next pass.
            }
        }

        await ReloadAsync();
        await Toast.ShowAsync(skipped > 0
            ? $"Deleted {count} duplicate(s), kept one copy each ({skipped} refused)"
            : $"Deleted {count} duplicate(s)");
    }

    private RenderFragment DupRow(Core.Data.ItemRow r) => __builder =>
    {
        <div class="xbs-duprow">
            @if (IsKeeper(r.RowId))
            {
                <span class="badge text-bg-success xbs-dupkept">Kept</span>
            }
            else
            {
                <input type="checkbox" class="form-check-input xbs-dupcheck" checked="@selected.Contains(r.RowId)"
                       aria-label="Select @(r.Title ?? r.Url)" @onchange="() => Toggle(r.RowId)" />
            }
            <button type="button" class="xbs-duptext" @onclick="() => Toggle(r.RowId)">
                <span class="xbs-row-title">@(r.Title ?? r.Url)</span><br />
                <span class="xbs-row-sub">@r.Url</span><br />
                @if (!string.IsNullOrEmpty(PathOf(r.RowId)))
                {
                    <span class="xbs-row-path"><span aria-hidden="true">📁</span> @PathOf(r.RowId)</span>
                }
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => Open(r)">Open</button>
        </div>
    };
}
