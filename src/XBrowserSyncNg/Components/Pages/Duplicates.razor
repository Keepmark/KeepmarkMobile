@page "/duplicates"
@using System.Linq
@inject XBrowserSyncNg.Services.XbsSession Session
@inject XBrowserSyncNg.Services.ToastState Toast

<PageTitle>Duplicates</PageTitle>

<h1>Duplicate bookmarks</h1>
<p class="text-muted">Same URL saved more than once. Mark copies with ✕ to delete them — one copy of each link always stays. Tap a title to open it.</p>

@if (!ready)
{
    <p><em>Loading…</em></p>
}
else if (groups.Count == 0)
{
    <div class="alert alert-success">No duplicates. Your library is clean.</div>
}
else
{
    <div class="btn-group mb-2" role="group" aria-label="Grouping">
        <button class="btn @(byFolder ? "btn-outline-primary" : "btn-primary")" @onclick="() => byFolder = false">By link</button>
        <button class="btn @(byFolder ? "btn-primary" : "btn-outline-primary")" @onclick="() => byFolder = true">By folder</button>
    </div>
    <p class="text-muted"><small>@MarkedCount() marked for deletion.</small></p>

    @if (!byFolder)
    {
        @foreach (var g in groups)
        {
            var markedHere = g.Rows.Count(r => selected.Contains(r.RowId));
            <section class="xbs-dupgroup">
                <div class="xbs-duptext-sub text-break">@g.Url <span class="badge text-bg-secondary">@g.Rows.Count</span></div>
                @foreach (var r in g.Rows)
                {
                    @DupRow(r, r.Title ?? r.Url ?? string.Empty, PathOf(r.RowId))
                }
                @if (armedGroup == g.Url)
                {
                    <div class="d-flex gap-2 align-items-center flex-wrap mt-1">
                        <span><strong>Delete @markedHere?</strong></span>
                        <button class="btn btn-sm btn-danger" disabled="@busy" @onclick="() => ExecuteGroup(g)">Yes</button>
                        <button class="btn btn-sm btn-secondary" disabled="@busy" @onclick="() => armedGroup = null">No</button>
                    </div>
                }
                else
                {
                    <button class="btn btn-sm btn-outline-danger mt-1" disabled="@(busy || markedHere == 0)" @onclick="() => armedGroup = g.Url">
                        Delete @(markedHere == 0 ? "marked" : $"{markedHere} marked")
                    </button>
                }
            </section>
        }
    }
    else
    {
        @foreach (var f in folders)
        {
            <section class="xbs-dupgroup">
                <div class="fw-bold mb-1">@(string.IsNullOrEmpty(f.Path) ? "⌂ Top level" : f.Path)</div>
                @foreach (var r in f.Rows)
                {
                    @DupRow(r, r.Title ?? r.Url ?? string.Empty, r.Url ?? string.Empty)
                }
            </section>
        }
    }

    <div class="xbs-dupbar">
        <span>@MarkedCount() marked</span>
        @if (!armedAll)
        {
            <button class="btn btn-danger" disabled="@(busy || MarkedCount() == 0)" @onclick="() => armedAll = true">Delete marked…</button>
        }
        else
        {
            <span><strong>Delete @MarkedCount()?</strong> One copy of each link stays.</span>
            <div class="d-flex gap-2">
                <button class="btn btn-danger" disabled="@busy" @onclick="ExecuteAll">Yes, delete</button>
                <button class="btn btn-secondary" disabled="@busy" @onclick="() => armedAll = false">Cancel</button>
            </div>
        }
    </div>
}

@code {
    private bool ready;
    private List<Core.Data.DuplicateGroup> groups = [];
    private List<FolderSection> folders = [];
    private Dictionary<int, string> paths = new();
    private Dictionary<int, Core.Data.DuplicateGroup> groupOf = new();
    private readonly HashSet<int> selected = [];
    private bool byFolder;
    private string? armedGroup;
    private bool armedAll;
    private bool busy;

    private sealed record FolderSection(string Path, List<Core.Data.ItemRow> Rows);

    protected override async Task OnInitializedAsync()
    {
        for (int i = 0; i < 100 && !Session.Ready; i++)
        {
            await Task.Delay(100);
        }

        await ReloadAsync();
        ready = true;
    }

    private async Task ReloadAsync()
    {
        armedGroup = null;
        armedAll = false;
        busy = false;
        if (Session.Store is null)
        {
            return;
        }

        groups = await Session.Store.GetDuplicateUrlsAsync();
        paths = await Session.Store.GetFolderPathsAsync();
        groupOf = groups.SelectMany(g => g.Rows.Select(r => (r.RowId, g)))
            .ToDictionary(x => x.RowId, x => x.g);
        // Default: everything marked but the first occurrence of each link.
        selected.Clear();
        foreach (var g in groups)
        {
            foreach (var r in g.Rows.Skip(1))
            {
                selected.Add(r.RowId);
            }
        }

        folders = groups.SelectMany(g => g.Rows)
            .GroupBy(r => paths.GetValueOrDefault(r.RowId, string.Empty))
            .OrderBy(g => g.Key)
            .Select(g => new FolderSection(g.Key, g.OrderBy(r => r.SortOrder).ToList()))
            .ToList();
    }

    private string PathOf(int rowId) => paths.GetValueOrDefault(rowId, string.Empty);

    private int MarkedCount() => selected.Count;

    /// <summary>Invariant: the last unmarked copy of a link cannot be marked.</summary>
    private bool IsLocked(int rowId) =>
        !selected.Contains(rowId) &&
        groupOf.TryGetValue(rowId, out var g) &&
        g.Rows.All(r => r.RowId == rowId || selected.Contains(r.RowId));

    private static string MarkLabel(bool marked, bool locked) =>
        marked ? "Unmark for deletion" : locked ? "Always kept copy" : "Mark for deletion";

    private async Task Toggle(int rowId)
    {
        if (IsLocked(rowId))
        {
            await Toast.ShowAsync("One copy always stays — unmark another copy first");
            return;
        }

        if (!selected.Remove(rowId))
        {
            selected.Add(rowId);
        }

        armedGroup = null;
        armedAll = false;
    }

    private async Task Open(Core.Data.ItemRow r)
    {
        if (!string.IsNullOrWhiteSpace(r.Url))
        {
            try { await Launcher.OpenAsync(r.Url); } catch { }
        }
    }

    private async Task ExecuteGroup(Core.Data.DuplicateGroup g)
    {
        if (Session.Engine is null || busy)
        {
            return;
        }

        busy = true;
        try
        {
            // Safety net (the UI already enforces it): never wipe a link entirely.
            var targets = g.Rows
                .Where(r => selected.Contains(r.RowId) &&
                            g.Rows.Any(o => o.RowId != r.RowId && !selected.Contains(o.RowId)))
                .ToList();
            foreach (var r in targets)
            {
                try
                {
                    await Session.Engine.DeleteBookmarkAsync(r.RowId);
                }
                catch
                {
                }
            }

            await ReloadAsync();
            await Toast.ShowAsync(targets.Count > 0 ? $"Deleted {targets.Count} duplicate(s)" : "Nothing to delete");
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ExecuteAll()
    {
        if (Session.Engine is null || busy)
        {
            return;
        }

        busy = true;
        try
        {
            var count = 0;
            foreach (var g in groups)
            {
                var targets = g.Rows
                    .Where(r => selected.Contains(r.RowId) &&
                                g.Rows.Any(o => o.RowId != r.RowId && !selected.Contains(o.RowId)))
                    .ToList();
                foreach (var r in targets)
                {
                    try
                    {
                        await Session.Engine.DeleteBookmarkAsync(r.RowId);
                        count++;
                    }
                    catch
                    {
                    }
                }
            }

            await ReloadAsync();
            await Toast.ShowAsync(count > 0 ? $"Deleted {count} duplicate(s)" : "Nothing to delete");
        }
        finally
        {
            busy = false;
        }
    }

    private RenderFragment DupRow(Core.Data.ItemRow r, string line1, string line2) => __builder =>
    {
        var marked = selected.Contains(r.RowId);
        var locked = IsLocked(r.RowId);
        <div class="xbs-duprow">
            <button type="button" class="xbs-dupmark @(marked ? "on" : string.Empty)" disabled="@locked"
                    aria-pressed="@marked.ToString().ToLowerInvariant()"
                    aria-label="@MarkLabel(marked, locked)"
                    @onclick="() => Toggle(r.RowId)" @onclick:stopPropagation="true">
                <span aria-hidden="true">@(locked ? "🔒" : "✕")</span>
            </button>
            <button type="button" class="xbs-duptext" aria-label="Open @(r.Title ?? r.Url)" @onclick="() => Open(r)">
                <span class="xbs-duptext-title">@line1</span>
                @if (!string.IsNullOrEmpty(line2))
                {
                    <span class="xbs-duptext-sub">@line2</span>
                }
            </button>
        </div>
    };
}
