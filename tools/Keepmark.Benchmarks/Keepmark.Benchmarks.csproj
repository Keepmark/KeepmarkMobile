<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../src/Keepmark.Core/Keepmark.Core.csproj" /></ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <None Include="../../artifacts/native/linux-x64/libsqlcipher.so" Link="libsqlcipher.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckSqlCipherDevelopmentNative" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <Error Condition="!Exists('../../artifacts/native/linux-x64/libsqlcipher.so')" Text="Build the SQLCipher test native first: python3 scripts/prepare-sqlcipher.py --linux (from the repository root)." />
  </Target>
</Project>
